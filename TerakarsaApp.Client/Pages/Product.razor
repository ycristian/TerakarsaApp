@page "/products"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Shared.Products
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@inject ProductApiService ProductApi
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Data Produk</PageTitle>

<h3>Data Produk</h3>

@if (hasAccess is null)
{
    <p>Memeriksa akses...</p>
}
else if (hasAccess == false)
{
    <div class="alert alert-danger">Anda tidak memiliki akses ke modul ini.</div>
}
else
{
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-primary" @onclick="OpenCreateForm">
            + Tambah Produk
        </button>
        <PageSizeSelector PageSize="pageSize" PageSizeChanged="HandlePageSizeChange" />
    </div>

    <div style="width: 300px;">
        <input class="form-control" placeholder="Cari nama produk..."
               @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
    </div>
</div>

@if (isLoading)
{
    <p>Memuat data...</p>
}
else if (pagedResult.Items.Count == 0)
{
    <p>Tidak ada data produk.</p>
}
else
{
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Daftar Produk</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered border text-nowrap mb-0">
                    <thead>
                        <tr>
                            <SortableHeader Label="Nama" Column="Name" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                            <SortableHeader Label="Harga" Column="Price" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                            <SortableHeader Label="Stok" Column="Stock" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in pagedResult.Items)
                        {
                            <tr>
                                <td>@p.Name</td>
                                <td>@p.Price.ToString("N0")</td>
                                <td>@p.Stock</td>
                                <td>
                                    <AuthorizeView Roles="Admin">
                                        <Authorized>
                                            <button class="btn btn-sm btn-primary me-1" title="Edit" @onclick="() => OpenEditForm(p)"><i class="fe fe-edit"></i></button>
                                            <button class="btn btn-sm btn-danger" title="Hapus" @onclick="() => HandleDelete(p)"><i class="fe fe-trash-2"></i></button>
                                        </Authorized>
                                    </AuthorizeView>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <TablePagination PageNumber="currentPage" PageSize="pageSize" TotalCount="pagedResult.TotalCount" TotalPages="pagedResult.TotalPages" PageNumberChanged="ChangePage" />
        </div>
    </div>
}

@if (showForm)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" @onclick="CloseForm">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Edit Produk" : "Tambah Produk")</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseForm"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-3">
                            <label class="form-label">Nama Produk</label>
                            <InputText class="form-control" @bind-Value="formModel.Name" />
                            <ValidationMessage For="@(() => formModel.Name)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Harga</label>
                            <InputNumber class="form-control" @bind-Value="formModel.Price" />
                            <ValidationMessage For="@(() => formModel.Price)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Stok</label>
                            <InputNumber class="form-control" @bind-Value="formModel.Stock" />
                            <ValidationMessage For="@(() => formModel.Stock)" class="text-danger" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100" disabled="@isSaving">
                            @(isSaving ? "Menyimpan..." : "Simpan")
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDeleteModal Show="showDeleteConfirm" IsBusy="isDeleting" OnConfirm="ConfirmDelete" OnCancel="CancelDelete">
    <Message>Yakin ingin menghapus produk "@productPendingDelete?.Name"?</Message>
</ConfirmDeleteModal>
}

@code {
    private ProductPagedResult pagedResult = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showForm = false;
    private bool isEditMode = false;
    private bool? hasAccess = null;
    private ProductFormModel formModel = new();
    private bool showDeleteConfirm = false;
    private bool isDeleting = false;
    private ProductDto? productPendingDelete;

    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private string? sortColumn;
    private string sortDirection = "asc";
    private System.Threading.Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        hasAccess = state.User.HasClaim("module", "products");

        if (hasAccess == true)
            await LoadProducts();
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        pagedResult = await ProductApi.GetPagedAsync(new ProductPagedRequest
        {
            Search = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
            PageNumber = currentPage,
            PageSize = pageSize,
            SortColumn = sortColumn,
            SortDirection = sortDirection
        });
        isLoading = false;
    }

    private async Task HandlePageSizeChange(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadProducts();
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDirection = sortDirection == "asc" ? "desc" : "asc";
        else
        {
            sortColumn = column;
            sortDirection = "asc";
        }
        currentPage = 1;
        await LoadProducts();
    }

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        debounceTimer?.Dispose();
        debounceTimer = new System.Threading.Timer(async _ =>
        {
            currentPage = 1;
            await InvokeAsync(async () =>
            {
                await LoadProducts();
                StateHasChanged();
            });
        }, null, 400, Timeout.Infinite);
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > pagedResult.TotalPages) return;
        currentPage = page;
        await LoadProducts();
    }

    private void OpenCreateForm()
    {
        isEditMode = false;
        formModel = new ProductFormModel();
        showForm = true;
    }

    private void OpenEditForm(ProductDto product)
    {
        isEditMode = true;
        formModel = new ProductFormModel
        {
            Id = product.Id,
            Name = product.Name,
            Price = product.Price,
            Stock = product.Stock
        };
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
    }

    private async Task HandleSubmit()
    {
        isSaving = true;

        bool success;
        if (isEditMode)
        {
            success = await ProductApi.UpdateAsync(new ProductUpdateRequest
            {
                Id = formModel.Id,
                Name = formModel.Name,
                Price = formModel.Price,
                Stock = formModel.Stock
            });
        }
        else
        {
            success = await ProductApi.CreateAsync(new ProductCreateRequest
            {
                Name = formModel.Name,
                Price = formModel.Price,
                Stock = formModel.Stock
            });
        }

        isSaving = false;

        if (success)
        {
            showForm = false;
            await LoadProducts();
        }
    }

    private void HandleDelete(ProductDto product)
    {
        productPendingDelete = product;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        productPendingDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (productPendingDelete is null) return;

        isDeleting = true;
        var success = await ProductApi.DeleteAsync(productPendingDelete.Id);
        isDeleting = false;

        showDeleteConfirm = false;
        productPendingDelete = null;

        if (success)
            await LoadProducts();
    }

    public class ProductFormModel
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "Nama produk wajib diisi.")]
        [StringLength(150, MinimumLength = 3, ErrorMessage = "Nama produk minimal 3 karakter.")]
        public string Name { get; set; } = string.Empty;

        [Range(1, 999999999, ErrorMessage = "Harga harus lebih dari 0.")]
        public decimal Price { get; set; }

        [Range(0, int.MaxValue, ErrorMessage = "Stok tidak boleh negatif.")]
        public int Stock { get; set; }
    }
}
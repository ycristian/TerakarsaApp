@page "/bundles"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TerakarsaApp.Client.Services
@inject BundleApiService BundleApi
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Kelola Bundle</PageTitle>

<div class="page-header">
    <h1 class="page-title">Kelola Bundle</h1>
    <div>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="javascript:void(0)">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Kelola Bundle</li>
        </ol>
    </div>
</div>

@if (hasAccess is null)
{
    <p>Memeriksa akses...</p>
}
else if (hasAccess == false)
{
    <div class="alert alert-danger">Anda tidak memiliki akses ke modul ini.</div>
}
else
{
    <ArticlePicker LoadProjectsAsync="BundleApi.GetProjectsAsync"
                    LoadArticlesAsync="BundleApi.GetArticlesByProjectAsync"
                    SearchArticlesAsync="BundleApi.SearchArticlesAsync"
                    LoadThumbnailAsync="BundleApi.GetArticleThumbnailAsync"
                    DetailUrl="@(a => $"/bundles/{a.Id}/edit")"
                    SearchDetailUrl="@(r => $"/bundles/{r.Id}/edit")"
                    ActionLabel="Kelola"
                    ExtraColumnHeader="Jumlah Bundle"
                    ExtraColumnValue="@(a => a.BundleCount.ToString())" />
}

@code {
    private bool? hasAccess = null;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        hasAccess = state.User.HasClaim("module", "BUNDLE_MANAGE");
    }
}

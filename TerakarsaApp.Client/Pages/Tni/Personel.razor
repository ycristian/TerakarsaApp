@page "/tni/personel"
@layout TerakarsaApp.Client.Layout.TniLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Shared.Tni
@inject TniPersonelApiService PersonelApi
@inject TniPolaApiService PolaApi
@inject TniOrderState OrderState
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@* Prompt 63: daftar personel PDH TNI AD -- cari satu orang lewat kode / NRP / nama,
   lihat posisinya di alur, filter per area / satuan / status / perlu review / pola kemeja & celana.
   Muat bertahap 30 per halaman. *@

<PageTitle>Personel — PDH TNI AD</PageTitle>

@if (hasAccess is null)
{
    <p>Memeriksa akses...</p>
}
else if (hasAccess == false)
{
    <div class="alert alert-danger">Anda tidak memiliki akses ke modul ini.</div>
}
else
{
<div class="tni">
    <div class="tni-top">
        <div class="tni-row">
            <div>
                <div class="tni-t"><i class="fe fe-users"></i> Personel</div>
                <div class="tni-s">@(OrderState.IsLoaded ? OrderState.Subjudul : "Memuat order...")</div>
            </div>
            <TniBackButton />
        </div>
    </div>

    <input class="tni-inp tni-search" style="font-size:15px;padding:12px"
           placeholder="Cari kode / NRP / nama..."
           @bind="search" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />

    <div class="tni-row" style="margin-bottom:10px">
        <button class="tni-btn @(AdaFilter ? "tni-btn-p" : "tni-btn-o")" @onclick="@(() => showFilter = true)">
            <i class="fe fe-filter"></i> Filter@(AdaFilter ? $" ({JumlahFilter})" : "")
        </button>
        @* Prompt 89: laporan PDF A4 dari daftar yang sedang tampil; jumlah orang pindah ke dalam tombol. *@
        <button class="tni-btn tni-btn-o" disabled="@(total == 0 || isLoading || isUnduh)" @onclick="UnduhLaporanAsync">
            @if (isUnduh)
            {
                <span class="spinner-border spinner-border-sm" style="margin-right:4px"></span>
            }
            else
            {
                <text>⬇ </text>
            }
            Laporan PDF · @total.ToString("N0") orang
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(infoMessage))
    {
        <div class="alert alert-success">@infoMessage</div>
    }

    @if (items.Count == 0 && !isLoading)
    {
        <div class="tni-card"><span class="tni-note">Tidak ada personel yang cocok.</span></div>
    }

    @foreach (var p in items)
    {
        @* Dibuka di TAB BARU supaya daftar + filter + posisi scroll-nya tetap utuh saat
           detail ditutup. Anchor target="_blank" TANPA rel="noopener" -- itu syarat browser
           mengizinkan window.close() di halaman detail (lihat CloseButton.razor). *@
        <a class="tni-card tni-tap" href="@($"/tni/personel/{p.PersonelId}")" target="_blank"
           style="display:block;text-decoration:none;color:inherit">
            <div class="tni-row">
                <span>
                    <span class="tni-pola-lg" style="font-size:15px">@p.KodeRef</span>
                    <span class="tni-note" style="margin-left:5px">@p.Pangkat</span>
                </span>
                <span>
                    @if (p.PerluReview)
                    {
                        <span class="tni-chip tni-chip-bad">review</span>
                    }
                    <TniStatusChip Status="@p.StatusProgres" />
                </span>
            </div>
            <div class="tni-b" style="margin-top:2px">@p.Nama</div>
            <div class="tni-row" style="margin-top:3px">
                <span class="tni-pola" style="font-size:11.5px">@p.PolaKemejaKode · @p.PolaCelanaKode</span>
                <span class="tni-k">
                    @p.SatuanCode
                    @if (!string.IsNullOrEmpty(p.BoxCode))
                    {
                        <text> · @p.BoxCode</text>
                    }
                </span>
            </div>
        </a>
    }

    @if (isLoading)
    {
        <p class="tni-note">Memuat...</p>
    }
    else if (items.Count < total)
    {
        <button class="tni-btn tni-btn-o" style="width:100%" @onclick="LoadMoreAsync">
            Muat lagi (@((total - items.Count).ToString("N0")) sisa)
        </button>
    }
</div>

@* ---------------- bottom sheet FILTER ---------------- *@
@if (showFilter)
{
    <div class="tni-sheet-backdrop" @onclick="@(() => showFilter = false)">
        <div class="tni-sheet tni" @onclick:stopPropagation="true">
            <div class="tni-sheet-h">
                <div class="tni-t" style="color:var(--tni-navy)">Filter</div>
                <button class="tni-btn" @onclick="@(() => showFilter = false)"><i class="fe fe-x"></i></button>
            </div>

            <div class="tni-k">Rawatan</div>
            <select class="tni-inp" @bind="areaId" @bind:after="OnAreaChanged">
                <option value="0">Semua rawatan</option>
                @foreach (var a in areas)
                {
                    <option value="@a.AreaId">@a.AreaName</option>
                }
            </select>

            <div class="tni-k" style="margin-top:8px">Satuan</div>
            <select class="tni-inp" @bind="satuanId">
                <option value="0">Semua satuan</option>
                @foreach (var sa in SatuanPilihan)
                {
                    <option value="@sa.SatuanId">@sa.SatuanCode — @sa.SatuanName</option>
                }
            </select>

            <div class="tni-k" style="margin-top:8px">Status</div>
            <select class="tni-inp" @bind="status">
                <option value="">Semua status</option>
                <option value="BELUM_CETAK">Belum cetak</option>
                <option value="DICETAK">Kartu dicetak</option>
                <option value="SET_JADI">Set jadi</option>
                <option value="MASUK_BOX">Masuk box</option>
                <option value="TERKIRIM">Terkirim</option>
            </select>

            @* Hanya pola yang dipakai personel di order aktif, beserta jumlah orangnya. *@
            <div class="tni-k" style="margin-top:8px">Kemeja</div>
            <select class="tni-inp" @bind="polaKemejaId">
                <option value="0">Semua kemeja</option>
                @foreach (var pk in polaKemeja)
                {
                    <option value="@pk.PolaId">@pk.Kode (@pk.JumlahPemakai.ToString("N0"))</option>
                }
            </select>

            <div class="tni-k" style="margin-top:8px">Celana</div>
            <select class="tni-inp" @bind="polaCelanaId">
                <option value="0">Semua celana</option>
                @foreach (var pc in polaCelana)
                {
                    <option value="@pc.PolaId">@pc.Kode (@pc.JumlahPemakai.ToString("N0"))</option>
                }
            </select>

            <label class="tni-k" style="display:flex;align-items:center;gap:6px;margin-top:10px">
                <input type="checkbox" @bind="perluReview" />
                Hanya yang perlu review
            </label>

            <div class="tni-bot" style="position:static;margin:14px -14px -18px">
                <button class="tni-btn tni-btn-o" @onclick="ResetFilterAsync">Reset</button>
                <button class="tni-btn tni-btn-p" @onclick="TerapkanFilterAsync">Terapkan</button>
            </div>
        </div>
    </div>
}
}

@code {
    private const int PageSize = 30;

    // Filter awal dari query string -- chip di beranda menautkan ke sini
    // (mis. /tni/personel?status=SET_JADI, /tni/personel?review=1).
    [SupplyParameterFromQuery(Name = "status")] public string? QStatus { get; set; }
    [SupplyParameterFromQuery(Name = "review")] public string? QReview { get; set; }
    [SupplyParameterFromQuery(Name = "areaId")] public int? QAreaId { get; set; }
    [SupplyParameterFromQuery(Name = "satuanId")] public int? QSatuanId { get; set; }
    [SupplyParameterFromQuery(Name = "polaKemejaId")] public int? QPolaKemejaId { get; set; }
    [SupplyParameterFromQuery(Name = "polaCelanaId")] public int? QPolaCelanaId { get; set; }

    private bool? hasAccess;
    private bool isLoading;
    private bool showFilter;
    private string errorMessage = string.Empty;

    private string search = string.Empty;
    private int areaId;
    private int satuanId;
    private string status = string.Empty;
    private bool perluReview;
    private int polaKemejaId;
    private int polaCelanaId;

    private List<TniPolaDto> polaKemeja = new();
    private List<TniPolaDto> polaCelana = new();

    private int page = 1;
    private int total;
    private List<TniPersonelListItemDto> items = new();
    private List<TniWilayahRowDto> wilayah = new();

    private System.Threading.Timer? debounceTimer;

    private List<TniWilayahRowDto> areas =>
        wilayah.GroupBy(w => w.AreaId).Select(g => g.First()).OrderBy(w => w.AreaCode).ToList();

    private List<TniWilayahRowDto> SatuanPilihan =>
        wilayah.Where(w => w.SatuanId.HasValue && (areaId == 0 || w.AreaId == areaId))
               .OrderBy(w => w.SatuanCode)
               .ToList();

    private bool AdaFilter => JumlahFilter > 0;

    private int JumlahFilter =>
        (areaId > 0 ? 1 : 0) + (satuanId > 0 ? 1 : 0) +
        (string.IsNullOrEmpty(status) ? 0 : 1) + (perluReview ? 1 : 0) +
        (polaKemejaId > 0 ? 1 : 0) + (polaCelanaId > 0 ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        // TANPA LOGIN: pairing perangkat ditangani TniLayout,
        // jadi halaman yang sudah dirender pasti sudah berhak.
        hasAccess = true;
        if (hasAccess != true) return;

        if (!string.IsNullOrEmpty(QStatus)) status = QStatus;
        if (QReview is "1" or "true") perluReview = true;
        if (QAreaId is > 0) areaId = QAreaId.Value;
        if (QSatuanId is > 0) satuanId = QSatuanId.Value;
        if (QPolaKemejaId is > 0) polaKemejaId = QPolaKemejaId.Value;
        if (QPolaCelanaId is > 0) polaCelanaId = QPolaCelanaId.Value;

        await OrderState.EnsureLoadedAsync();

        var wilayahTask = PersonelApi.GetWilayahAsync();
        var kemejaTask = PolaApi.GetListAsync("KEMEJA");
        var celanaTask = PolaApi.GetListAsync("CELANA");
        await Task.WhenAll(wilayahTask, kemejaTask, celanaTask);

        wilayah = wilayahTask.Result;
        // JumlahPemakai dihitung untuk order aktif -- pola yang tidak dipakai tidak perlu dipilih.
        polaKemeja = kemejaTask.Result.Where(p => p.JumlahPemakai > 0)
            .OrderBy(p => p.TargetGender).ThenBy(p => p.LingkarDadaAcuan).ThenBy(p => p.Kode).ToList();
        polaCelana = celanaTask.Result.Where(p => p.JumlahPemakai > 0)
            .OrderBy(p => p.TargetGender).ThenBy(p => p.SizeAngka).ThenBy(p => p.Kode).ToList();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        page = 1;

        try
        {
            var f = new FilterAktif(
                string.IsNullOrWhiteSpace(search) ? null : search,
                areaId > 0 ? areaId : null, satuanId > 0 ? satuanId : null,
                string.IsNullOrEmpty(status) ? null : status, perluReview,
                polaKemejaId > 0 ? polaKemejaId : null, polaCelanaId > 0 ? polaCelanaId : null);

            var result = await PersonelApi.GetListAsync(
                f.Search, f.AreaId, f.SatuanId, f.Status, f.PerluReview, page, PageSize,
                f.PolaKemejaId, f.PolaCelanaId);

            items = result.Items;
            total = result.TotalCount;
            filterAktif = f;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        isLoading = false;
    }

    private async Task LoadMoreAsync()
    {
        isLoading = true;
        page++;

        try
        {
            var result = await PersonelApi.GetListAsync(
                search, areaId > 0 ? areaId : null, satuanId > 0 ? satuanId : null,
                string.IsNullOrEmpty(status) ? null : status, perluReview, page, PageSize,
                polaKemejaId > 0 ? polaKemejaId : null, polaCelanaId > 0 ? polaCelanaId : null);

            items.AddRange(result.Items);
            total = result.TotalCount;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        isLoading = false;
    }

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        debounceTimer?.Dispose();
        debounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }, null, 300, Timeout.Infinite);
    }

    // Ganti rawatan -> satuan yang terpilih mungkin tidak lagi masuk daftar.
    private void OnAreaChanged()
    {
        if (satuanId > 0 && !SatuanPilihan.Any(x => x.SatuanId == satuanId)) satuanId = 0;
    }

    private async Task TerapkanFilterAsync()
    {
        showFilter = false;
        await LoadAsync();
    }

    private async Task ResetFilterAsync()
    {
        areaId = 0;
        satuanId = 0;
        status = string.Empty;
        perluReview = false;
        polaKemejaId = 0;
        polaCelanaId = 0;
        showFilter = false;
        await LoadAsync();
    }

    // ---------- Prompt 89: unduh laporan PDF ----------

    // Filter yang TERAKHIR dipakai memuat daftar -- isian sheet Filter yang belum
    // diterapkan / ketikan yang belum lewat debounce tidak ikut ke laporan.
    private sealed record FilterAktif(string? Search, int? AreaId, int? SatuanId, string? Status, bool PerluReview,
        int? PolaKemejaId, int? PolaCelanaId);

    private FilterAktif filterAktif = new(null, null, null, null, false, null, null);
    private bool isUnduh;
    private string infoMessage = string.Empty;

    // Perkiraan halaman PDF portrait: ±45 baris per halaman (sebagian nama 2 baris) + 1 untuk rekap box.
    private const int BarisPerHalaman = 45;
    private const int AmbangKonfirmasi = 300;

    private async Task UnduhLaporanAsync()
    {
        if (total == 0 || isUnduh) return;

        errorMessage = string.Empty;
        infoMessage = string.Empty;

        if (total > AmbangKonfirmasi)
        {
            var halaman = (int)Math.Ceiling(total / (double)BarisPerHalaman) + 1;
            var lanjut = await JS.InvokeAsync<bool>("confirm",
                $"Laporan {total:N0} orang ≈ {halaman:N0} halaman. Lanjutkan?");
            if (!lanjut) return;
        }

        isUnduh = true;
        StateHasChanged();

        try
        {
            var f = filterAktif;
            var (ok, err, bytes, nama) = await PersonelApi.GetLaporanPdfAsync(
                f.Search, f.AreaId, f.SatuanId, f.Status, f.PerluReview, f.PolaKemejaId, f.PolaCelanaId);

            if (!ok) { errorMessage = err; return; }

            await JS.InvokeVoidAsync("downloadFileFromBytes",
                nama, "application/pdf", Convert.ToBase64String(bytes!));
            infoMessage = $"Laporan {nama} diunduh.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isUnduh = false;
        }
    }

    public void Dispose() => debounceTimer?.Dispose();
}

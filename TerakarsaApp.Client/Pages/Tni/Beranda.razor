@page "/tni"
@layout TerakarsaApp.Client.Layout.TniLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Shared.Tni
@inject TniPersonelApiService PersonelApi
@inject TniOrderState OrderState
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject TniPerangkatState Sesi

@* Prompt 63: beranda module PDH TNI AD -- pintu masuk module di HP (mockup layar 1).
   Semua angka dari tni.SIS_Beranda_Summary, yang membacanya dari tni.v_personel. *@

<PageTitle>PDH TNI AD</PageTitle>

@if (hasAccess is null)
{
    <p>Memeriksa akses...</p>
}
else if (hasAccess == false)
{
    <div class="alert alert-danger">Anda tidak memiliki akses ke modul ini.</div>
}
else
{
<div class="tni">
    <div class="tni-top">
        <div class="tni-row">
            <div>
                <div class="tni-t"><i class="fe fe-shield"></i> @(OrderState.Order?.OrderName ?? "PDH TNI AD")</div>
                <div class="tni-s">@(OrderState.IsLoaded ? OrderState.Subjudul : "Memuat order...")</div>
            </div>
            <button class="tni-btn" style="background:rgba(255,255,255,.15);color:#fff"
                    @onclick="RefreshAsync" disabled="@isLoading">
                <i class="fe fe-refresh-cw"></i>
            </button>
        </div>
    </div>

    @* ---------- 4 kotak angka ---------- *@
    <div class="tni-stat4">
        <div>
            <span class="tni-k">Kartu dicetak</span>
            <b>@s.Dicetak.ToString("N0")</b>
        </div>
        <div>
            <span class="tni-k">Dapat set</span>
            <b>@s.DapatSet.ToString("N0")</b>
        </div>
        <div>
            <span class="tni-k">Masuk box</span>
            <b>@s.MasukBox.ToString("N0")</b>
        </div>
        <div>
            <span class="tni-k">Terkirim</span>
            <b style="color:var(--tni-ok)">@s.Terkirim.ToString("N0")</b>
        </div>
    </div>

    @* ---------- progres personel ----------
       Satu batang bertumpuk (warna sama dengan kartu satuan di Perintah Kerja):
       terkirim (hijau) -> masuk box (navy) -> sudah set (emas) -> sedang dikerjakan (biru muda).
       Legenda sekaligus pintu ke daftar Personel (menggantikan chip "set belum masuk box"
       dan "kartu belum di-scan" yang isinya sama). *@
    <div class="tni-card">
        <div class="tni-row">
            <span class="tni-k">Progres masuk box</span>
            <span class="tni-b">@s.PersenBox%</span>
        </div>
        <div class="tni-prog">
            <span style="width:@Lebar(s.Terkirim, s.Total);background:var(--tni-ok)"></span>
            <span style="width:@Lebar(s.MasukBox - s.Terkirim, s.Total);background:var(--tni-navy)"></span>
            <span style="width:@Lebar(s.SetBelumBox, s.Total);background:var(--tni-gold)"></span>
            <span style="width:@Lebar(s.KartuBelumScan, s.Total);background:@WarnaDicetak"></span>
        </div>
        <div class="tni-leg tni-leg-link">
            @if (s.Terkirim > 0)
            {
                <span @onclick="@(() => KePersonel("status=TERKIRIM"))"><i style="background:var(--tni-ok)"></i>Terkirim <b>@s.Terkirim.ToString("N0")</b></span>
            }
            <span @onclick="@(() => KePersonel("status=MASUK_BOX"))"><i style="background:var(--tni-navy)"></i>Masuk box <b>@((s.MasukBox - s.Terkirim).ToString("N0"))</b></span>
            <span @onclick="@(() => KePersonel("status=SET_JADI"))"><i style="background:var(--tni-gold)"></i>Sudah set <b>@s.SetBelumBox.ToString("N0")</b></span>
            <span @onclick="@(() => KePersonel("status=DICETAK"))"><i style="background:@WarnaDicetak"></i>Sedang dikerjakan <b>@s.KartuBelumScan.ToString("N0")</b></span>
        </div>
        <div class="tni-row" style="margin-top:6px">
            <span class="tni-note">
                @s.MasukBox.ToString("N0") dari @s.Total.ToString("N0") personel masuk box
                · <b>@s.BoxTerbuka/@s.BoxTotal</b> box terbuka
            </span>
            @if (s.PerluReview > 0 && Sesi.BolehMenu("PERSONEL"))
            {
                <span class="tni-chip tni-chip-bad" style="cursor:pointer"
                      @onclick="@(() => KePersonel("review=1"))">
                    @s.PerluReview perlu review
                </span>
            }
        </div>
    </div>

    @* ---------- grid tile ---------- *@
    <div class="tni-sec">Menu</div>
    @if (tiles.Count == 0)
    {
        <div class="tni-card"><span class="tni-note">Perangkat ini belum diberi akses menu apa pun.</span></div>
    }
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px">
        @foreach (var t in tiles)
        {
            <div class="tni-card tni-tap" style="text-align:center;padding:12px 4px;margin:0;position:relative"
                 @onclick="@(() => Nav.NavigateTo(t.Route))">
                <i class="@t.Icon" style="font-size:20px;display:block;margin-bottom:4px;color:var(--tni-navy)"></i>
                <span style="font-size:11.5px;font-weight:600">@t.Label</span>
                @if (t.Badge > 0)
                {
                    <span style="position:absolute;top:4px;right:6px;background:var(--tni-coral);color:#fff;font-size:9px;border-radius:10px;padding:1px 5px">
                        @t.Badge
                    </span>
                }
            </div>
        }
    </div>

    <div class="tni-sec">Barang &amp; stok</div>
    @* ---------- barang & stok (2026-11-10) ----------
       Kartu Kemeja/Celana: masuk bersih vs kebutuhan (1 per personel), lalu stok
       tersedia = belum di-set jadi = lock (dijatah kartu yang sudah dicetak) + kunci
       (ditahan satuan bergembok, dirinci per kode satuan) + unlock.
       Kartu Set: berapa personel yang bisa di-set dari stok itu sekarang. *@
    <div class="tni-grid3">
        @foreach (var (label, j) in new[] { ("Kemeja", st.Kemeja), ("Celana", st.Celana) })
        {
            var pct = Persen(j.Masuk, s.Total);
            <div class="tni-card">
                <div class="tni-row">
                    <span class="tni-b">@label</span>
                    <span class="tni-b" style="color:var(--tni-navy2)">@pct%</span>
                </div>
                <div class="tni-prog"><span style="width:@(pct)%;background:var(--tni-navy2)"></span></div>
                <div class="tni-note">@j.Masuk.ToString("N0") / @s.Total.ToString("N0") masuk</div>

                <div class="tni-grid3-sep">
                    <span class="tni-k">Stok tersedia</span>
                    <b class="tni-big">@j.Tersedia.ToString("N0")</b>
                    <div class="tni-leg" style="margin-top:4px">
                        <span><i style="background:@WarnaDicetak"></i>Lock @j.Lock.ToString("N0")</span>
                        @if (j.Kunci > 0)
                        {
                            <span><i style="background:@WarnaKunci"></i>Kunci @j.Kunci.ToString("N0")</span>
                        }
                        <span><i style="background:@WarnaUnlock"></i>Unlock @j.Unlock.ToString("N0")</span>
                    </div>
                    @if (j.KunciSatuan.Count > 0)
                    {
                        <div class="tni-note" style="margin-top:3px">
                            <i class="fe fe-lock" style="color:@WarnaKunci"></i>
                            @(string.Join(" · ", j.KunciSatuan.Select(x => x.SatuanCode + " " + x.Qty.ToString("N0"))))
                        </div>
                    }
                </div>
            </div>
        }
        <div class="tni-card">
            <span class="tni-b">Set</span>
            <div style="margin-top:6px">
                <span class="tni-k">Bisa di-set sekarang</span>
                <b class="tni-big" style="color:var(--tni-ok)">@st.BisaDiset.ToString("N0")</b>
                <div class="tni-note">personel, dari stok tersedia</div>
            </div>
            <div class="tni-grid3-sep">
                <div class="tni-leg" style="flex-direction:column;gap:3px">
                    <span><i style="background:@WarnaDicetak"></i>@st.BisaDisetLock.ToString("N0") dari lock</span>
                    @if (st.BisaDisetKunci > 0 || st.Kemeja.Kunci + st.Celana.Kunci > 0)
                    {
                        <span><i style="background:@WarnaKunci"></i>@st.BisaDisetKunci.ToString("N0") untuk satuan dikunci</span>
                    }
                    <span><i style="background:@WarnaUnlock"></i>@st.BisaDisetUnlock.ToString("N0") dari unlock</span>
                </div>
                <div class="tni-note" style="margin-top:4px">
                    Lock = stok yang sudah dijatah ke kartu tercetak.
                    @if (st.Kemeja.Kunci + st.Celana.Kunci > 0)
                    {
                        <span>Kunci = stok yang ditahan untuk satuan bergembok di Perintah Kerja.</span>
                    }
                </div>
            </div>
        </div>
    </div>

</div>
}

@code {
    private bool? hasAccess;
    private bool bolehApprove;      // module TNI_PDH_APPROVE -- tile Pembatalan
    private bool isLoading;
    private TniBerandaSummaryDto s = new();
    private TniBerandaStokDto st = new();

    // persen dibulatkan ke bawah & dibatasi 0..100 (masuk bisa melebihi kebutuhan)
    private static int Persen(int nilai, int total) =>
        total <= 0 ? 0 : Math.Clamp((int)(nilai * 100L / total), 0, 100);

    // lebar segmen batang bertumpuk (pecahan, titik desimal invariant untuk CSS)
    private static string Lebar(int nilai, int total) =>
        (total <= 0 ? 0 : Math.Clamp(nilai * 100.0 / total, 0, 100))
            .ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";

    // "dicetak / sedang dikerjakan" & stok lock -- sama dengan WarnaDicetak di PerintahKerja
    private const string WarnaDicetak = "#9DB8D6";
    private const string WarnaUnlock = "#F08A24";   // stok bebas (unlock) -- oranye
    private const string WarnaKunci = "#16365C";    // stok dikunci satuan (alter_81) -- navy, sama dengan gembok Perintah Kerja

    // legenda progres -> daftar Personel, hanya bila perangkat boleh membuka Personel
    private void KePersonel(string query)
    {
        if (Sesi.BolehMenu("PERSONEL")) Nav.NavigateTo("/tni/personel?" + query);
    }

    private record Tile(string Label, string Route, string Icon, int Badge = 0);

    // Halaman yang dibuat di prompt berikutnya (65-69) boleh belum ada.
    private List<Tile> tiles = new();

    protected override async Task OnInitializedAsync()
    {
        // TANPA LOGIN: pairing perangkat ditangani TniLayout.
        hasAccess = true;

        // Tile Pembatalan HANYA untuk user yang login & punya TNI_PDH_APPROVE --
        // memutus pembatalan tetap tidak boleh dilakukan dari perangkat kios.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        bolehApprove = authState.User.HasClaim("module", "TNI_PDH_APPROVE");

        if (hasAccess == true)
        {
            await OrderState.EnsureLoadedAsync();
            await RefreshAsync();
        }
    }

    private async Task RefreshAsync()
    {
        isLoading = true;
        // Akses menu bisa diubah admin kapan saja -- muat ulang identitas perangkat.
        await Sesi.EnsureLoadedAsync(paksa: true);
        var tSummary = PersonelApi.GetSummaryAsync();
        var tStok = PersonelApi.GetBerandaStokAsync();
        s = await tSummary;
        st = await tStok;
        await OrderState.RefreshAsync();
        BuildTiles();
        isLoading = false;
    }

    private void BuildTiles()
    {
        // alter_74: hanya menu yang diizinkan untuk perangkat ini.
        tiles = TniMenu.Semua
            .Where(m => Sesi.BolehMenu(m.Code))
            .Select(m => new Tile(m.Label, m.Route, m.Icon))
            .ToList();

        // Prompt 68: memutus pembatalan butuh TNI_PDH_APPROVE -- tile hanya
        // muncul untuk yang bisa membukanya. Badge = jumlah MENUNGGU dari
        // SIS_Beranda_Summary, ikut turun setelah RefreshAsync.
        if (bolehApprove)
        {
            tiles.Insert(Math.Min(5, tiles.Count), new Tile("Pembatalan", "/tni/pembatalan",
                "fe fe-rotate-ccw", s.PembatalanMenunggu));
        }
    }
}

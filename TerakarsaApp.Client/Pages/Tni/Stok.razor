    }

    private async Task SimpanSetoranAsync()
    {
        isSaving = true;
        errorMessage = string.Empty;
        infoMessage = string.Empty;

        var (ok, err, hasil) = await StokApi.SetoranAsync(new TniStokSetoranRequest
        {
            Tanggal = tanggal,
            Supplier = string.IsNullOrWhiteSpace(supplier) ? null : supplier.Trim(),
            Items = baris
        });

        isSaving = false;
        konfirmSetoran = false;

        if (!ok) { errorMessage = err; return; }

        // 2026-11-09 (alter_80): tiap simpan = satu setoran sendiri, tidak digabung lagi
        infoMessage = $"Setoran tersimpan: {hasil?.TotalKemeja ?? 0} kemeja, {hasil?.TotalCelana ?? 0} celana " +
                      $"({hasil?.JumlahBaris ?? 0} pola).";

        // form kosong lagi
        baris = new List<TniStokSetoranItem>();
        supplier = string.Empty;
        TambahBaris();
    }

    // ---------- keluarkan ----------
    private void TambahBarisKeluar()
    {
        barisKeluar.Add(new TniStokSetoranItem { JenisItem = jenisBarisKeluar });
        konfirmKeluar = false;
    }

    private async Task SimpanKeluarAsync()
    {
        isSaving = true;
        errorMessage = string.Empty;
        infoMessage = string.Empty;

        var label = LabelKeluar(keluarJenis, keluarArah);
        var tanda = Tanda(keluarJenis, keluarArah);
        var k = Total(barisKeluar, "KEMEJA");
        var c = Total(barisKeluar, "CELANA");

        var (ok, err) = await StokApi.KeluarAsync(new TniStokKeluarRequest
        {
            Tanggal = tanggal,
            JenisMutasi = keluarJenis,
            Arah = ArahPakai(keluarJenis, keluarArah),
            Alasan = keluarAlasan.Trim(),
            Items = barisKeluar
        });

        isSaving = false;
        konfirmKeluar = false;

        if (!ok) { errorMessage = err; return; }

        infoMessage = $"{label} tersimpan: {tanda}{k} kemeja, {tanda}{c} celana.";

        // form kosong lagi (jenis & arah dipertahankan)
        barisKeluar = new List<TniStokSetoranItem>();
        keluarAlasan = string.Empty;
        TambahBarisKeluar();
    }

    // ---------- stock opname ----------
    private async Task GoOpname()
    {
        tab = "OPNAME";
        if (barisOpname.Count == 0) TambahBarisOpname();
        await MuatSaldoOpnameAsync();
    }

    private void TambahBarisOpname()
    {
        barisOpname.Add(new TniStokSetoranItem { JenisItem = jenisBarisOpname, Qty = -1 });
        konfirmOpname = false;
    }

    // Saldo sistem untuk pratinjau selisih + daftar pilihan pola (urut sama dengan tab Stok).
    private async Task MuatSaldoOpnameAsync()
    {
        var k = await StokApi.GetSaldoAsync("KEMEJA");
        var c = await StokApi.GetSaldoAsync("CELANA");

        saldoOpname = k.Concat(c).ToDictionary(s => (s.JenisItem, s.PolaId));
        polaOpnameKemeja = k.Select(KePola).ToList();
        polaOpnameCelana = c.Select(KePola).ToList();
    }

    private static TniPolaDto KePola(TniStokSaldoDto s) => new()
    {
        PolaId = s.PolaId,
        JenisItem = s.JenisItem,
        Kode = s.IsActive ? s.Kode : $"{s.Kode} (nonaktif)",
        IsActive = s.IsActive
    };

    private async Task SimpanOpnameAsync()
    {
        isSaving = true;
        errorMessage = string.Empty;
        infoMessage = string.Empty;

        var (ok, err, hasil) = await StokApi.OpnameAsync(new TniStokOpnameRequest

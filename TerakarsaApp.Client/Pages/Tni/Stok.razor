    private bool OpnameValid() =>
        barisOpname.Count > 0 && barisOpname.All(x => x.PolaId > 0 && x.Qty >= 0);

    // Baris lengkap saja; pola dobel dijumlah (sama dengan SP).
    private List<OpnameBaris> PratinjauOpname() =>
        barisOpname
            .Where(x => x.PolaId > 0 && x.Qty >= 0)
            .GroupBy(x => (x.JenisItem, x.PolaId))
            .Select(g =>
            {
                saldoOpname.TryGetValue(g.Key, out var s);
                return new OpnameBaris(g.Key.JenisItem, g.Key.PolaId,
                    s?.Kode ?? $"id {g.Key.PolaId}", s?.Saldo ?? 0, g.Sum(x => x.Qty));
            })
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        // TANPA LOGIN: pairing perangkat ditangani TniLayout,
        // jadi halaman yang sudah dirender pasti sudah berhak.
        hasAccess = true;
        if (hasAccess != true) return;

        await OrderState.EnsureLoadedAsync();

        // Hanya pola AKTIF yang boleh dipilih untuk setoran / pengeluaran.
        polaKemeja = TniUrutStok.Urutkan(await PolaApi.GetListAsync("KEMEJA", hanyaAktif: true));
        polaCelana = TniUrutStok.Urutkan(await PolaApi.GetListAsync("CELANA", hanyaAktif: true));

        TambahBaris();
        TambahBarisKeluar();
    }

    // ---------- setoran ----------
    private void TambahBaris()
    {
        baris.Add(new TniStokSetoranItem { JenisItem = jenisBaris });

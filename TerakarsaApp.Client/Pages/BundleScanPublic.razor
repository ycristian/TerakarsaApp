@page "/b/{Serial}"
@layout TerakarsaApp.Client.Layout.BlankLayout
@using Microsoft.AspNetCore.Components.Authorization
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Client.Shared
@using TerakarsaApp.Shared.Bundles
@using TerakarsaApp.Shared.Resources
@using TerakarsaApp.Shared.Stations
@inject StationDeviceApiService StationApi
@inject PublicBundleApiService PublicApi
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Bundle @Serial</PageTitle>

@if (isLoading)
{
    <p class="text-center fs-4 mt-5">Memuat...</p>
}
else if (loadError is not null)
{
    <div class="alert alert-danger mt-5">@loadError</div>
}
else if (notFound)
{
    <div class="alert alert-danger mt-5">Bundle dengan serial <strong>@Serial</strong> tidak ditemukan.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <CloseButton />
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm" @onclick="() => showQrScanner = true">
                <i class="fe fe-camera"></i> Scan QR
            </button>
            @if (!hasStationToken || stationScanFailed)
            {
                <a href="/station" class="btn btn-outline-secondary btn-sm" title="Pengaturan Stasiun">
                    <i class="fe fe-settings"></i> Atur Perangkat sebagai Stasiun
                </a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(qrScanError))
    {
        <div class="alert alert-danger mb-2">@qrScanError</div>
    }

    @if (stationScanFailed)
    {
        <div class="alert alert-warning mb-2">
            Sesi perangkat stasiun ini tidak valid/kedaluwarsa — menampilkan tampilan hanya-baca.
            Buka <a href="/station">/station</a> untuk pasang ulang perangkat kalau perlu Terima/Kirim Hasil di sini.
        </div>
    }

    @if (hasStationToken && station is not null)
    {
        <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h4 class="mb-0">@station.StationName <span class="text-muted fs-6">(@station.DivisionName)</span></h4>
                    @if (autoLoginApplied)
                    {
                        <p class="mb-1"><span class="badge bg-info">Operator otomatis: @operatorName</span></p>
                    }
                    <p class="mb-0 text-muted">
                        Operator: <strong class="text-dark">@(operatorName ?? "-")</strong>
                    </p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="Rescan">
                        <i class="fe fe-refresh-cw"></i> Refresh
                    </button>
                    <a href="/station" class="btn btn-outline-primary btn-sm">Ke Stasiun</a>
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => showLogoutConfirm = true">Keluar</button>
                </div>
            </div>
        </div>
    }

    @if (hasStationToken && !stationScanFailed)
    {
        @if (operatorId is null)
        {
            <div class="alert alert-warning">Operator belum dipilih di perangkat ini. Buka <a href="/station">/station</a> untuk memilih operator terlebih dahulu.</div>
        }
        <BundleScanCard Info="scanInfo!" ReadOnly="@(operatorId is null)" Busy="actionBusy" ActionError="@actionError"
                        OnReceive="HandleReceive" OnComplete="HandleComplete" OnEdit="HandleEdit" OnAdjust="HandleAdjust" AllowReprint="true"
                        IsSuperAdmin="isSuperAdmin" OnEditLogRequested="HandleEditLogRequested" OnEditBundleRequested="HandleEditBundleRequested"
                        ResourceOptions="resourceOptions" ActiveResourceId="operatorId" AllowResourceChange="@(station?.AllowResourceChange ?? true)" />
    }
    else
    {
        <BundleScanCard Info="scanInfo!" ReadOnly="true" AllowReprint="false"
                        IsSuperAdmin="isSuperAdmin" OnEditLogRequested="HandleEditLogRequested" OnEditBundleRequested="HandleEditBundleRequested" />
    }

    <SuperAdminEditPanel @ref="editPanel" OnSaved="Rescan" />

    @if (wip.Count > 0)
    {
        <h5 class="mt-4">Progres Artikel</h5>
        <div class="row g-2">
            @foreach (var w in wip)
            {
                <div class="col-12 col-md-6" @key="w.ArticleWorkflowId">
                    <div class="card h-100 mb-0">
                        <div class="card-body">
                            <h6 class="mb-2">@w.SortOrder - @w.StepName</h6>

                            @if (w.RequiresBundle)
                            {
                                <div class="mb-2">
                                    <div class="small text-muted">Diterima</div>
                                    <div class="row g-1 text-center">
                                        <div class="col-4 small">@w.ReceivedPcs/@w.TotalBundlePcs pcs</div>
                                        <div class="col-4 small">@w.ReceivedBundleCount/@w.TotalBundleCount bundles</div>
                                        <div class="col-4 small">@(QtyPercent(w.ReceivedPcs, w.QtyOrder))%</div>
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <div class="small text-muted">Selesai</div>
                                    <div class="row g-1 text-center">
                                        <div class="col-4 small">@w.CompletedPcs/@w.TotalBundlePcs pcs</div>
                                        <div class="col-4 small">@w.CompletedBundleCount/@w.TotalBundleCount bundles</div>
                                        <div class="col-4 small">@(QtyPercent(w.CompletedPcs, w.QtyOrder))%</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="mb-2 small">Diterima: - &middot; Selesai: -</p>
                            }

                            <div class="row text-center border-top pt-2">
                                <div class="col-4">
                                    <div class="small text-muted">Qty OK</div>
                                    <div class="fw-bold text-success">@(w.QtyOk == 0 ? "-" : w.QtyOk.ToString())</div>
                                </div>
                                <div class="col-4">
                                    <div class="small text-muted">Qty Reject</div>
                                    <div class="fw-bold text-danger">@(w.QtyReject == 0 ? "-" : w.QtyReject.ToString())</div>
                                </div>
                                <div class="col-4">
                                    <div class="small text-muted">Qty Order</div>
                                    <div class="fw-bold">@(w.QtyOrder == 0 ? "-" : w.QtyOrder.ToString())</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<QrScannerModal Show="showQrScanner" OnScanned="HandleQrScanned" OnClose="() => showQrScanner = false" />

<ConfirmDeleteModal Show="showLogoutConfirm" IsBusy="isLoggingOut" Title="Keluar dari Perangkat"
                     ConfirmText="Ya, Keluar" BusyText="Memproses..." ConfirmButtonClass="btn-danger"
                     OnConfirm="ConfirmLogout" OnCancel="() => showLogoutConfirm = false">
    <Message>Perangkat akan keluar dan token saat ini tidak berlaku lagi. Untuk masuk kembali, minta kode pairing baru ke admin.</Message>
</ConfirmDeleteModal>

@code {
    [Parameter] public string Serial { get; set; } = string.Empty;

    private bool isLoading = true;
    private bool notFound = false;
    private string? loadError;
    private bool hasStationToken = false;
    // Fix: true kalau ada stationToken di localStorage TAPI panggilan ber-token itu gagal
    // (401/dst -- token stale/invalid/revoked, mis. station sudah dihapus/di-pairing ulang).
    // Dipakai supaya UI tidak menampilkan tombol aksi stasiun yang pasti gagal (Terima/Kirim
    // Hasil/dst juga pakai token yang sama), dan supaya user tahu kenapa halaman jadi
    // hanya-baca alih-alih diam-diam gagal.
    private bool stationScanFailed = false;
    private StationMeDto? station;
    private BundleScanInfoDto? scanInfo;
    private List<ArticleWipStepDto> wip = new();
    private bool actionBusy = false;
    private string actionError = string.Empty;
    private int? operatorId;
    private string? operatorName;
    // Prompt 40: true kalau operator sesi baru saja diganti otomatis berdasarkan saran scan
    // (badge "Operator otomatis"). Hanya dievaluasi sekali per scan bundle baru (LoadBundleAsync),
    // TIDAK di Rescan -- supaya pergantian manual (via /station) tidak langsung tertimpa lagi
    // saat halaman ini refresh/rescan bundle yang SAMA.
    private bool autoLoginApplied = false;
    // Prompt 39: opsi dropdown "Pelaksana" (Kirim Hasil) -- resource aktif divisi station ini.
    private List<ResourceLookupDto> resourceOptions = new();
    private bool showLogoutConfirm = false;
    private bool isLoggingOut = false;

    // Prompt 36: tombol Edit/Edit Bundle (Super Admin) -- HANYA untuk user login web
    // ber-modul SUPER_ADMIN, independen dari token stasiun/operator sesi di halaman ini.
    private bool isSuperAdmin = false;
    private SuperAdminEditPanel? editPanel;

    private Task HandleEditLogRequested(int workflowLogId) => editPanel!.OpenEditLogAsync(workflowLogId);
    private Task HandleEditBundleRequested() => editPanel!.OpenEditBundleAsync(scanInfo!.Bundle.BundleId);

    // Scan QR lewat kamera -- QR selalu berisi URL absolut ({PublicBaseUrl}/b/{serial}
    // atau /pack/{serial}); hasilnya dinavigasi client-side (NavigationManager, TANPA
    // forceLoad) supaya tetap dalam app, bukan buka tab baru.
    private bool showQrScanner = false;
    private string qrScanError = string.Empty;

    private void HandleQrScanned(string value)
    {
        showQrScanner = false;

        var path = ExtractLocalPath(value);
        if (path is null)
        {
            qrScanError = "QR tidak dikenali.";
            return;
        }

        qrScanError = string.Empty;
        Nav.NavigateTo(path);
    }

    private static string? ExtractLocalPath(string value)
    {
        if (Uri.TryCreate(value, UriKind.Absolute, out var uri)) return uri.PathAndQuery;
        return value.StartsWith('/') ? value : null;
    }

    private bool IsLocked => station is not null && !station.AllowResourceChange && station.DefaultResourceId is not null;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        isSuperAdmin = state.User.HasClaim("module", "SUPER_ADMIN");

        try
        {
            await LoadBundleAsync();
        }
        catch (Exception)
        {
            // Kalau halaman dibuka lewat HTTPS dan panggilan API gagal (mis. sertifikat
            // self-signed LAN belum di-trust penuh di device ini -- lihat DEPLOY-LOCAL-IIS.md
            // langkah 6, iPhone sering luput), coba lagi lewat HTTP: Program.cs otomatis
            // mengarahkan panggilan API ke port HTTP juga saat halaman dibuka via HTTP, jadi
            // ini melewati masalah sertifikat sama sekali. Konsekuensinya cuma tombol "Scan QR"
            // (kamera) di halaman ini tidak berfungsi di HTTP (browser blokir getUserMedia di
            // origin non-HTTPS selain localhost) -- fitur lain (lihat info, Terima, Selesaikan)
            // tetap jalan.
            var uri = new Uri(Nav.Uri);
            if (string.Equals(uri.Scheme, "https", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo($"http://{uri.Authority}{uri.PathAndQuery}", forceLoad: true);
                return;
            }

            loadError = "Gagal memuat data bundle. Periksa koneksi jaringan lalu coba lagi.";
            isLoading = false;
        }
    }

    private async Task LoadBundleAsync()
    {
        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "stationToken");
        hasStationToken = !string.IsNullOrWhiteSpace(token);

        if (hasStationToken)
        {
            station = await StationApi.GetMeAsync();
            // Fix: GetMeAsync murni cek validitas token (tidak tergantung serial/bundle) --
            // null di sini artinya token stale/invalid/revoked, sinyal paling akurat untuk
            // "device ini SEHARUSNYA stasiun tapi sesinya rusak" (beda dari device publik
            // biasa yang memang tidak pernah punya token).
            stationScanFailed = station is null;

            // Prompt 43: resourceOptions diambil LEBIH DULU (sebelum operatorId ditentukan) --
            // dipakai untuk validasi keanggotaan divisi di bawah, bukan cuma buat dropdown
            // "Ganti Operator". Butuh token valid, jadi hanya kalau !stationScanFailed.
            if (!stationScanFailed)
            {
                resourceOptions = await StationApi.GetResourcesAsync();
            }

            var savedOperatorId = await JS.InvokeAsync<string?>("localStorage.getItem", "stationOperatorId");
            // Prompt 43: dulu operator tersimpan langsung dipakai tanpa cek dia milik divisi
            // stasiun yang SEKARANG aktif -- kalau device ini sebelumnya pernah dipasang di
            // divisi lain (atau localStorage-nya kebawa dari pairing lain), operator lama bisa
            // nyangkut dan dianggap valid selamanya sampai SuggestedResourceId kebetulan
            // menimpanya. Sekarang disyaratkan ada di resourceOptions (resource hidup milik
            // divisi stasiun ini) -- persis pola LoadOperatorSessionAsync di StationDevice.razor
            // (operators.Any(o => o.Id == id)). stationScanFailed -> resourceOptions kosong,
            // operator tidak tervalidasi sama sekali (halaman ini memang read-only).
            var hasSavedOperator = int.TryParse(savedOperatorId, out var opId)
                && resourceOptions.Any(o => o.Id == opId);

            // Sama urutan fallback dengan LoadOperatorSessionAsync di StationDevice.razor:
            // locked selalu pakai default; kalau tidak, pakai operator tersimpan; kalau belum
            // pernah pilih operator, /station diam-diam jatuh ke DefaultResourceId TANPA
            // menulis ke localStorage -- jadi page ini harus meniru fallback yang sama supaya
            // operatornya dikenali sama seperti di /station.
            if (IsLocked)
            {
                operatorId = station!.DefaultResourceId;
                operatorName = station.DefaultResourceName;
            }
            else if (hasSavedOperator)
            {
                operatorId = opId;
                operatorName = await JS.InvokeAsync<string?>("localStorage.getItem", "stationOperatorName");
            }
            else if (station?.DefaultResourceId is not null)
            {
                operatorId = station.DefaultResourceId;
                operatorName = station.DefaultResourceName;
            }

            scanInfo = await StationApi.ScanAsync(Serial, operatorId);
            var publicDetail = await PublicApi.GetBundleAsync(Serial);
            wip = publicDetail?.Wip ?? new();
            // Fix: token stasiun stale/invalid/revoked bikin ScanAsync gagal (401/dst,
            // dikembalikan sebagai null oleh StationDeviceApiService) -- itu BUKAN berarti
            // bundle-nya tidak ada. Jatuh balik ke hasil publik (read-only) supaya device
            // dengan token rusak tetap bisa lihat bundle, bukan salah bilang "tidak ditemukan".
            scanInfo ??= publicDetail?.ScanInfo;

            if (!stationScanFailed)
            {
                await ApplyAutoLoginIfNeeded();
            }
        }
        else
        {
            var detail = await PublicApi.GetBundleAsync(Serial);
            scanInfo = detail?.ScanInfo;
            wip = detail?.Wip ?? new();
        }

        notFound = scanInfo is null;
        isLoading = false;
    }

    // Prompt 40: auto-login operator sesi saat scan -- HANYA stasiun tidak terkunci. Kalau
    // SuggestedResourceId (kaskade LINE_BUNDLE/PENERIMA/COUNTERPART/RIWAYAT, lihat
    // SIS_Bundle_ScanInfo) terisi dan beda dari operator sesi saat ini, ganti operator sesi ke
    // resource itu dan simpan ke localStorage (sticky, sama seperti pemilihan manual di
    // /station) -- scan ulang bundle yang sama (Rescan) TIDAK memicu ini lagi, supaya
    // pergantian manual operator tidak langsung tertimpa. NULL -> operator sesi dipertahankan.
    private async Task ApplyAutoLoginIfNeeded()
    {
        autoLoginApplied = false;
        if (IsLocked) return;
        if (scanInfo?.Bundle.SuggestedResourceId is not { } suggestedId) return;
        if (operatorId == suggestedId) return;

        operatorId = suggestedId;
        operatorName = scanInfo.Bundle.SuggestedResourceName;
        autoLoginApplied = true;

        await JS.InvokeVoidAsync("localStorage.setItem", "stationOperatorId", operatorId.Value.ToString());
        await JS.InvokeVoidAsync("localStorage.setItem", "stationOperatorName", operatorName ?? string.Empty);

        // Hitung ulang scanInfo terhadap operator yang benar (Aksi SS7/NextCounterpart di
        // SIS_Bundle_ScanInfo bergantung ke @ResourceId).
        scanInfo = await StationApi.ScanAsync(Serial, operatorId);
    }

    private async Task Rescan()
    {
        if (hasStationToken)
        {
            station = await StationApi.GetMeAsync();
            stationScanFailed = station is null;
        }

        scanInfo = await StationApi.ScanAsync(Serial, operatorId);
        var publicDetail = await PublicApi.GetBundleAsync(Serial);
        wip = publicDetail?.Wip ?? new();
        // Fix: sama seperti LoadBundleAsync -- token stasiun gagal tidak boleh menutupi
        // bundle yang sebenarnya ada.
        scanInfo ??= publicDetail?.ScanInfo;
        notFound = scanInfo is null;
    }

    private async Task ConfirmLogout()
    {
        isLoggingOut = true;
        await StationApi.LogoutAsync();
        await JS.InvokeVoidAsync("localStorage.removeItem", "stationToken");
        await JS.InvokeVoidAsync("localStorage.removeItem", "stationOperatorId");
        await JS.InvokeVoidAsync("localStorage.removeItem", "stationOperatorName");
        isLoggingOut = false;
        showLogoutConfirm = false;
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private static int QtyPercent(int value, int total) =>
        total > 0 ? Math.Min(100, (int)Math.Round(100.0 * value / total)) : 0;

    private async Task HandleReceive(string? remark)
    {
        if (scanInfo?.Action.ActionWorkflowLogId is null || operatorId is null) return;

        actionBusy = true;
        actionError = string.Empty;

        var (success, error) = await StationApi.ReceiveAsync(new TerakarsaApp.Shared.WorkflowLogs.StationReceiveRequest
        {
            WorkflowLogId = scanInfo.Action.ActionWorkflowLogId.Value,
            ResourceId = operatorId.Value,
            Remark = remark
        });

        actionBusy = false;
        if (!success) { actionError = error; return; }
        await Rescan();
    }

    private async Task HandleComplete(BundleCompleteFormValues values)
    {
        if (scanInfo?.Action.ActionArticleWorkflowId is null || operatorId is null) return;

        actionBusy = true;
        actionError = string.Empty;

        var (success, error) = await StationApi.CompleteAsync(new TerakarsaApp.Shared.WorkflowLogs.StationCompleteRequest
        {
            ArticleWorkflowId = scanInfo.Action.ActionArticleWorkflowId.Value,
            BundleId = scanInfo.Bundle.BundleId,
            // Prompt 39: pakai override dari dropdown "Pelaksana" (BundleScanCard) kalau ada
            // (SuggestedResourceId + station tidak terkunci) -- fallback resource sesi operator.
            ResourceId = values.ResourceId ?? operatorId.Value,
            QtyOk = values.QtyOk,
            QtyRejectPrint = values.QtyRejectPrint,
            QtyRejectFabric = values.QtyRejectFabric,
            QtyRejectSewing = values.QtyRejectSewing,
            QtyRejectRework = values.QtyRejectRework,
            QtyLost = values.QtyLost,
            Remark = values.Remark,
            ConfirmExceed = values.ConfirmExceed,
            ConfirmShort = values.ConfirmShort,
            // Prompt 40: penerima manual dipilih operator pengirim -- diteruskan apa adanya.
            AutoReceiveResourceId = values.AutoReceiveResourceId
        });

        actionBusy = false;
        if (!success) { actionError = error; return; }
        await Rescan();
    }

    private async Task HandleEdit(BundleCompleteFormValues values)
    {
        if (scanInfo?.Action.ActionWorkflowLogId is null) return;

        actionBusy = true;
        actionError = string.Empty;

        var (success, error) = await StationApi.UpdateLogAsync(scanInfo.Action.ActionWorkflowLogId.Value, new TerakarsaApp.Shared.WorkflowLogs.StationLogUpdateRequest
        {
            QtyOk = values.QtyOk,
            QtyRejectPrint = values.QtyRejectPrint,
            QtyRejectFabric = values.QtyRejectFabric,
            QtyRejectSewing = values.QtyRejectSewing,
            QtyRejectRework = values.QtyRejectRework,
            QtyLost = values.QtyLost,
            Remark = values.Remark,
            ConfirmExceed = values.ConfirmExceed,
            ConfirmShort = values.ConfirmShort
        });

        actionBusy = false;
        if (!success) { actionError = error; return; }
        await Rescan();
    }

    private async Task HandleAdjust(BundleAdjustFormValues values)
    {
        if (operatorId is null) return;

        actionBusy = true;
        actionError = string.Empty;

        var (success, error) = await StationApi.AdjustAsync(new TerakarsaApp.Shared.WorkflowLogs.StationAdjustRequest
        {
            ArticleWorkflowId = values.ArticleWorkflowId,
            BundleId = scanInfo!.Bundle.BundleId,
            ResourceId = operatorId.Value,
            QtyOk = values.QtyOk,
            QtyRejectPrint = values.QtyRejectPrint,
            QtyRejectFabric = values.QtyRejectFabric,
            QtyRejectSewing = values.QtyRejectSewing,
            QtyRejectRework = values.QtyRejectRework,
            QtyLost = values.QtyLost,
            TargetDivisionId = values.TargetDivisionId,
            Remark = values.Remark
        });

        actionBusy = false;
        if (!success) { actionError = error; return; }
        await Rescan();
    }
}

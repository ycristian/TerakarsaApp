@page "/b/{Serial}"
@layout TerakarsaApp.Client.Layout.BlankLayout
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Client.Shared
@using TerakarsaApp.Shared.Bundles
@using TerakarsaApp.Shared.Stations
@inject StationDeviceApiService StationApi
@inject PublicBundleApiService PublicApi
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Bundle @Serial</PageTitle>

@if (isLoading)
{
    <p class="text-center fs-4 mt-5">Memuat...</p>
}
else if (notFound)
{
    <div class="alert alert-danger mt-5">Bundle dengan serial <strong>@Serial</strong> tidak ditemukan.</div>
}
else
{
    <div class="d-flex justify-content-between mb-2">
        <CloseButton />
        @if (!hasStationToken)
        {
            <a href="/station" class="btn btn-outline-secondary btn-sm" title="Pengaturan Stasiun">
                <i class="fe fe-settings"></i> Atur Perangkat sebagai Stasiun
            </a>
        }
    </div>

    @if (hasStationToken && station is not null)
    {
        <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h4 class="mb-0">@station.StationName <span class="text-muted fs-6">(@station.DivisionName)</span></h4>
                    <p class="mb-0 text-muted">
                        Operator: <strong class="text-dark">@(operatorName ?? "-")</strong>
                    </p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="Rescan">
                        <i class="fe fe-refresh-cw"></i> Refresh
                    </button>
                    <a href="/station" class="btn btn-outline-primary btn-sm">Ke Stasiun</a>
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => showLogoutConfirm = true">Keluar</button>
                </div>
            </div>
        </div>
    }

    @if (hasStationToken)
    {
        @if (operatorId is null)
        {
            <div class="alert alert-warning">Operator belum dipilih di perangkat ini. Buka <a href="/station">/station</a> untuk memilih operator terlebih dahulu.</div>
        }
        <BundleScanCard Info="scanInfo!" ReadOnly="@(operatorId is null)" Busy="actionBusy" ActionError="@actionError"
                        OnReceive="HandleReceive" OnComplete="HandleComplete" OnEdit="HandleEdit" AllowReprint="true" />
    }
    else
    {
        <BundleScanCard Info="scanInfo!" ReadOnly="true" AllowReprint="false" />
    }

    @if (wip.Count > 0)
    {
        <h5 class="mt-4">Progres Artikel</h5>
        <div class="row g-2">
            @foreach (var w in wip)
            {
                <div class="col-12 col-md-6" @key="w.ArticleWorkflowId">
                    <div class="card h-100 mb-0">
                        <div class="card-body">
                            <h6 class="mb-2">@w.SortOrder - @w.StepName</h6>

                            @if (w.RequiresBundle)
                            {
                                <div class="mb-2">
                                    <div class="small text-muted">Diterima</div>
                                    <div class="row g-1 text-center">
                                        <div class="col-4 small">@w.ReceivedPcs/@w.TotalBundlePcs pcs</div>
                                        <div class="col-4 small">@w.ReceivedBundleCount/@w.TotalBundleCount bundles</div>
                                        <div class="col-4 small">@(QtyPercent(w.ReceivedPcs, w.QtyOrder))%</div>
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <div class="small text-muted">Selesai</div>
                                    <div class="row g-1 text-center">
                                        <div class="col-4 small">@w.CompletedPcs/@w.TotalBundlePcs pcs</div>
                                        <div class="col-4 small">@w.CompletedBundleCount/@w.TotalBundleCount bundles</div>
                                        <div class="col-4 small">@(QtyPercent(w.CompletedPcs, w.QtyOrder))%</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="mb-2 small">Diterima: - &middot; Selesai: -</p>
                            }

                            <div class="row text-center border-top pt-2">
                                <div class="col-4">
                                    <div class="small text-muted">Qty OK</div>
                                    <div class="fw-bold text-success">@(w.QtyOk == 0 ? "-" : w.QtyOk.ToString())</div>
                                </div>
                                <div class="col-4">
                                    <div class="small text-muted">Qty Reject</div>
                                    <div class="fw-bold text-danger">@(w.QtyReject == 0 ? "-" : w.QtyReject.ToString())</div>
                                </div>
                                <div class="col-4">
                                    <div class="small text-muted">Qty Order</div>
                                    <div class="fw-bold">@(w.QtyOrder == 0 ? "-" : w.QtyOrder.ToString())</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<ConfirmDeleteModal Show="showLogoutConfirm" IsBusy="isLoggingOut" Title="Keluar dari Perangkat"
                     ConfirmText="Ya, Keluar" BusyText="Memproses..." ConfirmButtonClass="btn-danger"
                     OnConfirm="ConfirmLogout" OnCancel="() => showLogoutConfirm = false">
    <Message>Perangkat akan keluar dan token saat ini tidak berlaku lagi. Untuk masuk kembali, minta kode pairing baru ke admin.</Message>
</ConfirmDeleteModal>

@code {
    [Parameter] public string Serial { get; set; } = string.Empty;

    private bool isLoading = true;
    private bool notFound = false;
    private bool hasStationToken = false;
    private StationMeDto? station;
    private BundleScanInfoDto? scanInfo;
    private List<ArticleWipStepDto> wip = new();
    private bool actionBusy = false;
    private string actionError = string.Empty;
    private int? operatorId;
    private string? operatorName;
    private bool showLogoutConfirm = false;
    private bool isLoggingOut = false;

    private bool IsLocked => station is not null && !station.AllowResourceChange && station.DefaultResourceId is not null;

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "stationToken");
        hasStationToken = !string.IsNullOrWhiteSpace(token);

        if (hasStationToken)
        {
            station = await StationApi.GetMeAsync();

            var savedOperatorId = await JS.InvokeAsync<string?>("localStorage.getItem", "stationOperatorId");
            var hasSavedOperator = int.TryParse(savedOperatorId, out var opId);

            // Sama urutan fallback dengan LoadOperatorSessionAsync di StationDevice.razor:
            // locked selalu pakai default; kalau tidak, pakai operator tersimpan; kalau belum
            // pernah pilih operator, /station diam-diam jatuh ke DefaultResourceId TANPA
            // menulis ke localStorage -- jadi page ini harus meniru fallback yang sama supaya
            // operatornya dikenali sama seperti di /station.
            if (IsLocked)
            {
                operatorId = station!.DefaultResourceId;
                operatorName = station.DefaultResourceName;
            }
            else if (hasSavedOperator)
            {
                operatorId = opId;
                operatorName = await JS.InvokeAsync<string?>("localStorage.getItem", "stationOperatorName");
            }
            else if (station?.DefaultResourceId is not null)
            {
                operatorId = station.DefaultResourceId;
                operatorName = station.DefaultResourceName;
            }

            scanInfo = await StationApi.ScanAsync(Serial, operatorId);
            var publicDetail = await PublicApi.GetBundleAsync(Serial);
            wip = publicDetail?.Wip ?? new();
        }
        else
        {
            var detail = await PublicApi.GetBundleAsync(Serial);
            scanInfo = detail?.ScanInfo;
            wip = detail?.Wip ?? new();
        }

        notFound = scanInfo is null;
        isLoading = false;
    }

    private async Task Rescan()
    {
        scanInfo = await StationApi.ScanAsync(Serial, operatorId);
        var publicDetail = await PublicApi.GetBundleAsync(Serial);
        wip = publicDetail?.Wip ?? new();
        notFound = scanInfo is null;
    }

    private async Task ConfirmLogout()
    {
        isLoggingOut = true;
        await StationApi.LogoutAsync();
        await JS.InvokeVoidAsync("localStorage.removeItem", "stationToken");
        await JS.InvokeVoidAsync("localStorage.removeItem", "stationOperatorId");
        await JS.InvokeVoidAsync("localStorage.removeItem", "stationOperatorName");
        isLoggingOut = false;
        showLogoutConfirm = false;
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private static int QtyPercent(int value, int total) =>
        total > 0 ? Math.Min(100, (int)Math.Round(100.0 * value / total)) : 0;

    private async Task HandleReceive(string? remark)
    {
        if (scanInfo?.Action.ActionWorkflowLogId is null || operatorId is null) return;

        actionBusy = true;
        actionError = string.Empty;

        var (success, error) = await StationApi.ReceiveAsync(new TerakarsaApp.Shared.WorkflowLogs.StationReceiveRequest
        {
            WorkflowLogId = scanInfo.Action.ActionWorkflowLogId.Value,
            ResourceId = operatorId.Value,
            Remark = remark
        });

        actionBusy = false;
        if (!success) { actionError = error; return; }
        await Rescan();
    }

    private async Task HandleComplete(BundleCompleteFormValues values)
    {
        if (scanInfo?.Action.ActionArticleWorkflowId is null || operatorId is null) return;

        actionBusy = true;
        actionError = string.Empty;

        var (success, error) = await StationApi.CompleteAsync(new TerakarsaApp.Shared.WorkflowLogs.StationCompleteRequest
        {
            ArticleWorkflowId = scanInfo.Action.ActionArticleWorkflowId.Value,
            BundleId = scanInfo.Bundle.BundleId,
            ResourceId = operatorId.Value,
            QtyOk = values.QtyOk,
            QtyRejectPrint = values.QtyRejectPrint,
            QtyRejectFabric = values.QtyRejectFabric,
            QtyRejectSewing = values.QtyRejectSewing,
            Remark = values.Remark,
            ConfirmExceed = values.ConfirmExceed,
            ConfirmShort = values.ConfirmShort
        });

        actionBusy = false;
        if (!success) { actionError = error; return; }
        await Rescan();
    }

    private async Task HandleEdit(BundleCompleteFormValues values)
    {
        if (scanInfo?.Action.ActionWorkflowLogId is null) return;

        actionBusy = true;
        actionError = string.Empty;

        var (success, error) = await StationApi.UpdateLogAsync(scanInfo.Action.ActionWorkflowLogId.Value, new TerakarsaApp.Shared.WorkflowLogs.StationLogUpdateRequest
        {
            QtyOk = values.QtyOk,
            QtyRejectPrint = values.QtyRejectPrint,
            QtyRejectFabric = values.QtyRejectFabric,
            QtyRejectSewing = values.QtyRejectSewing,
            Remark = values.Remark,
            ConfirmExceed = values.ConfirmExceed,
            ConfirmShort = values.ConfirmShort
        });

        actionBusy = false;
        if (!success) { actionError = error; return; }
        await Rescan();
    }
}

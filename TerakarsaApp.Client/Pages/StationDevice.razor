    private async Task HandleOutboundDateChanged(ChangeEventArgs e)
    {
        if (!DateTime.TryParse(e.Value?.ToString(), out var parsed)) return;

        // Prompt 56: rentang 7 -> 90 hari, selaras dengan SIS_Station_PendingHandover -- chip
        // "Belum lock" bisa menunjuk tanggal jauh di belakang.
        var min = DateTime.Today.AddDays(-90);
        outboundDate = parsed.Date < min ? min : (parsed.Date > DateTime.Today ? DateTime.Today : parsed.Date);
        ClearOutSelection();
        await RefreshLists();
    }

    // Prompt 80: perangkat ini milik divisi yang memegang step Bundling? Dipakai gate tab
    // "Stok Cutting". Sengaja TIDAK memakai nama divisi atau id hardcode -- sumbernya sama
    // dengan kartu "Buat Bundle" di tab WIP.
    private bool IsStationBundling => activeWork.Any(a => a.IsBundling);

    private async Task RefreshLists()
    {
        isLoadingLists = true;

        var pendingReceivesTask = StationApi.GetPendingReceivesAsync(currentOperatorId);
        var inProgressTask = StationApi.GetInProgressAsync(currentOperatorId);
        var activeWorkTask = StationApi.GetActiveWorkAsync();
        var outboundTask = StationApi.GetOutboundAsync(currentOperatorId, outboundDate);
        var countsTask = StationApi.GetCountsAsync(currentOperatorId);
        // Prompt 56: chip "Belum lock" -- lintas tanggal, jadi tidak ikut filter outboundDate.
        var unlockedDatesTask = StationApi.GetOutUnlockedDatesAsync(currentOperatorId);
        // Prompt 58: badge tunggakan absen -- ikut polling supaya angkanya tetap hidup kalau
        // PIC lain di line yang sama sudah mengisi.
        var absenPendingTask = currentOperatorId is int absenResourceId && absenResourceId > 0
            ? StationApi.GetAttendancePendingDatesAsync(absenResourceId)
            : Task.FromResult(new List<StationAttendancePendingDateDto>());
        await Task.WhenAll(pendingReceivesTask, inProgressTask, activeWorkTask, outboundTask, countsTask, unlockedDatesTask, absenPendingTask);

        pendingReceives = pendingReceivesTask.Result;
        inProgress = inProgressTask.Result;
        activeWork = activeWorkTask.Result;
        outbound = outboundTask.Result;
        counts = countsTask.Result;
        outUnlockedDates = unlockedDatesTask.Result;
        absenPendingDates = absenPendingTask.Result;
        // Prompt 56: buang pilihan yang barisnya sudah tidak ada / berubah status (mis. hasil
        // polling atau setelah lock dari perangkat lain).
        outSelected.RemoveWhere(id => !outbound.Any(r => r.WorkflowLogId == id && IsOutRowSelectable(r)));
        isLoadingLists = false;
        StateHasChanged();

        await LoadOutboundDatePeriodAsync();
        await RefreshMissing();
    }

    // Prompt 82: angka Hilang / Lebih kartu artikel. Diambil sekali untuk semua artikel yang
    // punya selisih terbuka (bukan per kartu) -- satu round-trip, kartu tinggal melihat dict.
    private async Task RefreshMissing()
    {
        var rows = await StationApi.GetMissingAsync();
        missingByArticle = rows.ToDictionary(r => r.ArticleId);
        StateHasChanged();
    }


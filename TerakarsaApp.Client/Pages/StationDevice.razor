    private void ResetRevise()
    {
        if (reviseTarget is null) return;

        reviseQtyOk = reviseTarget.QtyOk;
        reviseQtyRejectPrint = reviseTarget.QtyRejectPrint;
        reviseQtyRejectFabric = reviseTarget.QtyRejectFabric;
        reviseQtyRejectSewing = reviseTarget.QtyRejectSewing;
        reviseQtyRejectRework = reviseTarget.QtyRejectRework;
        reviseQtyLost = reviseTarget.QtyLost;
        reviseRemark = reviseTarget.Remark ?? string.Empty;
        revisePelaksanaResourceId = reviseTarget.ResourceId ?? currentOperatorId ?? 0;
    }

    private void CloseReviseModal()
    {
        showReviseModal = false;
        reviseTarget = null;
    }

    private async Task ConfirmRevise()
    {
        if (reviseTarget is null || currentOperatorId is null) return;

        var reviseTotalReject = reviseQtyRejectPrint + reviseQtyRejectFabric + reviseQtyRejectSewing + reviseQtyRejectRework + reviseQtyLost;
        if (reviseTotalReject > 0 && string.IsNullOrWhiteSpace(reviseRemark))
        {
            reviseError = "Catatan wajib diisi jika ada reject.";
            return;
        }

        isBusy = true;
        reviseError = string.Empty;

        // Prompt 23: baris step terakhir (IsLastStep) tidak punya tujuan serah untuk direvisi
        // -- pakai UPDATE biasa (sama seperti EDIT di BundleScanCard), bukan REVISE_HANDOVER.
        if (reviseTarget.IsLastStep)
        {
            var (okLastStep, errorLastStep) = await StationApi.UpdateLogAsync(reviseTarget.WorkflowLogId, new StationLogUpdateRequest
            {
                ArticleSizeId = reviseTarget.ArticleSizeId,
                QtyOk = reviseQtyOk,
                QtyRejectPrint = reviseQtyRejectPrint,
                QtyRejectFabric = reviseQtyRejectFabric,
                QtyRejectSewing = reviseQtyRejectSewing,
                QtyRejectRework = reviseQtyRejectRework,
                QtyLost = reviseQtyLost,
                Remark = string.IsNullOrWhiteSpace(reviseRemark) ? null : reviseRemark,
                ResourceId = currentOperatorId.Value,
                PelaksanaResourceId = revisePelaksanaResourceId > 0 ? revisePelaksanaResourceId : null
            });

            isBusy = false;

            if (!okLastStep)
            {
                reviseError = StripLockedPrefix(errorLastStep);
                return;
            }

            CloseReviseModal();
            await RefreshLists();
            return;
        }

        if (reviseTargetDivisionId <= 0)
        {
            isBusy = false;
            reviseError = "Divisi tujuan wajib dipilih.";
            return;
        }

        var (success, error) = await StationApi.ReviseHandoverAsync(reviseTarget.WorkflowLogId, new StationReviseHandoverRequest
        {
            QtyOk = reviseQtyOk,
            QtyRejectPrint = reviseQtyRejectPrint,
            QtyRejectFabric = reviseQtyRejectFabric,
            QtyRejectSewing = reviseQtyRejectSewing,
            QtyRejectRework = reviseQtyRejectRework,
            QtyLost = reviseQtyLost,
            Remark = string.IsNullOrWhiteSpace(reviseRemark) ? null : reviseRemark,
            NewTargetDivisionId = reviseTargetDivisionId,
            ResourceId = currentOperatorId.Value,
            NewResourceId = revisePelaksanaResourceId > 0 ? revisePelaksanaResourceId : null
        });

        isBusy = false;

        if (!success)
        {
            reviseError = StripLockedPrefix(error);
            return;
        }

        CloseReviseModal();
        await RefreshLists();
    }


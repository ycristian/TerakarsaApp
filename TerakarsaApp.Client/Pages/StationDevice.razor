@if (showReviseModal && reviseTarget is not null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Revisi Data</h5>
                    <button type="button" class="btn-close" @onclick="CloseReviseModal"></button>
                </div>
                <div class="modal-body">
                    @if (reviseTarget.BundleId is not null)
                    {
                        <p><strong>No. @BundleDisplay.Format(reviseTarget.BundleLetter, reviseTarget.BundleNo) - @reviseTarget.SizeName</strong> &middot; @reviseTarget.Serial</p>
                        <p class="text-muted">@reviseTarget.ArticleName &middot; @reviseTarget.StepName</p>
                    }
                    else
                    {
                        <p><strong>@reviseTarget.ArticleName</strong> &middot; @reviseTarget.StepName</p>
                    }

                    <div class="mb-3">
                        @if (!IsLocked)
                        {
                            <ResourcePickerCards Resources="operators" SelectedId="revisePelaksanaResourceId"
                                                  SelectedIdChanged="(int? v) => revisePelaksanaResourceId = v ?? 0" Label="Pelaksana" />
                        }
                        else
                        {
                            <label class="form-label">Pelaksana</label>
                            <div class="form-control form-control-lg bg-light"><i class="fe fe-lock"></i> @station?.DefaultResourceName</div>
                        }
                    </div>

                    <div class="d-flex justify-content-end mb-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ResetRevise">Reset</button>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label">Qty OK</label>
                            <input type="number" min="@(reviseTarget.BundleId is not null ? "0" : null)" class="form-control form-control-lg" @bind="reviseQtyOk" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Print</label>
                            <input type="number" min="@(reviseTarget.BundleId is not null ? "0" : null)" class="form-control form-control-lg" @bind="reviseQtyRejectPrint" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Bahan</label>
                            <input type="number" min="@(reviseTarget.BundleId is not null ? "0" : null)" class="form-control form-control-lg" @bind="reviseQtyRejectFabric" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Jahit</label>
                            <input type="number" min="@(reviseTarget.BundleId is not null ? "0" : null)" class="form-control form-control-lg" @bind="reviseQtyRejectSewing" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Rework</label>
                            <input type="number" min="@(reviseTarget.BundleId is not null ? "0" : null)" class="form-control form-control-lg" @bind="reviseQtyRejectRework" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Hilang</label>
                            <input type="number" min="@(reviseTarget.BundleId is not null ? "0" : null)" class="form-control form-control-lg" @bind="reviseQtyLost" />
                        </div>
                    </div>

                    @if (reviseQuotaInfo is not null)
                    {
                        <div class="form-text mb-2">Masuk: @reviseQuotaInfo.QtyMasuk &middot; Tercatat: @reviseQuotaInfo.QtySudah &middot; Sisa: @reviseQuotaInfo.Sisa</div>
                    }

                    @if (!reviseTarget.IsLastStep)
                    {
                        <div class="mb-2">
                            <label class="form-label">Divisi Tujuan</label>
                            <div class="form-control form-control-lg bg-light">
                                @(reviseTarget.TargetDivisionName ?? "-")
                            </div>
                        </div>
                    }

                    <label class="form-label">Catatan (wajib jika ada reject)</label>
                    <textarea class="form-control" rows="2" @bind="reviseRemark"></textarea>

                    @if (!string.IsNullOrEmpty(reviseError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@reviseError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseReviseModal">Batal</button>
                    <button class="btn btn-primary" disabled="@isBusy" @onclick="ConfirmRevise">Simpan</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showBatalSerahModal && batalSerahTarget is not null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(batalSerahTarget.IsLastStep ? "Batal Step Terakhir" : "Batal Serah")</h5>
                    <button type="button" class="btn-close" @onclick="CloseBatalSerahModal"></button>
                </div>
                <div class="modal-body">
                    @if (batalSerahTarget.BundleId is not null)
                    {
                        <p class="mb-1">
                            Yakin batal@(batalSerahTarget.IsLastStep ? "" : " serah") bundle No. @BundleDisplay.Format(batalSerahTarget.BundleLetter, batalSerahTarget.BundleNo) &middot; @batalSerahTarget.Serial?
                        </p>
                        <p class="text-muted mb-0">
                            @(batalSerahTarget.IsLastStep
                                ? "Baris step terakhir akan dihapus dan bundle kembali ke WIP."
                                : "Baris serah akan dihapus dan bundle kembali ke WIP.")
                        </p>
                    }
                    else
                    {
                        <p class="mb-1">
                            Yakin batal kirim hasil @batalSerahTarget.StepName @batalSerahTarget.SizeName? Baris input akan dihapus.
                        </p>
                    }
                    @if (!string.IsNullOrEmpty(batalSerahError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@batalSerahError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseBatalSerahModal">Batal</button>
                    <button class="btn btn-danger" disabled="@isBusy" @onclick="ConfirmBatalSerah">Ya, Batalkan</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showReviseGroupModal && reviseGroupTarget is not null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Revisi Gabungan &middot; @reviseGroupTarget.StepName</h5>
                    <button type="button" class="btn-close" @onclick="CloseReviseGroupModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-2">@reviseGroupTarget.ArticleName</p>
                    <div class="d-flex flex-wrap gap-3 mb-2">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="rgShowRejectPrint" @bind="reviseGroupShowRejectPrint" @bind:after="OnReviseGroupShowRejectPrintChanged" />
                            <label class="form-check-label" for="rgShowRejectPrint">Reject Print</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="rgShowRejectFabric" @bind="reviseGroupShowRejectFabric" @bind:after="OnReviseGroupShowRejectFabricChanged" />
                            <label class="form-check-label" for="rgShowRejectFabric">Reject Bahan</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="rgShowRejectSewing" @bind="reviseGroupShowRejectSewing" @bind:after="OnReviseGroupShowRejectSewingChanged" />
                            <label class="form-check-label" for="rgShowRejectSewing">Reject Jahit</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="rgShowRejectRework" @bind="reviseGroupShowRejectRework" @bind:after="OnReviseGroupShowRejectReworkChanged" />
                            <label class="form-check-label" for="rgShowRejectRework">Reject Rework</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="rgShowLost" @bind="reviseGroupShowLost" @bind:after="OnReviseGroupShowLostChanged" />
                            <label class="form-check-label" for="rgShowLost">Hilang</label>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered border mb-0">
                            <thead>
                                <tr>
                                    <th>Size</th>
                                    <th>Qty OK</th>
                                    @if (reviseGroupShowRejectPrint)
                                    {
                                        <th>Reject Print</th>
                                    }
                                    @if (reviseGroupShowRejectFabric)
                                    {
                                        <th>Reject Bahan</th>
                                    }
                                    @if (reviseGroupShowRejectSewing)
                                    {
                                        <th>Reject Jahit</th>
                                    }
                                    @if (reviseGroupShowRejectRework)
                                    {
                                        <th>Reject Rework</th>
                                    }
                                    @if (reviseGroupShowLost)
                                    {
                                        <th>Hilang</th>
                                    }
                                    <th>Catatan</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in reviseGroupRows)
                                {
                                    <tr>
                                        <td class="align-middle">@row.SizeName</td>
                                        <td><input type="number" min="0" class="form-control" @bind="row.QtyOk" @bind:after="() => row.QtyOk = Math.Max(0, row.QtyOk)" /></td>
                                        @if (reviseGroupShowRejectPrint)
                                        {
                                            <td><input type="number" min="0" class="form-control" @bind="row.QtyRejectPrint" @bind:after="() => row.QtyRejectPrint = Math.Max(0, row.QtyRejectPrint)" /></td>
                                        }
                                        @if (reviseGroupShowRejectFabric)
                                        {
                                            <td><input type="number" min="0" class="form-control" @bind="row.QtyRejectFabric" @bind:after="() => row.QtyRejectFabric = Math.Max(0, row.QtyRejectFabric)" /></td>
                                        }
                                        @if (reviseGroupShowRejectSewing)
                                        {
                                            <td><input type="number" min="0" class="form-control" @bind="row.QtyRejectSewing" @bind:after="() => row.QtyRejectSewing = Math.Max(0, row.QtyRejectSewing)" /></td>
                                        }
                                        @if (reviseGroupShowRejectRework)
                                        {
                                            <td><input type="number" min="0" class="form-control" @bind="row.QtyRejectRework" @bind:after="() => row.QtyRejectRework = Math.Max(0, row.QtyRejectRework)" /></td>
                                        }
                                        @if (reviseGroupShowLost)
                                        {
                                            <td><input type="number" min="0" class="form-control" @bind="row.QtyLost" @bind:after="() => row.QtyLost = Math.Max(0, row.QtyLost)" /></td>
                                        }
                                        <td><input class="form-control" @bind="row.Remark" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!string.IsNullOrEmpty(reviseGroupError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@reviseGroupError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseReviseGroupModal">Batal</button>
                    <button class="btn btn-primary" disabled="@isBusy" @onclick="ConfirmReviseGroup">Simpan</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showBatalSerahGroupModal && batalSerahGroupTarget is not null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Batal Serah</h5>
                    <button type="button" class="btn-close" @onclick="CloseBatalSerahGroupModal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1">
                        Yakin batal kirim hasil @batalSerahGroupTarget.StepName untuk @batalSerahGroupTarget.Items.Count ukuran (@string.Join(", ", batalSerahGroupTarget.Items.Select(i => i.SizeName)))?
                    </p>
                    <p class="text-muted mb-0">Semua baris ukuran pada kartu ini akan dihapus.</p>
                    @if (!string.IsNullOrEmpty(batalSerahGroupError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@batalSerahGroupError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseBatalSerahGroupModal">Batal</button>
                    <button class="btn btn-danger" disabled="@isBusy" @onclick="ConfirmBatalSerahGroup">Ya, Batalkan</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showBuatBundleModal && buatBundleTarget is not null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Buat Bundle &middot; @buatBundleTarget.ArticleName</h5>
                    <button type="button" class="btn-close" @onclick="CloseBuatBundleModal"></button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered border mb-0">
                            <thead>
                                <tr>
                                    <th>Ukuran</th>
                                    <th>Qty Order</th>
                                    <th>Stock Cutting</th>
                                    <th>Jumlah Bundle</th>
                                    <th>Total Qty Bundle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in buatBundleSummary)
                                {
                                    <tr class="@(s.TotalBundleQty != s.QtyOrder ? "table-warning" : "")"
                                        style="cursor:pointer;" @onclick="() => HandleBuatBundleSizeChanged(s.ArticleSizeId)">
                                        <td>@s.SizeName</td>
                                        <td>@s.QtyOrder</td>
                                        <td>@s.StockCutting</td>
                                        <td>@s.BundleCount</td>
                                        <td>@s.TotalBundleQty</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!string.IsNullOrEmpty(buatBundleFeedback))
                    {
                        <div class="alert alert-success">@buatBundleFeedback</div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Penjahit (Tim)</label>
                        <div class="row g-2">
                            @foreach (var r in buatBundleTailorOptions)
                            {
                                <div class="col-6 col-md-4">
                                    <button type="button" class="btn @(buatBundleTailorResourceId == r.Id ? "btn-primary" : "btn-outline-secondary") w-100 py-2"
                                            @onclick="() => HandleBuatBundleTailorResourceChanged(r.Id)">
                                        @r.ResourceName
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6 col-md-4">
                            <label class="form-label">Ukuran</label>
                            <SearchableSelect TItem="BundleSizeSummaryDto" Items="buatBundleSummary" Value="buatBundleArticleSizeId" ValueChanged="HandleBuatBundleSizeChanged"
                                              IdSelector="@(s => s.ArticleSizeId)" TextSelector="@(s => s.SizeName)"
                                              Placeholder="Cari ukuran..." />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Qty</label>
                            <input type="number" min="1" class="form-control form-control-lg" @bind="buatBundleQty" />
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label">Penjahit</label>
                            <SearchableSelect TItem="EmployeeLookupDto" Items="buatBundleTailorEmployeeOptions" @bind-Value="buatBundleTailorEmployeeId"
                                              IdSelector="@(e => e.Id)" TextSelector="@(e => BundleDisplay.FormatEmployeeOption(e.EmployeeCode, e.EmployeeName))"
                                              AllowNone="true" NoneLabel="- Tidak ada -" Disabled="@(buatBundleTailorResourceId <= 0)"
                                              Placeholder="Cari penjahit..." />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-9">
                            <label class="form-label">Catatan (opsional)</label>
                            <textarea class="form-control" rows="2" maxlength="500" @bind="buatBundleRemarks"></textarea>
                        </div>
                        <div class="col-3">
                            <label class="form-label">Jumlah Label</label>
                            <input type="number" min="0" class="form-control" @bind="buatBundlePrintCopies" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(buatBundleError))
                    {
                        <div class="alert alert-danger mb-0">@buatBundleError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseBuatBundleModal">Tutup</button>
                    <button class="btn btn-primary" disabled="@isBusy" @onclick="ConfirmBuatBundle">Simpan</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showEditBundleModal && editBundleTarget is not null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Bundle</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditBundleModal"></button>
                </div>
                <div class="modal-body">
                    <p><strong>No. @BundleDisplay.Format(editBundleTarget.BundleLetter, editBundleTarget.BundleNo)</strong> &middot; @editBundleTarget.Serial</p>
                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <label class="form-label">Ukuran</label>
                            <SearchableSelect TItem="BundleSizeSummaryDto" Items="editBundleSummary" Value="editBundleArticleSizeId" ValueChanged="(int v) => editBundleArticleSizeId = v"
                                              IdSelector="@(s => s.ArticleSizeId)" TextSelector="@(s => s.SizeName)"
                                              Placeholder="Cari ukuran..." />
                        </div>
                        <div class="col-5">
                            <label class="form-label">Qty</label>
                            <input type="number" min="1" class="form-control form-control-lg" @bind="editBundleQty" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Penjahit (Tim, opsional)</label>
                        <div class="row g-2">
                            <div class="col-6 col-md-4">
                                <button type="button" class="btn @(editBundleTailorResourceId == 0 ? "btn-primary" : "btn-outline-secondary") w-100 py-2"
                                        @onclick="() => HandleEditBundleTailorResourceChanged(0)">
                                    - Tidak ada -
                                </button>
                            </div>
                            @foreach (var r in editBundleTailorOptions)
                            {
                                <div class="col-6 col-md-4">
                                    <button type="button" class="btn @(editBundleTailorResourceId == r.Id ? "btn-primary" : "btn-outline-secondary") w-100 py-2"
                                            @onclick="() => HandleEditBundleTailorResourceChanged(r.Id)">
                                        @r.ResourceName
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Penjahit</label>
                        <SearchableSelect TItem="EmployeeLookupDto" Items="editBundleTailorEmployeeOptions" @bind-Value="editBundleTailorEmployeeId"
                                          IdSelector="@(e => e.Id)" TextSelector="@(e => BundleDisplay.FormatEmployeeOption(e.EmployeeCode, e.EmployeeName))"
                                          AllowNone="true" NoneLabel="- Tidak ada -" Disabled="@(editBundleTailorResourceId <= 0)"
                                          Placeholder="Cari penjahit..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Catatan (opsional)</label>
                        <textarea class="form-control" rows="2" maxlength="500" @bind="editBundleRemarks"></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(editBundleError))
                    {
                        <div class="alert alert-danger mb-0">@editBundleError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseEditBundleModal">Batal</button>
                    <button class="btn btn-primary" disabled="@isBusy" @onclick="ConfirmEditBundle">Simpan</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteBundleModal && deleteBundleTarget is not null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Hapus Bundle</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteBundleModal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1">Yakin hapus bundle No. @BundleDisplay.Format(deleteBundleTarget.BundleLetter, deleteBundleTarget.BundleNo) &middot; @deleteBundleTarget.Serial?</p>
                    <p class="text-muted mb-2">Bundle sudah diterima @deleteBundleTarget.TargetDivisionName. Hanya bisa dihapus sampai 1 jam setelah bundle dibuat.</p>
                    <label class="form-label">Alasan hapus (wajib)</label>

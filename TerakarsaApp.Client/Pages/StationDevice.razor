                </div>
            </div>
        </div>
    </div>
}

@if (showReprintBundleModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Cetak Ulang Label</h5>
                    <button type="button" class="btn-close" @onclick="CloseReprintBundleModal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Cetak ulang label @reprintBundleSerial.</p>
                    <label class="form-label">Jumlah Label</label>
                    <input type="number" min="1" class="form-control form-control-lg" @bind="reprintBundleCopies" />
                    @if (!string.IsNullOrEmpty(reprintBundleError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@reprintBundleError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseReprintBundleModal">Batal</button>
                    <button class="btn btn-primary" disabled="@(isBusy || reprintBundleCopies < 1)" @onclick="ConfirmReprintBundle">Cetak</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showPackFormModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditPlanMode ? "Edit Planning Karung" : "Buat Karung")</h5>
                    <button type="button" class="btn-close" @onclick="ClosePackFormModal"></button>
                </div>
                <div class="modal-body">
                    @foreach (var row in packFormRows)
                    {
                        <div class="row g-2 align-items-end mb-2" @key="row">
                            <div class="col-5">
                                <label class="form-label">Artikel</label>
                                <SearchableSelect TItem="PackArticleOption" Items="packArticleOptions" Value="row.ArticleId" ValueChanged="@(v => HandlePackFormArticleChanged(row, v))"
                                                  IdSelector="@(a => a.ArticleId)" TextSelector="@(a => a.Label)"
                                                  Placeholder="Cari artikel..." />
                            </div>
                            <div class="col-4">
                                <label class="form-label">Ukuran</label>
                                <SearchableSelect TItem="PackStockAvailableDto" Items="PackFormSizeOptions(row.ArticleId)" @bind-Value="row.ArticleSizeId"

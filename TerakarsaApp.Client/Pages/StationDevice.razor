    {
        isBusy = true;
        confirmError = string.Empty;

        var items = confirmRows.Select(r => new PackConfirmItemInput { PackItemId = r.PackItemId, QtyActual = r.QtyActual }).ToList();
        var (success, error) = await StationApi.ConfirmPackAsync(confirmPackId, new PackConfirmRequest { Items = items });

        isBusy = false;
        if (!success) { confirmError = error; return; }

        showConfirmPackModal = false;
        packingFeedback = "Karung dikonfirmasi.";
        await LoadPackingData();
    }

    private bool showDeletePackModal = false;
    private PackListItemDto? deletePackTarget;
    private string deletePackReason = string.Empty;
    private string deletePackError = string.Empty;

    private void OpenDeletePackModal(PackListItemDto pack)
    {
        deletePackTarget = pack;
        deletePackReason = string.Empty;
        deletePackError = string.Empty;
        showDeletePackModal = true;
    }

    private void CloseDeletePackModal()
    {
        showDeletePackModal = false;
        deletePackTarget = null;
    }

    private async Task ConfirmDeletePack()
    {
        if (deletePackTarget is null) return;

        if (string.IsNullOrWhiteSpace(deletePackReason))
        {
            deletePackError = "Alasan hapus wajib diisi.";
            return;
        }

        isBusy = true;
        deletePackError = string.Empty;

        var (success, error) = await StationApi.DeletePackAsync(deletePackTarget.Id, deletePackReason);

        isBusy = false;

        if (!success)
        {
            deletePackError = error;
            return;
        }

        showDeletePackModal = false;
        deletePackTarget = null;
        packingFeedback = "Karung dihapus.";
        await LoadPackingData();
    }

    // Fix: modal konfirmasi Cetak Ulang -- user input jumlah label (default 1).
    private bool showReprintPackModal = false;
    private int? reprintPackId;
    private string? reprintPackSerial;
    private int reprintPackCopies = 1;
    private string reprintPackError = string.Empty;

    private void OpenReprintPackModal(int packId, string? serial)
    {
        reprintPackId = packId;
        reprintPackSerial = serial;
        reprintPackCopies = 1;
        reprintPackError = string.Empty;
        showReprintPackModal = true;
    }

    private void CloseReprintPackModal()
    {
        showReprintPackModal = false;
        reprintPackId = null;
    }

    private async Task ConfirmReprintPack()
    {
        if (reprintPackId is null || reprintPackCopies < 1) return;

        isBusy = true;
        reprintPackError = string.Empty;
        packingFeedback = string.Empty;

        var (success, error) = await StationApi.ReprintPackAsync(reprintPackId.Value, reprintPackCopies);

        isBusy = false;

        if (!success)
        {
            reprintPackError = error;
            return;
        }

        CloseReprintPackModal();
        packingFeedback = "Label masuk antrian cetak.";
    }

    // Scan QR lewat kamera (label bundle/karung) -- QR selalu berisi URL absolut
    // ({PublicBaseUrl}/b/{serial} atau /pack/{serial}); hasilnya dinavigasi client-side
    // (NavigationManager, TANPA forceLoad) supaya tetap dalam app, bukan buka tab baru.
    private bool showQrScanner = false;
    private string qrScanError = string.Empty;

    private void HandleQrScanned(string value)
    {
        showQrScanner = false;

        var path = ExtractLocalPath(value);
        if (path is null)
        {
            qrScanError = "QR tidak dikenali.";
            return;
        }

        qrScanError = string.Empty;
        Nav.NavigateTo(path);
    }

    private static string? ExtractLocalPath(string value)
    {
        if (Uri.TryCreate(value, UriKind.Absolute, out var uri)) return uri.PathAndQuery;
        return value.StartsWith('/') ? value : null;
    }

    public void Dispose()
    {
        pollTimer?.Dispose();
    }
}

    private async Task OpenLockModal()
    {
        var selected = OutSelectedRows;
        if (selected.Count == 0) return;

        lockError = string.Empty;
        // defaultAt = created_at TERBARU di antara baris terpilih (lihat SIS_PayrollPeriod_Options).
        var defaultAt = selected.Max(r => r.CreatedAt);
        lockPeriodOptions = await StationApi.GetPayrollPeriodsAsync(defaultAt);
        lockPeriodId = (lockPeriodOptions.FirstOrDefault(p => p.IsDefault) ?? lockPeriodOptions.LastOrDefault())?.PayrollPeriodId ?? 0;

        // Peringatan kalau baris terpilih jatuh di lebih dari satu periode: batasnya Sabtu
        // 10:00, jadi cukup dicek lewat periode mana yang memuat created_at masing-masing --
        // didekati dengan rentang periode yang sedang dimuat.
        lockMultiPeriodWarning = lockPeriodOptions.Count > 0 && selected
            .Select(r => lockPeriodOptions.FirstOrDefault(p => r.CreatedAt >= p.PeriodStart && r.CreatedAt < p.PeriodEnd)?.PayrollPeriodId ?? 0)
            .Distinct().Count() > 1;

        showLockModal = true;
    }

    private void CloseLockModal()
    {
        showLockModal = false;
        lockError = string.Empty;
    }

    private async Task ConfirmLock()
    {
        if (currentOperatorId is null)
        {
            lockError = "Operator wajib dipilih.";
            return;
        }

        var ids = OutSelectedRows.Select(r => r.WorkflowLogId).ToList();
        if (ids.Count == 0 || lockPeriodId <= 0) return;

        isBusy = true;
        lockError = string.Empty;

        var (success, error) = await StationApi.LockOutRowsAsync(new StationLockRequest
        {
            WorkflowLogIds = ids,
            PayrollPeriodId = lockPeriodId,
            ResourceId = currentOperatorId.Value
        });

        isBusy = false;

        if (!success)
        {
            lockError = StripLockedPrefix(error);
            await RefreshLists();
            return;
        }

        var periodCode = lockPeriodOptions.FirstOrDefault(p => p.PayrollPeriodId == lockPeriodId)?.PeriodCode ?? "-";
        showLockModal = false;
        ClearOutSelection();
        outToast = $"{ids.Count} baris di-lock ke {periodCode}";
        await RefreshLists();
    }


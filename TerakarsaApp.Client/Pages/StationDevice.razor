    // pilihan & muat ulang opsi saat Tim diganti.
    private async Task HandleBuatBundleTailorResourceChanged(int resourceId)
    {
        buatBundleTailorResourceId = resourceId;
        buatBundleTailorEmployeeId = 0;
        buatBundleTailorEmployeeOptions = resourceId > 0 ? await StationApi.GetEmployeesByResourceAsync(resourceId) : new();
    }

    private async Task ConfirmBuatBundle()
    {
        if (buatBundleTarget is null || currentOperatorId is null) return;

        buatBundleError = string.Empty;
        buatBundleFeedback = string.Empty;

        if (buatBundleArticleSizeId <= 0)
        {
            buatBundleError = "Ukuran wajib dipilih.";
            return;
        }

        if (buatBundleQty <= 0)
        {
            buatBundleError = "Qty bundle harus lebih dari 0.";
            return;
        }

        var buatBundleSizeInfo = buatBundleSummary.FirstOrDefault(s => s.ArticleSizeId == buatBundleArticleSizeId);
        if (buatBundleSizeInfo is not null && buatBundleQty > buatBundleSizeInfo.StockCutting)
        {
            buatBundleError = $"Qty tidak boleh lebih dari Stock Cutting ({buatBundleSizeInfo.StockCutting}).";
            return;
        }

        if (buatBundleTailorResourceId <= 0)
        {
            buatBundleError = "Penjahit (Tim) wajib dipilih.";
            return;
        }

        if (buatBundlePrintCopies < 0)
        {
            buatBundleError = "Jumlah label tidak boleh negatif.";
            return;
        }

        isBusy = true;

        var (success, error, result) = await StationApi.CreateBundleAsync(new StationBundleCreateRequest
        {
            ArticleId = buatBundleTarget.ArticleId,
            ArticleSizeId = buatBundleArticleSizeId,
            Qty = buatBundleQty,
            ResourceId = currentOperatorId.Value,
            TailorResourceId = buatBundleTailorResourceId > 0 ? buatBundleTailorResourceId : null,
            TailorEmployeeId = buatBundleTailorEmployeeId > 0 ? buatBundleTailorEmployeeId : null,
            PrintCopies = buatBundlePrintCopies,
            Remarks = buatBundleRemarks
        });

        isBusy = false;

        if (!success)
        {
            buatBundleError = error;
            return;
        }

        buatBundleFeedback = $"Bundle {result?.Serial} dibuat" + (result?.PrintJobId is not null ? " · label masuk antrian cetak" : "");

        // Modal tetap terbuka (input beruntun) -- refresh ringkasan + daftar kartu WIP di
        // belakang layar supaya jumlah bundle/total qty ikut ter-update.
        buatBundleSummary = await StationApi.GetBundlingSummaryAsync(buatBundleTarget.ArticleId);
        await RefreshLists();
    }


            .GroupBy(i => i.ArticleId)
            .Select(g => new OutCard
            {
                ArticleId = g.Key,
                SortTime = g.Max(x => x.CreatedAt),
                // Ad hoc (2026-09-28): baris tabel kartu OUT urut dari kiriman terbaru ke terlama.
                Items = g.OrderByDescending(x => x.CreatedAt).ThenByDescending(x => x.BundleNo).ToList()
            })
            // Prompt 56: kartu yang masih punya baris belum lock di atas (itu yang butuh
            // tindakan); kartu yang sudah lock semua turun ke bawah dan tampil pudar.
            .OrderBy(c => c.Items.Any(r => !r.IsLocked) ? 0 : 1)
            .ThenByDescending(c => c.SortTime)
            .ToList();


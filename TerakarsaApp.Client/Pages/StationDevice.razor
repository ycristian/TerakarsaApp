        public string? Color;
        public string StepName = string.Empty;
        public string FromDivisionName = string.Empty;
        public DateTime GroupTime;
        public List<StationPendingReceiveDto> Items = new();
    }

    private List<InCard> InCards =>
        pendingReceives.Where(i => i.BundleId is not null)
            .GroupBy(i => i.ArticleWorkflowId)
            .Select(g => new InCard { SortTime = g.Min(x => x.SentAt), BundleGroup = g.OrderBy(x => x.BundleNo).ToList() })
        .Concat(
            pendingReceives.Where(i => i.BundleId is null)
                .GroupBy(i => (i.ArticleWorkflowId, Minute: TruncateToMinute(i.SentAt)))
                .Select(g => new InCard
                {
                    SortTime = g.Min(x => x.SentAt),
                    NonBundleGroup = new NonBundleReceiveGroup
                    {
                        ArticleWorkflowId = g.Key.ArticleWorkflowId,
                        ArticleName = g.First().ArticleName,
                        ProjectName = g.First().ProjectName,
                        NoPo = g.First().NoPo,
                        Style = g.First().Style,
                        Color = g.First().Color,
                        StepName = g.First().StepName,
                        FromDivisionName = g.First().FromDivisionName,
                        GroupTime = g.Min(x => x.SentAt),
                        Items = g.OrderBy(x => x.SizeSortOrder).ToList()
                    }
                })
        )
        .OrderBy(c => c.SortTime)
        .ToList();


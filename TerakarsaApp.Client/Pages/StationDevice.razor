    private const int OutUnlockedChipLimit = 6;

    private List<StationUnlockedDateDto> OutUnlockedChipSource =>
        outUnlockedDates.Where(d => d.Date.Date != outboundDate.Date).ToList();

    private List<StationUnlockedDateDto> OutUnlockedChips =>

@* Prompt 56: konfirmasi LOCK -- ringkasan per artikel + pilihan periode gajian. Operator
   diambil dari sesi aktif (tidak bisa diganti di sini). *@
@if (showLockModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Lock Hasil Kerja</h5>
                    <button type="button" class="btn-close" @onclick="CloseLockModal"></button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered border mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Artikel</th>
                                    <th class="text-end">Baris</th>
                                    <th class="text-end">Pcs</th>
                                    <th class="text-end">Reject</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in OutSelectedRows.GroupBy(r => r.ArticleName).OrderBy(g => g.Key))
                                {
                                    <tr>
                                        <td>@g.Key</td>
                                        <td class="text-end">@g.Count()</td>
                                        <td class="text-end">@g.Sum(x => x.QtyOk)</td>
                                        <td class="text-end @(g.Sum(RejectTotal) > 0 ? "text-danger" : "")">@g.Sum(RejectTotal)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Periode Gajian</label>
                        @if (lockPeriodOptions.Count == 0)
                        {
                            <div class="alert alert-warning mb-0">
                                Periode gajian belum di-generate. Hubungi admin.
                            </div>
                        }
                        else
                        {
                            <select class="form-select" @bind="lockPeriodId">
                                @foreach (var p in lockPeriodOptions)
                                {
                                    <option value="@p.PayrollPeriodId">@FormatPayrollPeriod(p)</option>
                                }
                            </select>
                        }
                    </div>

                    @if (lockMultiPeriodWarning)
                    {
                        <div class="alert alert-warning">
                            Baris yang dipilih berasal dari dua periode. Semua akan masuk periode yang
                            dipilih. Lock terpisah kalau perlu dibagi.
                        </div>
                    }

                    <div class="mb-2">
                        <label class="form-label">Operator</label>
                        <div class="form-control bg-light">@(currentOperatorName ?? "-")</div>
                    </div>

                    @if (!string.IsNullOrEmpty(lockError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@lockError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseLockModal">Batal</button>
                    <button class="btn btn-primary" disabled="@(isBusy || lockPeriodId <= 0)" @onclick="ConfirmLock">
                        Ya, data sudah sesuai &mdash; Lock
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Prompt 56: pengajuan unlock -- baris baru bisa diedit setelah admin menyetujui (Prompt 57). *@

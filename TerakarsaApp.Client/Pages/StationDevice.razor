    private static bool ContainsSearch(string? haystack, string needle) =>
        !string.IsNullOrEmpty(haystack) && haystack.Contains(needle, StringComparison.OrdinalIgnoreCase);

    // Fix: pencarian antar-atribut -- tiap kata dipisah spasi dicek independen ke SEMUA field
    // (boleh field berbeda per kata), kartu cocok kalau SEMUA kata ketemu di suatu field.
    // Mis. "Excellent Abuy Iki" cocok kalau "Excellent" ada di project/artikel, "Abuy" di
    // Line/resource, "Iki" di nama penjahit/remarks -- tidak perlu satu field yang sama.
    private bool MatchesWipSearch(WipCard card)
    {
        if (string.IsNullOrWhiteSpace(wipSearchText)) return true;
        var tokens = wipSearchText.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return tokens.All(t => MatchesWipSearchToken(card, t));
    }

    private static bool MatchesWipSearchToken(WipCard card, string q)
    {
        if (card.NonBundle is { } nb)
            return ContainsSearch(nb.ProjectName, q) || ContainsSearch(nb.ArticleName, q)
                || ContainsSearch(nb.NoPo, q) || ContainsSearch(nb.BuyerName, q) || ContainsSearch(nb.PicName, q)
                || ContainsSearch(nb.Style, q) || ContainsSearch(nb.Color, q) || ContainsSearch(nb.StepName, q);

        if (card.BundleGroup is { } grp)
            return grp.Any(b => ContainsSearch(b.ProjectName, q) || ContainsSearch(b.ArticleName, q)
                || ContainsSearch(b.NoPo, q) || ContainsSearch(b.BuyerName, q) || ContainsSearch(b.PicName, q)
                || ContainsSearch(b.Style, q) || ContainsSearch(b.Color, q) || ContainsSearch(b.NextStepName, q)
                || ContainsSearch(b.Serial, q) || ContainsSearch(b.BundleNo.ToString(), q)
                || ContainsSearch(b.TailorName, q) || ContainsSearch(b.EmployeeName, q) || ContainsSearch(b.Remarks, q));

        return false;
    }

    // Pencarian tab OUT -- pola sama dengan WIP: semua token harus cocok (AND), tiap token
    // dicocokkan ke salah satu field baris. Kartu ditampilkan kalau ADA barisnya yang cocok,
    // dan hanya baris yang cocok itu yang ditampilkan -- lihat OutCards.
    private string outSearchText = string.Empty;

    private bool MatchesOutSearch(StationPendingHandoverDto r)
    {
        if (string.IsNullOrWhiteSpace(outSearchText)) return true;
        var tokens = outSearchText.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return tokens.All(t => MatchesOutSearchToken(r, t));
    }

    private static bool MatchesOutSearchToken(StationPendingHandoverDto r, string q) =>
        ContainsSearch(r.ProjectName, q) || ContainsSearch(r.ArticleName, q)
        || ContainsSearch(r.NoPo, q) || ContainsSearch(r.BuyerName, q) || ContainsSearch(r.PicName, q)
        || ContainsSearch(r.Style, q) || ContainsSearch(r.Color, q) || ContainsSearch(r.StepName, q)
        || ContainsSearch(r.SizeName, q) || ContainsSearch(r.Serial, q)
        || ContainsSearch(BundleDisplay.Format(r.BundleLetter, r.BundleNo), q)
        || ContainsSearch(r.ResourceName, q) || ContainsSearch(r.BundleResourceName, q)
        || ContainsSearch(r.BundleEmployeeName, q) || ContainsSearch(r.Remark, q);


        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Revisi Data</h5>
                    <button type="button" class="btn-close" @onclick="CloseReviseModal"></button>
                </div>
                <div class="modal-body">
                    @if (reviseTarget.BundleId is not null)
                    {
                        <p><strong>No. @BundleDisplay.Format(reviseTarget.BundleLetter, reviseTarget.BundleNo) - @reviseTarget.SizeName</strong> &middot; @reviseTarget.Serial</p>
                        <p class="text-muted">@reviseTarget.ArticleName &middot; @reviseTarget.StepName</p>
                    }
                    else
                    {
                        <p><strong>@reviseTarget.ArticleName</strong> &middot; @reviseTarget.StepName</p>
                    }

                    <div class="mb-3">
                        @if (!IsLocked)
                        {
                            <ResourcePickerCards Resources="operators" SelectedId="revisePelaksanaResourceId"
                                                  SelectedIdChanged="(int? v) => revisePelaksanaResourceId = v ?? 0" Label="Pelaksana" />
                        }
                        else
                        {
                            <label class="form-label">Pelaksana</label>
                            <div class="form-control bg-light"><i class="fe fe-lock"></i> @station?.DefaultResourceName</div>
                        }
                    </div>

                    <div class="d-flex justify-content-end mb-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ResetRevise">Reset</button>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label">Qty OK</label>
                            <input type="number" min="@(reviseTarget.BundleId is not null ? "0" : null)" class="form-control" @bind="reviseQtyOk" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Print</label>
                            <input type="number" min="@(reviseTarget.BundleId is not null ? "0" : null)" class="form-control" @bind="reviseQtyRejectPrint" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Bahan</label>
                            <input type="number" min="@(reviseTarget.BundleId is not null ? "0" : null)" class="form-control" @bind="reviseQtyRejectFabric" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Jahit</label>
                            <input type="number" min="@(reviseTarget.BundleId is not null ? "0" : null)" class="form-control" @bind="reviseQtyRejectSewing" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Rework</label>
                            <input type="number" min="@(reviseTarget.BundleId is not null ? "0" : null)" class="form-control" @bind="reviseQtyRejectRework" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Hilang</label>
                            <input type="number" min="@(reviseTarget.BundleId is not null ? "0" : null)" class="form-control" @bind="reviseQtyLost" />
                        </div>
                    </div>

                    @if (reviseQuotaInfo is not null)
                    {
                        <div class="form-text mb-2">Masuk: @reviseQuotaInfo.QtyMasuk &middot; Tercatat: @reviseQuotaInfo.QtySudah &middot; Sisa: @reviseQuotaInfo.Sisa</div>
                    }

                    @if (!reviseTarget.IsLastStep)
                    {
                        <div class="mb-2">
                            <label class="form-label">Divisi Tujuan</label>
                            <div class="form-control bg-light">
                                @(reviseTarget.TargetDivisionName ?? "-")
                            </div>
                        </div>
                    }

                    <label class="form-label">Catatan (wajib jika ada reject)</label>
                    <textarea class="form-control" rows="2" @bind="reviseRemark"></textarea>

                    @if (!string.IsNullOrEmpty(reviseError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@reviseError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseReviseModal">Batal</button>
                    <button class="btn btn-primary" disabled="@isBusy" @onclick="ConfirmRevise">Simpan</button>
                </div>
            </div>
        </div>
    </div>
}


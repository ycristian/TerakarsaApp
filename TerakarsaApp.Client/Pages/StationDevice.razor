    private async Task DoReceiveAsync(int workflowLogId, string? remark, int? resourceId = null)
    {
        isBusy = true;
        actionError = string.Empty;

        var (success, error) = await StationApi.ReceiveAsync(new StationReceiveRequest
        {
            WorkflowLogId = workflowLogId,
            ResourceId = (resourceId ?? currentOperatorId)!.Value,
            Remark = remark
        });

        isBusy = false;
        if (!success) actionError = error;
        await RefreshLists();

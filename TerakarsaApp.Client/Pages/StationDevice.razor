    // Keterangan periode gajian di samping label "Tanggal Kirim". Memakai ULANG
    // SIS_PayrollPeriod_Options (@DefaultAt = tanggal terpilih, IsDefault = periode yang
    // memuatnya) -- tidak ada SP/endpoint baru. Dipanggil dari RefreshLists tapi hanya
    // benar-benar menembak API saat tanggalnya berganti, supaya polling tidak ikut menambah
    // request. NULL kalau periode tanggal itu belum di-generate -- badge disembunyikan.
    private string? outboundDatePeriodCode;
    private DateTime? outboundDatePeriodLoadedFor;

    private async Task LoadOutboundDatePeriodAsync()
    {
        if (outboundDatePeriodLoadedFor == outboundDate.Date) return;

        var options = await StationApi.GetPayrollPeriodsAsync(outboundDate.Date);

        // Periode berganti Sabtu 10:00, jadi satu TANGGAL bisa jatuh di DUA periode (baris
        // sebelum jam 10 vs sesudahnya). Ambil semua periode yang beririsan dengan hari itu,
        // bukan sekadar IsDefault -- kalau dua, tampilkan keduanya supaya tidak menyesatkan.
        var dayStart = outboundDate.Date;
        var dayEnd = dayStart.AddDays(1);
        var overlapping = options
            .Where(o => o.PeriodStart < dayEnd && o.PeriodEnd > dayStart)
            .OrderBy(o => o.PeriodStart)
            .Select(o => o.PeriodCode)
            .ToList();

        outboundDatePeriodCode = overlapping.Count == 0 ? null : string.Join(" / ", overlapping);
        outboundDatePeriodLoadedFor = outboundDate.Date;
        StateHasChanged();
    }


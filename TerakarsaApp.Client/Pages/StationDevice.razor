    protected override async Task OnInitializedAsync()
    {
        isLoadingSetup = true;

        var existingToken = await JS.InvokeAsync<string?>("localStorage.getItem", TokenKey);
        if (!string.IsNullOrWhiteSpace(existingToken) && !string.IsNullOrWhiteSpace(PairingCode))
        {
            // Sudah punya token aktif tapi scan kode pairing baru -- logout otomatis dari
            // stasiun lama, lalu login ke stasiun hasil scan terakhir.
            await StationApi.LogoutAsync();
            await ReleaseToken();
            await ClaimAsync(PairingCode.Trim());
        }
        else if (!string.IsNullOrWhiteSpace(existingToken))
        {
            station = await StationApi.GetMeAsync();
            if (station is null)
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", TokenKey);
                setupError = "Token perangkat sudah tidak berlaku. Minta kode pairing baru ke admin.";
            }
        }
        else if (!string.IsNullOrWhiteSpace(PairingCode))
        {
            await ClaimAsync(PairingCode.Trim());
        }

        isLoadingSetup = false;

        if (station is not null)
            await LoadOperatorSessionAsync();
    }

    // Prompt 20: tukar kode pairing (dari URL /station/{kode} atau input manual) dengan
    // station_token baru, simpan ke localStorage, lalu muat info stasiun.
    private async Task ClaimAsync(string code)
    {
        isValidatingToken = true;
        setupError = string.Empty;

        var claim = await StationApi.ClaimAsync(code);
        if (!claim.Success || claim.Result is null)
        {
            setupError = string.IsNullOrEmpty(claim.Error) ? "Kode pairing tidak valid atau sudah kedaluwarsa." : claim.Error;
            isValidatingToken = false;
            return;
        }

        await JS.InvokeVoidAsync("localStorage.setItem", TokenKey, claim.Result.Token);

        station = await StationApi.GetMeAsync();
        isValidatingToken = false;

        if (station is null)
        {
            setupError = "Gagal mengaktifkan perangkat. Minta kode pairing baru ke admin.";
            await JS.InvokeVoidAsync("localStorage.removeItem", TokenKey);
            return;
        }

        if (!string.IsNullOrWhiteSpace(PairingCode))
            Nav.NavigateTo("/station", replace: true);
    }

    private async Task HandleSetupSubmit()
    {
        if (string.IsNullOrWhiteSpace(tokenInput))
        {
            setupError = "Kode pairing wajib diisi.";
            return;
        }

        var code = tokenInput.Trim();
        tokenInput = string.Empty;
        await ClaimAsync(code);

        if (station is not null)
            await LoadOperatorSessionAsync();
    }

    private async Task ConfirmLogout()
    {
        isLoggingOut = true;
        await StationApi.LogoutAsync();
        isLoggingOut = false;
        showLogoutConfirm = false;
        await ReleaseToken();
    }

    private bool IsLocked => station is not null && !station.AllowResourceChange && station.DefaultResourceId is not null;

    private async Task LoadOperatorSessionAsync()
    {
        operators = await StationApi.GetResourcesAsync();

        // Prompt 16: stasiun terkunci selalu memakai resource bawaan, abaikan sesi lama
        // yang mungkin tersimpan sebelum stasiun dikunci admin.
        if (IsLocked)
        {
            currentOperatorId = station!.DefaultResourceId;
            currentOperatorName = station.DefaultResourceName;
            await StartSessionAsync();
            return;
        }

        var savedId = await JS.InvokeAsync<string?>("localStorage.getItem", OperatorIdKey);
        if (int.TryParse(savedId, out var id) && operators.Any(o => o.Id == id))
        {
            currentOperatorId = id;
            currentOperatorName = operators.First(o => o.Id == id).ResourceName;
            await StartSessionAsync();
            return;
        }

        if (station!.DefaultResourceId is not null)
        {
            currentOperatorId = station.DefaultResourceId;
            currentOperatorName = station.DefaultResourceName;
            await StartSessionAsync();
        }
    }

    private async Task SelectOperator(ResourceLookupDto op)
    {
        currentOperatorId = op.Id;
        currentOperatorName = op.ResourceName;
        await JS.InvokeVoidAsync("localStorage.setItem", OperatorIdKey, op.Id.ToString());
        await JS.InvokeVoidAsync("localStorage.setItem", OperatorNameKey, op.ResourceName);
        await StartSessionAsync();
    }

    private async Task ChangeOperator()
    {
        StopPolling();
        currentOperatorId = null;
        currentOperatorName = null;
        await JS.InvokeVoidAsync("localStorage.removeItem", OperatorIdKey);
        await JS.InvokeVoidAsync("localStorage.removeItem", OperatorNameKey);
    }

    private async Task ReleaseToken()
    {
        StopPolling();

        await JS.InvokeVoidAsync("localStorage.removeItem", TokenKey);
        await JS.InvokeVoidAsync("localStorage.removeItem", OperatorIdKey);
        await JS.InvokeVoidAsync("localStorage.removeItem", OperatorNameKey);

        station = null;
        currentOperatorId = null;
        currentOperatorName = null;
        tokenInput = string.Empty;
        setupError = string.Empty;
    }

    private async Task StartSessionAsync()
    {
        await RefreshLists();
        StartPolling();
    }

    private void StartPolling()
    {
        pollTimer?.Dispose();
        pollTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshLists();
                StateHasChanged();
            });
        }, null, 15000, 15000);
    }

    private void StopPolling()
    {
        pollTimer?.Dispose();
        pollTimer = null;
    }


        editBundleTarget = null;
    }

    private async Task ConfirmEditBundle()
    {
        if (editBundleTarget?.BundleId is null || currentOperatorId is null) return;

        editBundleError = string.Empty;

        if (editBundleArticleSizeId <= 0)
        {
            editBundleError = "Ukuran wajib dipilih.";
            return;
        }

        if (editBundleQty <= 0)
        {
            editBundleError = "Qty bundle harus lebih dari 0.";
            return;
        }

        // Fix: qty tidak boleh melebihi Stock Cutting -- sisa StockCutting size ini (dari
        // ringkasan yang diambil saat modal dibuka) belum menghitung qty lama bundle ini
        // sendiri (masih ikut TotalBundleQty ukuran semula), jadi ditambahkan kembali sebagai
        // headroom HANYA kalau ukuran tidak diubah -- kalau pindah ukuran, qty lama tidak
        // pernah ikut TotalBundleQty ukuran baru jadi tidak ada headroom untuk ditambahkan.
        var editSizeInfo = editBundleSummary.FirstOrDefault(s => s.ArticleSizeId == editBundleArticleSizeId);
        if (editSizeInfo is not null)
        {
            var maxQty = editSizeInfo.StockCutting + (editBundleArticleSizeId == editBundleTarget.ArticleSizeId ? editBundleTarget.QtyOk : 0);
            if (editBundleQty > maxQty)
            {
                editBundleError = $"Qty tidak boleh lebih dari Stock Cutting ({maxQty}).";
                return;
            }
        }

        isBusy = true;

        var (success, error) = await StationApi.UpdateBundleAsync(editBundleTarget.BundleId.Value, new StationBundleUpdateRequest
        {
            Qty = editBundleQty,
            ArticleSizeId = editBundleArticleSizeId,
            ResourceId = currentOperatorId.Value,
            TailorResourceId = editBundleTailorResourceId > 0 ? editBundleTailorResourceId : null,
            TailorEmployeeId = editBundleTailorEmployeeId > 0 ? editBundleTailorEmployeeId : null,
            Remarks = editBundleRemarks
        });

        isBusy = false;

        if (!success)
        {
            editBundleError = StripLockedPrefix(error);
            return;
        }

        CloseEditBundleModal();
        await RefreshLists();
    }


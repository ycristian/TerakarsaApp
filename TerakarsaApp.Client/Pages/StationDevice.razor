    private void ToggleOutRow(StationPendingHandoverDto row)
    {
        if (!IsOutRowSelectable(row)) return;
        if (!outSelected.Add(row.WorkflowLogId)) outSelected.Remove(row.WorkflowLogId);
    }

    private void ToggleOutCardSelection(OutCard card)
    {
        var selectable = card.Items.Where(IsOutRowSelectable).ToList();
        if (selectable.Count == 0) return;

        if (selectable.All(r => outSelected.Contains(r.WorkflowLogId)))
        {
            foreach (var r in selectable) outSelected.Remove(r.WorkflowLogId);
        }
        else
        {
            foreach (var r in selectable) outSelected.Add(r.WorkflowLogId);
        }
    }


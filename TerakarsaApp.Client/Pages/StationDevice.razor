    private async Task SubmitPackForm()
    {
        packFormError = string.Empty;

        if (packFormRows.Count == 0 || packFormRows.Any(r => r.ArticleId <= 0 || r.ArticleSizeId <= 0 || r.QtyPlan <= 0))
        {
            packFormError = "Isi semua baris (artikel, ukuran, qty lebih dari 0).";
            return;
        }

        isBusy = true;
        var items = packFormRows.Select(r => new PackItemInput { ArticleId = r.ArticleId, ArticleSizeId = r.ArticleSizeId, QtyPlan = r.QtyPlan }).ToList();

        if (isEditPlanMode)
        {
            var (success, error) = await StationApi.UpdatePackPlanAsync(editPlanPackId, new PackUpdatePlanRequest { Items = items });
            isBusy = false;
            if (!success) { packFormError = error; return; }
            packingFeedback = "Planning karung disimpan.";
        }
        else
        {
            var (success, error, result) = await StationApi.CreatePackAsync(new PackCreateRequest { ProjectId = packingProjectId, Items = items, AutoPrint = packFormAutoPrint });
            isBusy = false;
            if (!success) { packFormError = error; return; }
            packingFeedback = $"Karung No. {result?.PackNo} dibuat" + (result?.PrintJobId is not null ? " · label masuk antrian cetak" : "");
        }

        showPackFormModal = false;
        await LoadPackingData();
    }


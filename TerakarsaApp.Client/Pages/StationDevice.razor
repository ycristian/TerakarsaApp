    // bukan satu operator untuk semua.
    private async Task ReceiveGroup(NonBundleReceiveGroup group, string? remark = null)
    {
        isBusy = true;
        actionError = string.Empty;

        foreach (var item in group.Items)
        {
            var (success, error) = await StationApi.ReceiveAsync(new StationReceiveRequest
            {
                WorkflowLogId = item.WorkflowLogId,
                ResourceId = (EffectiveReceiverResourceId(item) ?? currentOperatorId)!.Value,
                Remark = remark
            });

            if (!success)
            {
                actionError = $"{item.SizeName}: {error}";
                break;

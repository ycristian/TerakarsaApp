@if (showSerahkanModal && serahkanTarget is not null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Kirim Hasil</h5>
                    <button type="button" class="btn-close" @onclick="CloseSerahkanModal"></button>
                </div>
                <div class="modal-body">
                    <p><strong>No. @BundleDisplay.Format(serahkanTarget.BundleLetter, serahkanTarget.BundleNo) &middot; @serahkanTarget.SizeName</strong> &middot; @serahkanTarget.Serial</p>
                    <p class="text-muted">@serahkanTarget.NextStepName</p>

                    <div class="d-flex justify-content-end mb-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="SetSerahkanAllOk">Set All OK</button>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label">Qty OK</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="serahkanQtyOk" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Print</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="serahkanQtyRejectPrint" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Bahan</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="serahkanQtyRejectFabric" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Jahit</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="serahkanQtyRejectSewing" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Rework</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="serahkanQtyRejectRework" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Hilang</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="serahkanQtyLost" />
                        </div>
                    </div>

                    @if (serahkanQuotaInfo is not null)
                    {
                        <div class="form-text mb-2">Masuk: @serahkanQuotaInfo.QtyMasuk &middot; Tercatat: @serahkanQuotaInfo.QtySudah &middot; Sisa: @serahkanQuotaInfo.Sisa</div>
                    }

                    <div class="mb-2">
                        <label class="form-label">Divisi Tujuan</label>
                        <div class="form-control form-control-lg bg-light">
                            @(serahkanTarget.IsLastStep ? "Step terakhir — tidak ada serah lanjutan" : (serahkanTarget.NextDivisionName ?? "-"))
                        </div>
                    </div>

                    <label class="form-label">Catatan (wajib jika ada reject)</label>
                    <textarea class="form-control" rows="2" @bind="serahkanRemark"></textarea>

                    @if (!string.IsNullOrEmpty(serahkanError) && serahkanError.StartsWith("QTY_EXCEED|"))
                    {
                        <div class="alert alert-warning mt-2 mb-0">
                            <p class="mb-2">@(serahkanError["QTY_EXCEED|".Length..])</p>
                            <p class="mb-2">Yakin tetap simpan?</p>
                            <button class="btn btn-warning btn-sm" disabled="@isBusy" @onclick="() => ConfirmSerahkan(true, false)">Ya, tetap simpan</button>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(serahkanError) && serahkanError.StartsWith("QTY_SHORT|"))
                    {
                        <div class="alert alert-warning mt-2 mb-0">
                            <p class="mb-2">@(serahkanError["QTY_SHORT|".Length..])</p>
                            <p class="mb-2">Yakin tetap simpan?</p>
                            <button class="btn btn-warning btn-sm" disabled="@isBusy" @onclick="() => ConfirmSerahkan(false, true)">Ya, tetap simpan</button>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(serahkanError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@serahkanError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseSerahkanModal">Batal</button>
                    <button class="btn btn-primary" disabled="@isBusy" @onclick="() => ConfirmSerahkan(false, false)">Kirim Hasil</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showNonBundleModal && nonBundleTarget is not null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Kirim Hasil &middot; @nonBundleTarget.StepName</h5>
                    <button type="button" class="btn-close" @onclick="CloseNonBundleModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-2">
                        @nonBundleTarget.ArticleName &middot; Tujuan: @(nonBundleTarget.IsLastStep ? "Step terakhir" : (nonBundleTarget.NextDivisionName ?? "-")) &middot; Pelaksana: @currentOperatorName
                    </p>
                    <div class="d-flex flex-wrap gap-3 mb-2">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="nbShowRejectPrint" @bind="nonBundleShowRejectPrint" @bind:after="OnNonBundleShowRejectPrintChanged" />
                            <label class="form-check-label" for="nbShowRejectPrint">Reject Print</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="nbShowRejectFabric" @bind="nonBundleShowRejectFabric" @bind:after="OnNonBundleShowRejectFabricChanged" />
                            <label class="form-check-label" for="nbShowRejectFabric">Reject Bahan</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="nbShowRejectSewing" @bind="nonBundleShowRejectSewing" @bind:after="OnNonBundleShowRejectSewingChanged" />
                            <label class="form-check-label" for="nbShowRejectSewing">Reject Jahit</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="nbShowRejectRework" @bind="nonBundleShowRejectRework" @bind:after="OnNonBundleShowRejectReworkChanged" />
                            <label class="form-check-label" for="nbShowRejectRework">Reject Rework</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="nbShowLost" @bind="nonBundleShowLost" @bind:after="OnNonBundleShowLostChanged" />
                            <label class="form-check-label" for="nbShowLost">Hilang</label>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered border mb-0">
                            <thead>
                                <tr>
                                    <th>Ukuran</th>
                                    <th>Order</th>
                                    <th>Total OK</th>
                                    <th>Qty OK</th>
                                    @if (nonBundleShowRejectPrint)
                                    {
                                        <th>Reject Print</th>
                                    }
                                    @if (nonBundleShowRejectFabric)
                                    {
                                        <th>Reject Bahan</th>
                                    }
                                    @if (nonBundleShowRejectSewing)
                                    {
                                        <th>Reject Jahit</th>
                                    }
                                    @if (nonBundleShowRejectRework)
                                    {
                                        <th>Reject Rework</th>
                                    }
                                    @if (nonBundleShowLost)
                                    {
                                        <th>Hilang</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in nonBundleRows)
                                {
                                    <tr>
                                        <td class="align-middle">@row.SizeName</td>
                                        <td class="align-middle">@row.QtyOrder</td>
                                        <td class="align-middle">@row.QtyRecorded</td>
                                        <td><input type="number" min="0" class="form-control" @bind="row.QtyOk" @bind:after="() => row.QtyOk = Math.Max(0, row.QtyOk)" /></td>
                                        @if (nonBundleShowRejectPrint)
                                        {
                                            <td><input type="number" min="0" class="form-control" @bind="row.QtyRejectPrint" @bind:after="() => row.QtyRejectPrint = Math.Max(0, row.QtyRejectPrint)" /></td>
                                        }
                                        @if (nonBundleShowRejectFabric)
                                        {
                                            <td><input type="number" min="0" class="form-control" @bind="row.QtyRejectFabric" @bind:after="() => row.QtyRejectFabric = Math.Max(0, row.QtyRejectFabric)" /></td>
                                        }
                                        @if (nonBundleShowRejectSewing)
                                        {
                                            <td><input type="number" min="0" class="form-control" @bind="row.QtyRejectSewing" @bind:after="() => row.QtyRejectSewing = Math.Max(0, row.QtyRejectSewing)" /></td>
                                        }
                                        @if (nonBundleShowRejectRework)
                                        {
                                            <td><input type="number" min="0" class="form-control" @bind="row.QtyRejectRework" @bind:after="() => row.QtyRejectRework = Math.Max(0, row.QtyRejectRework)" /></td>
                                        }
                                        @if (nonBundleShowLost)
                                        {
                                            <td><input type="number" min="0" class="form-control" @bind="row.QtyLost" @bind:after="() => row.QtyLost = Math.Max(0, row.QtyLost)" /></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <label class="form-label mt-2">Catatan (berlaku untuk seluruh batch; wajib jika ada reject)</label>
                    <textarea class="form-control" rows="2" @bind="nonBundleRemark"></textarea>

                    @if (!string.IsNullOrEmpty(nonBundleError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@nonBundleError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseNonBundleModal">Batal</button>
                    <button class="btn btn-primary" disabled="@isBusy" @onclick="ConfirmNonBundleSave">Simpan</button>
                </div>
            </div>
        </div>
    </div>
}


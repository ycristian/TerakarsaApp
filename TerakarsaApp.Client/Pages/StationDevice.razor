@page "/station"
@page "/station/{PairingCode}"
@layout TerakarsaApp.Client.Layout.BlankLayout
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Client.Shared
@using TerakarsaApp.Shared.Bundles
@using TerakarsaApp.Shared.Divisions
@using TerakarsaApp.Shared.Employees
@using TerakarsaApp.Shared.Packs
@using TerakarsaApp.Shared.Projects
@using TerakarsaApp.Shared.Resources
@using TerakarsaApp.Shared.Stations
@using TerakarsaApp.Shared.WorkflowLogs
@inject StationDeviceApiService StationApi
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Stasiun</PageTitle>

<div style="font-size: 0.9rem;">

<div class="mb-3">
    <CloseButton />
</div>

@if (isLoadingSetup)
{
    <p class="text-center fs-4 mt-5">Memuat...</p>
}
else if (station is null)
{
    <div class="card mt-5">
        <div class="card-body">
            <h3 class="card-title mb-3">Setup Perangkat Stasiun</h3>
            <p class="text-muted">Masukkan kode pairing 5 karakter yang diberikan admin untuk mengaktifkan perangkat ini.</p>
            <div class="mb-3">
                <input class="form-control form-control-lg text-uppercase" maxlength="5" placeholder="Kode pairing..." @bind="tokenInput" @bind:event="oninput" />
            </div>
            @if (!string.IsNullOrEmpty(setupError))
            {
                <div class="alert alert-danger">@setupError</div>
            }
            <button class="btn btn-primary btn-lg w-100" disabled="@isValidatingToken" @onclick="HandleSetupSubmit">
                @(isValidatingToken ? "Memeriksa..." : "Aktifkan Perangkat")
            </button>
        </div>
    </div>
}
else if (currentOperatorId is null)
{
    <div class="card mb-3">
        <div class="card-body text-center">
            <h3 class="mb-0">@station.StationName</h3>
            <p class="text-muted mb-2">@station.DivisionName</p>
            <button class="btn btn-outline-danger btn-sm" @onclick="() => showLogoutConfirm = true">Keluar</button>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Pilih Operator</h3>
        </div>
        <div class="card-body">
            @if (operators.Count == 0)
            {
                <div class="alert alert-warning mb-0">Belum ada resource aktif untuk divisi ini. Hubungi admin.</div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var op in operators)
                    {
                        <div class="col-6 col-md-4">
                            <button class="btn btn-outline-primary btn-lg w-100 py-4" @onclick="() => SelectOperator(op)">
                                @op.ResourceName
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h4 class="mb-0">@station.StationName <span class="text-muted fs-6">(@station.DivisionName)</span></h4>
                <p class="mb-0 text-muted">
                    Operator: <strong class="text-dark">@currentOperatorName</strong>
                    @if (IsLocked)
                    {
                        <i class="fe fe-lock ms-1" title="Terkunci ke resource bawaan"></i>
                    }
                </p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-sm" @onclick="() => showQrScanner = true">
                    <i class="fe fe-camera"></i> Scan QR
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshLists" disabled="@isLoadingLists">
                    <i class="fe fe-refresh-cw"></i> Refresh
                </button>
                @if (!IsLocked)
                {
                    <button class="btn btn-outline-danger btn-sm" @onclick="ChangeOperator">Ganti Operator</button>
                }
                <button class="btn btn-outline-danger btn-sm" @onclick="() => showLogoutConfirm = true">Keluar</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(qrScanError))
    {
        <div class="alert alert-danger mb-3">@qrScanError</div>
    }

    <div class="row g-2 mb-3">
        <div class="col-4">
            <div class="card bg-primary text-white h-100 border border-3 border-warning shadow-sm" style="cursor: pointer;" @onclick='() => SetTab("masuk")'>
                <div class="card-body py-2 px-3">
                    <div class="small">IN</div>
                    <div class="fs-1 fw-bold lh-1">@counts.MasukCount</div>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card bg-warning text-dark h-100 border border-3 border-warning shadow-sm" style="cursor: pointer;" @onclick='() => SetTab("kerja")'>
                <div class="card-body py-2 px-3">
                    <div class="small">WIP</div>
                    <div class="fs-1 fw-bold lh-1">@counts.DikerjakanCount</div>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card bg-light text-dark h-100 border border-3 border-warning shadow-sm" style="cursor: pointer;" @onclick='() => SetTab("kirim")'>
                <div class="card-body py-2 px-3">
                    <div class="small text-muted">OUT</div>
                    <div class="fs-1 fw-bold lh-1">@counts.DikirimCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "masuk" ? "active" : "")" href="javascript:void(0)" @onclick='() => SetTab("masuk")'>
                        IN <span class="badge bg-primary ms-1">@pendingReceives.Count</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "kerja" ? "active" : "")" href="javascript:void(0)" @onclick='() => SetTab("kerja")'>
                        WIP <span class="badge bg-warning text-dark ms-1">@(inProgress.Count + activeWork.Count)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "kirim" ? "active" : "")" href="javascript:void(0)" @onclick='() => SetTab("kirim")'>
                        OUT <span class="badge bg-secondary ms-1">@outbound.Count</span>
                    </a>
                </li>
                @if (station.EnablePacking)
                {
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == "packing" ? "active" : "")" href="javascript:void(0)" @onclick='() => SetTab("packing")'>
                            Packing
                        </a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "rekap" ? "active" : "")" href="javascript:void(0)" @onclick='() => SetTab("rekap")'>
                        Rekap Produksi
                    </a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            @if (activeTab == "masuk")
            {
                @if (pendingReceives.Count == 0)
                {
                    <p class="text-muted mb-0">Tidak ada kiriman yang menunggu diterima.</p>
                }
                else
                {
                    @foreach (var card in InCards)
                    {
                        @if (card.BundleGroup is { Count: > 0 } bundles)
                        {
                            var first = bundles[0];
                            <div class="card mb-2">
                                <div class="card-body">
                                    <div class="mb-2" style="font-size: 0.85rem;">
                                        <div class="fw-bold">@first.ProjectName <span class="text-muted fw-normal">&middot; @first.BuyerName</span></div>
                                        <div class="text-muted">@(first.NoPo ?? "-") &middot; @first.ArticleName</div>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered border mb-0 align-middle" style="font-size: 0.75rem;">
                                            <tbody>
                                                @foreach (var b in bundles)
                                                {
                                                    <tr>
                                                        <td style="font-size: 0.9rem;">@BundleDisplay.Format(b.BundleLetter, b.BundleNo)</td>
                                                        <td style="font-size: 0.9rem;">@(b.SizeName ?? "-")</td>
                                                        <td>@b.QtyOk</td>
                                                        <td>@b.FromDivisionName</td>
                                                        <td>
                                                            <div class="d-flex gap-1">
                                                                <button class="btn btn-outline-secondary btn-sm py-0 px-1" title="Cetak Ulang" disabled="@isBusy" @onclick="() => OpenReprintBundleModal(b.BundleId, b.Serial)"><i class="fe fe-printer"></i></button>
                                                                <button class="btn btn-outline-secondary btn-sm py-0 px-1" disabled="@isBusy" @onclick="() => OpenReceiveNoteModal(b)">Catatan</button>
                                                                <button class="btn btn-success btn-sm py-0 px-1" disabled="@isBusy" @onclick="() => ReceiveOne(b)">Terima</button>
                                                            </div>
                                                            <span class="text-muted">@FormatDateTime(b.SentAt)</span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (card.NonBundleGroup is { } grp)
                        {
                            <div class="card mb-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="mb-1">@grp.ArticleName <span class="text-muted">(@FormatProject(grp.NoPo, grp.ProjectName))</span></h5>
                                            <p class="text-muted mb-0">@grp.Style @grp.Color</p>
                                        </div>
                                        <span class="badge bg-secondary">@grp.Items.Count ukuran</span>
                                    </div>
                                    <hr class="my-2" />
                                    <p class="mb-2">Step: <strong>@grp.StepName</strong></p>
                                    <ul class="list-group list-group-flush mb-2">
                                        @foreach (var row in grp.Items)
                                        {
                                            <li class="list-group-item px-0 py-1 d-flex justify-content-between">
                                                <span>@row.SizeName</span>
                                                <strong>@row.QtyOk</strong>
                                            </li>
                                        }
                                    </ul>
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <span class="text-muted">
                                            Dari: @grp.FromDivisionName &middot; @grp.GroupTime.ToString("dd/MM HH:mm")
                                            <br />
                                            Diterima oleh: <strong>@ReceiverDisplayName(grp.Items.First())</strong>
                                        </span>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-outline-secondary btn-sm" disabled="@isBusy" @onclick="() => OpenReceiveNoteModalGroup(grp)">Dengan Catatan</button>
                                            <button class="btn btn-success" disabled="@isBusy" @onclick="() => ReceiveGroup(grp)">Terima</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            }
            else if (activeTab == "kerja")
            {
                <div class="mb-3">
                    <input class="form-control" placeholder="Cari project, artikel, step, atau serial" @bind="wipSearchText" @bind:event="oninput" />
                </div>

                @if (FilteredWipCards.Count == 0)
                {
                    <p class="text-muted mb-0">Tidak ada pekerjaan yang cocok.</p>
                }
                else
                {
                    @foreach (var card in FilteredWipCards)
                    {
                        @if (card.NonBundle is { IsBundling: true } bl)
                        {
                            <div class="card mb-2 border-primary">
                                <div class="card-body">
                                    <div class="d-flex align-items-start gap-2 mb-2">
                                        @{ articlePhotoCache.TryGetValue(bl.ArticleId, out var blPhotoSrc); }
                                        @if (blPhotoSrc is not null)
                                        {
                                            <img src="@blPhotoSrc" alt="@bl.ArticleName" style="width: 64px; height: 64px; object-fit: cover; border-radius: 4px; flex-shrink: 0; cursor: pointer;" @onclick="() => OpenPhotoModal(blPhotoSrc)" />
                                        }
                                        <div class="d-flex justify-content-between align-items-start flex-grow-1">
                                            <div>
                                                <h5 class="mb-1">@bl.ArticleName</h5>
                                                <p class="text-muted mb-0">
                                                    @FormatProject(bl.NoPo, bl.ProjectName) &middot; @bl.Style @bl.Color &middot; @(bl.BundleCount ?? 0) bundle &middot; total @(bl.TotalBundleQty ?? 0) dari @(bl.TotalOrderQty ?? 0) &middot; Stock Cutting: @StockCuttingText(bl)
                                                </p>
                                            </div>
                                            <span class="badge bg-primary text-light">Bundling</span>
                                        </div>
                                    </div>
                                    <hr class="my-2" />
                                    <div class="d-flex justify-content-end">
                                        <button class="btn btn-primary" disabled="@isBusy" @onclick="() => OpenBuatBundleModal(bl)">Buat Bundle</button>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (card.NonBundle is { } nb)
                        {
                            <div class="card mb-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="mb-1">@nb.ArticleName</h5>
                                            <p class="text-muted mb-0">
                                                @FormatProject(nb.NoPo, nb.ProjectName) &middot; @nb.Style @nb.Color &middot; Tujuan berikutnya: @(nb.IsLastStep ? "Step terakhir" : (nb.NextDivisionName ?? "-"))
                                            </p>
                                        </div>
                                        <span class="badge bg-info text-light"><i class="fe fe-clipboard"></i> Step: @nb.StepName</span>
                                    </div>
                                    <hr class="my-2" />
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <p class="mb-0 text-muted">
                                            Tercatat <strong>@(nb.Sizes.Sum(s => s.QtyRecorded))</strong> dari @(nb.Sizes.Sum(s => s.QtyOrder)) &middot; input bisa nyicil
                                        </p>
                                        <button class="btn btn-primary" disabled="@isBusy" @onclick="() => OpenNonBundleModal(nb)">Kirim Hasil</button>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (card.BundleGroup is { Count: > 0 } bundles)
                        {
                            var first = bundles[0];
                            <div class="card mb-2 border-warning">
                                <div class="card-body">
                                    <div class="mb-2" style="font-size: 0.85rem;">
                                        <div class="fw-bold">@first.ProjectName <span class="text-muted fw-normal">&middot; @first.BuyerName</span></div>
                                        <div class="text-muted">@(first.NoPo ?? "-") &middot; @first.ArticleName</div>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered border mb-0 align-middle" style="font-size: 0.75rem;">
                                            <tbody>
                                                @foreach (var b in bundles)
                                                {
                                                    <tr>
                                                        <td style="font-size: 0.9rem;">@BundleDisplay.Format(b.BundleLetter, b.BundleNo)</td>
                                                        <td style="font-size: 0.9rem;">@(b.SizeName ?? "-")</td>
                                                        <td>@b.Qty</td>
                                                        <td>@(b.EmployeeName ?? "-")</td>
                                                        <td>
                                                            <div class="d-flex gap-1">
                                                                <button class="btn btn-outline-secondary btn-sm py-0 px-1" title="Cetak Ulang" disabled="@isBusy" @onclick="() => OpenReprintBundleModal(b.BundleId, b.Serial)"><i class="fe fe-printer"></i></button>
                                                                <button class="btn btn-outline-danger btn-sm py-0 px-1" disabled="@isBusy" @onclick="() => OpenBatalTerimaModal(b)">Batal</button>
                                                                <button class="btn btn-success btn-sm py-0 px-1" disabled="@(isBusy || b.NextArticleWorkflowId is null)" @onclick="() => OpenSerahkanModal(b)">Kirim</button>
                                                            </div>
                                                            <span class="text-muted">@FormatDateTime(b.ReceivedAt)</span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            }
            else if (activeTab == "kirim")
            {
                @if (outbound.Count == 0)
                {
                    <p class="text-muted mb-0">Belum ada data yang dikirim hari ini.</p>
                }
                else
                {
                    @foreach (var card in OutCards)
                    {
                        @if (card.BundleGroup is { Count: > 0 } bundles)
                        {
                            var first = bundles[0];
                            <div class="card mb-2">
                                <div class="card-body">
                                    <div class="mb-2" style="font-size: 0.85rem;">
                                        <div class="fw-bold">@first.ProjectName <span class="text-muted fw-normal">&middot; @first.BuyerName</span></div>
                                        <div class="text-muted">@(first.NoPo ?? "-") &middot; @first.ArticleName</div>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered border mb-0 align-middle" style="font-size: 0.75rem;">
                                            <tbody>
                                                @foreach (var b in bundles)
                                                {
                                                    <tr>
                                                        <td style="font-size: 0.9rem;">@BundleDisplay.Format(b.BundleLetter, b.BundleNo)</td>
                                                        <td style="font-size: 0.9rem;">@(b.SizeName ?? "-")</td>
                                                        <td>@b.QtyOk</td>
                                                        <td>
                                                            @{ var rejectLines = RejectLines(b); }
                                                            @if (rejectLines.Count == 0)
                                                            {
                                                                <text>-</text>
                                                            }
                                                            else
                                                            {
                                                                @foreach (var line in rejectLines)
                                                                {
                                                                    <div class="text-danger">@line</div>
                                                                }
                                                            }
                                                        </td>
                                                        <td>
                                                            <div class="d-flex gap-1">
                                                                @if (b.BundleId is not null)
                                                                {
                                                                    <button class="btn btn-outline-secondary btn-sm py-0 px-1" title="Cetak Ulang" disabled="@isBusy" @onclick="() => OpenReprintBundleModal(b.BundleId, b.Serial)"><i class="fe fe-printer"></i></button>
                                                                }
                                                                @if (b.IsBundling && b.ReceivedAt is null)
                                                                {
                                                                    <button class="btn btn-outline-primary btn-sm py-0 px-1" disabled="@isBusy" @onclick="() => OpenEditBundleModal(b)">Edit</button>
                                                                    <button class="btn btn-outline-danger btn-sm py-0 px-1" disabled="@isBusy" @onclick="() => OpenDeleteBundleModal(b)">Hapus</button>
                                                                }
                                                                else if (b.IsBundling)
                                                                {
                                                                    <button class="btn btn-outline-primary btn-sm py-0 px-1" disabled="@(isBusy || !CanEditOrDeleteBundle(b))" @onclick="() => OpenEditBundleModal(b)">Edit</button>
                                                                    <button class="btn btn-outline-danger btn-sm py-0 px-1" disabled="@(isBusy || !CanEditOrDeleteBundle(b))" @onclick="() => OpenDeleteBundleModal(b)">Hapus</button>
                                                                }
                                                                else if (b.ReceivedAt is null)
                                                                {
                                                                    <button class="btn btn-outline-primary btn-sm py-0 px-1" disabled="@isBusy" @onclick="() => OpenReviseModal(b)">Revisi</button>
                                                                    <button class="btn btn-outline-danger btn-sm py-0 px-1" disabled="@isBusy" @onclick="() => OpenBatalSerahModal(b)">Batal</button>
                                                                }
                                                            </div>
                                                            <div class="text-muted" style="font-size: 0.65rem;">
                                                                Krm @FormatDateTime(b.CreatedAt)
                                                                @if (b.ReceivedAt is not null)
                                                                {
                                                                    <br />
                                                                    <text>Trm @FormatDateTime(b.ReceivedAt.Value)</text>
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (card.NonBundleGroup is { } grp)
                        {
                            <div class="card mb-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="mb-1">@grp.ArticleName <span class="text-muted">(@FormatProject(grp.NoPo, grp.ProjectName))</span></h5>
                                            <p class="text-muted mb-0">@grp.Style @grp.Color</p>
                                        </div>
                                        <span class="badge bg-secondary">@grp.Items.Count ukuran</span>
                                    </div>
                                    <hr class="my-2" />
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                        <div class="flex-grow-1">
                                            <p class="mb-1">
                                                Step: <strong>@grp.StepName</strong>
                                                @if (grp.UpdatedAt is not null)
                                                {
                                                    <span class="badge bg-info ms-1">Direvisi @grp.UpdatedAt.Value.ToString("dd/MM HH:mm")</span>
                                                }
                                            </p>
                                            <ul class="list-group list-group-flush mb-2">
                                                @foreach (var row in grp.Items)
                                                {
                                                    <li class="list-group-item px-0 py-1">
                                                        <div class="d-flex justify-content-between">
                                                            <span>@row.SizeName</span>
                                                            <strong>Qty OK: @row.QtyOk</strong>
                                                        </div>
                                                        @foreach (var line in RejectLines(row))
                                                        {
                                                            <div class="text-danger small">@line</div>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                            <div class="text-muted">
                                                @(grp.IsLastStep ? "step terakhir — selesai" : (grp.ReceivedAt is not null ? $"sudah diterima {grp.TargetDivisionName}" : $"menunggu diterima {grp.TargetDivisionName}"))
                                                &middot; @grp.GroupTime.ToString("dd/MM HH:mm")
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2">
                                            @if (grp.IsLastStep || grp.ReceivedAt is null)
                                            {
                                                <button class="btn btn-outline-primary btn-sm" disabled="@isBusy" @onclick="() => OpenReviseGroupModal(grp)">Revisi</button>
                                                <button class="btn btn-outline-danger btn-sm" disabled="@isBusy" @onclick="() => OpenBatalSerahGroupModal(grp)">Batal Serah</button>
                                            }
                                        </div>
                                    </div>
                                    <div class="text-muted small mt-2 mb-0">
                                        @if (grp.IsLastStep)
                                        {
                                            <text>Step terakhir — masih bisa direvisi/dibatalkan sampai H+1 (hari dibuat + 1 hari).</text>
                                        }
                                        else if (grp.ReceivedAt is not null)
                                        {
                                            <text>Sudah diterima @grp.TargetDivisionName — riwayat kiriman hari ini, tidak bisa direvisi/dibatalkan lagi.</text>
                                        }
                                        else
                                        {
                                            <text>Bisa direvisi/dibatalkan selama divisi tujuan belum menekan Terima.</text>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            }
            else if (activeTab == "packing")
            {
                <div class="mb-3" style="max-width: 420px;">
                    <label class="form-label">Project</label>
                    <SearchableSelect TItem="ProjectDto" Items="packingProjects" Value="packingProjectId" ValueChanged="HandlePackingProjectChanged"
                                      IdSelector="@(p => p.Id)" TextSelector="@(p => p.ProjectName)"
                                      Placeholder="Cari project..." />
                </div>

                @if (packingProjectId <= 0)
                {
                    <p class="text-muted mb-0">Pilih project untuk melihat stok siap pack.</p>
                }
                else if (isLoadingPacking)
                {
                    <p class="text-muted mb-0">Memuat...</p>
                }
                else
                {
                    <ul class="nav nav-pills mb-3 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link @(packingSubTab == "stock" ? "active" : "")" href="javascript:void(0)" @onclick='() => packingSubTab = "stock"'>Stok Siap Pack</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(packingSubTab == "packs" ? "active" : "")" href="javascript:void(0)" @onclick='() => packingSubTab = "packs"'>
                                Karung <span class="badge bg-secondary ms-1">@packingData.Packs.Count</span>
                            </a>
                        </li>
                        <li class="nav-item ms-auto">
                            <button class="btn btn-primary btn-sm" disabled="@isBusy" @onclick="OpenCreatePackModal">+ Buat Karung</button>
                        </li>
                    </ul>

                    @if (packingSubTab == "stock")
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered border mb-0">
                                <thead>
                                    <tr>
                                        <th>Artikel</th>
                                        <th>Ukuran</th>
                                        <th>Selesai</th>
                                        <th>Sudah Dipack</th>
                                        <th>Tersedia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in packingStock)
                                    {
                                        <tr>
                                            <td>@row.ArticleName <span class="text-muted">@row.Style @row.Color</span></td>
                                            <td>@row.SizeName</td>
                                            <td>@row.QtyDone</td>
                                            <td>@row.QtyPacked</td>
                                            <td class="@(row.QtyAvailable > 0 ? "fw-bold" : "")">@row.QtyAvailable</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        @if (packingData.Packs.Count == 0)
                        {
                            <p class="text-muted mb-0">Belum ada karung untuk project ini.</p>
                        }
                        else
                        {
                            @foreach (var pack in packingData.Packs)
                            {
                                <div class="card mb-2" @key="pack.Id">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h4 class="mb-0">Karung No. @pack.PackNo</h4>
                                                <p class="text-muted mb-0">@pack.Serial &middot; @pack.ArticleCount artikel &middot; Label: @(pack.LabelStatus ?? "-")</p>
                                            </div>
                                            <span class="badge @(pack.IsConfirmed ? "bg-success" : "bg-warning text-dark")">@(pack.IsConfirmed ? "AKTUAL" : "PLAN")</span>
                                        </div>
                                        <ul class="list-group list-group-flush mb-2">
                                            @foreach (var item in packingData.Items.Where(i => i.PackId == pack.Id))
                                            {
                                                <li class="list-group-item px-0 py-1 d-flex justify-content-between">
                                                    <span>@item.ArticleName @item.Style @item.Color &middot; @item.SizeName</span>
                                                    <strong>@item.QtyPlan@(item.QtyActual is not null ? $" (aktual {item.QtyActual})" : "")</strong>
                                                </li>
                                            }
                                        </ul>
                                        <p class="text-muted mb-2">Total plan: @pack.TotalPlan &middot; Total aktual: @pack.TotalActual</p>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <button class="btn btn-success btn-sm" disabled="@isBusy" @onclick="() => OpenConfirmPackModal(pack)">@(pack.IsConfirmed ? "Edit Aktual" : "Konfirmasi")</button>
                                            @if (!pack.IsConfirmed)
                                            {
                                                <button class="btn btn-outline-primary btn-sm" disabled="@isBusy" @onclick="() => OpenEditPlanModal(pack)">Edit Planning</button>
                                            }
                                            <button class="btn btn-outline-secondary btn-sm" disabled="@isBusy" @onclick="() => OpenReprintPackModal(pack.Id, pack.Serial)">Cetak Ulang</button>
                                            <button class="btn btn-outline-danger btn-sm" disabled="@isBusy" @onclick="() => OpenDeletePackModal(pack)">Hapus</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                }

                @if (!string.IsNullOrEmpty(packingError))
                {
                    <div class="alert alert-danger mt-3 mb-0">@packingError</div>
                }
                @if (!string.IsNullOrEmpty(packingFeedback))
                {
                    <div class="alert alert-success mt-3 mb-0">@packingFeedback</div>
                }
            }
            else if (activeTab == "rekap")
            {
                <div class="row g-2 align-items-end mb-2" style="max-width: 960px;">
                    <div class="col-6 col-md-3">
                        <label class="form-label">Divisi</label>
                        <SearchableSelect TItem="DivisionDto" Items="rekapDivisions" Value="rekapDivisionId" ValueChanged="HandleRekapDivisionChanged"
                                          IdSelector="@(d => d.Id)" TextSelector="@(d => d.DivisionName)"
                                          Placeholder="Cari divisi..." />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">Resource</label>
                        @if (IsLocked)
                        {
                            <input type="text" class="form-control" value="@currentOperatorName" disabled />
                        }
                        else
                        {
                            <SearchableSelect TItem="ResourceLookupDto" Items="rekapResourceOptions" Value="rekapResourceId" ValueChanged="HandleRekapResourceChanged"
                                              IdSelector="@(r => r.Id)" TextSelector="@(r => r.ResourceName)"
                                              Disabled="@(rekapDivisionId <= 0)"
                                              Placeholder="Cari resource..." />
                        }
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">Penjahit</label>
                        <SearchableSelect TItem="EmployeeLookupDto" Items="rekapEmployeeOptions" @bind-Value="rekapEmployeeId"
                                          IdSelector="@(e => e.Id)" TextSelector="@(e => BundleDisplay.FormatEmployeeOption(e.EmployeeCode, e.EmployeeName))"
                                          Disabled="@(rekapResourceId <= 0)"
                                          Placeholder="Cari penjahit..." />
                    </div>
                    <div class="col-6 col-md-3 d-flex gap-2">
                        <button type="button" class="btn btn-primary flex-fill" disabled="@(rekapDivisionId <= 0)" @onclick="OpenRekapStrukModal">Print Rekap</button>
                        <button type="button" class="btn btn-outline-primary flex-fill" disabled="@(rekapDivisionId <= 0 || isBusy)" @onclick="PrintRekapWip">Cetak WIP</button>
                    </div>
                </div>
                <p class="text-muted mb-0">
                    @if (IsLocked)
                    {
                        <text>Resource terkunci ke operator sesi ini (@currentOperatorName). Pilih Penjahit (opsional) untuk mempersempit level rekap.</text>
                    }
                    else
                    {
                        <text>Pilih Divisi (wajib), lalu Resource dan Penjahit (opsional) untuk mempersempit level rekap -- level rekap mengikuti pilihan terdalam yang diisi.</text>
                    }
                </p>
            }

            @if (!string.IsNullOrEmpty(actionError))
            {
                <div class="alert alert-danger mt-3 mb-0">@actionError</div>
            }
            @if (!string.IsNullOrEmpty(reprintFeedback))
            {
                <div class="alert alert-success mt-3 mb-0">@reprintFeedback</div>
            }
        </div>
    </div>
}

</div>

@if (showRekapStrukModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Rekap Produksi</h5>
                    <button type="button" class="btn-close" @onclick="CloseRekapStrukModal"></button>
                </div>
                <div class="modal-body">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="rekapUseTime"
                               checked="@rekapUseTime" @onchange="HandleRekapUseTimeChanged" />
                        <label class="form-check-label" for="rekapUseTime">Use Time</label>
                    </div>
                    @if (rekapUseTime)
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label">Waktu Mulai</label>
                                <input type="datetime-local" class="form-control"
                                       value="@rekapStartDateTime.ToString("yyyy-MM-ddTHH:mm")" @onchange="HandleRekapStartChanged" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Waktu Selesai</label>
                                <input type="datetime-local" class="form-control"
                                       value="@rekapEndDateTime.ToString("yyyy-MM-ddTHH:mm")" @onchange="HandleRekapEndChanged" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-8 col-md-6">
                                <label class="form-label">Tanggal</label>
                                <input type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       value="@rekapDate.ToString("yyyy-MM-dd")" @onchange="HandleRekapDateChanged" />
                            </div>
                        </div>
                    }

                    @if (isLoadingRekap)
                    {
                        <p class="text-muted mb-0">Memuat...</p>
                    }
                    else if (rekapResult?.Header is null)
                    {
                        <p class="text-muted mb-0">Data tidak ditemukan.</p>
                    }
                    else
                    {
                        var h = rekapResult.Header;
                        <p class="mb-2">
                            <strong>@h.DivisionName</strong>
                            @if (!string.IsNullOrEmpty(h.ResourceName))
                            {
                                <text> &middot; @h.ResourceName</text>
                            }
                            @if (!string.IsNullOrEmpty(h.EmployeeName))
                            {
                                <text> &middot; @h.EmployeeName</text>
                            }
                        </p>
                        <p class="text-muted mb-3">
                            Waktu: <strong>@h.PeriodStart.ToString("dd/MM/yyyy HH:mm") - @h.PeriodEnd.ToString(h.PeriodStart.Date == h.PeriodEnd.Date ? "HH:mm" : "dd/MM/yyyy HH:mm")</strong>
                        </p>
                        <div class="border rounded p-3 text-center">
                            <div class="text-muted small">Total pcs periode ini</div>
                            <div class="fs-2 fw-bold">@h.TotalQty</div>
                            @if (h.TotalQty == 0)
                            {
                                <div class="text-warning small mt-1">Tidak ada data produksi di resource &amp; periode ini.</div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(rekapError))
                    {
                        <div class="alert alert-danger mt-3 mb-0">@rekapError</div>
                    }
                    @if (!string.IsNullOrEmpty(rekapPrintFeedback))
                    {
                        <div class="alert alert-success mt-3 mb-0">@rekapPrintFeedback</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseRekapStrukModal">Tutup</button>
                    <button class="btn btn-primary" disabled="@(isBusy || rekapResult?.Header is null)" @onclick="ConfirmPrintRekapStruk">Cetak Struk</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showReceiveNoteModal && (receiveNoteTarget is not null || receiveNoteGroupTarget is not null))

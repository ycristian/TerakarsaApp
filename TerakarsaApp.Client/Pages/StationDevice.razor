    // Prompt 55: pesan SP berprefix 'LOCKED|' -- tampilkan bagian setelah '|' saja (prefix itu
    // penanda untuk client, bukan untuk operator). Pemanggil selalu memuat ulang daftar setelah
    // menerimanya karena datanya sudah basi.
    private static string StripLockedPrefix(string error)
    {
        const string prefix = "LOCKED|";
        var idx = error.IndexOf(prefix, StringComparison.Ordinal);
        return idx >= 0 ? error[(idx + prefix.Length)..].Trim() : error;
    }


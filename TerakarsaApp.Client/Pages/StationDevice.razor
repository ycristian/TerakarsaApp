    // dipakai baris lain pada form yang sedang diedit (belum tersimpan), supaya operator
    // tidak input dobel melebihi stok nyata sebelum submit.
    private int AvailableForPlanRow(PackFormRow currentRow, PackStockAvailableDto size)
    {
        var reservedByOtherRows = packFormRows
            .Where(r => r != currentRow && r.ArticleId == size.ArticleId && r.ArticleSizeId == size.ArticleSizeId)
            .Sum(r => r.QtyPlan);
        return size.QtyAvailable - reservedByOtherRows;
    }


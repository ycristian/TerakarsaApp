    private async Task ConfirmNonBundleSave()
    {
        if (nonBundleTarget is null || currentOperatorId is null) return;

        var entries = nonBundleRows
            .Where(r => r.QtyOk != 0 || r.QtyRejectPrint != 0 || r.QtyRejectFabric != 0 || r.QtyRejectRework != 0 || r.QtyRejectSewing != 0 || r.QtyLost != 0)
            .Select(r => new StationNonBundleBatchEntryRequest
            {
                ArticleSizeId = r.ArticleSizeId,
                QtyOk = r.QtyOk,
                QtyRejectPrint = r.QtyRejectPrint,
                QtyRejectFabric = r.QtyRejectFabric,
                QtyRejectSewing = r.QtyRejectSewing,
                QtyRejectRework = r.QtyRejectRework,
                QtyLost = r.QtyLost
            }).ToList();

        if (entries.Count == 0)
        {
            nonBundleError = "Isi minimal satu ukuran dengan qty lebih dari 0.";
            return;
        }

        if (entries.Any(e => e.QtyRejectPrint + e.QtyRejectFabric + e.QtyRejectSewing + e.QtyRejectRework + e.QtyLost > 0) && string.IsNullOrWhiteSpace(nonBundleRemark))
        {
            nonBundleError = "Catatan wajib diisi jika ada reject.";
            return;
        }

        isBusy = true;
        nonBundleError = string.Empty;

        var (success, error, failedSizeId) = await StationApi.CreateNonBundleLogBatchAsync(new StationNonBundleBatchCreateRequest
        {
            ArticleWorkflowId = nonBundleTarget.ArticleWorkflowId,
            ResourceId = currentOperatorId.Value,
            Remark = string.IsNullOrWhiteSpace(nonBundleRemark) ? null : nonBundleRemark,
            Entries = entries
        });

        isBusy = false;

        if (!success)
        {
            var sizeName = failedSizeId is int sizeId
                ? nonBundleRows.FirstOrDefault(r => r.ArticleSizeId == sizeId)?.SizeName
                : null;
            nonBundleError = sizeName is null ? error : $"Ukuran {sizeName}: {error}";
            return;
        }

        CloseNonBundleModal();
        await RefreshLists();
    }


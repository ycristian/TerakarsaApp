    // beda hanya di detik tetap dianggap satu batch) digabung jadi 1 kartu; aksi (Terima/
    // Revisi/Batal Serah) berlaku ke semua baris ukuran sekaligus. Baris bundle (BundleId
    // terisi) TIDAK digabung -- tetap 1 kartu per bundle seperti sebelumnya.
    private static DateTime TruncateToMinute(DateTime dt) => new(dt.Year, dt.Month, dt.Day, dt.Hour, dt.Minute, 0, dt.Kind);

    private class InCard
    {
        public DateTime SortTime;
        // Kartu bundle dikelompokkan per artikel jadi satu tabel (bukan satu kartu per

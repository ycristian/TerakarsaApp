@page "/station"
@layout TerakarsaApp.Client.Layout.BlankLayout
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Shared.Bundles
@using TerakarsaApp.Shared.Resources
@using TerakarsaApp.Shared.Stations
@using TerakarsaApp.Shared.WorkflowLogs
@inject StationDeviceApiService StationApi
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Stasiun</PageTitle>

<div style="font-size: 1.1rem;">

@if (isLoadingSetup)
{
    <p class="text-center fs-4 mt-5">Memuat...</p>
}
else if (station is null)
{
    <div class="card mt-5">
        <div class="card-body">
            <h3 class="card-title mb-3">Setup Perangkat Stasiun</h3>
            <p class="text-muted">Tempelkan token stasiun yang diberikan admin untuk mengaktifkan perangkat ini.</p>
            <div class="mb-3">
                <input class="form-control form-control-lg" placeholder="Token stasiun..." @bind="tokenInput" @bind:event="oninput" />
            </div>
            @if (!string.IsNullOrEmpty(setupError))
            {
                <div class="alert alert-danger">@setupError</div>
            }
            <button class="btn btn-primary btn-lg w-100" disabled="@isValidatingToken" @onclick="HandleSetupSubmit">
                @(isValidatingToken ? "Memeriksa..." : "Aktifkan Perangkat")
            </button>
        </div>
    </div>
}
else if (currentOperatorId is null)
{
    <div class="card mb-3">
        <div class="card-body text-center">
            <h3 class="mb-0">@station.StationName</h3>
            <p class="text-muted mb-2">@station.DivisionName</p>
            <button class="btn btn-outline-danger btn-sm" @onclick="ReleaseToken">Lepas Token</button>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Pilih Operator</h3>
        </div>
        <div class="card-body">
            @if (operators.Count == 0)
            {
                <div class="alert alert-warning mb-0">Belum ada resource aktif untuk divisi ini. Hubungi admin.</div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var op in operators)
                    {
                        <div class="col-6 col-md-4">
                            <button class="btn btn-outline-primary btn-lg w-100 py-4" @onclick="() => SelectOperator(op)">
                                @op.ResourceName
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h4 class="mb-0">@station.StationName <span class="text-muted fs-6">(@station.DivisionName)</span></h4>
                <p class="mb-0 text-muted">Operator: <strong class="text-dark">@currentOperatorName</strong></p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshLists" disabled="@isLoadingLists">
                    <i class="fe fe-refresh-cw"></i> Refresh
                </button>
                <button class="btn btn-outline-danger btn-sm" @onclick="ChangeOperator">Ganti Operator</button>
                <button class="btn btn-outline-danger btn-sm" @onclick="ReleaseToken">Lepas Token</button>
            </div>
        </div>
    </div>

    <button class="btn btn-primary btn-lg w-100 mb-3" @onclick="OpenScanPanel">
        <i class="fe fe-camera"></i> Scan Bundle
    </button>

    @if (isScanPanelOpen)
    {
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">Scan Bundle</h3>
                <div class="card-actions">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CloseScanPanel">Tutup</button>
                </div>
            </div>
            <div class="card-body">
                @if (scanResult is null)
                {
                    <div id="bundleScanReader" style="width:100%; max-width:400px; margin:0 auto;"></div>
                    <div class="input-group mt-3">
                        <input class="form-control form-control-lg" placeholder="Ketik/scan serial (mis. B26-000010)..."
                               @bind="scanTextInput" @bind:event="oninput"
                               @onkeyup='e => { if (e.Key == "Enter") { _ = SubmitTextScan(); } }' />
                        <button class="btn btn-primary" disabled="@isScanning" @onclick="SubmitTextScan">Cari</button>
                    </div>
                    @if (!string.IsNullOrEmpty(scanError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@scanError</div>
                    }
                }
                else
                {
                    <BundleScanCard Info="scanResult" Busy="scanActionBusy" ActionError="@scanActionError"
                                    OnReceive="HandleScanReceive" OnComplete="HandleScanComplete" OnEdit="HandleScanEdit" />
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-outline-primary flex-grow-1" disabled="@isScanning" @onclick="RefreshScanResult">
                            <i class="fe fe-refresh-cw"></i> Refresh
                        </button>
                        <button class="btn btn-outline-secondary flex-grow-1" @onclick="RescanAsync">Scan Bundle Lain</button>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
    <div class="card">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "pending" ? "active" : "")" href="javascript:void(0)" @onclick='() => SetTab("pending")'>
                        Menunggu Diterima <span class="badge bg-primary ms-1">@pendingReceives.Count</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "handover" ? "active" : "")" href="javascript:void(0)" @onclick='() => SetTab("handover")'>
                        Menunggu Diserahkan <span class="badge bg-primary ms-1">@pendingHandover.Count</span>
                    </a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            @if (activeTab == "pending")
            {
                @if (pendingReceives.Count == 0)
                {
                    <p class="text-muted mb-0">Tidak ada kiriman yang menunggu diterima.</p>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="selectAllPending" @onchange="ToggleSelectAllPending" checked="@(selectedPendingIds.Count > 0 && selectedPendingIds.Count == pendingReceives.Count)" />
                            <label class="form-check-label" for="selectAllPending">Pilih Semua</label>
                        </div>
                        <button class="btn btn-success" disabled="@(selectedPendingIds.Count == 0 || isBusy)" @onclick="ReceiveSelected">
                            Terima Terpilih (@selectedPendingIds.Count)
                        </button>
                    </div>

                    @foreach (var item in pendingReceives)
                    {
                        <div class="card mb-2">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-start gap-2">
                                        <input class="form-check-input mt-1" type="checkbox" style="width: 1.4em; height: 1.4em;"
                                               checked="@selectedPendingIds.Contains(item.WorkflowLogId)"
                                               @onchange="e => TogglePendingSelect(item, e.Value)" />
                                        <div>
                                            <h5 class="mb-1">@item.ArticleName <span class="text-muted">(@item.ProjectName)</span></h5>
                                            <p class="text-muted mb-0">@item.Style @item.Color</p>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        @if (item.BundleId is not null)
                                        {
                                            <span class="badge bg-dark d-block mb-1">No. @item.BundleNo &middot; @item.Serial</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.SizeName))
                                        {
                                            <span class="badge bg-secondary">@item.SizeName</span>
                                        }
                                    </div>
                                </div>
                                <hr class="my-2" />
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <p class="mb-0">
                                        Step: <strong>@item.StepName</strong> &middot; Qty kirim: <strong>@item.QtyOk</strong><br />
                                        <span class="text-muted">Dari: @item.FromDivisionName &middot; @item.SentAt.ToString("dd/MM HH:mm")</span>
                                    </p>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-outline-secondary btn-sm" disabled="@isBusy" @onclick="() => OpenReceiveNoteModal(item)">Dengan Catatan</button>
                                        <button class="btn btn-success" disabled="@isBusy" @onclick="() => ReceiveOne(item)">Terima</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                @if (pendingHandover.Count == 0)
                {
                    <p class="text-muted mb-0">Tidak ada data yang menunggu diserahkan.</p>
                }
                else
                {
                    @foreach (var item in pendingHandover)
                    {
                        <div class="card mb-2">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h5 class="mb-1">@item.ArticleName <span class="text-muted">(@item.ProjectName)</span></h5>
                                        <p class="text-muted mb-0">@item.Style @item.Color</p>
                                    </div>
                                    <div class="text-end">
                                        @if (item.BundleId is not null)
                                        {
                                            <span class="badge bg-dark d-block mb-1">No. @item.BundleNo &middot; @item.Serial</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.SizeName))
                                        {
                                            <span class="badge bg-secondary">@item.SizeName</span>
                                        }
                                    </div>
                                </div>
                                <hr class="my-2" />
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <p class="mb-0">
                                        Step: <strong>@item.StepName</strong>
                                        @if (!string.IsNullOrEmpty(item.ResourceName))
                                        {
                                            <text> &middot; Oleh: <strong>@item.ResourceName</strong></text>
                                        }
                                        &middot; Qty OK: <strong>@item.QtyOk</strong>
                                        @{
                                            var rejectSummary = RejectSummary(item);
                                        }
                                        @if (!string.IsNullOrEmpty(rejectSummary))
                                        {
                                            <text> &middot; <span class="text-danger">@rejectSummary</span></text>
                                        }
                                        <br />
                                        <span class="text-muted">Tujuan: @item.TargetDivisionName &middot; @item.CreatedAt.ToString("dd/MM HH:mm")</span>
                                    </p>
                                    <button class="btn btn-outline-primary" disabled="@isBusy" @onclick="() => OpenEditHandoverModal(item)">Edit</button>
                                </div>
                            </div>
                        </div>
                    }
                }
            }

            @if (!string.IsNullOrEmpty(actionError))
            {
                <div class="alert alert-danger mt-3 mb-0">@actionError</div>
            }
        </div>
    </div>
    }
}

</div>

@if (showReceiveNoteModal && receiveNoteTarget is not null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" @onclick="CloseReceiveNoteModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Terima dengan Catatan</h5>
                    <button type="button" class="btn-close" @onclick="CloseReceiveNoteModal"></button>
                </div>
                <div class="modal-body">
                    <p><strong>@receiveNoteTarget.ArticleName</strong> &middot; @receiveNoteTarget.StepName</p>
                    <label class="form-label">Catatan (wajib)</label>
                    <textarea class="form-control" rows="3" @bind="receiveNoteText"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseReceiveNoteModal">Batal</button>
                    <button class="btn btn-success" disabled="@(string.IsNullOrWhiteSpace(receiveNoteText) || isBusy)" @onclick="ConfirmReceiveWithNote">Terima</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showEditHandoverModal && editHandoverTarget is not null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" @onclick="CloseEditHandoverModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Revisi Data</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditHandoverModal"></button>
                </div>
                <div class="modal-body">
                    <p><strong>@editHandoverTarget.ArticleName</strong> &middot; @editHandoverTarget.StepName</p>

                    @if (editHandoverTarget.BundleId is null)
                    {
                        <div class="mb-2">
                            <label class="form-label">Size</label>
                            <select class="form-select form-select-lg" @bind="editArticleSizeId">
                                <option value="0">-- Pilih Size --</option>
                                @foreach (var s in editHandoverTarget.Sizes)
                                {
                                    <option value="@s.Id">@s.SizeName</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label">Qty OK</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="editQtyOk" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Print</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="editQtyRejectPrint" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Bahan</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="editQtyRejectFabric" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Jahit</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="editQtyRejectSewing" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Rework</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="editQtyRework" />
                        </div>
                    </div>

                    <label class="form-label">Catatan (opsional)</label>
                    <textarea class="form-control" rows="2" @bind="editRemark"></textarea>

                    @if (!string.IsNullOrEmpty(editError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@editError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseEditHandoverModal">Batal</button>
                    <button class="btn btn-primary" disabled="@isBusy" @onclick="ConfirmEditHandover">Simpan</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string TokenKey = "stationToken";
    private const string OperatorIdKey = "stationOperatorId";
    private const string OperatorNameKey = "stationOperatorName";

    private bool isLoadingSetup = true;
    private StationMeDto? station;
    private string tokenInput = string.Empty;
    private string setupError = string.Empty;
    private bool isValidatingToken = false;

    private List<ResourceLookupDto> operators = new();
    private int? currentOperatorId;
    private string? currentOperatorName;

    private string activeTab = "pending";
    private List<StationPendingReceiveDto> pendingReceives = new();
    private List<StationPendingHandoverDto> pendingHandover = new();
    private bool isLoadingLists = false;
    private bool isBusy = false;
    private string actionError = string.Empty;

    private HashSet<int> selectedPendingIds = new();

    private bool showReceiveNoteModal = false;
    private StationPendingReceiveDto? receiveNoteTarget;
    private string receiveNoteText = string.Empty;

    private bool showEditHandoverModal = false;
    private StationPendingHandoverDto? editHandoverTarget;
    private int editQtyOk;
    private int editQtyRejectPrint;
    private int editQtyRejectFabric;
    private int editQtyRejectSewing;
    private int editQtyRework;
    private int editArticleSizeId;
    private string editRemark = string.Empty;
    private string editError = string.Empty;

    private System.Threading.Timer? pollTimer;

    private bool isScanPanelOpen = false;
    private bool isCameraActive = false;
    private string scanTextInput = string.Empty;
    private bool isScanning = false;
    private string scanError = string.Empty;
    private BundleScanInfoDto? scanResult;
    private bool scanActionBusy = false;
    private string scanActionError = string.Empty;
    private string? lastScannedSerial;
    private DotNetObjectReference<StationDevice>? scannerRef;

    protected override async Task OnInitializedAsync()
    {
        isLoadingSetup = true;

        var existingToken = await JS.InvokeAsync<string?>("localStorage.getItem", TokenKey);
        if (!string.IsNullOrWhiteSpace(existingToken))
        {
            station = await StationApi.GetMeAsync();
            if (station is null)
                await JS.InvokeVoidAsync("localStorage.removeItem", TokenKey);
        }

        isLoadingSetup = false;

        if (station is not null)
            await LoadOperatorSessionAsync();
    }

    private async Task HandleSetupSubmit()
    {
        if (string.IsNullOrWhiteSpace(tokenInput))
        {
            setupError = "Token wajib diisi.";
            return;
        }

        isValidatingToken = true;
        setupError = string.Empty;
        await JS.InvokeVoidAsync("localStorage.setItem", TokenKey, tokenInput.Trim());

        station = await StationApi.GetMeAsync();
        isValidatingToken = false;

        if (station is null)
        {
            setupError = "Token tidak valid atau perangkat nonaktif.";
            await JS.InvokeVoidAsync("localStorage.removeItem", TokenKey);
            return;
        }

        tokenInput = string.Empty;
        await LoadOperatorSessionAsync();
    }

    private async Task LoadOperatorSessionAsync()
    {
        operators = await StationApi.GetResourcesAsync();

        var savedId = await JS.InvokeAsync<string?>("localStorage.getItem", OperatorIdKey);
        if (int.TryParse(savedId, out var id) && operators.Any(o => o.Id == id))
        {
            currentOperatorId = id;
            currentOperatorName = operators.First(o => o.Id == id).ResourceName;
            await StartSessionAsync();
        }
    }

    private async Task SelectOperator(ResourceLookupDto op)
    {
        currentOperatorId = op.Id;
        currentOperatorName = op.ResourceName;
        await JS.InvokeVoidAsync("localStorage.setItem", OperatorIdKey, op.Id.ToString());
        await JS.InvokeVoidAsync("localStorage.setItem", OperatorNameKey, op.ResourceName);
        await StartSessionAsync();
    }

    private async Task ChangeOperator()
    {
        StopPolling();
        currentOperatorId = null;
        currentOperatorName = null;
        selectedPendingIds.Clear();
        await JS.InvokeVoidAsync("localStorage.removeItem", OperatorIdKey);
        await JS.InvokeVoidAsync("localStorage.removeItem", OperatorNameKey);
    }

    private async Task ReleaseToken()
    {
        StopPolling();
        await StopCameraAsync();

        await JS.InvokeVoidAsync("localStorage.removeItem", TokenKey);
        await JS.InvokeVoidAsync("localStorage.removeItem", OperatorIdKey);
        await JS.InvokeVoidAsync("localStorage.removeItem", OperatorNameKey);

        station = null;
        currentOperatorId = null;
        currentOperatorName = null;
        selectedPendingIds.Clear();
        isScanPanelOpen = false;
        scanResult = null;
        tokenInput = string.Empty;
        setupError = string.Empty;
    }

    private async Task StartSessionAsync()
    {
        await RefreshLists();
        StartPolling();
    }

    private void StartPolling()
    {
        pollTimer?.Dispose();
        pollTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshLists();
                StateHasChanged();
            });
        }, null, 15000, 15000);
    }

    private void StopPolling()
    {
        pollTimer?.Dispose();
        pollTimer = null;
    }

    private async Task RefreshLists()
    {
        isLoadingLists = true;
        pendingReceives = await StationApi.GetPendingReceivesAsync();
        pendingHandover = await StationApi.GetPendingHandoverAsync();
        selectedPendingIds.RemoveWhere(id => pendingReceives.All(p => p.WorkflowLogId != id));
        isLoadingLists = false;
        StateHasChanged();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private static string RejectSummary(StationPendingHandoverDto item)
    {
        var parts = new List<string>();
        if (item.QtyRejectPrint > 0) parts.Add($"Reject Print: {item.QtyRejectPrint}");
        if (item.QtyRejectFabric > 0) parts.Add($"Reject Bahan: {item.QtyRejectFabric}");
        if (item.QtyRejectSewing > 0) parts.Add($"Reject Jahit: {item.QtyRejectSewing}");
        if (item.QtyRework > 0) parts.Add($"Rework: {item.QtyRework}");
        return string.Join(" · ", parts);
    }

    private void ToggleSelectAllPending(ChangeEventArgs e)
    {
        var check = e.Value is bool b && b;
        selectedPendingIds = check ? pendingReceives.Select(p => p.WorkflowLogId).ToHashSet() : new();
    }

    private void TogglePendingSelect(StationPendingReceiveDto item, object? value)
    {
        var check = value is bool b && b;
        if (check) selectedPendingIds.Add(item.WorkflowLogId);
        else selectedPendingIds.Remove(item.WorkflowLogId);
    }

    private async Task ReceiveOne(StationPendingReceiveDto item)
    {
        await DoReceiveAsync(item.WorkflowLogId, null);
    }

    private async Task ReceiveSelected()
    {
        isBusy = true;
        actionError = string.Empty;

        foreach (var workflowLogId in selectedPendingIds.ToList())
        {
            var (success, error) = await StationApi.ReceiveAsync(new StationReceiveRequest
            {
                WorkflowLogId = workflowLogId,
                ResourceId = currentOperatorId!.Value
            });

            if (!success)
            {
                actionError = error;
                break;
            }
        }

        selectedPendingIds.Clear();
        isBusy = false;
        await RefreshLists();
    }

    private void OpenReceiveNoteModal(StationPendingReceiveDto item)
    {
        receiveNoteTarget = item;
        receiveNoteText = string.Empty;
        showReceiveNoteModal = true;
    }

    private void CloseReceiveNoteModal()
    {
        showReceiveNoteModal = false;
        receiveNoteTarget = null;
        receiveNoteText = string.Empty;
    }

    private async Task ConfirmReceiveWithNote()
    {
        if (receiveNoteTarget is null || string.IsNullOrWhiteSpace(receiveNoteText)) return;

        var workflowLogId = receiveNoteTarget.WorkflowLogId;
        var remark = receiveNoteText;
        CloseReceiveNoteModal();
        await DoReceiveAsync(workflowLogId, remark);
    }

    private async Task DoReceiveAsync(int workflowLogId, string? remark)
    {
        isBusy = true;
        actionError = string.Empty;

        var (success, error) = await StationApi.ReceiveAsync(new StationReceiveRequest
        {
            WorkflowLogId = workflowLogId,
            ResourceId = currentOperatorId!.Value,
            Remark = remark
        });

        isBusy = false;
        if (!success) actionError = error;
        await RefreshLists();
    }

    private void OpenEditHandoverModal(StationPendingHandoverDto item)
    {
        editHandoverTarget = item;
        editQtyOk = item.QtyOk;
        editQtyRejectPrint = item.QtyRejectPrint;
        editQtyRejectFabric = item.QtyRejectFabric;
        editQtyRejectSewing = item.QtyRejectSewing;
        editQtyRework = item.QtyRework;
        editArticleSizeId = item.ArticleSizeId ?? 0;
        editRemark = item.Remark ?? string.Empty;
        editError = string.Empty;
        showEditHandoverModal = true;
    }

    private void CloseEditHandoverModal()
    {
        showEditHandoverModal = false;
        editHandoverTarget = null;
    }

    private async Task ConfirmEditHandover()
    {
        if (editHandoverTarget is null) return;

        if (editHandoverTarget.BundleId is null && editArticleSizeId <= 0)
        {
            editError = "Size wajib dipilih.";
            return;
        }

        isBusy = true;
        editError = string.Empty;

        var (success, error) = await StationApi.UpdateLogAsync(editHandoverTarget.WorkflowLogId, new StationLogUpdateRequest
        {
            ArticleSizeId = editHandoverTarget.BundleId is null ? editArticleSizeId : null,
            QtyOk = editQtyOk,
            QtyRejectPrint = editQtyRejectPrint,
            QtyRejectFabric = editQtyRejectFabric,
            QtyRejectSewing = editQtyRejectSewing,
            QtyRework = editQtyRework,
            Remark = string.IsNullOrWhiteSpace(editRemark) ? null : editRemark
        });

        isBusy = false;

        if (!success)
        {
            editError = error;
            return;
        }

        CloseEditHandoverModal();
        await RefreshLists();
    }

    private async Task OpenScanPanel()
    {
        StopPolling();
        isScanPanelOpen = true;
        scanResult = null;
        scanError = string.Empty;
        scanActionError = string.Empty;
        await StartCameraAsync();
    }

    private async Task CloseScanPanel()
    {
        await StopCameraAsync();
        isScanPanelOpen = false;
        scanResult = null;
        StartPolling();
        await RefreshLists();
    }

    private async Task StartCameraAsync()
    {
        scannerRef ??= DotNetObjectReference.Create(this);
        try
        {
            isCameraActive = await JS.InvokeAsync<bool>("bundleScanner.start", "bundleScanReader", scannerRef);
        }
        catch (JSException)
        {
            isCameraActive = false;
        }
    }

    private async Task StopCameraAsync()
    {
        if (!isCameraActive) return;
        try
        {
            await JS.InvokeVoidAsync("bundleScanner.stop");
        }
        catch (JSException)
        {
            // elemen sudah dilepas / kamera sudah berhenti, abaikan
        }
        isCameraActive = false;
    }

    [JSInvokable]
    public async Task OnScanResult(string decodedText)
    {
        await StopCameraAsync();
        await LookupSerial(ExtractSerial(decodedText));
        await InvokeAsync(StateHasChanged);
    }

    private async Task SubmitTextScan()
    {
        if (string.IsNullOrWhiteSpace(scanTextInput)) return;
        var serial = ExtractSerial(scanTextInput.Trim());
        scanTextInput = string.Empty;
        await LookupSerial(serial);
    }

    private static string ExtractSerial(string raw)
    {
        var idx = raw.IndexOf("/b/", StringComparison.OrdinalIgnoreCase);
        return idx >= 0 ? raw[(idx + 3)..].Trim('/') : raw;
    }

    private async Task LookupSerial(string serial)
    {
        lastScannedSerial = serial;
        isScanning = true;
        scanError = string.Empty;
        scanResult = await StationApi.ScanAsync(serial, currentOperatorId);
        isScanning = false;
        if (scanResult is null) scanError = "Bundle tidak ditemukan.";
    }

    private async Task RefreshScanResult()
    {
        if (string.IsNullOrEmpty(lastScannedSerial)) return;

        isScanning = true;
        scanActionError = string.Empty;
        scanResult = await StationApi.ScanAsync(lastScannedSerial, currentOperatorId);
        isScanning = false;
        if (scanResult is null) scanError = "Bundle tidak ditemukan.";
    }

    private async Task RescanAsync()
    {
        scanResult = null;
        scanActionError = string.Empty;
        scanError = string.Empty;
        await StartCameraAsync();
    }

    private async Task HandleScanReceive(string? remark)
    {
        if (scanResult?.Action.ActionWorkflowLogId is null || currentOperatorId is null) return;

        scanActionBusy = true;
        scanActionError = string.Empty;

        var (success, error) = await StationApi.ReceiveAsync(new StationReceiveRequest
        {
            WorkflowLogId = scanResult.Action.ActionWorkflowLogId.Value,
            ResourceId = currentOperatorId.Value,
            Remark = remark
        });

        scanActionBusy = false;
        if (!success)
        {
            scanActionError = error;
            return;
        }

        await RescanAsync();
    }

    private async Task HandleScanComplete(TerakarsaApp.Client.Shared.BundleCompleteFormValues values)
    {
        if (scanResult?.Action.ActionArticleWorkflowId is null || currentOperatorId is null) return;

        scanActionBusy = true;
        scanActionError = string.Empty;

        var (success, error) = await StationApi.CompleteAsync(new StationCompleteRequest
        {
            ArticleWorkflowId = scanResult.Action.ActionArticleWorkflowId.Value,
            BundleId = scanResult.Bundle.BundleId,
            ResourceId = currentOperatorId.Value,
            QtyOk = values.QtyOk,
            QtyRejectPrint = values.QtyRejectPrint,
            QtyRejectFabric = values.QtyRejectFabric,
            QtyRejectSewing = values.QtyRejectSewing,
            QtyRework = values.QtyRework,
            Remark = values.Remark
        });

        scanActionBusy = false;
        if (!success)
        {
            scanActionError = error;
            return;
        }

        await RescanAsync();
    }

    private async Task HandleScanEdit(TerakarsaApp.Client.Shared.BundleCompleteFormValues values)
    {
        if (scanResult?.Action.ActionWorkflowLogId is null) return;

        scanActionBusy = true;
        scanActionError = string.Empty;

        var (success, error) = await StationApi.UpdateLogAsync(scanResult.Action.ActionWorkflowLogId.Value, new StationLogUpdateRequest
        {
            QtyOk = values.QtyOk,
            QtyRejectPrint = values.QtyRejectPrint,
            QtyRejectFabric = values.QtyRejectFabric,
            QtyRejectSewing = values.QtyRejectSewing,
            QtyRework = values.QtyRework,
            Remark = values.Remark
        });

        scanActionBusy = false;
        if (!success)
        {
            scanActionError = error;
            return;
        }

        await RefreshScanResult();
    }

    public void Dispose()
    {
        pollTimer?.Dispose();
        scannerRef?.Dispose();
        if (isCameraActive)
        {
            _ = JS.InvokeVoidAsync("bundleScanner.stop");
        }
    }
}

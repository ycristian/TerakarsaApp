    private async Task ConfirmReviseGroup()
    {
        if (reviseGroupTarget is null || currentOperatorId is null) return;

        var reviseGroupBadRow = reviseGroupRows.FirstOrDefault(r =>
            r.QtyRejectPrint + r.QtyRejectFabric + r.QtyRejectSewing + r.QtyRejectRework + r.QtyLost > 0 && string.IsNullOrWhiteSpace(r.Remark));

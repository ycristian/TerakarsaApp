    private List<OutCard> OutCards =>
        outbound.Where(i => i.BundleId is not null)
            .GroupBy(i => i.ArticleId)
            .Select(g => new OutCard { SortTime = g.Max(x => x.CreatedAt), BundleGroup = g.OrderBy(x => x.BundleNo).ToList() })
        .Concat(
            outbound.Where(i => i.BundleId is null)
                .GroupBy(i => (i.ArticleWorkflowId, Minute: TruncateToMinute(i.CreatedAt)))
                .Select(g => new OutCard

@page "/station"
@page "/station/{PairingCode}"
@layout TerakarsaApp.Client.Layout.BlankLayout
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Client.Shared
@using TerakarsaApp.Shared.Bundles
@using TerakarsaApp.Shared.Divisions
@using TerakarsaApp.Shared.Employees
@using TerakarsaApp.Shared.Packs
@using TerakarsaApp.Shared.Payroll
@using TerakarsaApp.Shared.Projects
@using TerakarsaApp.Shared.Resources
@using TerakarsaApp.Shared.Stations
@using TerakarsaApp.Shared.WorkflowLogs
@inject StationDeviceApiService StationApi
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Stasiun</PageTitle>

<div style="font-size: 0.9rem;">

<div class="mb-3">
    <CloseButton />
</div>

@if (isLoadingSetup)
{
    <p class="text-center fs-4 mt-5">Memuat...</p>
}
else if (station is null)
{
    <div class="card mt-5">
        <div class="card-body">
            <h3 class="card-title mb-3">Setup Perangkat Stasiun</h3>
            <p class="text-muted">Masukkan kode pairing 5 karakter yang diberikan admin untuk mengaktifkan perangkat ini.</p>
            <div class="mb-3">
                <input class="form-control text-uppercase" maxlength="5" placeholder="Kode pairing..." @bind="tokenInput" @bind:event="oninput" />
            </div>
            @if (!string.IsNullOrEmpty(setupError))
            {
                <div class="alert alert-danger">@setupError</div>
            }
            <button class="btn btn-primary btn-lg w-100" disabled="@isValidatingToken" @onclick="HandleSetupSubmit">
                @(isValidatingToken ? "Memeriksa..." : "Aktifkan Perangkat")
            </button>
        </div>
    </div>
}
else if (currentOperatorId is null)
{
    <div class="card mb-3">
        <div class="card-body text-center">
            <h3 class="mb-0">@station.StationName</h3>
            <p class="text-muted mb-2">@station.DivisionName</p>
            <button class="btn btn-outline-danger btn-sm" @onclick="() => showLogoutConfirm = true">Keluar</button>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Pilih Operator</h3>
        </div>
        <div class="card-body">
            @if (operators.Count == 0)
            {
                <div class="alert alert-warning mb-0">Belum ada resource aktif untuk divisi ini. Hubungi admin.</div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var op in operators)
                    {
                        <div class="col-6 col-md-4">
                            <button class="btn btn-outline-primary btn-lg w-100 py-4" @onclick="() => SelectOperator(op)">
                                @op.ResourceName
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h4 class="mb-0">@station.StationName <span class="text-muted fs-6">(@station.DivisionName)</span></h4>
                <p class="mb-0 text-muted">
                    Operator: <strong class="text-dark">@currentOperatorName</strong>
                    @if (IsLocked)
                    {
                        <i class="fe fe-lock ms-1" title="Terkunci ke resource bawaan"></i>
                    }
                </p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-sm" @onclick="() => showQrScanner = true">
                    <i class="fe fe-camera"></i> QR
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshLists" disabled="@isLoadingLists" title="Refresh">
                    <i class="fe fe-refresh-cw"></i>
                </button>
                @if (!IsLocked)
                {
                    <button class="btn btn-outline-danger btn-sm" @onclick="ChangeOperator">Ganti Operator</button>
                }
                <button class="btn btn-outline-danger btn-sm" @onclick="() => showLogoutConfirm = true">Keluar</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(qrScanError))
    {
        <div class="alert alert-danger mb-3">@qrScanError</div>
    }

    <div class="row g-2 mb-3">
        <div class="col-4">
            <div class="card bg-primary text-white h-100 border border-3 border-warning shadow-sm" style="cursor: pointer;" @onclick='() => SetTab("masuk")'>
                @* py-1 + lh-1 di semua baris: kartu angka ini cuma pintasan tab, tidak perlu
                   tinggi. Ketiganya h-100 jadi tingginya mengikuti kartu OUT yang punya baris
                   tunggakan lock. *@
                <div class="card-body py-1 px-3">
                    <div class="small lh-1">IN</div>
                    <div class="fs-2 fw-bold lh-1">@counts.MasukCount</div>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card bg-warning text-dark h-100 border border-3 border-warning shadow-sm" style="cursor: pointer;" @onclick='() => SetTab("kerja")'>
                <div class="card-body py-1 px-3">
                    <div class="small lh-1">WIP</div>
                    <div class="fs-2 fw-bold lh-1">@counts.DikerjakanCount</div>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card bg-light text-dark h-100 border border-3 border-warning shadow-sm" style="cursor: pointer;" @onclick='() => SetTab("kirim")'>
                <div class="card-body py-1 px-3">
                    <div class="small lh-1 text-muted">OUT</div>
                    <div class="fs-2 fw-bold lh-1">@counts.DikirimCount</div>
                    @* Tunggakan lock (Prompt 56) -- baris sendiri di bawah angka, sembunyi
                       kalau sudah beres. text-nowrap supaya ikon dan angkanya tidak pernah
                       terpisah ke dua baris di kolom sesempit ini. *@
                    @if (counts.OutUnlockedCount > 0)
                    {
                        @* Ikon gembok terbuka menggantikan teks "belum lock" -- sama dengan
                           metrik Lock di header kartu OUT, jadi artinya konsisten. title
                           dipertahankan karena ikon sendirian tidak menjelaskan apa-apa. *@
                        <div class="text-danger lh-1 text-nowrap text-end" style="font-size: 0.7rem;" title="@counts.OutUnlockedCount baris belum di-lock">
                            <i class="bi bi-unlock"></i> @counts.OutUnlockedCount
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs flex-nowrap">
                <li class="nav-item">
                    <a class="nav-link small py-1 px-2 @(activeTab == "masuk" ? "active" : "")" href="javascript:void(0)" @onclick='() => SetTab("masuk")'>
                        IN
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link small py-1 px-2 @(activeTab == "kerja" ? "active" : "")" href="javascript:void(0)" @onclick='() => SetTab("kerja")'>
                        WIP
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link small py-1 px-2 @(activeTab == "kirim" ? "active" : "")" href="javascript:void(0)" @onclick='() => SetTab("kirim")'>
                        OUT
                    </a>
                </li>
                @if (station.EnablePacking)
                {
                    <li class="nav-item">
                        <a class="nav-link small py-1 px-2 @(activeTab == "packing" ? "active" : "")" href="javascript:void(0)" @onclick='() => SetTab("packing")'>
                            Packing
                        </a>
                    </li>
                }
                @* Prompt 80: hanya perangkat yang divisinya memegang step Bundling -- gate-nya
                   SAMA dengan yang memunculkan kartu "Buat Bundle" di tab WIP (activeWork
                   ber-IsBundling), jadi tidak ada sumber kebenaran baru soal "divisi Bundling".
                   Pengambilan bundle cutting juga ditolak SP kalau operatornya bukan resource
                   divisi Bundling artikel ybs. *@
                @if (IsStationBundling)
                {
                    <li class="nav-item">
                        <a class="nav-link small py-1 px-2 @(activeTab == "stokcutting" ? "active" : "")" href="javascript:void(0)" @onclick='() => SetTab("stokcutting")'>
                            Stok Cutting
                        </a>
                    </li>
                }
                @* Prompt 59: rekap ini milik SATU line, jadi tanpa operator sesi tidak ada yang
                   bisa ditampilkan -- tab dimatikan, bukan dibuka lalu kosong. Saat ini halaman
                   sudah menggantikan SELURUH isinya dengan layar "Pilih Operator" ketika
                   currentOperatorId null, jadi cabang ini praktis tidak terlihat -- disimpan
                   sebagai pengaman kalau gate halaman itu berubah (endpoint-nya pun menolak
                   sendiri dengan "Operator wajib dipilih."). *@
                <li class="nav-item">
                    @if (currentOperatorId is null)
                    {
                        <span class="nav-link small py-1 px-2 disabled text-muted" title="Pilih operator dulu">
                            Report
                        </span>
                    }
                    else
                    {
                        <a class="nav-link small py-1 px-2 @(activeTab == "rekapproduksi" ? "active" : "")" href="javascript:void(0)" @onclick='() => SetTab("rekapproduksi")'>
                            Report
                        </a>
                    }
                </li>
                @* Prompt 58: badge = pegawai aktif line ini yang absennya belum diisi HARI INI.
                   Hari libur tidak pernah masuk daftar tunggakan, jadi otomatis tanpa badge. *@
                <li class="nav-item">
                    <a class="nav-link small py-1 px-2 @(activeTab == "absen" ? "active" : "")" href="javascript:void(0)" @onclick='() => SetTab("absen")'>
                        Absen
                        @if (AbsenTodayPendingCount > 0)
                        {
                            <span class="badge bg-warning text-dark ms-1">@AbsenTodayPendingCount</span>
                        }
                    </a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            @if (activeTab == "masuk")
            {
                @if (pendingReceives.Count == 0)
                {
                    <p class="text-muted mb-0">Tidak ada kiriman yang menunggu diterima.</p>
                }
                else
                {
                    @foreach (var card in InCards)
                    {
                        @if (card.BundleGroup is { Count: > 0 } bundles)
                        {
                            var first = bundles[0];
                            <div class="card mb-2">
                                <div class="card-body">
                                    <div class="mb-2" style="font-size: 0.85rem;">
                                        <div class="fw-bold">@first.ProjectName <span class="text-muted fw-normal">&middot; @first.BuyerName</span></div>
                                        <div class="text-muted">@(first.NoPo ?? "-") &middot; @first.ArticleName</div>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered border mb-0 align-middle" style="font-size: 0.75rem;">
                                            <tbody>
                                                @foreach (var b in bundles)
                                                {
                                                    <tr>
                                                        <td style="font-size: 0.65rem;">@BundleDisplay.Format(b.BundleLetter, b.BundleNo)</td>
                                                        <td style="font-size: 0.9rem;">@(b.SizeName ?? "-")</td>
                                                        <td>@b.QtyOk</td>
                                                        <td>@b.FromDivisionName</td>
                                                        <td>
                                                            <div class="d-flex gap-1">
                                                                <button class="btn btn-outline-secondary btn-sm py-0 px-1" title="Cetak Ulang" disabled="@isBusy" @onclick="() => OpenReprintBundleModal(b.BundleId, b.Serial)"><i class="fe fe-printer"></i></button>
                                                                <button class="btn btn-outline-secondary btn-sm py-0 px-1" disabled="@isBusy" @onclick="() => OpenReceiveNoteModal(b)">Catatan</button>
                                                                <button class="btn btn-success btn-sm py-0 px-1" disabled="@isBusy" @onclick="() => ReceiveOne(b)">Terima</button>
                                                            </div>
                                                            <span class="text-muted">@FormatDateTime(b.SentAt)</span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (card.NonBundleGroup is { } grp)
                        {
                            <div class="card mb-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="mb-1">@grp.ArticleName <span class="text-muted">(@FormatProject(grp.NoPo, grp.ProjectName))</span></h5>
                                            <p class="text-muted mb-0">@grp.Style @grp.Color</p>
                                        </div>
                                        <span class="badge bg-secondary">@grp.Items.Count ukuran</span>
                                    </div>
                                    <hr class="my-2" />
                                    <p class="mb-2">Step: <strong>@grp.StepName</strong></p>
                                    <ul class="list-group list-group-flush mb-2">
                                        @foreach (var row in grp.Items)
                                        {
                                            <li class="list-group-item px-0 py-1 d-flex justify-content-between">
                                                <span>@row.SizeName</span>
                                                <strong>@row.QtyOk</strong>
                                            </li>
                                        }
                                    </ul>
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <span class="text-muted">
                                            Dari: @grp.FromDivisionName &middot; @grp.GroupTime.ToString("dd/MM HH:mm")
                                            <br />
                                            Diterima oleh: <strong>@ReceiverDisplayName(grp.Items.First())</strong>
                                        </span>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-outline-secondary btn-sm" disabled="@isBusy" @onclick="() => OpenReceiveNoteModalGroup(grp)">Dengan Catatan</button>
                                            <button class="btn btn-success" disabled="@isBusy" @onclick="() => ReceiveGroup(grp)">Terima</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            }
            else if (activeTab == "kerja")
            {
                @* Kartu WIP bisa ditutup/dibuka seperti tab OUT (chevron di kanan header).
                   Ringkasan angka SELALU terlihat supaya kartu yang ditutup tetap informatif;
                   yang disembunyikan hanya tabel/tombol aksinya. *@
                <div class="d-flex gap-2 mb-3">
                    <input class="form-control" placeholder="Cari No PO, customer, PIC, project, artikel, step, atau serial" @bind="wipSearchText" @bind:event="oninput" />
                    <button class="btn btn-light flex-shrink-0" title="@(AllWipExpanded ? "Tutup semua kartu" : "Buka semua kartu")" @onclick="ToggleAllWipCards">
                        <i class="fe @(AllWipExpanded ? "fe-minimize-2" : "fe-maximize-2")"></i>
                    </button>
                </div>

                @if (FilteredWipCards.Count == 0)
                {
                    <p class="text-muted mb-0">Tidak ada pekerjaan yang cocok.</p>
                }
                else
                {
                    @foreach (var card in FilteredWipCards)
                    {
                        var wipExpanded = expandedWipCards.Contains(card.Key);
                        @if (card.NonBundle is { IsBundling: true } bl)
                        {
                            <div class="card mb-2 border-primary">
                                <div class="card-body">
                                    <div style="cursor: pointer;" @onclick="() => ToggleWipCard(card.Key)">
                                        <div class="d-flex align-items-start gap-2 @(wipExpanded ? "mb-2" : "mb-0")">
                                            @* THUMBNAIL DIMATIKAN SENGAJA, JANGAN DIHAPUS.
                                               Memuat foto tiap kartu membuat /station lambat dibuka, jadi sekarang foto
                                               hanya diambil kalau operator menekan tombol kamera di kanan. Endpoint
                                               thumbnail (api/article-photo/{id}/thumb) tetap ada dan siap dipakai.

                                               Kalau nanti dihidupkan lagi, dua atribut ini wajib ikut:
                                               - loading="lazy"  : kartu yang belum di-scroll tidak menembak request.
                                               - onload + onerror BERPASANGAN: @foreach kartu WIP tidak pakai @@key, jadi
                                                 Blazor bisa memakai ulang elemen <img> ini untuk artikel lain. Tanpa
                                                 onload, "display:none" milik artikel tanpa foto ikut terbawa dan
                                                 menyembunyikan foto artikel berikutnya yang sebenarnya ada.
                                               - @@onclick:stopPropagation: klik foto membuka pratinjau, bukan menutup kartu.

                                            <img src="@StationApi.ArticleThumbUrl(bl.ArticleId)" alt="@bl.ArticleName" loading="lazy"
                                                 onload="this.style.display=''" onerror="this.style.display='none'"
                                                 style="width: 64px; height: 64px; object-fit: cover; border-radius: 4px; flex-shrink: 0; cursor: pointer;"
                                                 @onclick:stopPropagation="true" @onclick="() => OpenPhotoModal(StationApi.ArticlePhotoUrl(bl.ArticleId))" />
                                            *@
                                            <div class="d-flex justify-content-between align-items-start flex-grow-1" style="font-size: 0.85rem;">
                                                <div>
                                                    <div class="fw-bold">@bl.ProjectName</div>
                                                    <div class="text-muted">@(bl.NoPo ?? "-") &middot; @bl.ArticleName</div>
                                                </div>
                                                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                                    @* Pengganti thumbnail: foto baru diunduh saat tombol ini ditekan.
                                                       stopPropagation supaya kartu tidak ikut membuka/menutup. *@
                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="Lihat foto artikel"
                                                            @onclick:stopPropagation="true" @onclick="() => OpenPhotoModal(StationApi.ArticlePhotoUrl(bl.ArticleId))">
                                                        <i class="fe fe-camera"></i>
                                                    </button>
                                                    <span class="badge bg-primary text-light">Bundling</span>
                                                    <i class="fe @(wipExpanded ? "fe-chevron-up" : "fe-chevron-down") text-muted"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @if (wipExpanded)
                                    {
                                        <hr class="my-2" />
                                        <div class="d-flex justify-content-end">
                                            <button class="btn btn-primary btn-sm" disabled="@isBusy" @onclick="() => OpenBuatBundleModal(bl)">Buat Bundle</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else if (card.NonBundle is { } nb)
                        {
                            <div class="card mb-2">
                                <div class="card-body">
                                    <div style="cursor: pointer;" @onclick="() => ToggleWipCard(card.Key)">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h5 class="mb-1">@nb.ArticleName</h5>
                                                <p class="text-muted mb-0">
                                                    @FormatProject(nb.NoPo, nb.ProjectName) &middot; @nb.Style @nb.Color &middot; Tujuan berikutnya: @(nb.IsLastStep ? "Step terakhir" : (nb.NextDivisionName ?? "-"))
                                                </p>
                                            </div>
                                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                                <span class="badge bg-info text-light"><i class="fe fe-clipboard"></i> Step: @nb.StepName</span>
                                                <i class="fe @(wipExpanded ? "fe-chevron-up" : "fe-chevron-down") text-muted"></i>
                                            </div>
                                        </div>
                                        @* Dipindah ke header (dari baris tombol) supaya progres tetap
                                           terbaca saat kartu ditutup. *@
                                        <p class="mb-0 text-muted" style="font-size: 0.8rem;">
                                            Tercatat <strong>@(nb.Sizes.Sum(s => s.QtyRecorded))</strong> dari @(nb.Sizes.Sum(s => s.QtyOrder))
                                        </p>
                                    </div>
                                    @if (wipExpanded)
                                    {
                                        <hr class="my-2" />
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <p class="mb-0 text-muted">Input bisa nyicil.</p>
                                            <button class="btn btn-primary" disabled="@isBusy" @onclick="() => OpenNonBundleModal(nb)">Kirim Hasil</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else if (card.BundleGroup is { Count: > 0 } bundles)
                        {
                            var first = bundles[0];
                            <div class="card mb-2 border-warning">
                                <div class="card-body">
                                    <div style="cursor: pointer;" @onclick="() => ToggleWipCard(card.Key)">
                                        <div class="d-flex justify-content-between align-items-start mb-2" style="font-size: 0.85rem;">
                                            <div>
                                                <div class="fw-bold">@first.ProjectName <span class="text-muted fw-normal">&middot; @first.BuyerName</span></div>
                                                <div class="text-muted">@(first.NoPo ?? "-") &middot; @first.ArticleName</div>
                                                @* Rentang waktu terima bundle dalam kartu ini -- terawal s/d terakhir.
                                                   Satu bundle (atau semua diterima bersamaan) cukup satu waktu. *@
                                                @{
                                                    var recFirst = bundles.Min(x => x.ReceivedAt);
                                                    var recLast = bundles.Max(x => x.ReceivedAt);
                                                    // Selisih HARI KALENDER, bukan jam dibagi 24 -- '23/09 17:17 - 29/09 16:27'
                                                    // dibaca 6 hari, bukan 5 (selisih jamnya kurang sedikit dari 6x24).
                                                    var recSpanDays = (recLast.Date - recFirst.Date).Days;
                                                }
                                                <div class="text-muted" style="font-size: 0.65rem;" title="Waktu terima bundle: terawal - terakhir">
                                                    @if (recFirst == recLast)
                                                    {
                                                        @FormatDateTime(recFirst)
                                                    }
                                                    else
                                                    {
                                                        <text>@FormatDateTime(recFirst) - @FormatDateTime(recLast)</text>
                                                        @* Rentang di hari yang sama tidak perlu '(0 hari)'. *@
                                                        @if (recSpanDays > 0)
                                                        {
                                                            <text> (@recSpanDays hari)</text>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                            <i class="fe @(wipExpanded ? "fe-chevron-up" : "fe-chevron-down") text-muted ms-2"></i>
                                        </div>
                                    @* Prompt 82: Hilang = Sigma missing_qty POSITIF semua induk artikel ini
                                       (SEMUA station, bukan cuma station ini). > 0 merah & clickable ->
                                       modal "Barang ketemu"; = 0 abu-abu dan tidak clickable.
                                       Lebih = Sigma missing_qty negatif (absolut), tampil hanya kalau > 0.
                                       Qty tetap = Sigma qty bundle NYATA di station ini. *@
                                    @{
                                        var missingQty = MissingQtyOf(first.ArticleId);
                                        var overQty = OverQtyOf(first.ArticleId);
                                        var statCols = overQty > 0 ? "col-3" : "col-4";
                                    }
                                        <div class="row g-2 text-center @(wipExpanded ? "mb-2" : "mb-0")">
                                            <div class="@statCols">
                                                <div class="text-muted" style="font-size: 0.65rem;">Bundle</div>
                                                <div class="fw-bold">@bundles.Count</div>
                                            </div>
                                            <div class="@statCols">
                                                <div class="text-muted" style="font-size: 0.65rem;">Qty</div>
                                                <div class="fw-bold">@bundles.Sum(x => x.Qty)</div>
                                            </div>
                                            <div class="@statCols">
                                                <div class="text-muted" style="font-size: 0.65rem;">Hilang</div>
                                                @if (missingQty > 0)
                                                {
                                                    @* @onclick:stopPropagation supaya tidak ikut melipat kartu. *@
                                                    <div class="fw-bold text-danger" style="text-decoration: underline; cursor: pointer;"
                                                         @onclick="() => OpenKetemuModal(first)" @onclick:stopPropagation="true">@missingQty</div>
                                                }
                                                else
                                                {
                                                    <div class="fw-bold text-muted">0</div>
                                                }
                                            </div>
                                            @if (overQty > 0)
                                            {
                                                <div class="@statCols">
                                                    <div class="text-muted" style="font-size: 0.65rem;">Lebih</div>
                                                    <div class="fw-bold text-warning">@overQty</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    @if (wipExpanded)
                                    {
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered border mb-0 align-middle" style="font-size: 0.75rem;">
                                            <tbody>
                                                @foreach (var b in bundles)
                                                {
                                                    <tr>
                                                        <td style="font-size: 0.7rem;">@BundleDisplay.Format(b.BundleLetter, b.BundleNo)</td>
                                                        <td style="font-size: 0.7rem;">@(b.SizeName ?? "-")</td>
                                                        <td style="font-size: 0.7rem;">@b.Qty</td>
                                                        <td style="font-size: 0.7rem;">@(b.EmployeeName ?? "-")</td>
                                                        <td>
                                                            <div class="d-flex gap-1">
                                                                <button class="btn btn-outline-secondary btn-sm py-0 px-1" title="Cetak Ulang" disabled="@isBusy" @onclick="() => OpenReprintBundleModal(b.BundleId, b.Serial)"><i class="fe fe-printer"></i></button>
                                                                <button class="btn btn-outline-danger btn-sm py-0 px-1" title="Batal Terima" disabled="@isBusy" @onclick="() => OpenBatalTerimaModal(b)"><i class="fe fe-x"></i></button>
                                                                <button class="btn btn-success btn-sm py-0 px-1" disabled="@(isBusy || b.NextArticleWorkflowId is null)" @onclick="() => OpenSerahkanModal(b)">Kirim</button>
                                                            </div>
                                                            <span class="text-muted">@FormatDateTime(b.ReceivedAt)</span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
            }
            else if (activeTab == "kirim")
            {
                @* Pencarian tab OUT -- menyaring per BARIS (bukan per kartu), jadi kartu yang
                   tampil hanya memuat baris yang cocok. Field yang dicari sama dengan tab WIP
                   plus nomor bundle/ukuran. Ditaruh PALING ATAS, sejajar dengan tab WIP yang
                   kotak carinya juga di atas. *@
                <div class="mb-2">
                    <input class="form-control" placeholder="Cari No PO, Customer, PIC, Project, Artikel, Bundle, Penjahit"
                           @bind="outSearchText" @bind:event="oninput" />
                </div>

                <div class="d-flex align-items-end gap-2 flex-wrap mb-2">
                    <div style="max-width: 220px;">
                        @* Periode gajian yang memuat tanggal ini -- sekadar keterangan, tidak
                           mengikat: periode baris tetap ditentukan saat Lock, bukan dari tanggal
                           kirim. Ditaruh di label supaya lebar input tanggal tidak terganggu. *@
                        <label class="form-label mb-1">
                            Tanggal Kirim
                            @if (!string.IsNullOrEmpty(outboundDatePeriodCode))
                            {
                                @* bg-primary (solid) WAJIB kalau memakai .badge -- teks .badge
                                   putih, jadi latar tint/transparan bikin tidak terbaca. *@
                                <span class="badge bg-primary ms-1"
                                      style="font-size: 0.6rem;" title="Periode gajian tanggal ini">@outboundDatePeriodCode</span>
                            }
                        </label>
                        <input type="date" class="form-control form-control-sm"
                               min="@DateTime.Today.AddDays(-90).ToString("yyyy-MM-dd")"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")"
                               value="@outboundDate.ToString("yyyy-MM-dd")" @onchange="HandleOutboundDateChanged" />
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="outShowTailor"
                               checked="@showOutTailor" @onchange="e => showOutTailor = e.Value is bool v && v" />
                        <label class="form-check-label" for="outShowTailor">Penjahit</label>
                    </div>
                    @* Prompt 56: mode pilihan baris -- Lock (pilih baris belum lock) atau Unlock
                       (pilih baris sudah lock untuk diajukan ke admin). Default Lock. *@
                    <div class="btn-group btn-group-sm mb-2" role="group">
                        <button type="button" class="btn @(outLockMode == "lock" ? "btn-primary" : "btn-outline-primary")"
                                @onclick='() => SetOutLockMode("lock")'>Lock</button>
                        <button type="button" class="btn @(outLockMode == "unlock" ? "btn-warning" : "btn-outline-warning")"
                                @onclick='() => SetOutLockMode("unlock")'>Unlock</button>
                    </div>
                </div>

                @* Prompt 56: chip merah tanggal yang masih punya baris belum lock -- tap untuk
                   memindahkan filter tanggal ke sana. Tidak ada chip = semua beres. *@
                @if (OutUnlockedChips.Count > 0)
                {
                    <div class="d-flex flex-wrap align-items-center gap-1 mb-3">
                        @* Ikon gembok terbuka menggantikan label "Belum lock:" -- lambang yang
                           sama dipakai di kartu angka OUT dan metrik Lock tiap kartu. *@
                        <span class="text-danger fw-bold" style="font-size: 0.75rem;" title="Tanggal yang masih punya baris belum di-lock">
                            <i class="bi bi-unlock"></i>
                        </span>
                        @foreach (var chip in OutUnlockedChips)
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.75rem;"
                                    @onclick="() => JumpToUnlockedDate(chip.Date)">
                                @chip.Date.ToString("dd/MM") (@chip.Count)
                            </button>
                        }
                        @if (OutUnlockedChipsMore > 0)
                        {
                            <span class="text-danger" style="font-size: 0.75rem;">+@OutUnlockedChipsMore lagi</span>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(outToast))
                {
                    <div class="alert alert-success py-2 mb-3">@outToast</div>
                }

                @if (outbound.Count == 0)
                {
                    <p class="text-muted mb-0">Belum ada data yang dikirim pada tanggal ini.</p>
                }
                else
                {
                    @* Prompt 56: satu kartu per ARTIKEL, isinya baris bundle DAN non-bundle
                       (mis. Cutting) dengan pola tabel yang sama -- lihat OutCards. *@
                    @foreach (var card in OutCards)
                    {
                        var rows = card.Items;
                        var first = rows[0];
                        var outExpanded = expandedOutArticles.Contains(card.ArticleId);
                        var cardUnlocked = rows.Count(r => !r.IsLocked);
                        var cardSelectable = rows.Where(IsOutRowSelectable).ToList();
                        var cardAllSelected = cardSelectable.Count > 0 && cardSelectable.All(r => outSelected.Contains(r.WorkflowLogId));
                        <div class="card mb-2" style="@(cardUnlocked == 0 ? "opacity: 0.6;" : "")">
                            <div class="card-body">
                                <div class="d-flex align-items-start gap-2">
                                    @* Pilih semua baris kartu ini yang bisa dipilih pada mode aktif --
                                       bisa dipakai tanpa membuka kartu. *@
                                    @if (cardSelectable.Count > 0)
                                    {
                                        @* position/margin inline: lihat catatan di sel centang baris. *@
                                        <input class="form-check-input flex-shrink-0" type="checkbox"
                                               style="position: static; margin: 0.25rem 0 0 0;"
                                               checked="@cardAllSelected" @onchange="() => ToggleOutCardSelection(card)" />
                                    }
                                    <div class="flex-grow-1" style="cursor: pointer;" @onclick="() => ToggleOutCard(card.ArticleId)">
                                        <div class="d-flex justify-content-between align-items-start mb-2" style="font-size: 0.85rem;">
                                            <div>
                                                <div class="fw-bold">@first.ProjectName <span class="text-muted fw-normal">&middot; @first.BuyerName</span></div>
                                                <div class="text-muted">@(first.NoPo ?? "-") &middot; @first.ArticleName</div>
                                            </div>
                                            <i class="fe @(outExpanded ? "fe-chevron-up" : "fe-chevron-down") text-muted ms-2"></i>
                                        </div>
                                        <div class="row g-2 text-center @(outExpanded ? "mb-2" : "mb-0")">
                                            <div class="col-3">
                                                @* Label "Bundle" hanya benar kalau kartu ini murni bundle --
                                                   kartu yang memuat baris non-bundle memakai "Baris". *@
                                                <div class="text-muted" style="font-size: 0.65rem;">@(rows.Any(r => r.BundleId is null) ? "Baris" : "Bundle")</div>
                                                <div class="fw-bold">@rows.Count</div>
                                            </div>
                                            <div class="col-3">
                                                <div class="text-muted" style="font-size: 0.65rem;">Qty</div>
                                                <div class="fw-bold">@rows.Sum(x => x.QtyOk)</div>
                                            </div>
                                            <div class="col-3">
                                                <div class="text-muted" style="font-size: 0.65rem;">Reject</div>
                                                <div class="fw-bold @(rows.Sum(RejectTotal) > 0 ? "text-danger" : "")">@rows.Sum(RejectTotal)</div>
                                            </div>
                                            <div class="col-3">
                                                <div class="text-muted" style="font-size: 0.65rem;">Lock</div>
                                                @if (cardUnlocked > 0)
                                                {
                                                    <div class="fw-bold text-danger"><i class="bi bi-unlock"></i> @cardUnlocked</div>
                                                }
                                                else
                                                {
                                                    <div class="fw-bold text-success"><i class="bi bi-lock-fill"></i></div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @if (outExpanded)
                                {
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered border mb-0 align-middle" style="font-size: 0.75rem;">
                                        <tbody>
                                            @foreach (var lineGroup in OutRowGroups(rows))
                                            {
                                                @if (lineGroup.Header is not null)
                                                {
                                                    <tr class="table-light">
                                                        @* 5 kolom sejak centang digabung ke sel nomor bundle. *@
                                                        <td colspan="5" class="fw-bold">@lineGroup.Header</td>
                                                    </tr>
                                                }
                                                @foreach (var b in lineGroup.Items)
                                                {
                                                <tr class="@(outSelected.Contains(b.WorkflowLogId) ? "table-primary" : "")"
                                                    style="@(IsOutRowSelectable(b) ? "cursor: pointer;" : "")"
                                                    @onclick="() => ToggleOutRow(b)">
                                                    @* Centang pilih baris DISATUKAN ke sel nomor bundle -- sebagai <td> sendiri
                                                       (width 1%) checkbox-nya terlempar ke luar garis tabel di browser.
                                                       Placeholder selebar checkbox dipertahankan untuk baris yang tidak bisa
                                                       dipilih, supaya nomor bundle semua baris tetap sejajar. *@
                                                    <td class="align-middle">
                                                        <div class="d-flex align-items-center gap-2">
                                                            @if (IsOutRowSelectable(b))
                                                            {
                                                                @* position/margin inline WAJIB: assets/css/style.css memberi
                                                                   .form-check-input telanjang position:absolute + margin-left:-1.25rem
                                                                   (sisa Bootstrap 4), yang membuat checkbox keluar dari alur dan
                                                                   menutupi teks di sebelahnya. Kelas utility m-0 tidak cukup. *@
                                                                <input class="form-check-input flex-shrink-0" type="checkbox"
                                                                       style="position: static; margin: 0;"
                                                                       checked="@outSelected.Contains(b.WorkflowLogId)" />
                                                            }
                                                            else
                                                            {
                                                                <span class="flex-shrink-0" style="width: 1em;"></span>
                                                            }
                                                            <div>
                                                                @if (b.BundleId is not null)
                                                                {
                                                                    <div style="font-size: 0.65rem;">@BundleDisplay.Format(b.BundleLetter, b.BundleNo)</div>
                                                                    @if (showOutTailor && BundleTailorName(b) is { } tailorName)
                                                                    {
                                                                        <div class="text-muted" style="font-size: 0.65rem;">@tailorName</div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    @* Baris non-bundle: tidak ada nomor bundle, kolom pertama = size. *@
                                                                    <div style="font-size: 0.9rem;">@(b.SizeName ?? "-")</div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="align-middle" style="font-size: 0.9rem;">
                                                        @(b.BundleId is not null ? (b.SizeName ?? "-") : b.StepName)
                                                    </td>
                                                    <td class="align-middle" style="font-size: 0.9rem;">@b.QtyOk</td>
                                                    <td class="align-middle" style="font-size: 0.65rem;">
                                                        @{ var rejectLines = RejectLines(b); }
                                                        @if (rejectLines.Count == 0)
                                                        {
                                                            <text>-</text>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var line in rejectLines)
                                                            {
                                                                <div class="text-danger">@line</div>
                                                            }
                                                        }
                                                    </td>
                                                    <td class="align-middle" @onclick:stopPropagation="true">
                                                        <div class="d-flex gap-1 align-items-center">
                                                            @* Print hanya untuk baris bundle -- baris non-bundle tidak punya label. *@
                                                            @if (b.BundleId is not null)
                                                            {
                                                                <button class="btn btn-outline-secondary btn-sm py-0 px-1" title="Cetak Ulang" disabled="@isBusy" @onclick="() => OpenReprintBundleModal(b.BundleId, b.Serial)"><i class="fe fe-printer"></i></button>
                                                            }
                                                            @if (b.HasPendingUnlock)
                                                            {
                                                                <span class="text-warning" title="Menunggu approval unlock"><i class="bi bi-hourglass-split"></i></span>
                                                            }
                                                            else if (b.IsLocked)
                                                            {
                                                                @* Sudah lock: Edit & Hapus hilang, diganti ikon gembok di posisi yang sama,
                                                                   diikuti kode periode gajian supaya operator tahu baris ini masuk
                                                                   periode mana (periode selalu dari lock, bukan dari tanggal kirim). *@
                                                                <span class="text-success" title="Sudah di-lock"><i class="bi bi-lock-fill"></i></span>
                                                                @if (!string.IsNullOrEmpty(b.LockPeriodCode))
                                                                {
                                                                    @* Teks polos, BUKAN .badge: tema menimpa .badge tanpa memberi warna,
                                                                       sedangkan warna teks .badge dari Bootstrap = putih. Tanpa latar
                                                                       solid hasilnya putih di atas putih (tidak terlihat). *@
                                                                    <span class="text-success" style="font-size: 0.6rem;">@b.LockPeriodCode</span>
                                                                }
                                                            }
                                                            else if (b.IsBundling)
                                                            {
                                                                <button class="btn btn-outline-primary btn-sm py-0 px-1" title="Edit" disabled="@isBusy" @onclick="() => OpenEditBundleModal(b)"><i class="fe fe-edit-2"></i></button>
                                                                <button class="btn btn-outline-danger btn-sm py-0 px-1" title="Hapus" disabled="@isBusy" @onclick="() => OpenDeleteBundleModal(b)"><i class="fe fe-x"></i></button>
                                                            }
                                                            else
                                                            {
                                                                @* Ikon, bukan teks -- sejajar dengan cabang IsBundling di atas. title
                                                                   dipertahankan supaya aksinya tetap jelas saat di-hover/ditekan lama. *@
                                                                @* Prompt 82: baris BER-BUNDLE direvisi lewat modal Kirim Hasil (aditif:
                                                                   qty OK hanya boleh turun, sisanya jadi anak baru atau menambah
                                                                   hilang). Baris non-bundle (mis. Cutting per size) tetap memakai
                                                                   modal "Revisi Data" lama -- step itu tidak punya bundle untuk dipecah. *@
                                                                @if (b.BundleId is not null)
                                                                {
                                                                    <button class="btn btn-outline-primary btn-sm py-0 px-1" title="Edit Kirim Hasil" disabled="@isBusy" @onclick="() => OpenOutEditModal(b)"><i class="fe fe-edit-2"></i></button>
                                                                }
                                                                else
                                                                {
                                                                <button class="btn btn-outline-primary btn-sm py-0 px-1" title="Revisi" disabled="@isBusy" @onclick="() => OpenReviseModal(b)"><i class="fe fe-edit-2"></i></button>
                                                                }
                                                                <button class="btn btn-outline-danger btn-sm py-0 px-1" title="Batal Serah" disabled="@isBusy" @onclick="() => OpenBatalSerahModal(b)"><i class="fe fe-x"></i></button>
                                                            }
                                                        </div>
                                                        @if (b.HasPendingUnlock)
                                                        {
                                                            <div class="text-warning" style="font-size: 0.65rem;">menunggu approval</div>
                                                        }
                                                        <div class="text-muted" style="font-size: 0.65rem;">
                                                            @if (b.ReceivedAt is not null)
                                                            {
                                                                <text>Trm @FormatDateTime(b.ReceivedAt.Value)</text>
                                                            }
                                                            else
                                                            {
                                                                <text>Krm @FormatDateTime(b.CreatedAt)</text>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                }
                            </div>
                        </div>
                    }

                    @* Ruang bawah supaya kartu terakhir tidak tertutup bar aksi saat menggulir. *@
                    <div style="height: 3rem;"></div>

                    @* Bar aksi bawah: sticky DI DALAM wadah tab (bukan fixed -- halaman stasiun
                       bisa berada di panel). *@
                    @* Bar ini MELAYANG di atas daftar, jadi latarnya wajib PADAT -- bg-body
                       (= --bs-body-bg, ikut tema terang/gelap) dipasang di pembungkus luar.
                       Tanda mode Unlock ditaruh di lapisan DALAM memakai bg-warning-transparent
                       (rgba alpha 0.1): tint itu jadi menumpuk di atas bg-body yang padat,
                       bukan di atas isi kartu yang lewat di belakang bar. Memakainya langsung
                       di pembungkus luar membuat bar tembus pandang. *@
                    @* Margin negatif 25px = membatalkan padding .card-body tema (style.css
                       .card-body { padding: 25px }), supaya pita bar mencapai tepi kartu.
                       Padding-nya dikembalikan di lapisan DALAM, jadi teks & tombol tetap
                       sejajar dengan isi kartu di atasnya sementara warnanya penuh. *@
                    <div class="bg-body"
                         style="position: sticky; bottom: 0; z-index: 5; border-top: 1px solid var(--bs-border-color); margin-left: -25px; margin-right: -25px; padding-bottom: env(safe-area-inset-bottom);">
                        <div class="d-flex align-items-center justify-content-between gap-2 py-2 @(outLockMode == "unlock" ? "bg-warning-transparent" : "")"
                             style="padding-left: 25px; padding-right: 25px;">
                            <div style="font-size: 0.8rem;">
                                @OutSelectedRows.Count baris &middot; @OutSelectedRows.Sum(x => x.QtyOk) pcs &middot; reject @OutSelectedRows.Sum(RejectTotal)
                            </div>
                            @if (outLockMode == "lock")
                            {
                                <button class="btn btn-primary" disabled="@(isBusy || OutSelectedRows.Count == 0)" @onclick="OpenLockModal">
                                    LOCK (@OutSelectedRows.Count)
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-warning" disabled="@(isBusy || OutSelectedRows.Count == 0)" @onclick="OpenUnlockRequestModal">
                                    AJUKAN UNLOCK (@OutSelectedRows.Count)
                                </button>
                            }
                        </div>
                    </div>
                }
            }
            else if (activeTab == "packing")
            {
                <div class="mb-3" style="max-width: 420px;">
                    <label class="form-label">Project</label>
                    <SearchableSelect TItem="ProjectDto" Items="packingProjects" Value="packingProjectId" ValueChanged="HandlePackingProjectChanged"
                                      IdSelector="@(p => p.Id)" TextSelector="@(p => p.ProjectName)"
                                      Placeholder="Cari project..." />
                </div>

                @if (packingProjectId <= 0)
                {
                    <p class="text-muted mb-0">Pilih project untuk melihat stok siap pack.</p>
                }
                else if (isLoadingPacking)
                {
                    <p class="text-muted mb-0">Memuat...</p>
                }
                else
                {
                    <ul class="nav nav-pills mb-3 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link @(packingSubTab == "stock" ? "active" : "")" href="javascript:void(0)" @onclick='() => packingSubTab = "stock"'>Stok Siap Pack</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(packingSubTab == "packs" ? "active" : "")" href="javascript:void(0)" @onclick='() => packingSubTab = "packs"'>
                                Karung <span class="badge bg-secondary ms-1">@packingData.Packs.Count</span>
                            </a>
                        </li>
                        <li class="nav-item ms-auto">
                            <button class="btn btn-primary btn-sm" disabled="@isBusy" @onclick="OpenCreatePackModal">+ Buat Karung</button>
                        </li>
                    </ul>

                    @if (packingSubTab == "stock")
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered border mb-0">
                                <thead>
                                    <tr>
                                        <th>Artikel</th>
                                        <th>Ukuran</th>
                                        <th>Selesai</th>
                                        <th>Sudah Dipack</th>
                                        <th>Tersedia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in packingStock)
                                    {
                                        <tr>
                                            <td>@row.ArticleName <span class="text-muted">@row.Style @row.Color</span></td>
                                            <td>@row.SizeName</td>
                                            <td>@row.QtyDone</td>
                                            <td>@row.QtyPacked</td>
                                            <td class="@(row.QtyAvailable > 0 ? "fw-bold" : "")">@row.QtyAvailable</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        @if (packingData.Packs.Count == 0)
                        {
                            <p class="text-muted mb-0">Belum ada karung untuk project ini.</p>
                        }
                        else
                        {
                            @foreach (var pack in packingData.Packs)
                            {
                                <div class="card mb-2" @key="pack.Id">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h4 class="mb-0">Karung No. @pack.PackNo</h4>
                                                <p class="text-muted mb-0">@pack.Serial &middot; @pack.ArticleCount artikel &middot; Label: @(pack.LabelStatus ?? "-")</p>
                                            </div>
                                            <span class="badge @(pack.IsConfirmed ? "bg-success" : "bg-warning text-dark")">@(pack.IsConfirmed ? "AKTUAL" : "PLAN")</span>
                                        </div>
                                        <ul class="list-group list-group-flush mb-2">
                                            @foreach (var item in packingData.Items.Where(i => i.PackId == pack.Id))
                                            {
                                                <li class="list-group-item px-0 py-1 d-flex justify-content-between">
                                                    <span>@item.ArticleName @item.Style @item.Color &middot; @item.SizeName</span>
                                                    <strong>@item.QtyPlan@(item.QtyActual is not null ? $" (aktual {item.QtyActual})" : "")</strong>
                                                </li>
                                            }
                                        </ul>
                                        <p class="text-muted mb-2">Total plan: @pack.TotalPlan &middot; Total aktual: @pack.TotalActual</p>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <button class="btn btn-success btn-sm" disabled="@isBusy" @onclick="() => OpenConfirmPackModal(pack)">@(pack.IsConfirmed ? "Edit Aktual" : "Konfirmasi")</button>
                                            @if (!pack.IsConfirmed)
                                            {
                                                <button class="btn btn-outline-primary btn-sm" disabled="@isBusy" @onclick="() => OpenEditPlanModal(pack)">Edit Planning</button>
                                            }
                                            <button class="btn btn-outline-secondary btn-sm" disabled="@isBusy" @onclick="() => OpenReprintPackModal(pack.Id, pack.Serial)">Cetak Ulang</button>
                                            <button class="btn btn-outline-danger btn-sm" disabled="@isBusy" @onclick="() => OpenDeletePackModal(pack)">Hapus</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                }

                @if (!string.IsNullOrEmpty(packingError))
                {
                    <div class="alert alert-danger mt-3 mb-0">@packingError</div>
                }
                @if (!string.IsNullOrEmpty(packingFeedback))
                {
                    <div class="alert alert-success mt-3 mb-0">@packingFeedback</div>
                }
            }
            else if (activeTab == "stokcutting")
            {
                @* Prompt 80: Scan Stok Bundle -- Bundling MENGAMBIL bundle yang sudah dibentuk
                   Cutting dari hamparan (tidak membuat bundle lagi). Isinya di
                   StationCuttingStockTab supaya halaman ini tidak makin besar (pola sama
                   dengan tab Absen & Report). Setelah pengambilan, daftar WIP/IN/OUT dimuat
                   ulang: bundle yang diambil langsung jadi baris handover Bundling baru. *@
                <StationCuttingStockTab ResourceId="currentOperatorId ?? 0" OnTaken="RefreshLists" />
            }
            else if (activeTab == "rekapproduksi")
            {
                @* Prompt 59: tab "Report" (label lama: "Rekap Produksi"; nama file/komponen
                   sengaja TIDAK ikut di-rename). Isinya di StationRekapProduksiTab supaya
                   halaman ini tidak makin besar (pola sama dengan tab Absen). Divisi tidak dikirim dari sini --
                   komponen hanya meneruskan operator sesi sebagai resourceId. *@
                <StationRekapProduksiTab ResourceId="currentOperatorId ?? 0" />

                @* Dulu tab "Settlement" tersendiri; digabung ke dasar tab ini supaya cetak
                   struk/WIP ada di layar yang sama dengan angka yang dicetaknya. Tombolnya
                   tetap memanggil handler di halaman ini (modal struk juga tinggal di sini),
                   jadi yang pindah hanya posisinya. *@
                <hr class="my-4" />
                <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem; letter-spacing: 0.04em;">Settlement</h6>
                <div class="d-flex gap-2 mb-2" style="max-width: 480px;">
                    <button type="button" class="btn btn-primary flex-fill" disabled="@(RekapResourceId <= 0)" @onclick="OpenRekapStrukModal">Print Rekap</button>
                    <button type="button" class="btn btn-outline-primary flex-fill" disabled="@(RekapResourceId <= 0 || isBusy)" @onclick="PrintRekapWip">Cetak WIP</button>
                </div>
                <p class="text-muted mb-0">
                    Rekap dicetak untuk <strong>@station.DivisionName</strong> &middot; <strong>@currentOperatorName</strong>.
                </p>
            }
            else if (activeTab == "absen")
            {
                @* Prompt 58: isinya di StationAttendanceTab (+ 3 komponen sub-tab) supaya
                   halaman ini tidak makin besar. Divisi/line tidak dikirim ke server dari
                   sini -- komponen hanya meneruskan operator sesi sebagai resourceId. *@
                <StationAttendanceTab ResourceId="currentOperatorId ?? 0"
                                      DivisionName="@station.DivisionName"
                                      ResourceName="@(currentOperatorName ?? "-")"
                                      OnDirtyCountChanged="HandleAbsenDirtyCountChanged"
                                      OnDataChanged="HandleAbsenDataChanged" />
            }

            @if (!string.IsNullOrEmpty(actionError))
            {
                <div class="alert alert-danger mt-3 mb-0">@actionError</div>
            }
            @if (!string.IsNullOrEmpty(reprintFeedback))
            {
                <div class="alert alert-success mt-3 mb-0">@reprintFeedback</div>
            }
        </div>
    </div>
}

</div>

@if (showRekapStrukModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Rekap Produksi</h5>
                    <button type="button" class="btn-close" @onclick="CloseRekapStrukModal"></button>
                </div>
                <div class="modal-body">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="rekapUseTime"
                               checked="@rekapUseTime" @onchange="HandleRekapUseTimeChanged" />
                        <label class="form-check-label" for="rekapUseTime">Use Time</label>
                    </div>
                    @if (rekapUseTime)
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label">Waktu Mulai</label>
                                <input type="datetime-local" class="form-control"
                                       value="@rekapStartDateTime.ToString("yyyy-MM-ddTHH:mm")" @onchange="HandleRekapStartChanged" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Waktu Selesai</label>
                                <input type="datetime-local" class="form-control"
                                       value="@rekapEndDateTime.ToString("yyyy-MM-ddTHH:mm")" @onchange="HandleRekapEndChanged" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-8 col-md-6">
                                <label class="form-label">Tanggal</label>
                                <input type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       value="@rekapDate.ToString("yyyy-MM-dd")" @onchange="HandleRekapDateChanged" />
                            </div>
                        </div>
                    }

                    @if (isLoadingRekap)
                    {
                        <p class="text-muted mb-0">Memuat...</p>
                    }
                    else if (rekapResult?.Header is null)
                    {
                        <p class="text-muted mb-0">Data tidak ditemukan.</p>
                    }
                    else
                    {
                        var h = rekapResult.Header;
                        <p class="mb-2">
                            <strong>@h.DivisionName</strong>
                            @if (!string.IsNullOrEmpty(h.ResourceName))
                            {
                                <text> &middot; @h.ResourceName</text>
                            }
                            @if (!string.IsNullOrEmpty(h.EmployeeName))
                            {
                                <text> &middot; @h.EmployeeName</text>
                            }
                        </p>
                        <p class="text-muted mb-3">
                            Waktu: <strong>@h.PeriodStart.ToString("dd/MM/yyyy HH:mm") - @h.PeriodEnd.ToString(h.PeriodStart.Date == h.PeriodEnd.Date ? "HH:mm" : "dd/MM/yyyy HH:mm")</strong>
                        </p>
                        <div class="border rounded p-3 text-center">
                            <div class="text-muted small">Total pcs periode ini</div>
                            <div class="fs-2 fw-bold">@h.TotalQty</div>
                            @if (h.TotalQty == 0)
                            {
                                <div class="text-warning small mt-1">Tidak ada data produksi di resource &amp; periode ini.</div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(rekapError))
                    {
                        <div class="alert alert-danger mt-3 mb-0">@rekapError</div>
                    }
                    @if (!string.IsNullOrEmpty(rekapPrintFeedback))
                    {
                        <div class="alert alert-success mt-3 mb-0">@rekapPrintFeedback</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseRekapStrukModal">Tutup</button>
                    <button class="btn btn-primary" disabled="@(isBusy || rekapResult?.Header is null)" @onclick="ConfirmPrintRekapStruk">Cetak Struk</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showReceiveNoteModal && (receiveNoteTarget is not null || receiveNoteGroupTarget is not null))

                QtyLost = row.QtyLost,
                Remark = string.IsNullOrWhiteSpace(row.Remark) ? null : row.Remark,
                ResourceId = currentOperatorId.Value
            });

            if (!success)
            {
                reviseGroupError = $"{row.SizeName}: {error}";

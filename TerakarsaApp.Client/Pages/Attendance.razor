    // Reader "mengetik" UID lalu menekan Enter -- Enter langsung menyimpan, supaya pendaftaran
    // massal cukup: pilih karyawan, tap, pilih karyawan, tap.
    private async Task OnCardUidKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter") await SaveCard();
    }

    private async Task SaveCard()
    {
        if (isSaving) return;
        cardFormError = string.Empty;

        if (cardForm.EmployeeId <= 0) { cardFormError = "Karyawan wajib dipilih."; return; }

        var digits = new string((cardForm.CardUid ?? string.Empty).Where(char.IsDigit).ToArray());
        if (digits.Length == 0 || digits.Length > 10)
        {
            cardFormError = "UID kartu harus 10 digit angka dari reader.";
            return;
        }
        // Nol di depan dipulihkan di sini juga (SP melakukan hal yang sama) supaya yang tampil
        // di form sudah bentuk final yang tersimpan.
        var uid = digits.PadLeft(10, '0');

        isSaving = true;
        var result = cardForm.Id == 0
            ? await AttendanceApi.CreateCardAsync(new EmployeeCardCreateRequest
            {
                EmployeeId = cardForm.EmployeeId,
                CardUid = uid,
                CardType = cardForm.CardType,
                Remarks = NullIfBlank(cardForm.Remarks)
            })
            : await AttendanceApi.UpdateCardAsync(new EmployeeCardUpdateRequest
            {
                Id = cardForm.Id,
                EmployeeId = cardForm.EmployeeId,
                CardUid = uid,
                CardType = cardForm.CardType,
                Remarks = NullIfBlank(cardForm.Remarks)
            });
        isSaving = false;

        if (!result.Success) { cardFormError = result.Error; return; }

        if (cardForm.Id == 0)
        {
            // Pendaftaran massal: form tetap terbuka, karyawan dikosongkan, fokus balik ke UID.
            cardForm = new CardFormModel { CardType = cardForm.CardType };
            focusCardUidOnRender = true;
        }
        else
        {
            showCardForm = false;
        }

        await LoadCards();
    }


        });
    }

    private async Task SubmitRemarkAction()
    {
        if (remarkAction is null || isSaving) return;
        remarkError = string.Empty;

        if (remarkAction.RemarksRequired && string.IsNullOrWhiteSpace(remarkText))
        {
            remarkError = "Catatan wajib diisi.";
            return;
        }

        isSaving = true;
        (bool Success, string Error) result;

        switch (remarkAction.Kind)
        {
            case RemarkActionKind.DeactivateCard:
                result = await AttendanceApi.DeactivateCardAsync(new EmployeeCardDeactivateRequest
                {
                    Id = remarkAction.TargetId,
                    Remarks = NullIfBlank(remarkText)
                });
                break;

            case RemarkActionKind.DeleteCard:
                result = await AttendanceApi.DeleteCardAsync(remarkAction.TargetId);
                break;

            case RemarkActionKind.Correct:
                if (editCheckInAt is null || editCheckOutAt is null)
                {
                    isSaving = false;
                    remarkError = "Jam masuk dan jam pulang wajib diisi.";
                    return;
                }
                result = await AttendanceApi.CorrectAsync(new AttendanceCorrectRequest
                {
                    Id = remarkAction.TargetId,
                    CheckInAt = editCheckInAt.Value,
                    CheckOutAt = editCheckOutAt.Value,
                    Remarks = remarkText
                });
                break;

            case RemarkActionKind.Ack:
                result = await AttendanceApi.AckAsync(new AttendanceAckRequest
                {
                    Id = remarkAction.TargetId,
                    Remarks = remarkText
                });
                break;

            case RemarkActionKind.DeleteSession:
                result = await AttendanceApi.DeleteSessionAsync(new AttendanceDeleteRequest
                {
                    Id = remarkAction.TargetId,
                    Remarks = remarkText
                });
                break;

            case RemarkActionKind.Manual:
                if (manualEmployeeId <= 0)
                {
                    isSaving = false;
                    remarkError = "Karyawan wajib dipilih.";
                    return;
                }
                if (editCheckInAt is null)
                {
                    isSaving = false;
                    remarkError = "Jam masuk wajib diisi.";
                    return;
                }
                result = await AttendanceApi.CreateManualAsync(new AttendanceManualRequest
                {
                    EmployeeId = manualEmployeeId,
                    CheckInAt = editCheckInAt.Value,
                    CheckOutAt = editCheckOutAt,
                    Remarks = remarkText
                });
                break;

            default:
                isSaving = false;
                return;
        }

        isSaving = false;

        if (!result.Success) { remarkError = result.Error; return; }

        var kind = remarkAction.Kind;
        CloseRemarkAction();

        if (kind is RemarkActionKind.DeactivateCard or RemarkActionKind.DeleteCard)
        {
            await LoadCards();
        }
        else
        {
            await LoadAnomali();
            if (reportRows.Count > 0) await LoadReport();
        }
    }

    // ======================= Label & util =======================

    private static string EmployeeLabel(EmployeeDto e) =>
        string.IsNullOrWhiteSpace(e.EmployeeCode) ? e.EmployeeName : $"{e.EmployeeName} ({e.EmployeeCode})";

    private static string DurationText(int? minutes)
    {
        if (minutes is null) return "—";
        var total = Math.Max(0, minutes.Value);
        return $"{total / 60}j {total % 60:00}m";
    }

    private static string StatusLabel(AttendanceSessionDto row) => row.SessionStatus switch
    {
        AttendanceSessionStatuses.Open => "Sedang di dalam",
        AttendanceSessionStatuses.Anomali => "Perlu koreksi",
        _ => row.SessionFlag switch
        {
            AttendanceSessionFlags.LemburDikonfirmasi => "Lembur",
            AttendanceSessionFlags.Dikoreksi => "Dikoreksi",
            _ => row.EntrySource == "MANUAL" ? "Manual" : "Normal",
        }
    };

    private static string FlagLabel(string? flag) => flag switch
    {
        AttendanceSessionFlags.LupaKembali => "Lupa kembalikan",
        AttendanceSessionFlags.BelumCheckout => "Tersapu tap baru",
        AttendanceSessionFlags.Diverifikasi => "Sudah diperiksa",
        _ => "Jam pulang kosong",
    };

    // Minggu berjalan = Senin s/d Minggu.
    private static DateTime StartOfWeek(DateTime date)
    {
        var diff = ((int)date.DayOfWeek + 6) % 7;   // Senin = 0
        return date.Date.AddDays(-diff);
    }

    private static string? NullIfBlank(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private class CardFormModel
    {
        public int Id { get; set; }
        public int EmployeeId { get; set; }
        public string CardUid { get; set; } = string.Empty;
        public string CardType { get; set; } = "TETAP";
        public string Remarks { get; set; } = string.Empty;
    }

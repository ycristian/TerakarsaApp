    private List<ResourceDto> ReportResourceOptions =>
        reportDivisionId <= 0
            ? resourceOptions
            : resourceOptions.Where(r => r.DivisionId == reportDivisionId).ToList();

    private void OnReportDivisionChanged(int divisionId)
    {
        reportDivisionId = divisionId;
        // Resource yang jadi tidak valid harus direset, kalau tidak filternya menyaring ke
        // kombinasi divisi+resource yang tidak mungkin dan tabelnya kosong tanpa sebab jelas.
        if (reportResourceId > 0 && !ReportResourceOptions.Any(r => r.Id == reportResourceId))
            reportResourceId = 0;
    }

    private async Task LoadReport()
    {
        isLoadingReport = true;
        reportRows = await AttendanceApi.GetReportAsync(new AttendanceReportRequest
        {
            DateFrom = reportFrom,
            DateTo = reportTo,
            DivisionId = reportDivisionId > 0 ? reportDivisionId : null,
            ResourceId = reportResourceId > 0 ? reportResourceId : null,
            EmployeeId = reportEmployeeId > 0 ? reportEmployeeId : null,
        });
        isLoadingReport = false;
    }

    private string TotalHoursText
    {
        get
        {
            var minutes = reportRows.Where(r => r.DurationMinutes.HasValue).Sum(r => r.DurationMinutes!.Value);
            return $"{minutes / 60.0:N0}j";
        }
    }

    // Export = CSV dipisah ";" (cocok default locale id-ID), lewat JS interop
    // downloadFileFromBytes yang sudah dipakai ReportProduksi.razor.
    private async Task ExportReport()
    {
        var sb = new StringBuilder();
        AppendCsvLine(sb, "Tanggal", "Nama", "Kode", "Divisi", "Resource", "Masuk", "Pulang",
            "Durasi (menit)", "Status", "Flag", "Sumber", "Catatan");

        foreach (var row in reportRows)
        {
            AppendCsvLine(sb,
                row.WorkDate.ToString("yyyy-MM-dd"),
                row.EmployeeName,
                row.EmployeeCode ?? string.Empty,
                row.DivisionName,
                row.ResourceName ?? string.Empty,
                row.CheckInAt.ToString("HH:mm"),
                row.CheckOutAt?.ToString("HH:mm") ?? string.Empty,
                row.DurationMinutes?.ToString() ?? string.Empty,
                row.SessionStatus,
                row.SessionFlag ?? string.Empty,
                row.EntrySource,
                row.Remarks ?? string.Empty);
        }

        var fileName = $"absensi-{reportFrom:yyyyMMdd}-{reportTo:yyyyMMdd}.csv";
        var bytes = new UTF8Encoding(true).GetBytes(sb.ToString());
        await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "text/csv;charset=utf-8;", Convert.ToBase64String(bytes));
    }

    private static void AppendCsvLine(StringBuilder sb, params string[] values)
    {
        sb.AppendLine(string.Join(';', values.Select(v =>
            v.Contains(';') || v.Contains('"') || v.Contains('\n')
                ? '"' + v.Replace("\"", "\"\"") + '"'
                : v)));
    }


    private enum RemarkActionKind { DeactivateCard, DeleteCard, Correct, Ack, DeleteSession, Manual }

    private class RemarkAction
    {
        public RemarkActionKind Kind { get; init; }
        public int TargetId { get; init; }
        public string Title { get; init; } = string.Empty;
        public string Message { get; init; } = string.Empty;
        public string ConfirmLabel { get; init; } = "Simpan";
        public string ConfirmClass { get; init; } = "btn-primary";
        public bool RemarksRequired { get; init; } = true;
        public string RemarksPlaceholder { get; init; } = string.Empty;
    }

    private void OpenRemarkAction(RemarkAction action)
    {
        remarkAction = action;
        remarkText = string.Empty;
        remarkError = string.Empty;
    }

    private void CloseRemarkAction()
    {
        remarkAction = null;
        remarkText = string.Empty;
        remarkError = string.Empty;
        editCheckInAt = null;
        editCheckOutAt = null;
        manualEmployeeId = 0;
    }


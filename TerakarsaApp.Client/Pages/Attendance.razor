        {
            Kind = RemarkActionKind.Manual,
            Title = "Tambah Absensi Manual",
            Message = "Untuk karyawan yang kartunya hilang atau lupa tap sama sekali. Sumber sesinya dicatat MANUAL.",
            ConfirmLabel = "Simpan",

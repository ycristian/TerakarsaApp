@page "/stations"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Shared.Stations
@using TerakarsaApp.Shared.Divisions
@using TerakarsaApp.Shared.Resources
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@inject StationApiService StationApi
@inject DivisionApiService DivisionApi
@inject ResourceApiService ResourceApi
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Kelola Stasiun</PageTitle>

<div class="page-header">
    <h1 class="page-title">Kelola Stasiun</h1>
    <div>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="javascript:void(0)">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Kelola Stasiun</li>
        </ol>
    </div>
</div>

@if (hasAccess is null)
{
    <p>Memeriksa akses...</p>
}
else if (hasAccess == false)
{
    <div class="alert alert-danger">Anda tidak memiliki akses ke modul ini.</div>
}
else
{
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-primary" @onclick="OpenCreateForm">
            + Tambah Stasiun
        </button>
        <PageSizeSelector PageSize="pageSize" PageSizeChanged="HandlePageSizeChange" />
    </div>

    <div style="width: 300px;">
        <input class="form-control" placeholder="Cari kode / nama stasiun / divisi..."
               @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
    </div>
</div>

@if (!string.IsNullOrEmpty(listError))
{
    <div class="alert alert-danger">@listError</div>
}

@if (isLoading)
{
    <p>Memuat data...</p>
}
else if (pagedResult.Items.Count == 0)
{
    <p>Tidak ada data stasiun.</p>
}
else
{
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Daftar Stasiun</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered border text-nowrap mb-0">
                    <thead>
                        <tr>
                            <SortableHeader Label="Kode" Column="StationCode" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                            <SortableHeader Label="Nama Stasiun" Column="StationName" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                            <SortableHeader Label="Divisi" Column="DivisionName" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                            <th>Status</th>
                            <th>Status Perangkat</th>
                            <th>Resource Bawaan</th>
                            <th>Packing</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in pagedResult.Items)
                        {
                            <tr>
                                <td>@s.StationCode</td>
                                <td>@s.StationName</td>
                                <td>
                                    @s.DivisionName
                                    @if (s.AllowAllDivisions)
                                    {
                                        <span class="badge bg-info text-light ms-1" title="Boleh pindah ke semua divisi">Semua divisi</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">
                                        @(s.IsActive ? "Aktif" : "Nonaktif")
                                    </span>
                                </td>
                                <td>
                                    @DeviceStatus(s)
                                    @if (s.PairingCodeLocked)
                                    {
                                        <span class="badge bg-dark text-light ms-1" title="Kode login permanen untuk app Android">Kode terkunci</span>
                                    }
                                </td>
                                <td>
                                    @(string.IsNullOrEmpty(s.DefaultResourceName) ? "-" : s.DefaultResourceName)
                                    @if (!s.AllowResourceChange && !string.IsNullOrEmpty(s.DefaultResourceName))
                                    {
                                        <i class="fe fe-lock ms-1" title="Terkunci ke resource bawaan"></i>
                                    }
                                </td>
                                <td>
                                    @if (s.EnablePacking)
                                    {
                                        <span class="badge bg-info text-light">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-primary me-1" title="Edit" @onclick="() => OpenEditForm(s)"><i class="fe fe-edit"></i></button>
                                    @if (s.PairingCodeLocked)
                                    {
                                        <button class="btn btn-sm btn-dark me-1" title="Kode Login" @onclick="() => OpenLoginCodeModal(s)"><i class="fe fe-key"></i></button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-warning me-1" title="Buat Kode Pairing" disabled="@isGeneratingPairing" @onclick="() => GeneratePairing(s)"><i class="fe fe-link"></i></button>
                                        <button class="btn btn-sm btn-outline-dark me-1" title="Kunci Kode Login" disabled="@isLockingCode" @onclick="() => LockLoginCode(s)"><i class="fe fe-lock"></i></button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger me-1" title="Putuskan Perangkat" disabled="@(s.PairedAt is null)" @onclick="() => HandleUnpair(s)"><i class="fe fe-unlock"></i></button>
                                    <button class="btn btn-sm btn-danger" title="Hapus" @onclick="() => HandleDelete(s)"><i class="fe fe-trash-2"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <TablePagination PageNumber="currentPage" PageSize="pageSize" TotalCount="pagedResult.TotalCount" TotalPages="pagedResult.TotalPages" PageNumberChanged="ChangePage" />
        </div>
    </div>
}

@if (showForm)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Edit Stasiun" : "Tambah Stasiun")</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-3">
                            <label class="form-label">Kode Stasiun</label>
                            <InputText class="form-control" @bind-Value="formModel.StationCode" />
                            <ValidationMessage For="@(() => formModel.StationCode)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nama Stasiun</label>
                            <InputText class="form-control" @bind-Value="formModel.StationName" />
                            <ValidationMessage For="@(() => formModel.StationName)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Divisi</label>
                            <InputSelect class="form-select" @bind-Value="formModel.DivisionId" @bind-Value:after="OnDivisionChanged">
                                <option value="0">-- Pilih Divisi --</option>
                                @foreach (var d in divisionOptions)
                                {
                                    <option value="@d.Id">@d.DivisionName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => formModel.DivisionId)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Resource Bawaan (opsional)</label>
                            <SearchableSelect TItem="ResourceLookupDto" Items="resourceOptions" @bind-Value="formModel.DefaultResourceId" @bind-Value:after="OnDefaultResourceChanged"
                                              IdSelector="@(r => r.Id)" TextSelector="@(r => r.ResourceName)"
                                              AllowNone="true" NoneLabel="- Tidak ada -" Placeholder="Cari resource..." />
                            @if (formModel.DivisionId <= 0)
                            {
                                <div class="form-text">Pilih divisi terlebih dahulu untuk memilih resource.</div>
                            }
                        </div>
                        <div class="mb-3 form-check">
                            <input class="form-check-input" type="checkbox" id="lockToDefaultCheck" disabled="@(formModel.DefaultResourceId <= 0 || formModel.AllowAllDivisions)" @bind="formModel.LockToDefault" />
                            <label class="form-check-label" for="lockToDefaultCheck">Kunci ke resource bawaan</label>
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" id="allowAllDivisionsCheck" @bind-Value="formModel.AllowAllDivisions" />
                            <label class="form-check-label" for="allowAllDivisionsCheck">Boleh pindah ke semua divisi</label>
                            <div class="form-text">Operator memilih divisi di layar "Pilih Operator". Divisi di atas jadi divisi awal.</div>
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="formModel.IsActive" />
                            <label class="form-check-label">Aktif</label>
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" id="enablePackingCheck" @bind-Value="formModel.EnablePacking" />
                            <label class="form-check-label" for="enablePackingCheck">Modul Packing</label>
                        </div>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }
                        <button type="submit" class="btn btn-primary w-100" disabled="@isSaving">
                            @(isSaving ? "Menyimpan..." : "Simpan")
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (showPairingModal && pairingResult is not null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Kode Pairing</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="ClosePairingModal"></button>
                </div>
                <div class="modal-body text-center">
                    <p class="text-muted">Scan QR ini langsung dari kamera tablet/HP, buka link-nya, atau ketik kodenya manual di layar aktivasi perangkat.</p>
                    <div id="pairingQrCode" class="d-flex justify-content-center mb-3"></div>
                    <div class="display-4 fw-bold mb-3">@pairingResult.Code</div>
                    <div class="input-group mb-2">
                        <input class="form-control" readonly value="@pairingResult.Link" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="CopyPairingLink">
                            @(copied ? "Tersalin!" : "Salin Link")
                        </button>
                        <a class="btn btn-outline-secondary" title="Buka" target="_blank" href="@pairingResult.Link"><i class="fe fe-external-link"></i></a>
                    </div>
                    <div class="text-muted small">Berlaku sampai @pairingResult.ExpiresAt.ToString("HH:mm") &middot; 15 menit, sekali pakai.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="ClosePairingModal">Selesai</button>
                </div>
            </div>
        </div>
    </div>
}

@* Prompt 85: kode login terkunci -- permanen, untuk Pengaturan app Android (ketik/scan QR). *@
@if (loginCodeTarget is not null && loginCodeValue is not null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Kode Login &middot; @loginCodeTarget.StationName</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseLoginCodeModal"></button>
                </div>
                <div class="modal-body text-center">
                    <p class="text-muted">Isi kode ini di Pengaturan app Android (ketik atau scan QR). Kode permanen dan bisa dipakai berulang; perangkat lain yang memakainya diminta konfirmasi dulu sebelum mengambil alih stasiun.</p>
                    <div id="loginQrCode" class="d-flex justify-content-center mb-3"></div>
                    <div class="display-6 fw-bold mb-3" style="font-family: monospace; letter-spacing: 0.15em;">@loginCodeValue</div>
                    <div class="input-group mb-2">
                        <input class="form-control" readonly value="@loginCodeLink" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="CopyLoginCodeLink">
                            @(loginCopied ? "Tersalin!" : "Salin Link")
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(loginCodeError))
                    {
                        <div class="alert alert-danger text-start mb-0">@loginCodeError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-warning me-auto" disabled="@isRefreshingCode" @onclick="() => showRefreshConfirm = true">Refresh Kode</button>
                    <button type="button" class="btn btn-outline-danger" disabled="@isUnlockingCode" @onclick="() => showUnlockConfirm = true">Buka Kunci</button>
                    <button type="button" class="btn btn-primary" @onclick="CloseLoginCodeModal">Selesai</button>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDeleteModal Show="showRefreshConfirm" IsBusy="isRefreshingCode" Title="Refresh Kode Login"
                     ConfirmText="Ya, Refresh" BusyText="Memproses..." ConfirmButtonClass="btn-warning"
                     OnConfirm="ConfirmRefreshCode" OnCancel="() => showRefreshConfirm = false">
    <Message>Kode lama langsung tidak berlaku. Perangkat yang sedang jalan tetap jalan, tapi kode di app Android harus diganti. Kalau tidak, perangkat tidak bisa masuk lagi begitu ter-logout.</Message>
</ConfirmDeleteModal>

<ConfirmDeleteModal Show="showUnlockConfirm" IsBusy="isUnlockingCode" Title="Buka Kunci Kode Login"
                     ConfirmText="Ya, Buka Kunci" BusyText="Memproses..." ConfirmButtonClass="btn-danger"
                     OnConfirm="ConfirmUnlockCode" OnCancel="() => showUnlockConfirm = false">
    <Message>Kode login dihapus. Perangkat yang sedang jalan tetap jalan, tapi app Android tidak bisa login ulang otomatis sampai stasiun dikunci lagi dan kodenya diperbarui.</Message>
</ConfirmDeleteModal>

<ConfirmDeleteModal Show="showDeleteConfirm" IsBusy="isDeleting" OnConfirm="ConfirmDelete" OnCancel="CancelDelete">
    <Message>Yakin ingin menghapus stasiun "@stationPendingDelete?.StationName"?</Message>
</ConfirmDeleteModal>

<ConfirmDeleteModal Show="showUnpairConfirm" IsBusy="isUnpairing" Title="Putuskan Perangkat"
                     ConfirmText="Ya, Putuskan" BusyText="Memutuskan..." ConfirmButtonClass="btn-warning"
                     OnConfirm="ConfirmUnpair" OnCancel="CancelUnpair">
    <Message>
        Yakin ingin memutuskan perangkat stasiun "@unpairTarget?.StationName"? Perangkat yang sedang aktif akan tertendang dan harus minta kode pairing baru untuk masuk lagi.
        @if (unpairTarget?.PairingCodeLocked == true)
        {
            <text> Perangkat dengan kode login terkunci bisa masuk lagi memakai kode yang sama &mdash; refresh kode kalau ingin menutup aksesnya.</text>
        }
    </Message>
</ConfirmDeleteModal>
}

@code {
    private StationPagedResult pagedResult = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showForm = false;
    private bool isEditMode = false;
    private bool? hasAccess = null;
    private string errorMessage = string.Empty;
    private StationFormModel formModel = new();
    private bool showDeleteConfirm = false;
    private bool isDeleting = false;
    private StationDto? stationPendingDelete;
    private List<DivisionDto> divisionOptions = new();
    private List<ResourceLookupDto> resourceOptions = new();
    private bool isGeneratingPairing = false;
    private bool showPairingModal = false;
    private bool pendingQrRender = false;
    private StationPairingResult? pairingResult;
    private bool copied = false;
    private bool showUnpairConfirm = false;
    private bool isUnpairing = false;
    private StationDto? unpairTarget;
    private string listError = string.Empty;

    // Prompt 85: kode login terkunci.
    private bool isLockingCode = false;
    private StationDto? loginCodeTarget;
    private string? loginCodeValue;
    private string loginCodeLink = string.Empty;
    private string loginCodeError = string.Empty;
    private bool pendingLoginQrRender = false;
    private bool loginCopied = false;
    private bool showRefreshConfirm = false;
    private bool isRefreshingCode = false;
    private bool showUnlockConfirm = false;
    private bool isUnlockingCode = false;

    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private string? sortColumn;
    private string sortDirection = "asc";
    private System.Threading.Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        hasAccess = state.User.HasClaim("module", "STATION_MANAGE");

        if (hasAccess == true)
        {
            divisionOptions = await DivisionApi.GetActiveAsync();
            await LoadStations();
        }
    }

    private async Task LoadStations()
    {
        isLoading = true;
        pagedResult = await StationApi.GetPagedAsync(new StationPagedRequest
        {
            Search = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
            PageNumber = currentPage,
            PageSize = pageSize,
            SortColumn = sortColumn,
            SortDirection = sortDirection
        });
        isLoading = false;
    }

    private async Task HandlePageSizeChange(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadStations();
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDirection = sortDirection == "asc" ? "desc" : "asc";
        else
        {
            sortColumn = column;
            sortDirection = "asc";
        }
        currentPage = 1;
        await LoadStations();
    }

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        debounceTimer?.Dispose();
        debounceTimer = new System.Threading.Timer(async _ =>
        {
            currentPage = 1;
            await InvokeAsync(async () =>
            {
                await LoadStations();
                StateHasChanged();
            });
        }, null, 400, Timeout.Infinite);
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > pagedResult.TotalPages) return;
        currentPage = page;
        await LoadStations();
    }

    private void OpenCreateForm()
    {
        isEditMode = false;
        formModel = new StationFormModel();
        resourceOptions = new();
        errorMessage = string.Empty;
        showForm = true;
    }

    private async Task OpenEditForm(StationDto station)
    {
        isEditMode = true;
        formModel = new StationFormModel
        {
            Id = station.Id,
            StationCode = station.StationCode,
            StationName = station.StationName,
            DivisionId = station.DivisionId,
            IsActive = station.IsActive,
            DefaultResourceId = station.DefaultResourceId ?? 0,
            AllowResourceChange = station.AllowResourceChange,
            EnablePacking = station.EnablePacking,
            AllowAllDivisions = station.AllowAllDivisions
        };
        errorMessage = string.Empty;
        await LoadResourceOptions();
        showForm = true;
    }

    private async Task OnDivisionChanged()
    {
        formModel.DefaultResourceId = 0;
        formModel.AllowResourceChange = true;
        await LoadResourceOptions();
    }

    private async Task LoadResourceOptions()
    {
        resourceOptions = formModel.DivisionId > 0
            ? await ResourceApi.GetActiveByDivisionAsync(formModel.DivisionId)
            : new();
    }

    private void OnDefaultResourceChanged()
    {
        if (formModel.DefaultResourceId <= 0)
            formModel.AllowResourceChange = true;
    }

    private void CloseForm()
    {
        showForm = false;
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = string.Empty;

        if (isEditMode)
        {
            var result = await StationApi.UpdateAsync(new StationUpdateRequest
            {
                Id = formModel.Id,
                StationCode = formModel.StationCode,
                StationName = formModel.StationName,
                DivisionId = formModel.DivisionId,
                IsActive = formModel.IsActive,
                DefaultResourceId = formModel.DefaultResourceId > 0 ? formModel.DefaultResourceId : null,
                AllowResourceChange = formModel.AllowResourceChange,
                EnablePacking = formModel.EnablePacking,
                AllowAllDivisions = formModel.AllowAllDivisions
            });

            isSaving = false;

            if (result.Success)
            {
                showForm = false;
                await LoadStations();
            }
            else
            {
                errorMessage = result.Error;
            }
        }
        else
        {
            var result = await StationApi.CreateAsync(new StationCreateRequest
            {
                StationCode = formModel.StationCode,
                StationName = formModel.StationName,
                DivisionId = formModel.DivisionId,
                IsActive = formModel.IsActive,
                DefaultResourceId = formModel.DefaultResourceId > 0 ? formModel.DefaultResourceId : null,
                AllowResourceChange = formModel.AllowResourceChange,
                EnablePacking = formModel.EnablePacking,
                AllowAllDivisions = formModel.AllowAllDivisions
            });

            isSaving = false;

            if (result.Success)
            {
                showForm = false;
                await LoadStations();
            }
            else
            {
                errorMessage = result.Error;
            }
        }
    }

    private async Task GeneratePairing(StationDto station)
    {
        isGeneratingPairing = true;
        var result = await StationApi.GeneratePairingCodeAsync(station.Id);
        isGeneratingPairing = false;

        if (result.Success)
        {
            await LoadStations();
            pairingResult = result.Result;
            copied = false;
            showPairingModal = true;
            pendingQrRender = true;
        }
        else
        {
            errorMessage = result.Error;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingQrRender && pairingResult is not null)
        {
            pendingQrRender = false;
            await JS.InvokeVoidAsync("qrCodeRenderer.render", "pairingQrCode", pairingResult.Link);
        }

        if (pendingLoginQrRender && loginCodeValue is not null)
        {
            pendingLoginQrRender = false;
            await JS.InvokeVoidAsync("qrCodeRenderer.render", "loginQrCode", loginCodeLink);
        }
    }

    // Prompt 85: kunci kode login (tanpa konfirmasi -- tidak menendang siapa pun).
    private async Task LockLoginCode(StationDto station)
    {
        listError = string.Empty;
        isLockingCode = true;
        var result = await StationApi.LockLoginCodeAsync(station.Id);
        isLockingCode = false;

        if (!result.Success || result.Result is null)
        {
            listError = result.Error;
            return;
        }

        await LoadStations();
        ShowLoginCode(station, result.Result.Code, result.Result.Link);
    }

    private void OpenLoginCodeModal(StationDto station)
    {
        if (string.IsNullOrEmpty(station.LoginCode)) return;
        ShowLoginCode(station, station.LoginCode, $"{pagedResult.PublicBaseUrl}/station/{station.LoginCode}");
    }

    private void ShowLoginCode(StationDto station, string code, string link)
    {
        loginCodeTarget = station;
        loginCodeValue = code;
        loginCodeLink = link;
        loginCodeError = string.Empty;
        loginCopied = false;
        pendingLoginQrRender = true;
    }

    private async Task CloseLoginCodeModal()
    {
        loginCodeTarget = null;
        loginCodeValue = null;
        await JS.InvokeVoidAsync("qrCodeRenderer.clear", "loginQrCode");
    }

    private async Task CopyLoginCodeLink()
    {
        await JS.InvokeVoidAsync("copyToClipboard", loginCodeLink);
        loginCopied = true;
    }

    private async Task ConfirmRefreshCode()
    {
        if (loginCodeTarget is null) return;

        isRefreshingCode = true;
        var result = await StationApi.LockLoginCodeAsync(loginCodeTarget.Id);
        isRefreshingCode = false;
        showRefreshConfirm = false;

        if (!result.Success || result.Result is null)
        {
            loginCodeError = result.Error;
            return;
        }

        loginCodeValue = result.Result.Code;
        loginCodeLink = result.Result.Link;
        loginCodeError = string.Empty;
        loginCopied = false;
        pendingLoginQrRender = true;
        await LoadStations();
    }

    private async Task ConfirmUnlockCode()
    {
        if (loginCodeTarget is null) return;

        isUnlockingCode = true;
        var result = await StationApi.UnlockLoginCodeAsync(loginCodeTarget.Id);
        isUnlockingCode = false;
        showUnlockConfirm = false;

        if (!result.Success)
        {
            loginCodeError = result.Error;
            return;
        }

        await CloseLoginCodeModal();
        await LoadStations();
    }

    private async Task CopyPairingLink()
    {
        await JS.InvokeVoidAsync("copyToClipboard", pairingResult?.Link ?? string.Empty);
        copied = true;
    }

    private async Task ClosePairingModal()
    {
        showPairingModal = false;
        pairingResult = null;
        await JS.InvokeVoidAsync("qrCodeRenderer.clear", "pairingQrCode");
    }

    private void HandleUnpair(StationDto station)
    {
        unpairTarget = station;
        showUnpairConfirm = true;
    }

    private void CancelUnpair()
    {
        showUnpairConfirm = false;
        unpairTarget = null;
    }

    private async Task ConfirmUnpair()
    {
        if (unpairTarget is null) return;

        isUnpairing = true;
        var result = await StationApi.UnpairAsync(unpairTarget.Id);
        isUnpairing = false;
        showUnpairConfirm = false;
        unpairTarget = null;

        if (result.Success)
            await LoadStations();
        else
            errorMessage = result.Error;
    }

    private static string DeviceStatus(StationDto s)
    {
        // Prompt 85: nama perangkat pemegang token (NULL = perangkat lama yang belum teradopsi)
        // + kapan terakhir memanggil API.
        if (s.PairedAt is not null || s.LastSeenAt is not null)
            return $"Dipakai: {s.PairedDeviceName ?? "Perangkat lama"} · aktif {StationDisplay.FormatLastSeen(s.LastSeenAt ?? s.PairedAt)}";
        if (s.PairingCodeExpiresAt is not null) return $"Kode aktif s.d. {s.PairingCodeExpiresAt:HH:mm}";
        return "Belum terhubung";
    }

    private void HandleDelete(StationDto station)
    {
        stationPendingDelete = station;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        stationPendingDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (stationPendingDelete is null) return;

        isDeleting = true;
        var success = await StationApi.DeleteAsync(stationPendingDelete.Id);
        isDeleting = false;

        showDeleteConfirm = false;
        stationPendingDelete = null;

        if (success)
            await LoadStations();
    }

    public class StationFormModel
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "Kode stasiun wajib diisi.")]
        [StringLength(30, ErrorMessage = "Kode stasiun maksimal 30 karakter.")]
        public string StationCode { get; set; } = string.Empty;

        [Required(ErrorMessage = "Nama stasiun wajib diisi.")]
        [StringLength(150, ErrorMessage = "Nama stasiun maksimal 150 karakter.")]
        public string StationName { get; set; } = string.Empty;

        [Range(1, int.MaxValue, ErrorMessage = "Divisi wajib dipilih.")]
        public int DivisionId { get; set; }

        public bool IsActive { get; set; } = true;

        public int DefaultResourceId { get; set; }
        public bool AllowResourceChange { get; set; } = true;
        public bool EnablePacking { get; set; }

        // alter_87: stasiun semua divisi tidak boleh dikunci ke resource bawaan (SP menolak),
        // jadi kunci otomatis dilepas saat flag ini dicentang.
        private bool allowAllDivisions;
        public bool AllowAllDivisions
        {
            get => allowAllDivisions;
            set
            {
                allowAllDivisions = value;
                if (value) AllowResourceChange = true;
            }
        }

        // Kebalikan AllowResourceChange, khusus untuk binding checkbox "Kunci ke resource bawaan".
        public bool LockToDefault
        {
            get => !AllowResourceChange;
            set => AllowResourceChange = !value;
        }
    }
}

@page "/projects"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Shared.Projects
@using TerakarsaApp.Shared.Buyers
@using TerakarsaApp.Shared.Employees
@using TerakarsaApp.Shared.Reports
@using TerakarsaApp.Shared.Bundles
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@inject ProjectApiService ProjectApi
@inject BuyerApiService BuyerApi
@inject EmployeeApiService EmployeeApi
@inject ArticleApiService ArticleApi
@inject ArticlePhotoApiService ArticlePhotoApi
@inject BundleApiService BundleApi
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Data Project</PageTitle>

<div class="page-header">
    <h1 class="page-title">Data Project</h1>
    <div>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="javascript:void(0)">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Data Project</li>
        </ol>
    </div>
</div>

@if (hasAccess is null)
{
    <p>Memeriksa akses...</p>
}
else if (hasAccess == false)
{
    <div class="alert alert-danger">Anda tidak memiliki akses ke modul ini.</div>
}
else
{
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-primary" @onclick="OpenCreateForm">
            + Tambah Project
        </button>
        <PageSizeSelector PageSize="pageSize" PageSizeChanged="HandlePageSizeChange" />
        <select class="form-select" style="width: 180px;" @bind="statusFilter" @bind:after="HandleStatusFilterChange">
            <option value="">Semua</option>
            <option value="NOT_STARTED">Belum Dimulai</option>
            <option value="STARTED">Dimulai</option>
            <option value="ON_GOING">Berjalan</option>
            <option value="ON_HOLD">Ditahan</option>
            <option value="COMPLETED">Selesai</option>
            <option value="CANCELLED">Dibatalkan</option>
        </select>
    </div>

    <div style="width: 300px;">
        <input class="form-control" placeholder="Cari nama project / no PO / buyer..."
               @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
    </div>
</div>

<div class="row">
    <div class="col-12">
        @if (isLoading)
        {
            <p>Memuat data...</p>
        }
        else if (pagedResult.Items.Count == 0)
        {
            <p>Tidak ada data project.</p>
        }
        else
        {
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Daftar Project</h3>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered border text-nowrap mb-0">
                            <thead>
                                <tr>
                                    <th>Foto</th>
                                    <SortableHeader Label="Nama Project" Column="ProjectName" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                                    <SortableHeader Label="Buyer" Column="BuyerName" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                                    <SortableHeader Label="No PO" Column="NoPo" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                                    <th>Nama Bahan</th>
                                    <SortableHeader Label="Tgl Order" Column="OrderDate" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                                    <SortableHeader Label="Deadline" Column="Deadline" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                                    <th>MD</th>
                                    <th>PIC</th>
                                    <th>Catatan</th>
                                    <th>%</th>
                                    <th>Status</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in pagedResult.Items)
                                {
                                    <tr @onclick="() => SelectProject(p.Id)" style="cursor: pointer; @(p.Id == selectedProjectId ? "background-color: #f5f5f5;" : "")">
                                        <td>
                                            @if (thumbnails.TryGetValue(p.Id, out var thumbUrl))
                                            {
                                                <img src="@thumbUrl" alt="Foto" style="width: 36px; height: 36px; object-fit: cover; border-radius: 4px;" />
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @p.ProjectName
                                            @if (p.IsUrgent)
                                            {
                                                <span class="badge bg-danger ms-1">Urgent</span>
                                            }
                                        </td>
                                        <td>@p.BuyerName</td>
                                        <td>@(p.NoPo ?? "-")</td>
                                        <td>@(p.MaterialName ?? "-")</td>
                                        <td>@(p.OrderDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td>@(p.Deadline?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td>@(p.ProjectMdName ?? "-")</td>
                                        <td>@(p.ProjectPicName ?? "-")</td>
                                        <td>@(p.Remarks ?? "-")</td>
                                        <td>@p.ProgressPercent.ToString("0.#")%</td>
                                        <td>
                                            <span class="badge @StatusBadgeClass(p.DerivedStatus)" title="@(p.DerivedStatus == "ON_HOLD" ? p.StatusReason : null)">@StatusLabel(p.DerivedStatus)</span>
                                            @if (p.DerivedStatus == "ON_HOLD" && !string.IsNullOrWhiteSpace(p.StatusReason))
                                            {
                                                <div class="small text-muted">@p.StatusReason</div>
                                            }
                                            @if (p.HasUnsetWorkflow)
                                            {
                                                <div class="small text-danger">Ada artikel belum di-set workflow</div>
                                            }
                                        </td>
                                        <td @onclick:stopPropagation="true">
                                            <a class="btn btn-sm btn-primary me-1" title="Edit" href="@($"/projects/edit/{p.Id}")" target="_blank"><i class="fe fe-edit"></i></a>
                                            <button class="btn btn-sm btn-danger" title="Hapus" @onclick="() => HandleDelete(p)"><i class="fe fe-trash-2"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <TablePagination PageNumber="currentPage" PageSize="pageSize" TotalCount="pagedResult.TotalCount" TotalPages="pagedResult.TotalPages" PageNumberChanged="ChangePage" />
                </div>
            </div>
        }
    </div>
</div>

<div class="row">
    <div class="col-lg-4 mb-4 mb-lg-0">
        <div class="card h-100 mb-0">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0">Artikel</h3>
                <a class="btn btn-sm btn-primary @(selectedProjectId is null ? "disabled" : "")" href="@($"/projects/{selectedProjectId}/articles/create")" target="_blank">+ Tambah Artikel</a>
            </div>
            <div class="card-body">
                @if (selectedProjectId is null)
                {
                    <p class="text-muted mb-0">Pilih project untuk melihat artikel.</p>
                }
                else if (isLoadingArticles)
                {
                    <p class="mb-0">Memuat artikel...</p>
                }
                else if (selectedProjectArticles.Count == 0)
                {
                    <p class="text-muted mb-0">Belum ada artikel untuk project ini.</p>
                }
                else
                {
                    @foreach (var a in selectedProjectArticles)
                    {
                        <div class="d-flex align-items-start border-bottom pb-2 mb-2">
                            <div class="me-2">
                                @if (articleThumbnails.TryGetValue(a.Id, out var thumbUrl))
                                {
                                    <img src="@thumbUrl" alt="Foto" style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-light text-muted" style="width: 48px; height: 48px; border-radius: 4px;">-</div>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold">@a.ArticleName</div>
                                <div class="small text-muted">@(a.Style ?? "-") / @(a.Color ?? "-")</div>
                                <div class="small">Qty: @a.TotalQty</div>
                            </div>
                            @if (articleSizes.TryGetValue(a.Id, out var sizes) && sizes.Count > 0)
                            {
                                <div class="ms-2" style="font-size: 11px; line-height: 1.4; white-space: nowrap;">
                                    @foreach (var s in sizes)
                                    {
                                        <div>@(s.SizeName) : @s.Qty</div>
                                    }
                                </div>
                            }
                            <div class="ms-2 d-flex flex-column gap-1">
                                <a class="btn btn-sm btn-primary" title="Edit" href="@($"/projects/{selectedProjectId}/articles/{a.Id}/edit")" target="_blank"><i class="fe fe-edit"></i></a>
                                <a class="btn btn-sm btn-info" title="Kelola Bundle" href="@($"/bundles/{a.Id}/edit")" target="_blank"><i class="fe fe-package"></i></a>
                                <button class="btn btn-sm btn-danger" title="Hapus" @onclick="() => HandleDeleteArticle(a)"><i class="fe fe-trash-2"></i></button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4 mb-lg-0">
        <div class="card h-100 mb-0">
            <div class="card-header">
                <h3 class="card-title mb-0">Bundle</h3>
            </div>
            <div class="card-body">
                @if (!hasBundleAccess)
                {
                    <p class="text-muted mb-0">Anda tidak memiliki akses ke rekap bundle.</p>
                }
                else if (selectedProjectId is null)
                {
                    <p class="text-muted mb-0">Pilih project untuk melihat rekap bundle.</p>
                }
                else if (isLoadingBundleSummaries)
                {
                    <p class="mb-0">Memuat rekap bundle...</p>
                }
                else if (selectedProjectArticles.Count == 0)
                {
                    <p class="text-muted mb-0">Belum ada artikel untuk project ini.</p>
                }
                else
                {
                    @foreach (var a in selectedProjectArticles)
                    {
                        var summaries = articleBundleSummaries.TryGetValue(a.Id, out var s) ? s : new();
                        <div class="border-bottom pb-2 mb-2">
                            <div class="fw-bold">@a.ArticleName</div>
                            @if (summaries.Count == 0)
                            {
                                <div class="small text-muted">Belum ada bundle.</div>
                            }
                            else
                            {
                                <table class="table table-sm table-borderless mb-0" style="table-layout: fixed;">
                                    <tbody>
                                        @foreach (var b in summaries)
                                        {
                                            var pct = b.QtyOrder > 0 ? Math.Round(100.0 * b.TotalBundleQty / b.QtyOrder) : 0;
                                            <tr class="small">
                                                <td class="ps-0">@b.SizeName</td>
                                                <td>@b.BundleCount bundle</td>
                                                <td>@b.TotalBundleQty pcs</td>
                                                <td class="text-end pe-0">@pct %</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100 mb-0">
            <div class="card-header">
                <h3 class="card-title mb-0">Laporan Progress per Ukuran</h3>
            </div>
            <div class="card-body">
                @if (selectedProjectId is null)
                {
                    <p class="text-muted mb-0">Pilih project untuk melihat laporan progress.</p>
                }
                else if (isLoadingSizeProgress)
                {
                    <p class="mb-0">Memuat laporan progress...</p>
                }
                else if (selectedProjectArticles.Count == 0)
                {
                    <p class="text-muted mb-0">Belum ada artikel untuk project ini.</p>
                }
                else
                {
                    @foreach (var a in selectedProjectArticles)
                    {
                        <div class="fw-bold mb-1">@a.ArticleName</div>
                        @if (!articleSizeProgress.TryGetValue(a.Id, out var progress) || progress.Sizes.Count == 0)
                        {
                            <div class="small text-muted mb-2">Belum ada data ukuran.</div>
                        }
                        else
                        {
                            var steps = progress.Steps.OrderBy(s => s.SortOrder).ToList();
                            var sizes = progress.Sizes.OrderBy(s => s.SortOrder).ToList();
                            var poTotal = sizes.Sum(s => s.PoQty);
                            <div class="table-responsive mb-2">
                                <table class="table table-sm table-bordered border text-center mb-0">
                                    <thead>
                                        <tr>
                                            <th class="text-start">Ukuran</th>
                                            <th>PO</th>
                                            @foreach (var step in steps)
                                            {
                                                <th>@step.StepName</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var size in sizes)
                                        {
                                            <tr>
                                                <td class="text-start fw-bold">@size.SizeName</td>
                                                <td>@size.PoQty</td>
                                                @foreach (var step in steps)
                                                {
                                                    <td>@GetCellQty(progress, step.ArticleWorkflowId, size.SizeId)</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="fw-bold">
                                            <td class="text-start">Total</td>
                                            <td>@poTotal</td>
                                            @foreach (var step in steps)
                                            {
                                                <td>@GetStepTotal(progress, step.ArticleWorkflowId)</td>
                                            }
                                        </tr>
                                        <tr class="small text-muted">
                                            <td class="text-start">%</td>
                                            <td>-</td>
                                            @foreach (var step in steps)
                                            {
                                                <td>@GetStepPercentLabel(progress, step.ArticleWorkflowId, poTotal)</td>
                                            }
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>

@if (showForm)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Tambah Project</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-3">
                            <label class="form-label">Nama Project</label>
                            <InputText class="form-control" @bind-Value="formModel.ProjectName" />
                            <ValidationMessage For="@(() => formModel.ProjectName)" class="text-danger" />
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label">Buyer</label>
                                <SearchableSelect TItem="BuyerDto" Items="buyerOptions" @bind-Value="formModel.CustomerId"
                                                  IdSelector="@(b => b.Id)" TextSelector="@(b => b.BuyerName)"
                                                  Placeholder="Cari buyer..." />
                                <ValidationMessage For="@(() => formModel.CustomerId)" class="text-danger" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">No PO</label>
                                <InputText class="form-control" @bind-Value="formModel.NoPo" />
                                <ValidationMessage For="@(() => formModel.NoPo)" class="text-danger" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label">MD</label>
                                <SearchableSelect TItem="EmployeeDto" Items="employeeOptions" @bind-Value="formModel.ProjectMd"
                                                  IdSelector="@(e => e.Id)" TextSelector="@(e => e.EmployeeName)"
                                                  Placeholder="Cari nama karyawan..." AllowNone="true" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">PIC</label>
                                <SearchableSelect TItem="EmployeeDto" Items="employeeOptions" @bind-Value="formModel.ProjectPic"
                                                  IdSelector="@(e => e.Id)" TextSelector="@(e => e.EmployeeName)"
                                                  Placeholder="Cari nama karyawan..." AllowNone="true" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nama Bahan</label>
                            <InputText class="form-control" @bind-Value="formModel.MaterialName" />
                            <ValidationMessage For="@(() => formModel.MaterialName)" class="text-danger" />
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label">Tanggal Order</label>
                                <InputDate class="form-control" @bind-Value="formModel.OrderDate" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Deadline</label>
                                <InputDate class="form-control" @bind-Value="formModel.Deadline" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label">Tanggal Mulai</label>
                                <InputDate class="form-control" @bind-Value="formModel.StartDate" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Tanggal Kirim</label>
                                <InputDate class="form-control" @bind-Value="formModel.DeliveryDate" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Catatan</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="formModel.Remarks" />
                            <ValidationMessage For="@(() => formModel.Remarks)" class="text-danger" />
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="formModel.IsUrgent" />
                            <label class="form-check-label">Urgent</label>
                        </div>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }
                        <button type="submit" class="btn btn-primary w-100" disabled="@isSaving">
                            @(isSaving ? "Menyimpan..." : "Simpan")
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDeleteModal Show="showDeleteConfirm" IsBusy="isDeleting" OnConfirm="ConfirmDelete" OnCancel="CancelDelete">
    <Message>Yakin ingin menghapus project "@projectPendingDelete?.ProjectName"?</Message>
</ConfirmDeleteModal>

<ConfirmDeleteModal Show="showDeleteArticleConfirm" IsBusy="isDeletingArticle" OnConfirm="ConfirmDeleteArticle" OnCancel="CancelDeleteArticle">
    <Message>Yakin ingin menghapus artikel "@articlePendingDelete?.ArticleName"?</Message>
</ConfirmDeleteModal>
}

@code {
    private ProjectPagedResult pagedResult = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showForm = false;
    private bool? hasAccess = null;
    private string errorMessage = string.Empty;
    private ProjectFormModel formModel = new();
    private bool showDeleteConfirm = false;
    private bool isDeleting = false;
    private ProjectDto? projectPendingDelete;
    private List<BuyerDto> buyerOptions = new();
    private List<EmployeeDto> employeeOptions = new();
    private Dictionary<int, string> thumbnails = new();

    private int? selectedProjectId;
    private List<ArticleListItemDto> selectedProjectArticles = new();
    private bool isLoadingArticles = false;
    private Dictionary<int, string> articleThumbnails = new();
    private Dictionary<int, List<ArticleSizeSummaryDto>> articleSizes = new();
    private bool showDeleteArticleConfirm = false;
    private bool isDeletingArticle = false;
    private ArticleListItemDto? articlePendingDelete;

    private bool isLoadingSizeProgress = false;
    private Dictionary<int, ArticleSizeProgressResultDto> articleSizeProgress = new();

    private bool hasBundleAccess = false;
    private bool isLoadingBundleSummaries = false;
    private Dictionary<int, List<BundleSizeSummaryDto>> articleBundleSummaries = new();

    private static int GetCellQty(ArticleSizeProgressResultDto progress, int articleWorkflowId, int sizeId)
        => progress.Cells.FirstOrDefault(c => c.ArticleWorkflowId == articleWorkflowId && c.SizeId == sizeId)?.QtyOk ?? 0;

    private static int GetStepTotal(ArticleSizeProgressResultDto progress, int articleWorkflowId)
        => progress.Cells.Where(c => c.ArticleWorkflowId == articleWorkflowId).Sum(c => c.QtyOk);

    private static string GetStepPercentLabel(ArticleSizeProgressResultDto progress, int articleWorkflowId, int poTotal)
    {
        if (poTotal <= 0) return "-";
        var stepTotal = GetStepTotal(progress, articleWorkflowId);
        return $"{(decimal)stepTotal / poTotal * 100:0.0}%";
    }

    private string searchTerm = string.Empty;
    private string statusFilter = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private string? sortColumn;
    private string sortDirection = "asc";
    private System.Threading.Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        hasAccess = state.User.HasClaim("module", "ORDER_PROJECT");
        hasBundleAccess = state.User.HasClaim("module", "BUNDLE_MANAGE");

        if (hasAccess == true)
        {
            buyerOptions = await BuyerApi.GetActiveAsync();
            employeeOptions = await EmployeeApi.GetActiveAsync();
            await LoadProjects();
        }
    }

    private async Task LoadProjects()
    {
        isLoading = true;
        pagedResult = await ProjectApi.GetPagedAsync(new ProjectPagedRequest
        {
            Search = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
            Status = string.IsNullOrWhiteSpace(statusFilter) ? null : statusFilter,
            PageNumber = currentPage,
            PageSize = pageSize,
            SortColumn = sortColumn,
            SortDirection = sortDirection
        });
        isLoading = false;
        await LoadThumbnails();
    }

    private async Task HandleStatusFilterChange()
    {
        currentPage = 1;
        await LoadProjects();
    }

    private static string StatusLabel(string status) => status switch
    {
        "NOT_STARTED" => "Belum Dimulai",
        "STARTED" => "Dimulai",
        "ON_GOING" => "Berjalan",
        "ON_HOLD" => "Ditahan",
        "COMPLETED" => "Selesai",
        "CANCELLED" => "Dibatalkan",
        _ => status
    };

    private static string StatusBadgeClass(string status) => status switch
    {
        "NOT_STARTED" => "bg-secondary",
        "STARTED" => "bg-info",
        "ON_GOING" => "bg-primary",
        "ON_HOLD" => "bg-warning",
        "COMPLETED" => "bg-success",
        "CANCELLED" => "bg-danger",
        _ => "bg-secondary"
    };

    private async Task LoadThumbnails()
    {
        var tasks = pagedResult.Items.Select(async p =>
        {
            var result = await ArticlePhotoApi.GetFirstPhotoForProjectAsync(p.Id);
            if (result is null) return (p.Id, Url: (string?)null);

            var base64 = Convert.ToBase64String(result.Value.Bytes);
            return (p.Id, Url: (string?)$"data:{result.Value.ContentType};base64,{base64}");
        });

        var results = await Task.WhenAll(tasks);
        thumbnails = results.Where(r => r.Url is not null).ToDictionary(r => r.Id, r => r.Url!);
    }

    private async Task HandlePageSizeChange(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadProjects();
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDirection = sortDirection == "asc" ? "desc" : "asc";
        else
        {
            sortColumn = column;
            sortDirection = "asc";
        }
        currentPage = 1;
        await LoadProjects();
    }

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        debounceTimer?.Dispose();
        debounceTimer = new System.Threading.Timer(async _ =>
        {
            currentPage = 1;
            await InvokeAsync(async () =>
            {
                await LoadProjects();
                StateHasChanged();
            });
        }, null, 400, Timeout.Infinite);
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > pagedResult.TotalPages) return;
        currentPage = page;
        await LoadProjects();
    }

    private void OpenCreateForm()
    {
        formModel = new ProjectFormModel();
        errorMessage = string.Empty;
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = string.Empty;

        var result = await ProjectApi.CreateAsync(new ProjectCreateRequest
        {
            ProjectName = formModel.ProjectName,
            CustomerId = formModel.CustomerId,
            ProjectMd = formModel.ProjectMd > 0 ? formModel.ProjectMd : null,
            ProjectPic = formModel.ProjectPic > 0 ? formModel.ProjectPic : null,
            NoPo = string.IsNullOrWhiteSpace(formModel.NoPo) ? null : formModel.NoPo,
            MaterialName = string.IsNullOrWhiteSpace(formModel.MaterialName) ? null : formModel.MaterialName,
            OrderDate = formModel.OrderDate,
            StartDate = formModel.StartDate,
            Deadline = formModel.Deadline,
            DeliveryDate = formModel.DeliveryDate,
            Remarks = string.IsNullOrWhiteSpace(formModel.Remarks) ? null : formModel.Remarks,
            IsUrgent = formModel.IsUrgent
        });

        isSaving = false;

        if (result.Success)
        {
            showForm = false;
            Nav.NavigateTo($"/projects/edit/{result.Id}");
        }
        else
        {
            errorMessage = result.Error;
        }
    }

    private void HandleDelete(ProjectDto project)
    {
        projectPendingDelete = project;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        projectPendingDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (projectPendingDelete is null) return;

        isDeleting = true;
        var success = await ProjectApi.DeleteAsync(projectPendingDelete.Id);
        isDeleting = false;

        showDeleteConfirm = false;
        projectPendingDelete = null;

        if (success)
            await LoadProjects();
    }

    private async Task SelectProject(int projectId)
    {
        selectedProjectId = projectId;
        isLoadingArticles = true;
        selectedProjectArticles = await ArticleApi.GetByProjectAsync(projectId);
        isLoadingArticles = false;
        await LoadArticleThumbnails();
        await LoadArticleSizes(projectId);
        await LoadSizeProgress();
        await LoadBundleSummaries();
    }

    private async Task LoadSizeProgress()
    {
        isLoadingSizeProgress = true;
        var tasks = selectedProjectArticles.Select(async a =>
        {
            var progress = await ArticleApi.GetSizeProgressAsync(a.Id);
            return (a.Id, Progress: progress);
        });
        var results = await Task.WhenAll(tasks);
        articleSizeProgress = results.ToDictionary(r => r.Id, r => r.Progress);
        isLoadingSizeProgress = false;
    }

    private async Task LoadBundleSummaries()
    {
        if (!hasBundleAccess) return;

        isLoadingBundleSummaries = true;
        var tasks = selectedProjectArticles.Select(async a =>
        {
            var result = await BundleApi.GetByArticleAsync(a.Id);
            return (a.Id, result.Summary);
        });
        var results = await Task.WhenAll(tasks);
        articleBundleSummaries = results.ToDictionary(r => r.Id, r => r.Summary);
        isLoadingBundleSummaries = false;
    }

    private async Task LoadArticleSizes(int projectId)
    {
        var sizes = await ArticleApi.GetSizesByProjectAsync(projectId);
        articleSizes = sizes.GroupBy(s => s.ArticleId).ToDictionary(g => g.Key, g => g.ToList());
    }

    private async Task LoadArticleThumbnails()
    {
        var tasks = selectedProjectArticles.Select(async a =>
        {
            var result = await ArticlePhotoApi.GetPrimaryPhotoAsync(a.Id);
            if (result is null) return (a.Id, Url: (string?)null);

            var base64 = Convert.ToBase64String(result.Value.Bytes);
            return (a.Id, Url: (string?)$"data:{result.Value.ContentType};base64,{base64}");
        });

        var results = await Task.WhenAll(tasks);
        articleThumbnails = results.Where(r => r.Url is not null).ToDictionary(r => r.Id, r => r.Url!);
    }

    private void HandleDeleteArticle(ArticleListItemDto article)
    {
        articlePendingDelete = article;
        showDeleteArticleConfirm = true;
    }

    private void CancelDeleteArticle()
    {
        showDeleteArticleConfirm = false;
        articlePendingDelete = null;
    }

    private async Task ConfirmDeleteArticle()
    {
        if (articlePendingDelete is null || selectedProjectId is null) return;

        isDeletingArticle = true;
        var success = await ArticleApi.DeleteAsync(articlePendingDelete.Id);
        isDeletingArticle = false;

        showDeleteArticleConfirm = false;
        articlePendingDelete = null;

        if (success)
            await SelectProject(selectedProjectId.Value);
    }

    public class ProjectFormModel
    {
        [Required(ErrorMessage = "Nama project wajib diisi.")]
        [StringLength(150, ErrorMessage = "Nama project maksimal 150 karakter.")]
        public string ProjectName { get; set; } = string.Empty;

        [Range(1, int.MaxValue, ErrorMessage = "Buyer wajib dipilih.")]
        public int CustomerId { get; set; }

        public int ProjectMd { get; set; }

        public int ProjectPic { get; set; }

        [StringLength(50, ErrorMessage = "No PO maksimal 50 karakter.")]
        public string? NoPo { get; set; }

        [StringLength(150, ErrorMessage = "Nama bahan maksimal 150 karakter.")]
        public string? MaterialName { get; set; }

        public DateTime? OrderDate { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? Deadline { get; set; }
        public DateTime? DeliveryDate { get; set; }

        [StringLength(500, ErrorMessage = "Catatan maksimal 500 karakter.")]
        public string? Remarks { get; set; }

        public bool IsUrgent { get; set; }
    }
}

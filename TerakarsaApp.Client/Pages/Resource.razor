@page "/resources"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Shared.Resources
@using TerakarsaApp.Shared.Divisions
@using TerakarsaApp.Shared.ResourceTypes
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@inject ResourceApiService ResourceApi
@inject DivisionApiService DivisionApi
@inject ResourceTypeApiService ResourceTypeApi
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Data Resource</PageTitle>

<div class="page-header">
    <h1 class="page-title">Data Resource</h1>
    <div>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="javascript:void(0)">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Data Resource</li>
        </ol>
    </div>
</div>

@if (hasAccess is null)
{
    <p>Memeriksa akses...</p>
}
else if (hasAccess == false)
{
    <div class="alert alert-danger">Anda tidak memiliki akses ke modul ini.</div>
}
else
{
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-primary" @onclick="OpenCreateForm">
            + Tambah Resource
        </button>
        <PageSizeSelector PageSize="pageSize" PageSizeChanged="HandlePageSizeChange" />
    </div>

    <div style="width: 300px;">
        <input class="form-control" placeholder="Cari nama resource / divisi / tipe..."
               @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
    </div>
</div>

@if (isLoading)
{
    <p>Memuat data...</p>
}
else if (pagedResult.Items.Count == 0)
{
    <p>Tidak ada data resource.</p>
}
else
{
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Daftar Resource</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered border text-nowrap mb-0">
                    <thead>
                        <tr>
                            <SortableHeader Label="Nama Resource" Column="ResourceName" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                            <SortableHeader Label="Divisi" Column="DivisionName" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                            <SortableHeader Label="Tipe Resource" Column="ResourceTypeName" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                            <th>Status</th>
                            <th>Dashboard</th>
                            <th>Counterpart</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in pagedResult.Items)
                        {
                            <tr>
                                <td>@r.ResourceName</td>
                                <td>@r.DivisionName</td>
                                <td>@r.ResourceTypeName</td>
                                <td>
                                    <span class="badge @(r.IsActive ? "bg-success" : "bg-secondary")">
                                        @(r.IsActive ? "Aktif" : "Nonaktif")
                                    </span>
                                </td>
                                <td>
                                    @if (r.IncludeInDashboard)
                                    {
                                        <span class="badge bg-info">Ikut Dashboard</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Tidak</span>
                                    }
                                </td>
                                <td>@(r.CounterpartResourceName is not null ? $"{r.CounterpartResourceName} ({r.CounterpartDivisionName})" : "-")</td>
                                <td>
                                    <button class="btn btn-sm btn-primary me-1" title="Edit" @onclick="() => OpenEditForm(r)"><i class="fe fe-edit"></i></button>
                                    <button class="btn btn-sm btn-danger" title="Hapus" @onclick="() => HandleDelete(r)"><i class="fe fe-trash-2"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <TablePagination PageNumber="currentPage" PageSize="pageSize" TotalCount="pagedResult.TotalCount" TotalPages="pagedResult.TotalPages" PageNumberChanged="ChangePage" />
        </div>
    </div>
}

@if (showForm)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Edit Resource" : "Tambah Resource")</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-3">
                            <label class="form-label">Divisi</label>
                            <InputSelect class="form-select" @bind-Value="formModel.DivisionId" @bind-Value:after="OnDivisionChanged">
                                <option value="0">-- Pilih Divisi --</option>
                                @foreach (var d in divisionOptions)
                                {
                                    <option value="@d.Id">@d.DivisionName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => formModel.DivisionId)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Counterpart (Divisi Berikutnya)</label>
                            <SearchableSelect TItem="ResourceCounterpartOptionDto" Items="counterpartOptions"
                                              @bind-Value="formModel.CounterpartResourceId"
                                              IdSelector="@(o => o.Id)" TextSelector="@(o => $"{o.ResourceName} ({o.DivisionName})")"
                                              AllowNone="true" NoneLabel="- Tidak ada -" Placeholder="Cari resource..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tipe Resource</label>
                            <InputSelect class="form-select" @bind-Value="formModel.ResourceTypeId">
                                <option value="0">-- Pilih Tipe Resource --</option>
                                @foreach (var t in resourceTypeOptions)
                                {
                                    <option value="@t.Id">@t.ResourceTypeName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => formModel.ResourceTypeId)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nama Resource</label>
                            <InputText class="form-control" @bind-Value="formModel.ResourceName" />
                            <ValidationMessage For="@(() => formModel.ResourceName)" class="text-danger" />
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="formModel.IsActive" />
                            <label class="form-check-label">Aktif</label>
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="formModel.IncludeInDashboard" />
                            <label class="form-check-label">Ikut Dashboard</label>
                        </div>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }
                        <button type="submit" class="btn btn-primary w-100" disabled="@isSaving">
                            @(isSaving ? "Menyimpan..." : "Simpan")
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDeleteModal Show="showDeleteConfirm" IsBusy="isDeleting" OnConfirm="ConfirmDelete" OnCancel="CancelDelete">
    <Message>Yakin ingin menghapus resource "@resourcePendingDelete?.ResourceName"?</Message>
</ConfirmDeleteModal>
}

@code {
    private ResourcePagedResult pagedResult = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showForm = false;
    private bool isEditMode = false;
    private bool? hasAccess = null;
    private string errorMessage = string.Empty;
    private ResourceFormModel formModel = new();
    private bool showDeleteConfirm = false;
    private bool isDeleting = false;
    private ResourceDto? resourcePendingDelete;
    private List<DivisionDto> divisionOptions = new();
    private List<ResourceTypeDto> resourceTypeOptions = new();
    private List<ResourceCounterpartOptionDto> counterpartOptions = new();

    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private string? sortColumn;
    private string sortDirection = "asc";
    private System.Threading.Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        hasAccess = state.User.HasClaim("module", "MASTER_RESOURCE");

        if (hasAccess == true)
        {
            divisionOptions = await DivisionApi.GetActiveAsync();
            resourceTypeOptions = await ResourceTypeApi.GetActiveAsync();
            await LoadResources();
        }
    }

    private async Task LoadResources()
    {
        isLoading = true;
        pagedResult = await ResourceApi.GetPagedAsync(new ResourcePagedRequest
        {
            Search = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
            PageNumber = currentPage,
            PageSize = pageSize,
            SortColumn = sortColumn,
            SortDirection = sortDirection
        });
        isLoading = false;
    }

    private async Task HandlePageSizeChange(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadResources();
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDirection = sortDirection == "asc" ? "desc" : "asc";
        else
        {
            sortColumn = column;
            sortDirection = "asc";
        }
        currentPage = 1;
        await LoadResources();
    }

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        debounceTimer?.Dispose();
        debounceTimer = new System.Threading.Timer(async _ =>
        {
            currentPage = 1;
            await InvokeAsync(async () =>
            {
                await LoadResources();
                StateHasChanged();
            });
        }, null, 400, Timeout.Infinite);
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > pagedResult.TotalPages) return;
        currentPage = page;
        await LoadResources();
    }

    private async Task OpenCreateForm()
    {
        isEditMode = false;
        formModel = new ResourceFormModel();
        errorMessage = string.Empty;
        counterpartOptions = await ResourceApi.GetActiveExceptDivisionAsync(null);
        showForm = true;
    }

    private async Task OpenEditForm(ResourceDto resource)
    {
        isEditMode = true;
        formModel = new ResourceFormModel
        {
            Id = resource.Id,
            DivisionId = resource.DivisionId,
            ResourceTypeId = resource.ResourceTypeId,
            ResourceName = resource.ResourceName,
            IsActive = resource.IsActive,
            IncludeInDashboard = resource.IncludeInDashboard,
            CounterpartResourceId = resource.CounterpartResourceId ?? 0
        };
        errorMessage = string.Empty;
        counterpartOptions = await ResourceApi.GetActiveExceptDivisionAsync(resource.DivisionId);
        showForm = true;
    }

    // Prompt 39: dropdown Pasangan mengikuti Divisi yang sedang dipilih (pasangan wajib
    // beda divisi) -- reload opsi & reset pilihan yang jadi tidak valid.
    private async Task OnDivisionChanged()
    {
        counterpartOptions = formModel.DivisionId > 0
            ? await ResourceApi.GetActiveExceptDivisionAsync(formModel.DivisionId)
            : await ResourceApi.GetActiveExceptDivisionAsync(null);

        if (formModel.CounterpartResourceId > 0 && !counterpartOptions.Any(o => o.Id == formModel.CounterpartResourceId))
            formModel.CounterpartResourceId = 0;
    }

    private void CloseForm()
    {
        showForm = false;
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = string.Empty;

        (bool Success, string Error) result;
        if (isEditMode)
        {
            result = await ResourceApi.UpdateAsync(new ResourceUpdateRequest
            {
                Id = formModel.Id,
                DivisionId = formModel.DivisionId,
                ResourceTypeId = formModel.ResourceTypeId,
                ResourceName = formModel.ResourceName,
                IsActive = formModel.IsActive,
                IncludeInDashboard = formModel.IncludeInDashboard,
                CounterpartResourceId = formModel.CounterpartResourceId > 0 ? formModel.CounterpartResourceId : null
            });
        }
        else
        {
            result = await ResourceApi.CreateAsync(new ResourceCreateRequest
            {
                DivisionId = formModel.DivisionId,
                ResourceTypeId = formModel.ResourceTypeId,
                ResourceName = formModel.ResourceName,
                IsActive = formModel.IsActive,
                IncludeInDashboard = formModel.IncludeInDashboard,
                CounterpartResourceId = formModel.CounterpartResourceId > 0 ? formModel.CounterpartResourceId : null
            });
        }

        isSaving = false;

        if (result.Success)
        {
            showForm = false;
            await LoadResources();
        }
        else
        {
            errorMessage = result.Error;
        }
    }

    private void HandleDelete(ResourceDto resource)
    {
        resourcePendingDelete = resource;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        resourcePendingDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (resourcePendingDelete is null) return;

        isDeleting = true;
        var success = await ResourceApi.DeleteAsync(resourcePendingDelete.Id);
        isDeleting = false;

        showDeleteConfirm = false;
        resourcePendingDelete = null;

        if (success)
            await LoadResources();
    }

    public class ResourceFormModel
    {
        public int Id { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Divisi wajib dipilih.")]
        public int DivisionId { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Tipe resource wajib dipilih.")]
        public int ResourceTypeId { get; set; }

        [Required(ErrorMessage = "Nama resource wajib diisi.")]
        [StringLength(150, ErrorMessage = "Nama resource maksimal 150 karakter.")]
        public string ResourceName { get; set; } = string.Empty;

        public bool IsActive { get; set; } = true;
        public bool IncludeInDashboard { get; set; } = true;
        public int CounterpartResourceId { get; set; }
    }
}

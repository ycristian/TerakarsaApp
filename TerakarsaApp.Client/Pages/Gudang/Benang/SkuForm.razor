@page "/gudang/benang/sku/baru"
@page "/gudang/benang/sku/edit/{Id:int}"
@attribute [Authorize]
@layout TerakarsaApp.Client.Layout.BenangLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using TerakarsaApp.Client.Pages.Gudang.Benang.Shared
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Client.Shared
@using TerakarsaApp.Shared.Inv
@inject ThreadStockApiService ThreadApi
@inject NavigationManager Nav

@* Prompt 71 -- form SKU benang (tidak punya mockup sendiri; gaya mengikuti
   Sku.dc.html: kepala putih + kartu putih + tombol aksi menempel di bawah).

   sku_code TIDAK ada di form: dibuat inv.SIS_ThreadItem_Manage saat CREATE dan
   tidak pernah berubah -- label QR yang sudah tertempel di kones harus tetap
   dikenali. *@

<PageTitle>@(IsEdit ? "Edit SKU" : "SKU baru")</PageTitle>

<div class="bn-phead">
    <BenangBackButton To="@(IsEdit ? $"/gudang/benang/sku/{Id}" : "/gudang/benang")" />
    <div class="bn-phead-t">@(IsEdit ? "Edit SKU" : "SKU baru")</div>
</div>

<div class="bn-body">
    @if (isLoading)
    {
        <div class="bn-card bn-note">Memuat...</div>
    }
    else if (IsEdit && itemLama is null)
    {
        <div class="bn-card bn-note">SKU tidak ditemukan atau sudah dihapus.</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger" style="margin:0">@error</div>
        }

        @if (IsEdit)
        {
            <div class="bn-card bn-note">
                Kode SKU <span class="bn-mono">@itemLama!.SkuCode</span> tidak berubah walau
                jenis / merk / warna diubah, supaya label QR yang sudah tertempel di kones
                tetap dikenali.
            </div>
        }

        <div class="bn-card" style="display:flex;flex-direction:column;gap:14px">

            <div class="bn-field">
                <label class="bn-label" for="bn-jenis">Jenis benang</label>
                <select id="bn-jenis" class="bn-inp" value="@form.ThreadTypeId" @onchange="JenisDiubah">
                    <option value="0">-- Pilih jenis --</option>
                    @foreach (var t in types)
                    {
                        <option value="@t.ThreadTypeId">@t.Name</option>
                    }
                </select>
            </div>

            <div class="bn-field">
                <label class="bn-label">Merk</label>
                <SearchableSelect TItem="ThreadBrandDto"
                                  Items="brands"
                                  Value="form.ThreadBrandId"
                                  ValueChanged="MerkDipilih"
                                  IdSelector="@(b => b.ThreadBrandId)"
                                  TextSelector="@(b => b.Name)"
                                  Placeholder="Cari merk..." />

                @if (!tambahMerk)
                {
                    <button type="button" class="bn-btn bn-btn-sm bn-btn-soft" style="align-self:flex-start"
                            @onclick="@(() => tambahMerk = true)">
                        + Tambah merk baru
                    </button>
                }
                else
                {
                    <div style="display:flex;gap:8px">
                        <input class="bn-inp" style="flex:1;min-width:0" placeholder="Nama merk baru"
                               @bind="merkBaru" @bind:event="oninput" />
                        <button type="button" class="bn-btn bn-btn-sm bn-btn-p"
                                disabled="@(isSavingMerk || string.IsNullOrWhiteSpace(merkBaru))"
                                @onclick="SimpanMerkBaru">
                            Simpan
                        </button>
                        <button type="button" class="bn-btn bn-btn-sm bn-btn-soft" @onclick="BatalMerkBaru">
                            Batal
                        </button>
                    </div>
                }
            </div>

            <div class="bn-field">
                <label class="bn-label" for="bn-warna">Nama warna</label>
                <input id="bn-warna" class="bn-inp" placeholder="mis. Merah Cabe"
                       @bind="form.ColorName" @bind:event="oninput" />
            </div>

            <div class="bn-field">
                <label class="bn-label" for="bn-kodewarna">Kode warna</label>
                <input id="bn-kodewarna" class="bn-inp" placeholder="mis. 2041"
                       @bind="form.ColorCode" @bind:event="oninput" />
                <div class="bn-note">Ikut jadi bagian kode SKU, jadi tulis sesuai kode di kones.</div>
            </div>

            <div class="bn-field">
                <label class="bn-label">Jenis kones</label>
                <div class="bn-seg">
                    <button type="button" class="@(form.ConeSize == "KECIL" ? "is-on" : "")"
                            @onclick="@(() => form.ConeSize = "KECIL")">Kecil</button>
                    <button type="button" class="@(form.ConeSize == "BESAR" ? "is-on" : "")"
                            @onclick="@(() => form.ConeSize = "BESAR")">Besar</button>
                </div>
            </div>

            <div class="bn-field">
                <label class="bn-label">Foto (opsional)</label>
                <div style="display:flex;gap:12px;align-items:center">
                    @if (!string.IsNullOrWhiteSpace(fotoPathLama))
                    {
                        <img class="bn-thumb" src="@ThreadApi.PhotoUrl(fotoPathLama)" alt="Foto SKU" />
                    }
                    else if (fotoBaru is not null)
                    {
                        <span class="bn-noimg">siap</span>
                    }
                    else
                    {
                        <span class="bn-noimg">no foto</span>
                    }

                    <label class="bn-btn bn-btn-sm bn-btn-soft" style="cursor:pointer">
                        <i class="fe fe-camera"></i> Pilih / ambil foto
                        <InputFile OnChange="FotoDipilih" accept="image/*" capture="environment"
                                   style="display:none" />
                    </label>

                    @if (IsEdit && !string.IsNullOrWhiteSpace(fotoPathLama))
                    {
                        <button type="button" class="bn-btn bn-btn-sm bn-btn-danger" @onclick="HapusFoto">
                            Hapus foto
                        </button>
                    }
                </div>
                @if (fotoBaru is not null)
                {
                    <div class="bn-note">@fotoBaru.Name — diunggah saat SKU disimpan.</div>
                }
                <div class="bn-note">Foto boleh dilengkapi belakangan dari halaman detail SKU.</div>
            </div>
        </div>

        @if (IsEdit)
        {
            <div class="bn-card" style="display:flex;flex-direction:column;gap:10px">
                <div class="bn-sub">Lainnya</div>
                <div style="display:flex;gap:10px;flex-wrap:wrap">
                    <button type="button" class="bn-btn bn-btn-sm bn-btn-soft" @onclick="ToggleAktif">
                        @(itemLama!.IsActive ? "Nonaktifkan SKU" : "Aktifkan SKU")
                    </button>
                    <button type="button" class="bn-btn bn-btn-sm bn-btn-danger"
                            @onclick="@(() => konfirmasiHapus = true)">
                        Hapus SKU
                    </button>
                </div>
                <div class="bn-note">
                    SKU yang sudah punya riwayat mutasi tidak bisa dihapus — nonaktifkan saja
                    supaya tidak muncul di pilihan, tapi riwayatnya tetap utuh.
                </div>
            </div>
        }
    }
</div>

<ConfirmDeleteModal Show="konfirmasiHapus" IsBusy="isDeleting"
                    Title="Hapus SKU" OnConfirm="Hapus"
                    OnCancel="@(() => konfirmasiHapus = false)">
    <Message>
        Hapus SKU <strong>@itemLama?.ColorName</strong> (@itemLama?.SkuCode)?
        Foto SKU ini ikut terhapus.
    </Message>
</ConfirmDeleteModal>

@if (!isLoading && (!IsEdit || itemLama is not null))
{
    <div class="bn-bot bn-bot-2">
        <button type="button" class="bn-btn bn-btn-soft" @onclick="Batal">Batal</button>
        <button type="button" class="bn-btn bn-btn-p" disabled="@(isSaving || !BolehSimpan)" @onclick="Simpan">
            @(isSaving ? "Menyimpan..." : "Simpan")
        </button>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsEdit => Id.HasValue;

    private List<ThreadTypeDto> types = new();
    private List<ThreadBrandDto> brands = new();
    private ThreadItemDto? itemLama;
    private ThreadItemSaveRequest form = new();
    private string? fotoPathLama;
    private IBrowserFile? fotoBaru;

    private bool tambahMerk;
    private string merkBaru = string.Empty;
    private bool isSavingMerk;

    private bool isLoading = true;
    private bool isSaving;
    private bool konfirmasiHapus;
    private bool isDeleting;
    private string? error;

    private bool BolehSimpan =>
        form.ThreadTypeId > 0 && form.ThreadBrandId > 0
        && !string.IsNullOrWhiteSpace(form.ColorName)
        && !string.IsNullOrWhiteSpace(form.ColorCode);

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        types = await ThreadApi.GetTypesAsync();
        brands = await ThreadApi.GetBrandsAsync();

        if (IsEdit)
        {
            var detail = await ThreadApi.GetItemAsync(Id!.Value);
            itemLama = detail?.Item;

            if (itemLama is not null)
            {
                form = new ThreadItemSaveRequest
                {
                    ThreadItemId = itemLama.ThreadItemId,
                    ThreadTypeId = itemLama.ThreadTypeId,
                    ThreadBrandId = itemLama.ThreadBrandId,
                    ColorName = itemLama.ColorName,
                    ColorCode = itemLama.ColorCode,
                    ConeSize = itemLama.ConeSize
                };
                fotoPathLama = itemLama.PhotoPath;
            }
        }
        else
        {
            form = new ThreadItemSaveRequest { ConeSize = "BESAR" };
            fotoPathLama = null;
        }

        isLoading = false;
    }

    private void JenisDiubah(ChangeEventArgs e) =>
        form.ThreadTypeId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;

    private void MerkDipilih(int id) => form.ThreadBrandId = id;

    private async Task SimpanMerkBaru()
    {
        isSavingMerk = true;
        error = null;

        var (success, err, newId) = await ThreadApi.SaveBrandAsync(
            new ThreadBrandSaveRequest { Name = merkBaru.Trim() });

        isSavingMerk = false;

        if (!success)
        {
            error = err;
            return;
        }

        brands = await ThreadApi.GetBrandsAsync();
        form.ThreadBrandId = newId;
        merkBaru = string.Empty;
        tambahMerk = false;
    }

    private void BatalMerkBaru()
    {
        merkBaru = string.Empty;
        tambahMerk = false;
    }

    private void FotoDipilih(InputFileChangeEventArgs e) => fotoBaru = e.File;

    private async Task HapusFoto()
    {
        if (!IsEdit) return;

        var (success, err) = await ThreadApi.DeletePhotoAsync(Id!.Value);
        if (!success)
        {
            error = err;
            return;
        }

        fotoPathLama = null;
        fotoBaru = null;
    }

    private async Task Simpan()
    {
        isSaving = true;
        error = null;

        var (success, err, newId) = await ThreadApi.SaveItemAsync(form);

        if (!success)
        {
            isSaving = false;
            error = err;
            return;
        }

        var itemId = IsEdit ? Id!.Value : newId;

        // Foto diunggah setelah SKU ada (upload butuh id SKU-nya).
        if (fotoBaru is not null && itemId > 0)
        {
            var (fotoOk, fotoErr, _) = await ThreadApi.UploadPhotoAsync(itemId, fotoBaru);
            if (!fotoOk)
            {
                isSaving = false;
                // SKU-nya SUDAH tersimpan -- jangan hilangkan datanya, cukup beri tahu.
                error = $"SKU tersimpan, tapi foto gagal diunggah: {fotoErr}";
                fotoBaru = null;
                return;
            }
        }

        isSaving = false;
        Nav.NavigateTo(itemId > 0 ? $"/gudang/benang/sku/{itemId}" : "/gudang/benang");
    }

    private async Task ToggleAktif()
    {
        if (itemLama is null) return;

        var (success, err) = await ThreadApi.SetItemActiveAsync(itemLama.ThreadItemId, !itemLama.IsActive);
        if (!success)
        {
            error = err;
            return;
        }

        await OnParametersSetAsync();
    }

    private async Task Hapus()
    {
        if (itemLama is null) return;

        isDeleting = true;
        var (success, err) = await ThreadApi.DeleteItemAsync(itemLama.ThreadItemId);
        isDeleting = false;
        konfirmasiHapus = false;

        if (!success)
        {
            error = err;
            return;
        }

        Nav.NavigateTo("/gudang/benang");
    }

    private void Batal() =>
        Nav.NavigateTo(IsEdit ? $"/gudang/benang/sku/{Id}" : "/gudang/benang");
}

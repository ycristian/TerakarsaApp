@page "/gudang/benang/sku/{Id:int}"
@attribute [Authorize]
@layout TerakarsaApp.Client.Layout.BenangLayout
@using Microsoft.AspNetCore.Authorization
@using TerakarsaApp.Client.Pages.Gudang.Benang.Shared
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Shared.Inv
@inject ThreadStockApiService ThreadApi
@inject NavigationManager Nav

@* Prompt 71 -- detail satu SKU benang. Mockup: Sku.dc.html.
   Prompt 72: tab "Riwayat" (20 movement terakhir) + tombol Ambil/Pindah per rak
   (di dalam ThreadSkuDetailPanel) + tombol Ambil di bar bawah aktif.
   Tombol "Cetak label SKU" (Prompt 73) masih mati. *@

<PageTitle>@(detail?.Item?.ColorName ?? "Detail SKU")</PageTitle>

<div class="bn-phead">
    <BenangBackButton />
    <div class="bn-phead-t">Detail SKU</div>
    @if (detail?.Item is not null)
    {
        <button type="button" class="bn-btn bn-btn-sm bn-btn-soft" style="margin-left:auto"
                @onclick="@(() => Nav.NavigateTo($"/gudang/benang/sku/edit/{Id}"))">
            Edit
        </button>
    }
</div>

@if (detail?.Item is not null)
{
    <div class="bn-tabs" style="padding-top:12px">
        <button type="button" class="@(tab == "STOK" ? "is-on" : "")" @onclick="@(() => tab = "STOK")">Stok</button>
        <button type="button" class="@(tab == "RIWAYAT" ? "is-on" : "")" @onclick="PilihRiwayat">Riwayat</button>
    </div>
}

<div class="bn-body">
    @if (isLoading)
    {
        <div class="bn-card bn-note">Memuat detail SKU...</div>
    }
    else if (detail?.Item is null)
    {
        <div class="bn-card bn-note">SKU tidak ditemukan atau sudah dihapus.</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(pesanSukses))
        {
            <div class="bn-toast">
                <i class="fe fe-check-circle" style="font-size:18px"></i>
                <span>@pesanSukses</span>
            </div>
        }

        @if (tab == "STOK")
        {
            <ThreadSkuDetailPanel Detail="detail" OnPhotoChanged="MuatUlang" />
        }
        else
        {
            <div class="bn-sub">20 mutasi terakhir</div>
            @if (isLoadingRiwayat)
            {
                <div class="bn-card bn-note">Memuat riwayat...</div>
            }
            else
            {
                <ThreadMovementList Movements="movements" />
            }
        }
    }
</div>

@if (detail?.Item is not null)
{
    <div class="bn-bot bn-bot-2">
        <button type="button" class="bn-btn" disabled title="Prompt berikutnya">Cetak label SKU</button>
        <button type="button" class="bn-btn bn-btn-p"
                @onclick="@(() => Nav.NavigateTo($"/gudang/benang/ambil/{Id}"))">
            Ambil
        </button>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    // Pesan hasil simpan yang dikirim halaman Pindah.
    [SupplyParameterFromQuery(Name = "pesan")] public string? QPesan { get; set; }

    private ThreadItemDetailDto? detail;
    private List<ThreadMovementDto> movements = new();
    private string tab = "STOK";
    private string? pesanSukses;
    private bool isLoading = true;
    private bool isLoadingRiwayat;

    protected override async Task OnParametersSetAsync()
    {
        // Pesan hasil simpan dari halaman Pindah (query ?pesan=).
        pesanSukses = string.IsNullOrWhiteSpace(QPesan) ? null : QPesan;

        await MuatUlang();
    }

    private async Task MuatUlang()
    {
        isLoading = true;
        detail = await ThreadApi.GetItemAsync(Id);
        isLoading = false;

        if (tab == "RIWAYAT") await MuatRiwayat();
    }

    private async Task PilihRiwayat()
    {
        tab = "RIWAYAT";
        await MuatRiwayat();
    }

    private async Task MuatRiwayat()
    {
        isLoadingRiwayat = true;
        movements = await ThreadApi.GetMovementsAsync(Id, 20);
        isLoadingRiwayat = false;
    }
}

@page "/gudang/benang/kembali/{ItemId:int}"
@attribute [Authorize]
@layout TerakarsaApp.Client.Layout.BenangLayout
@using Microsoft.AspNetCore.Authorization
@using TerakarsaApp.Client.Pages.Gudang.Benang.Shared
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Shared.Inv
@inject ThreadStockApiService ThreadApi
@inject NavigationManager Nav

@* Prompt 72 -- Kembali & timbang. Mockup: Kembali.dc.html.

   SEMUA kones yang kembali dicatat sebagai SPLIT baru dengan kode sendiri
   (keputusan desain: tidak ada kembali sebagai whole). Kode kones dibuat
   inv.SIS_ThreadMovement_Manage (serial SP-xxxxxx, applock).

   Tombol "Simpan & cetak label" baru aktif di Prompt 73 -- tempatnya sudah
   disiapkan di bar bawah. *@

<PageTitle>Kembali &amp; Timbang</PageTitle>

<div class="bn-phead">
    <BenangBackButton />
    <div class="bn-phead-t">Kembali &amp; Timbang</div>
</div>

<div class="bn-body">
    @if (isLoading)
    {
        <div class="bn-card bn-note">Memuat...</div>
    }
    else if (item is null)
    {
        <div class="bn-card bn-note">SKU tidak ditemukan.</div>
    }
    else if (hasil is not null)
    {
        @* ---------- setelah simpan: tampilkan kode kones hasil ---------- *@
        <div class="bn-toast">
            <i class="fe fe-check-circle" style="font-size:18px"></i>
            <span>
                Kones split baru tercatat: <b class="bn-mono">@hasil.ConeCode</b> ·
                <b>@hasil.WeightGram g</b> di rak <b>@KodeRakTerpilih</b>.
            </span>
        </div>

        <ThreadLabelPreview QrContent="@($"TS:{hasil.ConeCode}")"
                            ColorCode="@item.ColorCode"
                            ColorName="@item.ColorName"
                            Brand="@item.BrandName"
                            ThreadType="@item.TypeName"
                            ConeCode="@hasil.ConeCode"
                            WeightGram="@hasil.WeightGram" />

        @if (!string.IsNullOrEmpty(labelError))
        {
            <div class="alert alert-danger" style="margin:0">@labelError</div>
        }

        @if (hasil.ThreadSplitConeId.HasValue)
        {
            <ThreadLabelStatus @ref="statusLabel" Kind="SPLIT" RefId="@hasil.ThreadSplitConeId.Value" />
        }

        <div style="display:flex;gap:10px;flex-wrap:wrap">
            <button type="button" class="bn-btn bn-btn-sm bn-btn-a" disabled="@isPrinting" @onclick="CetakLabel">
                @(isPrinting ? "Mengirim..." : "Cetak label")
            </button>
            <button type="button" class="bn-btn bn-btn-sm bn-btn-soft" @onclick="TimbangLagi">
                Timbang kones berikutnya
            </button>
            <button type="button" class="bn-btn bn-btn-sm bn-btn-soft"
                    @onclick="@(() => Nav.NavigateTo($"/gudang/benang/sku/{ItemId}"))">
                Buka detail SKU
            </button>
        </div>
    }
    else
    {
        <ThreadSkuMini Item="item" Keterangan="@($"Hasil scan label SKU · {item.ConeSizeLabel}")" />

        <div class="bn-banner">
            Semua kones yang kembali dicatat sebagai <strong>split</strong> dan dapat barcode
            baru. Timbang tanpa tube.
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger" style="margin:0">@error</div>
        }

        <div class="bn-field">
            <label class="bn-label" for="bn-berat">Berat netto</label>
            <div class="bn-gram">
                <input id="bn-berat" type="number" min="1" @bind="weightGram" @bind:event="oninput" />
                <div class="bn-gram-u">gram</div>
            </div>
        </div>

        <div class="bn-field">
            <label class="bn-label" for="bn-dari">Kembali dari</label>
            <select id="bn-dari" class="bn-inp" style="height:48px" value="@resourceId" @onchange="LineDiubah">
                <option value="0">-- Tidak dicatat --</option>
                @foreach (var r in resources)
                {
                    <option value="@r.ResourceId">@r.Label</option>
                }
            </select>
        </div>

        <div class="bn-field">
            <label class="bn-label" for="bn-project">Order / project (opsional)</label>
            <select id="bn-project" class="bn-inp" style="height:48px" value="@projectId" @onchange="ProjectDiubah">
                <option value="0">— Tanpa project —</option>
                @foreach (var p in projects)
                {
                    <option value="@p.ProjectId">@p.Label</option>
                }
            </select>
        </div>

        <div class="bn-field">
            <label class="bn-label" for="bn-rak">Simpan di lokasi</label>
            <select id="bn-rak" class="bn-inp" style="height:48px" value="@toLocationId" @onchange="RakDiubah">
                <option value="0">-- Pilih rak --</option>
                @foreach (var l in locations)
                {
                    <option value="@l.ThreadLocationId">@l.Label</option>
                }
            </select>
        </div>
    }
</div>

@if (item is not null && hasil is null)
{
    <div class="bn-bot">
        <button type="button" class="bn-btn bn-btn-a bn-btn-lg" disabled="@(isSaving || !BolehSimpan)" @onclick="Simpan">
            @(isSaving ? "Menyimpan..." : $"Simpan · {weightGram} g")
        </button>
    </div>
}

@code {
    [Parameter] public int ItemId { get; set; }

    private ThreadItemDto? item;
    private List<ThreadLocationDto> locations = new();
    private List<ThreadResourceLookupDto> resources = new();
    private List<ThreadProjectLookupDto> projects = new();

    private int weightGram;
    private int resourceId;
    private int projectId;
    private int toLocationId;

    private ThreadMovementResultDto? hasil;
    private bool isLoading = true;
    private bool isSaving;
    private string? error;

    // Cetak label kones yang baru dibuat (Prompt 73) -- TIDAK otomatis, selalu lewat tombol.
    private bool isPrinting;
    private string? labelError;
    private ThreadLabelStatus? statusLabel;

    private bool BolehSimpan => weightGram > 0 && toLocationId > 0;

    private string? KodeRakTerpilih =>
        locations.FirstOrDefault(l => l.ThreadLocationId == toLocationId)?.Code;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        hasil = null;

        var detail = await ThreadApi.GetItemAsync(ItemId);
        item = detail?.Item;

        if (item is not null)
        {
            locations = (await ThreadApi.GetLocationsAsync(hanyaAktif: true));
            resources = await ThreadApi.GetResourcesAsync();
            projects = await ThreadApi.GetProjectsAsync();

            toLocationId = locations.FirstOrDefault()?.ThreadLocationId ?? 0;
        }

        isLoading = false;
    }

    private void LineDiubah(ChangeEventArgs e) =>
        resourceId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;

    private void ProjectDiubah(ChangeEventArgs e) =>
        projectId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;

    private void RakDiubah(ChangeEventArgs e) =>
        toLocationId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;

    private async Task Simpan()
    {
        isSaving = true;
        error = null;

        var (success, err, hasilSimpan) = await ThreadApi.ReturnAsync(new ThreadReturnRequest
        {
            ThreadItemId = ItemId,
            WeightGram = weightGram,
            ToLocationId = toLocationId,
            ResourceId = resourceId > 0 ? resourceId : null,
            ProjectId = projectId > 0 ? projectId : null
        });

        isSaving = false;

        if (!success)
        {
            error = err;
            return;
        }

        hasil = hasilSimpan;
    }

    private async Task CetakLabel()
    {
        if (hasil?.ThreadSplitConeId is null) return;

        isPrinting = true;
        labelError = null;

        var (success, err, _) = await ThreadApi.CetakLabelSplitAsync(hasil.ThreadSplitConeId.Value);

        isPrinting = false;

        if (!success)
        {
            labelError = err;
            return;
        }

        statusLabel?.Mulai();
    }

    private void TimbangLagi()
    {
        hasil = null;
        weightGram = 0;
        error = null;
        labelError = null;
        statusLabel?.Kosongkan();
    }
}

@page "/projects/edit/{Id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Shared.Projects
@using TerakarsaApp.Shared.Buyers
@using TerakarsaApp.Shared.Employees
@using Microsoft.AspNetCore.Components.Authorization
@inject ProjectApiService ProjectApi
@inject ProjectAttachmentApiService AttachmentApi
@inject BuyerApiService BuyerApi
@inject EmployeeApiService EmployeeApi
@inject ArticleApiService ArticleApi
@inject ArticlePhotoApiService ArticlePhotoApi
@inject ArticleWorkflowApiService ArticleWorkflowApi
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Edit Project</PageTitle>

<div class="page-header">
    <h1 class="page-title">Edit Project</h1>
    <div>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="javascript:void(0)">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit Project</li>
        </ol>
    </div>
</div>

@if (hasAccess is null)
{
    <p>Memeriksa akses...</p>
}
else if (hasAccess == false)
{
    <div class="alert alert-danger">Anda tidak memiliki akses ke modul ini.</div>
}
else if (isLoading)
{
    <p>Memuat data...</p>
}
else if (project is null)
{
    <div class="alert alert-danger">Project tidak ditemukan.</div>
}
else
{
    <div class="mb-3">
        <CloseButton />
    </div>

    <div class="row mb-4">
        <div class="col-lg-4 mb-4 mb-lg-0">
            <div class="card h-100">
                <div class="card-header">
                    <h3 class="card-title">Detail Project</h3>
                </div>
                <div class="card-body">
                    <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-3">
                            <label class="form-label">Nama Project</label>
                            <InputText class="form-control" @bind-Value="formModel.ProjectName" />
                            <ValidationMessage For="@(() => formModel.ProjectName)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Buyer</label>
                            <SearchableSelect TItem="BuyerDto" Items="buyerOptions" @bind-Value="formModel.CustomerId"
                                              IdSelector="@(b => b.Id)" TextSelector="@(b => b.BuyerName)"
                                              Placeholder="Cari buyer..." />
                            <ValidationMessage For="@(() => formModel.CustomerId)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">MD</label>
                            <SearchableSelect TItem="EmployeeDto" Items="employeeOptions" @bind-Value="formModel.ProjectMd"
                                              IdSelector="@(e => e.Id)" TextSelector="@(e => e.EmployeeName)"
                                              Placeholder="Cari nama karyawan..." AllowNone="true" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">PIC</label>
                            <SearchableSelect TItem="EmployeeDto" Items="employeeOptions" @bind-Value="formModel.ProjectPic"
                                              IdSelector="@(e => e.Id)" TextSelector="@(e => e.EmployeeName)"
                                              Placeholder="Cari nama karyawan..." AllowNone="true" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">No PO</label>
                            <InputText class="form-control" @bind-Value="formModel.NoPo" />
                            <ValidationMessage For="@(() => formModel.NoPo)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tanggal Order</label>
                            <InputDate class="form-control" @bind-Value="formModel.OrderDate" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tanggal Mulai</label>
                            <InputDate class="form-control" @bind-Value="formModel.StartDate" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Deadline</label>
                            <InputDate class="form-control" @bind-Value="formModel.Deadline" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tanggal Kirim</label>
                            <InputDate class="form-control" @bind-Value="formModel.DeliveryDate" />
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }
                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success">@successMessage</div>
                        }
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @(isSaving ? "Menyimpan..." : "Simpan")
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card h-100 mb-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">Artikel</h3>
                    <a class="btn btn-primary" href="@($"/projects/{Id}/articles/create")" target="_blank">+ Tambah Artikel</a>
                </div>
                <div class="card-body">
                    @if (isLoadingArticles)
                    {
                        <p class="mb-0">Memuat artikel...</p>
                    }
                    else if (articles.Count == 0)
                    {
                        <p class="mb-0">Belum ada artikel untuk project ini.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered border text-nowrap mb-0">
                                <thead>
                                    <tr>
                                        <th>Foto</th>
                                        <th>Nama Artikel</th>
                                        <th>Style</th>
                                        <th>Color</th>
                                        <th>Size Pack</th>
                                        <th>Total Qty</th>
                                        <th>Size</th>
                                        <th>Workflow</th>
                                        <th>Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in articles)
                                    {
                                        <tr>
                                            <td>
                                                @if (articleThumbnails.TryGetValue(a.Id, out var thumbUrl))
                                                {
                                                    <img src="@thumbUrl" alt="Foto" style="width: 36px; height: 36px; object-fit: cover; border-radius: 4px;" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>@a.ArticleName</td>
                                            <td>@(a.Style ?? "-")</td>
                                            <td>@(a.Color ?? "-")</td>
                                            <td>@a.SizePackName</td>
                                            <td>@a.TotalQty</td>
                                            <td>
                                                @if (articleSizes.TryGetValue(a.Id, out var sizes) && sizes.Count > 0)
                                                {
                                                    <div style="font-size: 11px; line-height: 1.4;">
                                                        @foreach (var s in sizes)
                                                        {
                                                            <div>@(s.SizeName) : @s.Qty</div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (articleWorkflowTemplateNames.TryGetValue(a.Id, out var wfName) && !string.IsNullOrEmpty(wfName))
                                                {
                                                    @wfName
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                <a class="btn btn-sm btn-primary me-1" title="Edit" href="@($"/projects/{Id}/articles/{a.Id}/edit")" target="_blank"><i class="fe fe-edit"></i></a>
                                                <a class="btn btn-sm btn-info me-1" title="Kelola Bundle" href="@($"/bundles/{a.Id}/edit")" target="_blank"><i class="fe fe-package"></i></a>
                                                <button class="btn btn-sm btn-danger" title="Hapus" @onclick="() => HandleDeleteArticle(a)"><i class="fe fe-trash-2"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <div class="card h-100 mb-0">
                <div class="card-header">
                    <h3 class="card-title">Galeri Foto</h3>
                </div>
                <div class="card-body">
                    @if (isLoadingAttachments)
                    {
                        <p>Memuat foto...</p>
                    }
                    else if (PhotoAttachments.Count == 0)
                    {
                        <p class="text-muted mb-0">Belum ada foto (jpg/png) yang diunggah. Dokumen (pdf/xlsx) tidak ditampilkan di sini.</p>
                    }
                    else
                    {
                        <div class="product-carousel">
                            <div id="projectPhotoSlider" class="carousel slide border" data-bs-ride="false">
                                <div class="carousel-inner">
                                    @for (var i = 0; i < PhotoAttachments.Count; i++)
                                    {
                                        var photo = PhotoAttachments[i];
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                            @if (photoPreviews.TryGetValue(photo.Id, out var mainSrc))
                                            {
                                                <img src="@mainSrc" alt="@photo.FileName" class="img-fluid mx-auto d-block" style="max-height: 320px; object-fit: contain;" />
                                            }
                                        </div>
                                    }
                                </div>
                                @if (PhotoAttachments.Count > 1)
                                {
                                    <a class="carousel-control-prev" href="#projectPhotoSlider" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    </a>
                                    <a class="carousel-control-next" href="#projectPhotoSlider" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    </a>
                                }
                            </div>
                        </div>
                        @if (PhotoAttachments.Count > 1)
                        {
                            <div class="clearfix carousel-slider">
                                <div id="projectPhotoThumbs" class="carousel slide">
                                    <div class="carousel-inner">
                                        <ul class="carousel-item active ps-0 mb-0 d-flex flex-wrap">
                                            @for (var i = 0; i < PhotoAttachments.Count; i++)
                                            {
                                                var photo = PhotoAttachments[i];
                                                <li data-bs-target="#projectPhotoSlider" data-bs-slide-to="@i" class="thumb @(i == 0 ? "active" : "") m-2" style="cursor: pointer;">
                                                    @if (photoPreviews.TryGetValue(photo.Id, out var thumbSrc))
                                                    {
                                                        <img src="@thumbSrc" alt="@photo.FileName" style="width: 70px; height: 70px; object-fit: cover;" />
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100 mb-0">
                <div class="card-header">
                    <h3 class="card-title">Lampiran</h3>
                </div>
                <div class="card-body">
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-12">
                            <label class="form-label">File (jpg, png, pdf, xlsx - maks. 10 MB, bisa pilih beberapa sekaligus)</label>
                            <InputFile class="form-control" multiple OnChange="HandleFilesSelected" />
                            @if (selectedFiles.Count > 0)
                            {
                                <div class="form-text">@selectedFiles.Count file dipilih: @string.Join(", ", selectedFiles.Select(f => f.Name))</div>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label">Deskripsi (opsional)</label>
                            <input class="form-control" maxlength="255" @bind="uploadDescription" />
                        </div>
                        <div class="col-12">
                            <button class="btn btn-primary w-100" disabled="@(selectedFiles.Count == 0 || isUploading)" @onclick="HandleUpload">
                                @(isUploading ? "Mengunggah..." : "Unggah")
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(uploadError))
                    {
                        <div class="alert alert-danger">@uploadError</div>
                    }

                    @if (isLoadingAttachments)
                    {
                        <p>Memuat lampiran...</p>
                    }
                    else if (attachments.Count == 0)
                    {
                        <p>Belum ada lampiran.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered border text-nowrap mb-0">
                                <thead>
                                    <tr>
                                        <th>Nama File</th>
                                        <th>Tipe</th>
                                        <th>Ukuran (KB)</th>
                                        <th>Deskripsi</th>
                                        <th>Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in attachments)
                                    {
                                        <tr>
                                            <td>@a.FileName</td>
                                            <td>@a.FileType</td>
                                            <td>@a.FileSizeKb</td>
                                            <td>@(a.Description ?? "-")</td>
                                            <td>
                                                <button class="btn btn-sm btn-secondary me-1" title="Download" @onclick="() => HandleDownload(a)"><i class="fe fe-download"></i></button>
                                                <button class="btn btn-sm btn-danger" title="Hapus" @onclick="() => HandleDeleteAttachment(a)"><i class="fe fe-trash-2"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <ConfirmDeleteModal Show="showDeleteConfirm" IsBusy="isDeletingAttachment" OnConfirm="ConfirmDeleteAttachment" OnCancel="CancelDeleteAttachment">
        <Message>Yakin ingin menghapus lampiran "@attachmentPendingDelete?.FileName"?</Message>
    </ConfirmDeleteModal>

    <ConfirmDeleteModal Show="showDeleteArticleConfirm" IsBusy="isDeletingArticle" OnConfirm="ConfirmDeleteArticle" OnCancel="CancelDeleteArticle">
        <Message>Yakin ingin menghapus artikel "@articlePendingDelete?.ArticleName"?</Message>
    </ConfirmDeleteModal>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool? hasAccess = null;
    private bool isLoading = true;
    private bool isSaving = false;
    private ProjectDto? project;
    private ProjectFormModel formModel = new();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private List<BuyerDto> buyerOptions = new();
    private List<EmployeeDto> employeeOptions = new();

    private List<ProjectAttachmentDto> attachments = new();
    private bool isLoadingAttachments = true;
    private List<IBrowserFile> selectedFiles = new();
    private string? uploadDescription;
    private bool isUploading = false;
    private string uploadError = string.Empty;
    private bool showDeleteConfirm = false;
    private bool isDeletingAttachment = false;
    private ProjectAttachmentDto? attachmentPendingDelete;

    private Dictionary<int, string> photoPreviews = new();
    private List<ProjectAttachmentDto> PhotoAttachments => attachments.Where(a => a.FileType is "jpg" or "png").ToList();

    private List<ArticleListItemDto> articles = new();
    private bool isLoadingArticles = true;
    private Dictionary<int, string> articleThumbnails = new();
    private Dictionary<int, List<ArticleSizeSummaryDto>> articleSizes = new();
    private Dictionary<int, string?> articleWorkflowTemplateNames = new();
    private bool showDeleteArticleConfirm = false;
    private bool isDeletingArticle = false;
    private ArticleListItemDto? articlePendingDelete;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        hasAccess = state.User.HasClaim("module", "ORDER_PROJECT");

        if (hasAccess == true)
        {
            buyerOptions = await BuyerApi.GetActiveAsync();
            employeeOptions = await EmployeeApi.GetActiveAsync();
            await LoadProject();
            await LoadAttachments();
            await LoadArticles();
        }
    }

    private async Task LoadProject()
    {
        isLoading = true;
        project = await ProjectApi.GetByIdAsync(Id);
        if (project is not null)
        {
            formModel = new ProjectFormModel
            {
                ProjectName = project.ProjectName,
                CustomerId = project.CustomerId,
                ProjectMd = project.ProjectMd ?? 0,
                ProjectPic = project.ProjectPic ?? 0,
                NoPo = project.NoPo,
                OrderDate = project.OrderDate,
                StartDate = project.StartDate,
                Deadline = project.Deadline,
                DeliveryDate = project.DeliveryDate
            };
        }
        isLoading = false;
    }

    private async Task LoadAttachments()
    {
        isLoadingAttachments = true;
        attachments = await AttachmentApi.GetByProjectAsync(Id);
        isLoadingAttachments = false;
        await LoadPhotoPreviews();
    }

    private async Task LoadPhotoPreviews()
    {
        var photos = PhotoAttachments;

        foreach (var staleId in photoPreviews.Keys.Where(id => photos.All(p => p.Id != id)).ToList())
            photoPreviews.Remove(staleId);

        foreach (var photo in photos)
        {
            if (photoPreviews.ContainsKey(photo.Id)) continue;

            var result = await AttachmentApi.DownloadAsync(Id, photo.Id);
            if (result is null) continue;

            var base64 = Convert.ToBase64String(result.Value.Bytes);
            photoPreviews[photo.Id] = $"data:{result.Value.ContentType};base64,{base64}";
        }
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        var result = await ProjectApi.UpdateAsync(new ProjectUpdateRequest
        {
            Id = Id,
            ProjectName = formModel.ProjectName,
            CustomerId = formModel.CustomerId,
            ProjectMd = formModel.ProjectMd > 0 ? formModel.ProjectMd : null,
            ProjectPic = formModel.ProjectPic > 0 ? formModel.ProjectPic : null,
            NoPo = string.IsNullOrWhiteSpace(formModel.NoPo) ? null : formModel.NoPo,
            OrderDate = formModel.OrderDate,
            StartDate = formModel.StartDate,
            Deadline = formModel.Deadline,
            DeliveryDate = formModel.DeliveryDate
        });

        isSaving = false;

        if (result.Success)
        {
            successMessage = "Perubahan berhasil disimpan.";
            await LoadProject();
        }
        else
        {
            errorMessage = result.Error;
        }
    }

    private void HandleFilesSelected(InputFileChangeEventArgs e)
    {
        selectedFiles = e.GetMultipleFiles(20).ToList();
        uploadError = string.Empty;
    }

    private async Task HandleUpload()
    {
        if (selectedFiles.Count == 0) return;

        isUploading = true;
        uploadError = string.Empty;

        var (success, error, results) = await AttachmentApi.UploadManyAsync(Id, selectedFiles, uploadDescription);

        isUploading = false;

        if (!success)
        {
            uploadError = error;
            return;
        }

        var failures = results.Where(r => !r.Success).ToList();
        uploadError = failures.Count > 0
            ? string.Join(" | ", failures.Select(f => $"{f.FileName}: {f.Error}"))
            : string.Empty;

        selectedFiles = new();
        uploadDescription = null;
        await LoadAttachments();
    }

    private async Task HandleDownload(ProjectAttachmentDto attachment)
    {
        var result = await AttachmentApi.DownloadAsync(Id, attachment.Id);
        if (result is null) return;

        var base64 = Convert.ToBase64String(result.Value.Bytes);
        await JS.InvokeVoidAsync("downloadFileFromBytes", result.Value.FileName, result.Value.ContentType, base64);
    }

    private void HandleDeleteAttachment(ProjectAttachmentDto attachment)
    {
        attachmentPendingDelete = attachment;
        showDeleteConfirm = true;
    }

    private void CancelDeleteAttachment()
    {
        showDeleteConfirm = false;
        attachmentPendingDelete = null;
    }

    private async Task ConfirmDeleteAttachment()
    {
        if (attachmentPendingDelete is null) return;

        isDeletingAttachment = true;
        var success = await AttachmentApi.DeleteAsync(attachmentPendingDelete.Id);
        isDeletingAttachment = false;

        showDeleteConfirm = false;
        attachmentPendingDelete = null;

        if (success)
            await LoadAttachments();
    }

    private async Task LoadArticles()
    {
        isLoadingArticles = true;
        articles = await ArticleApi.GetByProjectAsync(Id);
        isLoadingArticles = false;
        await LoadArticleThumbnails();
        await LoadArticleSizes();
        await LoadArticleWorkflows();
    }

    private async Task LoadArticleSizes()
    {
        var sizes = await ArticleApi.GetSizesByProjectAsync(Id);
        articleSizes = sizes.GroupBy(s => s.ArticleId).ToDictionary(g => g.Key, g => g.ToList());
    }

    private async Task LoadArticleWorkflows()
    {
        var tasks = articles.Select(async a =>
        {
            var workflow = await ArticleWorkflowApi.GetByArticleAsync(a.Id);
            return (a.Id, workflow.WorkflowTemplateName);
        });

        var results = await Task.WhenAll(tasks);
        articleWorkflowTemplateNames = results.ToDictionary(r => r.Id, r => r.WorkflowTemplateName);
    }

    private async Task LoadArticleThumbnails()
    {
        var tasks = articles.Select(async a =>
        {
            var result = await ArticlePhotoApi.GetPrimaryPhotoAsync(a.Id);
            if (result is null) return (a.Id, Url: (string?)null);

            var base64 = Convert.ToBase64String(result.Value.Bytes);
            return (a.Id, Url: (string?)$"data:{result.Value.ContentType};base64,{base64}");
        });

        var results = await Task.WhenAll(tasks);
        articleThumbnails = results.Where(r => r.Url is not null).ToDictionary(r => r.Id, r => r.Url!);
    }

    private void HandleDeleteArticle(ArticleListItemDto article)
    {
        articlePendingDelete = article;
        showDeleteArticleConfirm = true;
    }

    private void CancelDeleteArticle()
    {
        showDeleteArticleConfirm = false;
        articlePendingDelete = null;
    }

    private async Task ConfirmDeleteArticle()
    {
        if (articlePendingDelete is null) return;

        isDeletingArticle = true;
        var success = await ArticleApi.DeleteAsync(articlePendingDelete.Id);
        isDeletingArticle = false;

        showDeleteArticleConfirm = false;
        articlePendingDelete = null;

        if (success)
            await LoadArticles();
    }

    public class ProjectFormModel
    {
        [Required(ErrorMessage = "Nama project wajib diisi.")]
        [StringLength(150, ErrorMessage = "Nama project maksimal 150 karakter.")]
        public string ProjectName { get; set; } = string.Empty;

        [Range(1, int.MaxValue, ErrorMessage = "Buyer wajib dipilih.")]
        public int CustomerId { get; set; }

        public int ProjectMd { get; set; }

        public int ProjectPic { get; set; }

        [StringLength(50, ErrorMessage = "No PO maksimal 50 karakter.")]
        public string? NoPo { get; set; }

        public DateTime? OrderDate { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? Deadline { get; set; }
        public DateTime? DeliveryDate { get; set; }
    }
}

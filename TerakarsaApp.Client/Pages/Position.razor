@page "/positions"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Shared.Positions
@using TerakarsaApp.Shared.Divisions
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@inject PositionApiService PositionApi
@inject DivisionApiService DivisionApi
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Data Jabatan</PageTitle>

<div class="page-header">
    <h1 class="page-title">Data Jabatan</h1>
    <div>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="javascript:void(0)">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Data Jabatan</li>
        </ol>
    </div>
</div>

@if (hasAccess is null)
{
    <p>Memeriksa akses...</p>
}
else if (hasAccess == false)
{
    <div class="alert alert-danger">Anda tidak memiliki akses ke modul ini.</div>
}
else
{
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-primary" @onclick="OpenCreateForm">
            + Tambah Jabatan
        </button>
        <PageSizeSelector PageSize="pageSize" PageSizeChanged="HandlePageSizeChange" />
    </div>

    <div style="width: 300px;">
        <input class="form-control" placeholder="Cari nama jabatan..."
               @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
    </div>
</div>

@if (isLoading)
{
    <p>Memuat data...</p>
}
else if (pagedResult.Items.Count == 0)
{
    <p>Tidak ada data jabatan.</p>
}
else
{
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Daftar Jabatan</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered border text-nowrap mb-0">
                    <thead>
                        <tr>
                            <SortableHeader Label="Nama Jabatan" Column="PositionName" CurrentColumn="sortColumn" CurrentDirection="sortDirection" OnSort="ToggleSort" />
                            <th>Divisi</th>
                            <th>Menu Gate</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in pagedResult.Items)
                        {
                            <tr>
                                <td>@p.PositionName</td>
                                @* Kosong = jabatan ini belum dibatasi, jadi muncul di semua divisi. *@
                                <td>@(string.IsNullOrWhiteSpace(p.DivisionNames) ? "Semua divisi" : p.DivisionNames)</td>
                                @* Prompt 70: siapa yang boleh membuka menu satpam di aplikasi gate. *@
                                <td>@(p.IsGateOperator ? "Boleh" : "—")</td>
                                <td>
                                    <button class="btn btn-sm btn-primary me-1" title="Edit" @onclick="() => OpenEditForm(p)"><i class="fe fe-edit"></i></button>
                                    <button class="btn btn-sm btn-danger" title="Hapus" @onclick="() => HandleDelete(p)"><i class="fe fe-trash-2"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <TablePagination PageNumber="currentPage" PageSize="pageSize" TotalCount="pagedResult.TotalCount" TotalPages="pagedResult.TotalPages" PageNumberChanged="ChangePage" />
        </div>
    </div>
}

@if (showForm)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Edit Jabatan" : "Tambah Jabatan")</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-3">
                            <label class="form-label">Nama Jabatan</label>
                            <InputText class="form-control" @bind-Value="formModel.PositionName" />
                            <ValidationMessage For="@(() => formModel.PositionName)" class="text-danger" />
                        </div>
                        @* Prompt 58 (lanjutan): jabatan dibatasi ke divisi tertentu -- dipakai
                           membatasi dropdown "Jabatan" saat mendaftar pegawai dari stasiun.
                           Tidak ada yang dicentang = berlaku di SEMUA divisi (fallback di SP). *@
                        <div class="mb-3">
                            <label class="form-label">Divisi</label>
                            <div class="border rounded-0 p-2" style="max-height: 220px; overflow-y: auto;">
                                @foreach (var d in divisionOptions)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="@($"pos-div-{d.Id}")"
                                               checked="@formModel.DivisionIds.Contains(d.Id)"
                                               @onchange="e => ToggleDivision(d.Id, e.Value is bool b && b)" />
                                        <label class="form-check-label" for="@($"pos-div-{d.Id}")">@d.DivisionName</label>
                                    </div>
                                }
                            </div>
                            <div class="form-text">Tidak ada yang dicentang = jabatan ini berlaku di semua divisi.</div>
                        </div>
                        @* Prompt 70: akses menu satpam di aplikasi gate melekat pada JABATAN --
                           aplikasi gate tanpa login, dan employees tidak punya relasi ke users. *@
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="pos-gate-operator"
                                       checked="@formModel.IsGateOperator"
                                       @onchange="e => formModel.IsGateOperator = e.Value is bool b && b" />
                                <label class="form-check-label" for="pos-gate-operator">Boleh buka menu gate</label>
                            </div>
                            <div class="form-text">Kartu pegawai dengan jabatan ini bisa membuka menu satpam di aplikasi gate (daftar kartu, ubah data karyawan).</div>
                        </div>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }
                        <button type="submit" class="btn btn-primary w-100" disabled="@isSaving">
                            @(isSaving ? "Menyimpan..." : "Simpan")
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDeleteModal Show="showDeleteConfirm" IsBusy="isDeleting" OnConfirm="ConfirmDelete" OnCancel="CancelDelete">
    <Message>Yakin ingin menghapus jabatan "@positionPendingDelete?.PositionName"?</Message>
</ConfirmDeleteModal>
}

@code {
    private PositionPagedResult pagedResult = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showForm = false;
    private bool isEditMode = false;
    private bool? hasAccess = null;
    private string errorMessage = string.Empty;
    private PositionFormModel formModel = new();
    private bool showDeleteConfirm = false;
    private bool isDeleting = false;
    private PositionDto? positionPendingDelete;
    // Prompt 58 (lanjutan): pilihan divisi untuk jabatan (division_positions).
    private List<DivisionDto> divisionOptions = new();

    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private string? sortColumn;
    private string sortDirection = "asc";
    private System.Threading.Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        hasAccess = state.User.HasClaim("module", "MASTER_POSITION");

        if (hasAccess == true)
        {
            divisionOptions = await DivisionApi.GetActiveAsync();
            await LoadPositions();
        }
    }

    private async Task LoadPositions()
    {
        isLoading = true;
        pagedResult = await PositionApi.GetPagedAsync(new PositionPagedRequest
        {
            Search = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
            PageNumber = currentPage,
            PageSize = pageSize,
            SortColumn = sortColumn,
            SortDirection = sortDirection
        });
        isLoading = false;
    }

    private async Task HandlePageSizeChange(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadPositions();
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDirection = sortDirection == "asc" ? "desc" : "asc";
        else
        {
            sortColumn = column;
            sortDirection = "asc";
        }
        currentPage = 1;
        await LoadPositions();
    }

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        debounceTimer?.Dispose();
        debounceTimer = new System.Threading.Timer(async _ =>
        {
            currentPage = 1;
            await InvokeAsync(async () =>
            {
                await LoadPositions();
                StateHasChanged();
            });
        }, null, 400, Timeout.Infinite);
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > pagedResult.TotalPages) return;
        currentPage = page;
        await LoadPositions();
    }

    private void OpenCreateForm()
    {
        isEditMode = false;
        formModel = new PositionFormModel();
        errorMessage = string.Empty;
        showForm = true;
    }

    private async Task OpenEditForm(PositionDto position)
    {
        isEditMode = true;
        formModel = new PositionFormModel
        {
            Id = position.Id,
            PositionName = position.PositionName,
            IsGateOperator = position.IsGateOperator,
            // Dibaca dari pemetaan tersimpan, bukan dari teks DivisionNames di tabel.
            DivisionIds = await PositionApi.GetDivisionIdsAsync(position.Id)
        };
        errorMessage = string.Empty;
        showForm = true;
    }

    private void ToggleDivision(int divisionId, bool isChecked)
    {
        if (isChecked)
        {
            if (!formModel.DivisionIds.Contains(divisionId)) formModel.DivisionIds.Add(divisionId);
        }
        else
        {
            formModel.DivisionIds.Remove(divisionId);
        }
    }

    private void CloseForm()
    {
        showForm = false;
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = string.Empty;

        (bool Success, string Error) result;
        if (isEditMode)
        {
            result = await PositionApi.UpdateAsync(new PositionUpdateRequest
            {
                Id = formModel.Id,
                PositionName = formModel.PositionName,
                IsGateOperator = formModel.IsGateOperator,
                DivisionIds = formModel.DivisionIds
            });
        }
        else
        {
            result = await PositionApi.CreateAsync(new PositionCreateRequest
            {
                PositionName = formModel.PositionName,
                IsGateOperator = formModel.IsGateOperator,
                DivisionIds = formModel.DivisionIds
            });
        }

        isSaving = false;

        if (result.Success)
        {
            showForm = false;
            await LoadPositions();
        }
        else
        {
            errorMessage = result.Error;
        }
    }

    private void HandleDelete(PositionDto position)
    {
        positionPendingDelete = position;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        positionPendingDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (positionPendingDelete is null) return;

        isDeleting = true;
        var success = await PositionApi.DeleteAsync(positionPendingDelete.Id);
        isDeleting = false;

        showDeleteConfirm = false;
        positionPendingDelete = null;

        if (success)
            await LoadPositions();
    }

    public class PositionFormModel
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "Nama jabatan wajib diisi.")]
        [StringLength(150, ErrorMessage = "Nama jabatan maksimal 150 karakter.")]
        public string PositionName { get; set; } = string.Empty;

        // Prompt 70: jabatan ini boleh membuka menu satpam di aplikasi gate.
        public bool IsGateOperator { get; set; }

        // Kosong = jabatan tidak dibatasi divisi (berlaku di semua divisi).
        public List<int> DivisionIds { get; set; } = new();
    }
}

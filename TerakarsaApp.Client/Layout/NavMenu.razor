@using Microsoft.AspNetCore.Components.Authorization
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Shared.Modules
@inject AuthenticationStateProvider AuthStateProvider
@inject ModuleApiService ModuleApi
@implements IDisposable

<ul class="side-menu">
    <li class="sub-category">
        <h3>Main</h3>
    </li>
    <li class="slide">
        <NavLink class="side-menu__item" Match="NavLinkMatch.All" href="/">
            <i class="side-menu__icon fe fe-home"></i><span class="side-menu__label">Dashboard</span>
        </NavLink>
    </li>
    @foreach (var group in moduleGroups)
    {
        <li class="sub-category">
            <h3>@group.Category</h3>
        </li>
        @foreach (var entry in group.Entries)
        {
            @if (entry is FlatEntry flat)
            {
                <li class="slide">
                    <NavLink class="side-menu__item" href="@flat.Module.Route">
                        <i class="side-menu__icon @flat.Module.Icon"></i><span class="side-menu__label">@flat.Module.Name</span>
                    </NavLink>
                </li>
            }
            else if (entry is SubGroupEntry sub)
            {
                <li class="slide">
                    <a class="side-menu__item" data-bs-toggle="slide" href="javascript:void(0)">
                        <i class="side-menu__icon fe fe-folder"></i><span class="side-menu__label">@sub.SubCategory</span><i class="angle fe fe-chevron-right"></i>
                    </a>
                    <ul class="slide-menu">
                        <li class="side-menu-label1"><a href="javascript:void(0)">@sub.SubCategory</a></li>
                        @foreach (var m in sub.Modules)
                        {
                            <li>
                                <NavLink class="slide-item" href="@m.Route"> @m.Name</NavLink>
                            </li>
                        }
                    </ul>
                </li>
            }
        }
    }
</ul>

@code {
    private abstract record MenuEntry(int SortOrder);
    private record FlatEntry(ModuleDto Module) : MenuEntry(Module.SortOrder);
    private record SubGroupEntry(string SubCategory, List<ModuleDto> Modules) : MenuEntry(Modules.Min(m => m.SortOrder));

    private record ModuleGroup(string Category, List<MenuEntry> Entries);

    private List<ModuleGroup> moduleGroups = new();

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        await LoadModules();
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        await LoadModules();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadModules()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();

        if (state.User.Identity?.IsAuthenticated != true)
        {
            moduleGroups = new();
            return;
        }

        var myModules = await ModuleApi.GetMyModulesAsync();

        moduleGroups = myModules
            .GroupBy(m => m.Category)
            .Select(g =>
            {
                var flat = g.Where(m => string.IsNullOrWhiteSpace(m.SubCategory))
                    .Select(m => (MenuEntry)new FlatEntry(m));

                var subGroups = g.Where(m => !string.IsNullOrWhiteSpace(m.SubCategory))
                    .GroupBy(m => m.SubCategory!)
                    .Select(sg => (MenuEntry)new SubGroupEntry(sg.Key, sg.OrderBy(m => m.SortOrder).ToList()));

                var entries = flat.Concat(subGroups).OrderBy(e => e.SortOrder).ToList();
                return new ModuleGroup(g.Key, entries);
            })
            .OrderBy(g => g.Entries.Min(e => e.SortOrder))
            .ToList();
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}

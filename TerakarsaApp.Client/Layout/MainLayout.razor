@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="page">
    <div class="page-main">
        <AppHeader  />
        <AppSidebar />
        <div class="main-content app-content">
            <div class="side-app">
                <!-- CONTAINER -->
                <div class="main-container container-fluid">
                    @Body
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("jumpsPrevent");
            }
            catch (Microsoft.JSInterop.JSException)
            {
                // If the JS function isn't available or fails, ignore to avoid breaking render.
            }
        }
    }
}

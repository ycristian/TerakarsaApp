@* Pemilih artikel dipakai bersama (project dropdown -> tabel artikel, + pencarian lintas
   project). Diekstrak dari BundlePicker.razor (Prompt 11b) supaya /workflow-input (Prompt 12c)
   tidak menduplikasi markup ini. Sumber data (project/artikel/pencarian/thumbnail) dan URL
   tujuan disuntikkan lewat delegate/parameter -- komponen ini sendiri tidak tahu module apa
   yang memanggilnya. *@
@using TerakarsaApp.Shared.Projects

<div class="row mb-4">
    <div class="col-lg-7 mb-4 mb-lg-0">
        <div class="card h-100 mb-0">
            <div class="card-header">
                <h3 class="card-title">Pilih Artikel</h3>
            </div>
            <div class="card-body">
                <label class="form-label">Project</label>
                <SearchableSelect TItem="ProjectDto" Items="projects" Value="selectedProjectId" ValueChanged="HandleProjectChanged"
                                  IdSelector="@(p => p.Id)" TextSelector="@(p => $"{p.ProjectName} / {p.BuyerName} / {p.NoPo ?? "-"}")"
                                  Placeholder="Cari project / buyer / no PO..." />

                @if (isLoadingArticles)
                {
                    <p class="mt-3 mb-0">Memuat artikel...</p>
                }
                else if (selectedProjectId > 0 && articles.Count == 0)
                {
                    <p class="mt-3 mb-0 text-muted">Project ini belum punya artikel.</p>
                }
                else if (articles.Count > 0)
                {
                    <div class="table-responsive mt-3">
                        <table class="table table-bordered border mb-0">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Artikel</th>
                                    <th>Qty Order</th>
                                    @if (ExtraColumnHeader is not null)
                                    {
                                        <th>@ExtraColumnHeader</th>
                                    }
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in articles)
                                {
                                    <tr>
                                        <td style="width: 56px;">
                                            @if (thumbnails.TryGetValue(a.Id, out var src))
                                            {
                                                <img src="@src" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 4px;">
                                                    <i class="fe fe-image text-muted"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div>@a.ArticleName</div>
                                            <div class="text-muted small">@(string.IsNullOrEmpty(a.Style) ? "" : $"{a.Style} ") @(a.Color ?? "")</div>
                                        </td>
                                        <td>@a.TotalQty</td>
                                        @if (ExtraColumnHeader is not null)
                                        {
                                            <td>@ExtraColumnValue!(a)</td>
                                        }
                                        <td>
                                            <a class="btn btn-sm btn-primary" href="@DetailUrl(a)" target="_blank">@ActionLabel</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100 mb-0">
            <div class="card-header">
                <h3 class="card-title">Cari Artikel Lintas Project</h3>
            </div>
            <div class="card-body">
                <input class="form-control" placeholder="Ketik min. 3 huruf (nama artikel / style)..."
                       @bind="searchKeyword" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />

                @if (isSearching)
                {
                    <p class="mt-3 mb-0">Mencari...</p>
                }
                else if (searchKeyword.Trim().Length >= 3 && searchResults.Count == 0)
                {
                    <p class="mt-3 mb-0 text-muted">Tidak ada artikel yang cocok.</p>
                }
                else if (searchResults.Count > 0)
                {
                    <div class="list-group mt-3">
                        @foreach (var r in searchResults)
                        {
                            <a class="list-group-item list-group-item-action" href="@SearchDetailUrl(r)" target="_blank">
                                <div class="fw-semibold">@r.ArticleName @(string.IsNullOrEmpty(r.Style) ? "" : $"- {r.Style}") @(r.Color ?? "")</div>
                                <div class="text-muted small">@r.ProjectName</div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Func<Task<List<ProjectDto>>> LoadProjectsAsync { get; set; } = default!;
    [Parameter, EditorRequired] public Func<int, Task<List<ArticleListItemDto>>> LoadArticlesAsync { get; set; } = default!;
    [Parameter, EditorRequired] public Func<string, Task<List<ArticleSearchDto>>> SearchArticlesAsync { get; set; } = default!;
    [Parameter, EditorRequired] public Func<int, Task<(byte[] Bytes, string ContentType)?>> LoadThumbnailAsync { get; set; } = default!;
    [Parameter, EditorRequired] public Func<ArticleListItemDto, string> DetailUrl { get; set; } = default!;
    [Parameter, EditorRequired] public Func<ArticleSearchDto, string> SearchDetailUrl { get; set; } = default!;
    [Parameter] public string ActionLabel { get; set; } = "Kelola";
    [Parameter] public string? ExtraColumnHeader { get; set; }
    [Parameter] public Func<ArticleListItemDto, string>? ExtraColumnValue { get; set; }

    private List<ProjectDto> projects = new();
    private int selectedProjectId;
    private bool isLoadingArticles = false;
    private List<ArticleListItemDto> articles = new();
    private Dictionary<int, string> thumbnails = new();

    private string searchKeyword = string.Empty;
    private bool isSearching = false;
    private List<ArticleSearchDto> searchResults = new();
    private System.Threading.Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        projects = await LoadProjectsAsync();
    }

    private async Task HandleProjectChanged(int projectId)
    {
        selectedProjectId = projectId;
        articles = new();
        thumbnails = new();

        if (projectId <= 0) return;

        isLoadingArticles = true;
        articles = await LoadArticlesAsync(projectId);
        isLoadingArticles = false;

        foreach (var a in articles)
        {
            var result = await LoadThumbnailAsync(a.Id);
            if (result is not null)
            {
                var base64 = Convert.ToBase64String(result.Value.Bytes);
                thumbnails[a.Id] = $"data:{result.Value.ContentType};base64,{base64}";
            }
        }
    }

    private void HandleSearchKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        debounceTimer?.Dispose();
        debounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                var keyword = searchKeyword.Trim();
                if (keyword.Length < 3)
                {
                    searchResults = new();
                    isSearching = false;
                    StateHasChanged();
                    return;
                }

                isSearching = true;
                StateHasChanged();
                searchResults = await SearchArticlesAsync(keyword);
                isSearching = false;
                StateHasChanged();
            });
        }, null, 400, Timeout.Infinite);
    }
}

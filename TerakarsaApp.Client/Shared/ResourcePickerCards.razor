@* Prompt 49: pilih pelaksana lewat tombol kartu kecil.
   Dulu grid col-6 col-md-4 (tetap 2 kolom di layar sempit) -- diganti flex-wrap: tombol
   selebar isinya dan baru turun baris kalau memang tidak muat lagi ke samping. Nama resource
   panjang-pendeknya berbeda-beda, jadi kolom tetap menyisakan banyak ruang kosong. *@
@using TerakarsaApp.Shared.Resources

<div>
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label">@Label</label>
    }
    <div class="d-flex flex-wrap gap-2">
        @foreach (var r in Resources)
        {
            <button type="button" class="btn btn-sm @(SelectedId == r.Id ? "btn-primary" : "btn-outline-primary")"
                    disabled="@Disabled" @onclick="() => Select(r.Id)">
                @r.ResourceName
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public List<ResourceLookupDto> Resources { get; set; } = new();
    [Parameter] public int? SelectedId { get; set; }
    [Parameter] public EventCallback<int?> SelectedIdChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Label { get; set; } = "Pelaksana";

    private Task Select(int id) => SelectedIdChanged.InvokeAsync(id);
}

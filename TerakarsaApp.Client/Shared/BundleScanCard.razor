@* Kartu hasil scan bundle — dipakai di panel Scan /station (aksi kontekstual aktif)
   dan halaman publik /b/{serial} (ReadOnly=true, tanpa tombol aksi). *@
@using TerakarsaApp.Shared.Bundles
@using TerakarsaApp.Shared.Resources
@using TerakarsaApp.Shared.WorkflowLogs
@using TerakarsaApp.Client.Services
@inject StationDeviceApiService StationApi
@inject IJSRuntime JS

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
                <h2 class="mb-0">No. @BundleDisplay.Format(Info.Bundle.BundleLetter, Info.Bundle.BundleNo)</h2>
                <p class="text-muted mb-0">@Info.Bundle.Serial</p>
            </div>
            <div class="text-end">
                <h4 class="mb-0">
                    @Info.Bundle.Qty <small class="text-muted">pcs</small>
                    <span class="badge bg-secondary fl-6">@Info.Bundle.SizeName</span>
                </h4>
                @if (AllowReprint)
                {
                    <button class="btn btn-outline-secondary btn-sm mt-2" disabled="@reprintBusy" @onclick="OpenReprintModal">
                        <i class="fe fe-printer"></i> Cetak Ulang
                    </button>
                    @if (!string.IsNullOrEmpty(reprintFeedback))
                    {
                        <div class="small mt-1 @(reprintFeedback == "Label masuk antrian cetak." ? "text-success" : "text-danger")">@reprintFeedback</div>
                    }
                }
                @if (IsSuperAdmin)
                {
                    <button class="btn btn-outline-dark btn-sm mt-2 ms-1" @onclick="() => OnEditBundleRequested.InvokeAsync()">
                        <i class="fe fe-edit-2"></i> Edit Bundle
                    </button>
                }
            </div>
        </div>

        <hr />

        <p class="mb-1"><strong>@Info.Bundle.ArticleName</strong> @Info.Bundle.Style @Info.Bundle.Color</p>
        <p class="text-muted mb-1">@Info.Bundle.ProjectName</p>
        @if (!string.IsNullOrEmpty(Info.Bundle.Line) || !string.IsNullOrEmpty(Info.Bundle.EmployeeName))
        {
            <p class="mb-1">Line: <strong>@BundleDisplay.FormatPenjahit(Info.Bundle.Line, Info.Bundle.EmployeeName)</strong></p>
        }
        <p class="mb-3">
            Posisi terakhir: <strong>@Info.Bundle.LastStepName</strong>
            @if (!string.IsNullOrEmpty(Info.Bundle.LastDivisionName))
            {
                <span>(@Info.Bundle.LastDivisionName)</span>
            }
            — <span class="badge bg-info">@Info.Bundle.LastStatus</span>
        </p>

        <h6>Timeline</h6>
        @{
            var shown = showFullTimeline ? Info.Timeline : Info.Timeline.TakeLast(5).ToList();
        }
        <ul class="list-group list-group-flush mb-2">
            @foreach (var t in shown)
            {
                <li class="list-group-item px-0 py-1">
                    <div class="d-flex justify-content-between">
                        <span>
                            <strong>@t.SortOrder - @t.StepName</strong>
                            @if (t.LogType == "ADJUSTMENT")
                            {
                                <span class="badge bg-warning text-dark ms-1">Penyesuaian</span>
                            }
                        </span>
                        <span class="text-muted">
                            @t.CreatedAt.ToString("dd/MM HH:mm")
                            @if (AllowReprint && TotalReject(t) > 0)
                            {
                                <button class="btn btn-sm p-0 ms-2" title="Cetak Reject" disabled="@(printRejectBusyId == t.Id)" @onclick="() => PrintReject(t.Id)"><i class="fe fe-printer text-danger"></i></button>
                            }
                            @if (IsSuperAdmin)
                            {
                                <button class="btn btn-outline-secondary btn-sm p-0 ms-2" title="Edit" @onclick="() => OnEditLogRequested.InvokeAsync(t.Id)"><i class="fe fe-edit"></i></button>
                            }
                        </span>
                    </div>
                    @if (t.QtyOk > 0 || t.QtyRejectPrint != 0 || t.QtyRejectFabric != 0 || t.QtyRejectSewing != 0 || t.QtyRejectRework != 0 || t.QtyLost != 0 || !string.IsNullOrEmpty(t.TargetDivisionName) || !string.IsNullOrEmpty(t.ResourceName))
                    {
                        <div class="text-muted small">
                            <div>No @t.Id</div>
                            @if (!string.IsNullOrEmpty(t.ResourceName))
                            {
                                <div>Pelaksana: @(!string.IsNullOrEmpty(t.DivisionName) ? $"{t.DivisionName} - " : "")@t.ResourceName</div>
                            }
                            @if (t.QtyOk != 0)
                            {
                                <div>Qty OK: @FormatSigned(t.QtyOk, t.LogType)</div>
                            }
                            @if (t.QtyRejectPrint != 0)
                            {
                                <div class="text-danger">Reject Print: @FormatSigned(t.QtyRejectPrint, t.LogType)</div>
                            }
                            @if (t.QtyRejectFabric != 0)
                            {
                                <div class="text-danger">Reject Bahan: @FormatSigned(t.QtyRejectFabric, t.LogType)</div>
                            }
                            @if (t.QtyRejectSewing != 0)
                            {
                                <div class="text-danger">Reject Jahit: @FormatSigned(t.QtyRejectSewing, t.LogType)</div>
                            }
                            @if (t.QtyRejectRework != 0)
                            {
                                <div class="text-danger">Reject Rework: @FormatSigned(t.QtyRejectRework, t.LogType)</div>
                            }
                            @if (t.QtyLost != 0)
                            {
                                <div class="text-danger">Hilang: @FormatSigned(t.QtyLost, t.LogType)</div>
                            }
                            @if (!string.IsNullOrEmpty(t.TargetDivisionName))
                            {
                                <div>Target Division: @t.TargetDivisionName</div>
                            }
                        </div>
                    }
                    @if (t.ReceivedAt is not null)
                    {
                        <small class="text-success d-block">
                            Diterima @t.ReceivedAt.Value.ToString("dd/MM HH:mm") oleh @(t.ReceivedByResourceName ?? (t.ReceivedRemark == "Otomatis: auto-terima" ? "Otomatis" : ""))
                            @(!string.IsNullOrEmpty(t.ReceivedRemark) ? $"— {t.ReceivedRemark}" : "")
                        </small>
                    }
                </li>
            }
        </ul>
        @if (Info.Timeline.Count > 5)
        {
            <button class="btn btn-link btn-sm p-0 mb-3" @onclick="() => showFullTimeline = !showFullTimeline">
                @(showFullTimeline ? "Sembunyikan" : $"Lihat semua ({Info.Timeline.Count})")
            </button>
        }
        @if (!string.IsNullOrEmpty(printRejectFeedback))
        {
            <div class="small mb-2 @(printRejectFeedback.StartsWith("Nota") ? "text-success" : "text-danger")">@printRejectFeedback</div>
        }

        @if (!ReadOnly)
        {
            <hr />

            @if (Info.Action.AllowedAction == "RECEIVE")
            {
                @if (PendingReceive is not null)
                {
                    <div class="alert alert-success d-flex justify-content-between align-items-center mb-2">
                        <span>Qty OK</span>
                        <span class="fs-3 fw-bold">@PendingReceive.QtyOk</span>
                    </div>
                }
                @if (!showReceiveNote)
                {
                    <div class="d-flex gap-2">
                        <button class="btn btn-success btn-lg flex-grow-1" disabled="@Busy" @onclick="() => OnReceive.InvokeAsync(null)">Terima</button>
                        <button class="btn btn-outline-secondary" disabled="@Busy" @onclick="() => showReceiveNote = true">Dengan Catatan</button>
                    </div>
                }
                else
                {
                    <label class="form-label">Catatan</label>
                    <textarea class="form-control mb-2" rows="2" @bind="receiveNoteText"></textarea>
                    <div class="d-flex gap-2">
                        <button class="btn btn-light" disabled="@Busy" @onclick="() => showReceiveNote = false">Batal</button>
                        <button class="btn btn-success flex-grow-1" disabled="@(Busy || string.IsNullOrWhiteSpace(receiveNoteText))"
                                @onclick="() => OnReceive.InvokeAsync(receiveNoteText)">Terima</button>
                    </div>
                }
            }
            else if (Info.Action.AllowedAction == "COMPLETE")
            {
                <button class="btn btn-primary btn-lg w-100" disabled="@Busy" @onclick="OpenCompleteModal">
                    Kirim Hasil
                </button>
            }
            else if (Info.Action.AllowedAction == "EDIT")
            {
                <div class="alert alert-info d-flex justify-content-between align-items-center mb-0">
                    <span>
                        @if (Info.Action.IsLastStep)
                        {
                            <text>Step terakhir sudah selesai — masih bisa direvisi sampai H+1 (besok).</text>
                        }
                        else
                        {
                            <text>Bundle ini sudah kamu serahkan, masih menunggu diterima tujuan — masih bisa direvisi.</text>
                        }
                    </span>
                    <div class="d-flex gap-2 ms-2">
                        @if (Info.Action.PrintKupon && Info.Action.ActionWorkflowLogId is not null)
                        {
                            <button class="btn btn-outline-success btn-sm text-nowrap" disabled="@(Busy || printHasilBusy)" @onclick="PrintHasil">
                                <i class="fe fe-printer"></i> Print Hasil
                            </button>
                        }
                        <button class="btn btn-outline-primary btn-sm" disabled="@Busy" @onclick="OpenEditModal">Edit</button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(printHasilFeedback))
                {
                    <div class="small mt-1 @(printHasilFeedback == "Kupon masuk antrian cetak." ? "text-success" : "text-danger")">@printHasilFeedback</div>
                }
            }
            else
            {
                <div class="alert alert-warning mb-0">@(Info.Action.Message ?? "Tidak ada aksi untuk bundle ini saat ini.")</div>
            }

            @if (!string.IsNullOrEmpty(ActionError) && !ActionError.StartsWith("QTY_EXCEED|") && !ActionError.StartsWith("QTY_SHORT|"))
            {
                <div class="alert alert-danger mt-2 mb-0">@ActionError</div>
            }

            @if (Info.Action.AllowedAdjust)
            {
                <button class="btn btn-outline-warning btn-sm w-100 mt-2" disabled="@Busy" @onclick="OpenAdjustModal">
                    <i class="fe fe-edit-3"></i> Penyesuaian
                </button>
            }
        }
    </div>
</div>

@if (showAdjustModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Penyesuaian</h5>
                    <button type="button" class="btn-close" @onclick="CloseAdjustModal"></button>
                </div>
                <div class="modal-body">
                    <p><strong>No. @BundleDisplay.Format(Info.Bundle.BundleLetter, Info.Bundle.BundleNo) - @Info.Bundle.SizeName</strong> &middot; @Info.Bundle.Serial</p>

                    @if (Info.AdjustSteps.Count > 1)
                    {
                        <label class="form-label">Step</label>
                        <select class="form-select mb-2" @bind="adjustSelectedStepId" @bind:after="OnAdjustStepChanged">
                            @foreach (var s in Info.AdjustSteps)
                            {
                                <option value="@s.ArticleWorkflowId">@s.SortOrder - @s.StepName</option>
                            }
                        </select>
                    }

                    @if (adjustStep is not null)
                    {
                        <div class="row g-2 mb-1 small text-muted">
                            <div class="col-6">Kategori</div>
                            <div class="col-3">Saldo</div>
                            <div class="col-3">Mutasi</div>
                        </div>
                        <div class="row g-2 align-items-center mb-1">
                            <div class="col-6">Reject Print</div>
                            <div class="col-3">@adjustStep.SaldoRejectPrint</div>
                            <div class="col-3">
                                <div class="input-group input-group-sm">
                                    <button type="button" class="btn btn-outline-secondary" title="Balik tanda +/-" @onclick="() => adjustQtyRejectPrint = -adjustQtyRejectPrint">&plusmn;</button>
                                    <input type="number" class="form-control form-control-sm" @bind="adjustQtyRejectPrint" />
                                </div>
                            </div>
                        </div>
                        <div class="row g-2 align-items-center mb-1">
                            <div class="col-6">Reject Bahan</div>
                            <div class="col-3">@adjustStep.SaldoRejectFabric</div>
                            <div class="col-3">
                                <div class="input-group input-group-sm">
                                    <button type="button" class="btn btn-outline-secondary" title="Balik tanda +/-" @onclick="() => adjustQtyRejectFabric = -adjustQtyRejectFabric">&plusmn;</button>
                                    <input type="number" class="form-control form-control-sm" @bind="adjustQtyRejectFabric" />
                                </div>
                            </div>
                        </div>
                        <div class="row g-2 align-items-center mb-1">
                            <div class="col-6">Reject Jahit</div>
                            <div class="col-3">@adjustStep.SaldoRejectSewing</div>
                            <div class="col-3">
                                <div class="input-group input-group-sm">
                                    <button type="button" class="btn btn-outline-secondary" title="Balik tanda +/-" @onclick="() => adjustQtyRejectSewing = -adjustQtyRejectSewing">&plusmn;</button>
                                    <input type="number" class="form-control form-control-sm" @bind="adjustQtyRejectSewing" />
                                </div>
                            </div>
                        </div>
                        <div class="row g-2 align-items-center mb-1">
                            <div class="col-6">Reject Rework</div>
                            <div class="col-3">@adjustStep.SaldoRejectRework</div>
                            <div class="col-3">
                                <div class="input-group input-group-sm">
                                    <button type="button" class="btn btn-outline-secondary" title="Balik tanda +/-" @onclick="() => adjustQtyRejectRework = -adjustQtyRejectRework">&plusmn;</button>
                                    <input type="number" class="form-control form-control-sm" @bind="adjustQtyRejectRework" />
                                </div>
                            </div>
                        </div>
                        <div class="row g-2 align-items-center mb-1">
                            <div class="col-6">Hilang</div>
                            <div class="col-3">@adjustStep.SaldoLost</div>
                            <div class="col-3">
                                <div class="input-group input-group-sm">
                                    <button type="button" class="btn btn-outline-secondary" title="Balik tanda +/-" @onclick="() => adjustQtyLost = -adjustQtyLost">&plusmn;</button>
                                    <input type="number" class="form-control form-control-sm" @bind="adjustQtyLost" />
                                </div>
                            </div>
                        </div>
                        <div class="row g-2 align-items-center mb-2">
                            <div class="col-6">Qty OK</div>
                            <div class="col-3">-</div>
                            <div class="col-3"><input type="number" min="0" class="form-control form-control-sm" @bind="adjustQtyOk" /></div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded @(AdjustTotal == 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                            <span>Total Mutasi</span>
                            <strong>@AdjustTotal</strong>
                        </div>

                        @if (adjustQtyOk > 0)
                        {
                            <div class="mb-2">
                                <label class="form-label">Divisi Tujuan</label>
                                <div class="form-control form-control-sm bg-light">
                                    @(adjustStep.NextDivisionId is not null ? adjustStep.NextDivisionName : "Step terakhir — tidak ada serah lanjutan")
                                </div>
                            </div>
                        }

                        <label class="form-label">Catatan (opsional)</label>
                        <textarea class="form-control" rows="2" @bind="adjustRemark"></textarea>
                    }

                    @if (!string.IsNullOrEmpty(adjustError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@adjustError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseAdjustModal">Batal</button>
                    <button class="btn btn-warning" disabled="@(Busy || adjustStep is null || AdjustTotal != 0)" @onclick="SubmitAdjust">Simpan</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showEditModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Revisi Data</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    <p><strong>No. @BundleDisplay.Format(Info.Bundle.BundleLetter, Info.Bundle.BundleNo) - @Info.Bundle.SizeName</strong> &middot; @Info.Bundle.Serial</p>

                    <div class="d-flex justify-content-end mb-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ResetEdit">Reset</button>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label">Qty OK</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="editQtyOk" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Print</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="editQtyRejectPrint" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Bahan</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="editQtyRejectFabric" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Jahit</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="editQtyRejectSewing" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Rework</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="editQtyRejectRework" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Hilang</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="editQtyLost" />
                        </div>
                    </div>

                    @if (editQuotaInfo is not null)
                    {
                        <div class="form-text mb-2">Masuk: @editQuotaInfo.QtyMasuk &middot; Tercatat: @editQuotaInfo.QtySudah &middot; Sisa: @editQuotaInfo.Sisa</div>
                    }

                    <label class="form-label">Catatan (wajib jika ada reject)</label>
                    <textarea class="form-control" rows="2" @bind="editRemark"></textarea>
                    @if (!string.IsNullOrEmpty(editRemarkError))
                    {
                        <div class="text-danger small mb-2">@editRemarkError</div>
                    }

                    @if (!string.IsNullOrEmpty(ActionError) && ActionError.StartsWith("QTY_EXCEED|"))
                    {
                        <div class="alert alert-warning mt-2 mb-0">
                            <p class="mb-2">@(ActionError["QTY_EXCEED|".Length..])</p>
                            <p class="mb-2">Yakin tetap simpan?</p>
                            <button class="btn btn-warning btn-sm" disabled="@Busy" @onclick="ConfirmSubmitEditExceed">Ya, tetap simpan</button>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(ActionError) && ActionError.StartsWith("QTY_SHORT|"))
                    {
                        <div class="alert alert-warning mt-2 mb-0">
                            <p class="mb-2">@(ActionError["QTY_SHORT|".Length..])</p>
                            <p class="mb-2">Yakin tetap simpan?</p>
                            <button class="btn btn-warning btn-sm" disabled="@Busy" @onclick="ConfirmSubmitEditShort">Ya, tetap simpan</button>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(ActionError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@ActionError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseEditModal">Batal</button>
                    <button class="btn btn-primary" disabled="@Busy" @onclick="SubmitEdit">Simpan</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDefectLabelModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Print Label Cacat</h5>
                    <button type="button" class="btn-close" @onclick="CloseDefectLabelModal"></button>
                </div>
                <div class="modal-body">
                    <p><strong>No. @BundleDisplay.Format(Info.Bundle.BundleLetter, Info.Bundle.BundleNo) - @Info.Bundle.SizeName</strong> &middot; @Info.Bundle.Serial</p>

                    <div class="text-danger small mb-3">
                        @if (defectQtyRejectPrint > 0)
                        {
                            <div>Reject Print: @defectQtyRejectPrint</div>
                        }
                        @if (defectQtyRejectFabric > 0)
                        {
                            <div>Reject Bahan: @defectQtyRejectFabric</div>
                        }
                        @if (defectQtyRejectSewing > 0)
                        {
                            <div>Reject Jahit: @defectQtyRejectSewing</div>
                        }
                    </div>

                    <label class="form-label">Jumlah Label</label>
                    <input type="number" min="1" class="form-control form-control-lg" @bind="defectLabelCopies" />

                    @if (!string.IsNullOrEmpty(defectLabelError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@defectLabelError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseDefectLabelModal">Lewati</button>
                    <button class="btn btn-primary" disabled="@(defectLabelBusy || defectLabelCopies < 1)" @onclick="SubmitDefectLabel">Cetak</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showReprintModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Cetak Ulang Label</h5>
                    <button type="button" class="btn-close" @onclick="CloseReprintModal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Cetak ulang label @Info.Bundle.Serial.</p>
                    <label class="form-label">Jumlah Label</label>
                    <input type="number" min="1" class="form-control form-control-lg" @bind="reprintCopies" />
                    @if (!string.IsNullOrEmpty(reprintModalError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@reprintModalError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseReprintModal">Batal</button>
                    <button class="btn btn-primary" disabled="@(reprintBusy || reprintCopies < 1)" @onclick="SubmitReprint">Cetak</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showCompleteModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Kirim Hasil</h5>
                    <button type="button" class="btn-close" @onclick="CloseCompleteModal"></button>
                </div>
                <div class="modal-body">
                    <p><strong>No. @BundleDisplay.Format(Info.Bundle.BundleLetter, Info.Bundle.BundleNo) - @Info.Bundle.SizeName</strong> &middot; @Info.Bundle.Serial</p>

                    <div class="mb-3">
                        @if (AllowResourceChange)
                        {
                            <ResourcePickerCards Resources="ResourceOptions" SelectedId="completeResourceId"
                                                  SelectedIdChanged="(int? v) => completeResourceId = v ?? 0" Label="Pelaksana" />
                        }
                        else
                        {
                            <label class="form-label">Pelaksana</label>
                            <div class="form-control form-control-lg bg-light"><i class="fe fe-lock"></i> @ActiveResourceName</div>
                        }
                    </div>

                    <div class="d-flex justify-content-end mb-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="SetCompleteAllOk">Set All OK</button>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label">Qty OK</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="completeQtyOk" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Print</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="completeQtyRejectPrint" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Bahan</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="completeQtyRejectFabric" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Jahit</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="completeQtyRejectSewing" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Reject Rework</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="completeQtyRejectRework" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Hilang</label>
                            <input type="number" min="0" class="form-control form-control-lg" @bind="completeQtyLost" />
                        </div>
                    </div>

                    @if (completeQuotaInfo is not null)
                    {
                        <div class="form-text mb-2">Masuk: @completeQuotaInfo.QtyMasuk &middot; Tercatat: @completeQuotaInfo.QtySudah &middot; Sisa: @completeQuotaInfo.Sisa</div>
                    }

                    <div class="mb-2">
                        <label class="form-label">Divisi Tujuan</label>
                        <div class="form-control form-control-lg bg-light">
                            @(Info.Action.IsLastStep ? "Step terakhir — tidak ada serah lanjutan" : (Info.Action.NextDivisionName ?? "-"))
                        </div>
                    </div>

                    @if (Info.Action.ReceiverPickerRequired == true)
                    {
                        <div class="mb-2">
                            <label class="form-label">Diterima Oleh (@Info.Action.NextDivisionName)</label>
                            <SearchableSelect TItem="ResourceLookupDto" Items="receiverOptions" @bind-Value="completeAutoReceiveResourceId"
                                              IdSelector="@(r => r.Id)" TextSelector="@(r => r.ResourceName)" Placeholder="Cari resource..." />
                            @if (completeAutoReceiveResourceId <= 0)
                            {
                                <div class="text-danger small mt-1">Penerima wajib dipilih.</div>
                            }
                        </div>
                    }
                    else if (Info.Action.NextAutoReceive == true && !string.IsNullOrEmpty(Info.Action.NextCounterpartResourceName))
                    {
                        <div class="alert alert-info py-2 mb-2">
                            Otomatis diterima oleh <strong>@Info.Action.NextCounterpartResourceName</strong>.
                        </div>
                    }

                    <label class="form-label">Catatan (wajib jika ada reject)</label>
                    <textarea class="form-control mb-2" rows="2" @bind="completeRemark"></textarea>
                    @if (!string.IsNullOrEmpty(completeRemarkError))
                    {
                        <div class="text-danger small mb-2">@completeRemarkError</div>
                    }

                    @if (!string.IsNullOrEmpty(ActionError) && ActionError.StartsWith("QTY_EXCEED|"))
                    {
                        <div class="alert alert-warning mt-2 mb-0">
                            <p class="mb-2">@(ActionError["QTY_EXCEED|".Length..])</p>
                            <p class="mb-2">Yakin tetap simpan?</p>
                            <button class="btn btn-warning btn-sm" disabled="@Busy" @onclick="ConfirmSubmitCompleteExceed">Ya, tetap simpan</button>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(ActionError) && ActionError.StartsWith("QTY_SHORT|"))
                    {
                        <div class="alert alert-warning mt-2 mb-0">
                            <p class="mb-2">@(ActionError["QTY_SHORT|".Length..])</p>
                            <p class="mb-2">Yakin tetap simpan?</p>
                            <button class="btn btn-warning btn-sm" disabled="@Busy" @onclick="ConfirmSubmitCompleteShort">Ya, tetap simpan</button>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(ActionError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@ActionError</div>
                    }

                    @if (AllowResourceChange && completeResourceId > 0 && completeResourceId != ActiveResourceId)
                    {
                        <div class="mt-2">
                            <span class="badge bg-warning text-dark">Pelaksana: @(ResourceOptions.FirstOrDefault(r => r.Id == completeResourceId)?.ResourceName) — bukan operator sesi</span>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseCompleteModal">Batal</button>
                    <button class="btn btn-primary" disabled="@(Busy || (Info.Action.ReceiverPickerRequired == true && completeAutoReceiveResourceId <= 0))" @onclick="SubmitComplete">Kirim Hasil</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public BundleScanInfoDto Info { get; set; } = null!;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? ActionError { get; set; }
    [Parameter] public EventCallback<string?> OnReceive { get; set; }
    [Parameter] public EventCallback<BundleCompleteFormValues> OnComplete { get; set; }
    [Parameter] public EventCallback<BundleCompleteFormValues> OnEdit { get; set; }
    // Prompt 28: panel Penyesuaian -- lihat OpenAdjustModal/SubmitAdjust di bawah.
    [Parameter] public EventCallback<BundleAdjustFormValues> OnAdjust { get; set; }
    // Prompt 24: Cetak Ulang -- hanya masuk akal saat ada token stasiun (endpoint reprint
    // butuh header X-Station-Token); halaman publik /b/{serial} tanpa token mengirim false.
    [Parameter] public bool AllowReprint { get; set; }
    // Prompt 36: tombol "Edit"/"Edit Bundle" (Super Admin) -- HANYA dikirim true dari
    // BundleScanPublic.razor (/b/{serial}) untuk user login web ber-modul SUPER_ADMIN.
    // Panel scan /station TIDAK PERNAH mengirim true (operator station tidak dapat fitur ini).
    [Parameter] public bool IsSuperAdmin { get; set; }
    [Parameter] public EventCallback<int> OnEditLogRequested { get; set; }
    [Parameter] public EventCallback OnEditBundleRequested { get; set; }

    // Prompt 39: dropdown "Pelaksana" opsional di form Kirim Hasil -- hanya tampil kalau
    // Info.Bundle.SuggestedResourceId terisi DAN station tidak terkunci (AllowResourceChange).
    // Station terkunci tetap dipaksa ActiveResourceId (default_resource_id), saran diabaikan.
    [Parameter] public List<ResourceLookupDto> ResourceOptions { get; set; } = new();
    [Parameter] public int? ActiveResourceId { get; set; }
    [Parameter] public bool AllowResourceChange { get; set; } = true;
    // Prompt 49: nama operator sesi -- dipakai teks terkunci (ikon gembok) saat
    // AllowResourceChange = false, pengganti picker "Pelaksana".
    [Parameter] public string? ActiveResourceName { get; set; }

    private bool showFullTimeline = false;
    private bool showReceiveNote = false;
    private string receiveNoteText = string.Empty;
    private bool reprintBusy = false;
    private string reprintFeedback = string.Empty;
    // Fix: modal konfirmasi Cetak Ulang -- user input jumlah label (default 1), ganti dari
    // JS confirm() polos.
    private bool showReprintModal = false;
    private int reprintCopies = 1;
    private string reprintModalError = string.Empty;

    private void OpenReprintModal()
    {
        reprintCopies = 1;
        reprintModalError = string.Empty;
        showReprintModal = true;
    }

    private void CloseReprintModal()
    {
        showReprintModal = false;
    }

    private async Task SubmitReprint()
    {
        if (reprintCopies < 1) return;

        reprintBusy = true;
        reprintModalError = string.Empty;
        reprintFeedback = string.Empty;

        var (success, error) = await StationApi.ReprintBundleAsync(Info.Bundle.BundleId, reprintCopies);

        reprintBusy = false;

        if (!success)
        {
            reprintModalError = error;
            return;
        }

        showReprintModal = false;
        reprintFeedback = "Label masuk antrian cetak.";
    }

    private BundleScanTimelineDto? PendingReceive => Info.Timeline.LastOrDefault(t => t.ReceivedAt is null);

    // Fix: "Cetak Reject" -- tombol per baris timeline, hanya tampil kalau baris itu punya
    // reject/hilang > 0 (server menegakkan ulang di SIS_WorkflowLog_PrintReject).
    private static int TotalReject(BundleScanTimelineDto t) =>
        t.QtyRejectPrint + t.QtyRejectFabric + t.QtyRejectSewing + t.QtyRejectRework + t.QtyLost;

    private int? printRejectBusyId;
    private string printRejectFeedback = string.Empty;

    private async Task PrintReject(int workflowLogId)
    {
        printRejectBusyId = workflowLogId;
        printRejectFeedback = string.Empty;

        var (success, error) = await StationApi.PrintRejectAsync(workflowLogId);

        printRejectBusyId = null;
        printRejectFeedback = success ? "Nota reject masuk antrian cetak." : error;
    }

    // Prompt 41 (lanjutan): "Print Hasil" -- cetak kupon manual segera setelah Kirim Hasil,
    // muncul selama AllowedAction = "EDIT" (belum diterima) dan step-nya ber-print_kupon = 1.
    // Boleh ditekan berkali-kali, tidak ada guard "sudah pernah cetak" (lihat
    // SIS_WorkflowLog_PrintHasil).
    private bool printHasilBusy;
    private string printHasilFeedback = string.Empty;

    private async Task PrintHasil()
    {
        if (Info.Action.ActionWorkflowLogId is null) return;

        printHasilBusy = true;
        printHasilFeedback = string.Empty;

        var (success, error) = await StationApi.PrintHasilAsync(Info.Action.ActionWorkflowLogId.Value);

        printHasilBusy = false;
        printHasilFeedback = success ? "Kupon masuk antrian cetak." : error;
    }

    // Prompt 28: baris ADJUSTMENT boleh bernilai negatif (mutasi) -- tampilkan tanda +/- di
    // timeline supaya jelas arah mutasinya; baris NORMAL tetap tampil polos (selalu >= 0).
    private static string FormatSigned(int value, string logType) =>
        logType == "ADJUSTMENT" && value > 0 ? $"+{value}" : value.ToString();

    private int completeQtyOk;
    private int completeQtyRejectPrint;
    private int completeQtyRejectFabric;
    private int completeQtyRejectSewing;
    private int completeQtyRejectRework;
    private int completeQtyLost;
    private string completeRemark = string.Empty;
    private string completeRemarkError = string.Empty;
    private WorkflowQuotaInfoDto? completeQuotaInfo;
    // Prompt 49: picker "Pelaksana" -- semua resource aktif divisi stasiun, sekali pakai per
    // pengiriman (reset ke operator sesi tiap kali modal dibuka, lihat OpenCompleteModal).
    private int completeResourceId;
    // Prompt 40: dropdown "Diterima Oleh" wajib kalau ReceiverPickerRequired = true (step
    // tujuan auto_receive = 1 tapi counterpart pengirim tidak valid) -- sekali pakai per
    // pengiriman, TIDAK sticky antar bundle.
    private List<ResourceLookupDto> receiverOptions = new();
    private int completeAutoReceiveResourceId;

    protected override async Task OnParametersSetAsync()
    {
        completeQuotaInfo = Info.Action.AllowedAction == "COMPLETE" && Info.Action.ActionArticleWorkflowId is not null
            ? await StationApi.GetQuotaInfoAsync(Info.Action.ActionArticleWorkflowId.Value, Info.Bundle.BundleId)
            : null;
    }

    private bool showCompleteModal = false;

    private async Task OpenCompleteModal()
    {
        completeRemarkError = string.Empty;
        completeResourceId = ActiveResourceId ?? 0;
        completeAutoReceiveResourceId = 0;
        receiverOptions = Info.Action.ReceiverPickerRequired == true && Info.Action.ActionArticleWorkflowId is not null
            ? await StationApi.GetReceiverOptionsAsync(Info.Action.ActionArticleWorkflowId.Value, Info.Bundle.BundleId)
            : new();
        showCompleteModal = true;
    }

    private void CloseCompleteModal()
    {
        showCompleteModal = false;
    }

    private void SetCompleteAllOk()
    {
        completeQtyOk = Math.Max(0, completeQuotaInfo?.Sisa ?? 0);
        completeQtyRejectPrint = 0;
        completeQtyRejectFabric = 0;
        completeQtyRejectSewing = 0;
        completeQtyRejectRework = 0;
        completeQtyLost = 0;
    }

    private Task SubmitComplete() => DoSubmitComplete(false, false);
    private Task ConfirmSubmitCompleteExceed() => DoSubmitComplete(true, false);
    private Task ConfirmSubmitCompleteShort() => DoSubmitComplete(false, true);

    private async Task DoSubmitComplete(bool confirmExceed, bool confirmShort)
    {
        var totalReject = completeQtyRejectPrint + completeQtyRejectFabric + completeQtyRejectSewing + completeQtyRejectRework + completeQtyLost;
        if (totalReject > 0 && string.IsNullOrWhiteSpace(completeRemark))
        {
            completeRemarkError = "Catatan wajib diisi jika ada reject.";
            return;
        }
        completeRemarkError = string.Empty;

        await OnComplete.InvokeAsync(new BundleCompleteFormValues
        {
            QtyOk = completeQtyOk,
            QtyRejectPrint = completeQtyRejectPrint,
            QtyRejectFabric = completeQtyRejectFabric,
            QtyRejectSewing = completeQtyRejectSewing,
            QtyRejectRework = completeQtyRejectRework,
            QtyLost = completeQtyLost,
            Remark = string.IsNullOrWhiteSpace(completeRemark) ? null : completeRemark,
            ConfirmExceed = confirmExceed,
            ConfirmShort = confirmShort,
            ResourceId = completeResourceId > 0 ? completeResourceId : null,
            AutoReceiveResourceId = completeAutoReceiveResourceId > 0 ? completeAutoReceiveResourceId : null
        });

        if (string.IsNullOrEmpty(ActionError))
        {
            showCompleteModal = false;

            if (totalReject > 0)
            {
                defectQtyRejectPrint = completeQtyRejectPrint;
                defectQtyRejectFabric = completeQtyRejectFabric;
                defectQtyRejectSewing = completeQtyRejectSewing;
                defectRemark = completeRemark;
                defectLabelCopies = 1;
                defectLabelError = string.Empty;
                showDefectLabelModal = true;
            }
        }
    }

    // Prompt: "Print Label Cacat" -- muncul setelah Kirim Hasil berhasil disimpan dengan
    // reject > 0. Cetak ulang label bundle (template sama, lihat SIS_Bundle_ReprintLabel)
    // sebanyak Copies lembar, remark di-override dengan catatan Kirim Hasil + ringkasan qty
    // cacat (BUKAN qty cacat itu sendiri -- Copies murni jumlah lembar fisik yang dicetak).
    private bool showDefectLabelModal = false;
    private int defectLabelCopies = 1;
    private bool defectLabelBusy = false;
    private string defectLabelError = string.Empty;
    private int defectQtyRejectPrint;
    private int defectQtyRejectFabric;
    private int defectQtyRejectSewing;
    private string defectRemark = string.Empty;

    private void CloseDefectLabelModal()
    {
        showDefectLabelModal = false;
    }

    private async Task SubmitDefectLabel()
    {
        if (defectLabelCopies < 1) return;

        defectLabelBusy = true;
        defectLabelError = string.Empty;

        var parts = new List<string>();
        if (defectQtyRejectPrint > 0) parts.Add($"Print {defectQtyRejectPrint}");
        if (defectQtyRejectFabric > 0) parts.Add($"Bahan {defectQtyRejectFabric}");
        if (defectQtyRejectSewing > 0) parts.Add($"Jahit {defectQtyRejectSewing}");
        var defectSummary = "Cacat: " + string.Join(", ", parts);
        var remark = string.IsNullOrWhiteSpace(defectRemark) ? defectSummary : $"{defectRemark} — {defectSummary}";

        var (success, error) = await StationApi.PrintDefectLabelAsync(Info.Bundle.BundleId, defectLabelCopies, remark);

        defectLabelBusy = false;
        if (success)
        {
            showDefectLabelModal = false;
        }
        else
        {
            defectLabelError = error;
        }
    }

    private bool showEditModal = false;
    private int editQtyOk;
    private int editQtyRejectPrint;
    private int editQtyRejectFabric;
    private int editQtyRejectSewing;
    private int editQtyRejectRework;
    private int editQtyLost;
    private string editRemark = string.Empty;
    private string editRemarkError = string.Empty;
    private WorkflowQuotaInfoDto? editQuotaInfo;

    private async Task OpenEditModal()
    {
        editQtyOk = Info.Action.ActionQtyOk ?? 0;
        editQtyRejectPrint = Info.Action.ActionQtyRejectPrint ?? 0;
        editQtyRejectFabric = Info.Action.ActionQtyRejectFabric ?? 0;
        editQtyRejectSewing = Info.Action.ActionQtyRejectSewing ?? 0;
        editQtyRejectRework = Info.Action.ActionQtyRejectRework ?? 0;
        editQtyLost = Info.Action.ActionQtyLost ?? 0;
        editRemark = Info.Action.ActionRemark ?? string.Empty;
        editQuotaInfo = Info.Action.ActionArticleWorkflowId is not null
            ? await StationApi.GetQuotaInfoAsync(Info.Action.ActionArticleWorkflowId.Value, Info.Bundle.BundleId)
            : null;
        editRemarkError = string.Empty;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
    }

    private void ResetEdit()
    {
        editQtyOk = Info.Action.ActionQtyOk ?? 0;
        editQtyRejectPrint = Info.Action.ActionQtyRejectPrint ?? 0;
        editQtyRejectFabric = Info.Action.ActionQtyRejectFabric ?? 0;
        editQtyRejectSewing = Info.Action.ActionQtyRejectSewing ?? 0;
        editQtyRejectRework = Info.Action.ActionQtyRejectRework ?? 0;
        editQtyLost = Info.Action.ActionQtyLost ?? 0;
        editRemark = Info.Action.ActionRemark ?? string.Empty;
        editRemarkError = string.Empty;
    }

    private Task SubmitEdit() => DoSubmitEdit(false, false);
    private Task ConfirmSubmitEditExceed() => DoSubmitEdit(true, false);
    private Task ConfirmSubmitEditShort() => DoSubmitEdit(false, true);

    private async Task DoSubmitEdit(bool confirmExceed, bool confirmShort)
    {
        var totalReject = editQtyRejectPrint + editQtyRejectFabric + editQtyRejectSewing + editQtyRejectRework + editQtyLost;
        if (totalReject > 0 && string.IsNullOrWhiteSpace(editRemark))
        {
            editRemarkError = "Catatan wajib diisi jika ada reject.";
            return;
        }
        editRemarkError = string.Empty;

        await OnEdit.InvokeAsync(new BundleCompleteFormValues
        {
            QtyOk = editQtyOk,
            QtyRejectPrint = editQtyRejectPrint,
            QtyRejectFabric = editQtyRejectFabric,
            QtyRejectSewing = editQtyRejectSewing,
            QtyRejectRework = editQtyRejectRework,
            QtyLost = editQtyLost,
            Remark = string.IsNullOrWhiteSpace(editRemark) ? null : editRemark,
            ConfirmExceed = confirmExceed,
            ConfirmShort = confirmShort
        });

        if (string.IsNullOrEmpty(ActionError))
        {
            showEditModal = false;
        }
    }

    // Prompt 28: panel Penyesuaian -- pilih step ber-bundle bersaldo, mutasi antar kategori
    // reject/hilang atau ke Qty OK, total wajib 0 (ditegakkan lagi di SIS_WorkflowLog_Manage).
    private bool showAdjustModal = false;
    private int adjustSelectedStepId;
    private int adjustQtyOk;
    private int adjustQtyRejectPrint;
    private int adjustQtyRejectFabric;
    private int adjustQtyRejectSewing;
    private int adjustQtyRejectRework;
    private int adjustQtyLost;
    private string adjustRemark = string.Empty;
    private string adjustError = string.Empty;

    private BundleAdjustStepSaldoDto? adjustStep =>
        Info.AdjustSteps.FirstOrDefault(s => s.ArticleWorkflowId == adjustSelectedStepId);

    private int AdjustTotal => adjustQtyOk + adjustQtyRejectPrint + adjustQtyRejectFabric
        + adjustQtyRejectSewing + adjustQtyRejectRework + adjustQtyLost;

    private void OpenAdjustModal()
    {
        adjustSelectedStepId = Info.AdjustSteps.FirstOrDefault()?.ArticleWorkflowId ?? 0;
        ResetAdjustQty();
        adjustRemark = string.Empty;
        adjustError = string.Empty;
        showAdjustModal = true;
    }

    private void CloseAdjustModal()
    {
        showAdjustModal = false;
    }

    private void OnAdjustStepChanged() => ResetAdjustQty();

    private void ResetAdjustQty()
    {
        adjustQtyOk = 0;
        adjustQtyRejectPrint = 0;
        adjustQtyRejectFabric = 0;
        adjustQtyRejectSewing = 0;
        adjustQtyRejectRework = 0;
        adjustQtyLost = 0;
    }

    private async Task SubmitAdjust()
    {
        if (adjustStep is null || AdjustTotal != 0) return;

        if (adjustQtyOk == 0 && adjustQtyRejectPrint == 0 && adjustQtyRejectFabric == 0
            && adjustQtyRejectSewing == 0 && adjustQtyRejectRework == 0 && adjustQtyLost == 0)
        {
            adjustError = "Isi minimal satu nilai penyesuaian.";
            return;
        }

        // Cegah mutasi minus melebihi saldo (server menegakkan ulang, ini cuma UX).
        if (adjustStep.SaldoRejectPrint + adjustQtyRejectPrint < 0
            || adjustStep.SaldoRejectFabric + adjustQtyRejectFabric < 0
            || adjustStep.SaldoRejectSewing + adjustQtyRejectSewing < 0
            || adjustStep.SaldoRejectRework + adjustQtyRejectRework < 0
            || adjustStep.SaldoLost + adjustQtyLost < 0)
        {
            adjustError = "Mutasi minus tidak boleh melebihi saldo kategori tsb.";
            return;
        }

        adjustError = string.Empty;

        await OnAdjust.InvokeAsync(new BundleAdjustFormValues
        {
            ArticleWorkflowId = adjustStep.ArticleWorkflowId,
            QtyOk = adjustQtyOk,
            QtyRejectPrint = adjustQtyRejectPrint,
            QtyRejectFabric = adjustQtyRejectFabric,
            QtyRejectSewing = adjustQtyRejectSewing,
            QtyRejectRework = adjustQtyRejectRework,
            QtyLost = adjustQtyLost,
            TargetDivisionId = adjustQtyOk > 0 ? adjustStep.NextDivisionId : null,
            Remark = string.IsNullOrWhiteSpace(adjustRemark) ? null : adjustRemark
        });

        if (string.IsNullOrEmpty(ActionError))
        {
            showAdjustModal = false;
        }
        else
        {
            adjustError = ActionError;
        }
    }
}

@typeparam TItem
@inject IJSRuntime JS

<div class="position-relative">
    <input @ref="inputRef" type="text" class="form-control" placeholder="@Placeholder"
           value="@(isOpen ? searchText : SelectedLabel)"
           disabled="@Disabled"
           @oninput="OnInput"
           @onfocus="OnFocus"
           @onblur="OnBlur" />

    @if (isOpen)
    {
        <div class="dropdown-menu show" style="@DropdownStyle">
            @if (AllowNone)
            {
                <button type="button" class="dropdown-item" @onmousedown="SelectNone" @onmousedown:preventDefault="true">@NoneLabel</button>
            }
            @if (FilteredItems.Count == 0)
            {
                <span class="dropdown-item-text text-muted">Tidak ada hasil.</span>
            }
            else
            {
                @foreach (var item in FilteredItems)
                {
                    <button type="button" class="dropdown-item" @onmousedown="@(() => SelectItem(item))" @onmousedown:preventDefault="true">@TextSelector(item)</button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<TItem> Items { get; set; } = new();
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter, EditorRequired] public Func<TItem, int> IdSelector { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TItem, string> TextSelector { get; set; } = default!;
    [Parameter] public string Placeholder { get; set; } = "Cari...";
    [Parameter] public bool AllowNone { get; set; } = false;
    [Parameter] public string NoneLabel { get; set; } = "- Tidak ada -";
    [Parameter] public bool Disabled { get; set; } = false;

    private ElementReference inputRef;
    private bool isOpen = false;
    private string searchText = string.Empty;
    private bool openUpward = false;
    private double maxHeightPx = PreferredMaxHeight;

    private const double PreferredMaxHeight = 320;
    private const double MinUsableHeight = 140;
    private const double ViewportBuffer = 12;

    private string DropdownStyle =>
        $"min-width: 100%; width: max-content; max-width: min(90vw, 480px); " +
        $"max-height: {maxHeightPx.ToString(System.Globalization.CultureInfo.InvariantCulture)}px; " +
        $"overflow-y: auto; z-index: 1051;" +
        (openUpward ? " top: auto; bottom: 100%;" : string.Empty);

    private string SelectedLabel
    {
        get
        {
            if (Value <= 0) return AllowNone ? NoneLabel : string.Empty;
            var match = Items.FirstOrDefault(i => IdSelector(i) == Value);
            return match is null ? string.Empty : TextSelector(match);
        }
    }

    private List<TItem> FilteredItems => string.IsNullOrWhiteSpace(searchText)
        ? Items
        : Items.Where(i => TextSelector(i).Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();

    private async Task OnFocus()
    {
        isOpen = true;
        searchText = string.Empty;
        await UpdatePositionAsync();
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        isOpen = true;
        await UpdatePositionAsync();
    }

    private async Task UpdatePositionAsync()
    {
        try
        {
            var space = await JS.InvokeAsync<DropdownSpace>("getDropdownSpace", inputRef);

            if (space.SpaceBelow - ViewportBuffer >= MinUsableHeight || space.SpaceBelow >= space.SpaceAbove)
            {
                openUpward = false;
                maxHeightPx = Math.Clamp(space.SpaceBelow - ViewportBuffer, MinUsableHeight, PreferredMaxHeight);
            }
            else
            {
                openUpward = true;
                maxHeightPx = Math.Clamp(space.SpaceAbove - ViewportBuffer, MinUsableHeight, PreferredMaxHeight);
            }
        }
        catch (JSException)
        {
            openUpward = false;
            maxHeightPx = PreferredMaxHeight;
        }

        StateHasChanged();
    }

    private class DropdownSpace
    {
        public double SpaceBelow { get; set; }
        public double SpaceAbove { get; set; }
    }

    private async Task OnBlur()
    {
        await Task.Delay(150);
        isOpen = false;
        searchText = string.Empty;
        StateHasChanged();
    }

    private async Task SelectItem(TItem item)
    {
        Value = IdSelector(item);
        isOpen = false;
        searchText = string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task SelectNone()
    {
        Value = 0;
        isOpen = false;
        searchText = string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }
}

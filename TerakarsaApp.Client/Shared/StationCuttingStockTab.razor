@using TerakarsaApp.Client.Services
@using TerakarsaApp.Shared.Cutting
@using TerakarsaApp.Shared.Employees
@using TerakarsaApp.Shared.Resources
@inject StationDeviceApiService StationApi

@* Prompt 80 §1 -- "Scan Stok Bundle" di station Bundling.

   Bundling MENGAMBIL bundle yang sudah dibentuk Cutting dari hamparan; tidak membuat
   bundle lagi.

   Prompt 81 -- sistem claim, dua perubahan dari Prompt 80:
     1. SATU bundle sekali proses (tidak ada daftar/pooling): scan -> pilih Line ->
        Claim -> siap scan berikutnya. Pilihan Line & penjahit dipertahankan supaya
        claim beruntun ke Line yang sama cepat.
     2. Line tujuan WAJIB. Jalur "ambil tanpa claim" dihapus, juga di SP -- tidak ada
        lagi bundle cutting yang beredar tanpa pemilik.

   Label hasil claim = cetak ulang bundle yang SAMA dalam layout BUNDLE_LABEL (serial &
   QR tidak berubah), berisi nama Line & penjahit seperti bundle manual.

   Kamera memakai QrScannerModal yang sudah dipakai halaman station lain; QR bundle
   berisi URL {PublicBaseUrl}/b/<serial> dan normalisasinya dikerjakan SP, jadi isi QR
   apa pun (URL / serial / kode cutting) dikirim apa adanya ke server. *@

<div class="d-flex flex-column gap-2">
    <div class="alert alert-light border mb-0 py-2 small">
        Scan QR stiker bundle dari Cutting, atau ketik kodenya. Satu bundle sekali proses:
        pilih Line tujuan lalu Claim. Serial bundle tidak berubah — labelnya dicetak ulang
        dengan nama Line &amp; penjahit. Bundle yang sudah diambil atau bundle buatan manual
        akan ditolak.
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-primary" disabled="@sedangProses" @onclick="() => showScanner = true">
            <i class="fe fe-maximize"></i> Scan QR
        </button>
        <div class="input-group" style="max-width: 360px;">
            <input class="form-control" placeholder="Kode bundle / serial"
                   value="@kodeManual"
                   @oninput="e => kodeManual = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="KodeKeyDown" />
            <button type="button" class="btn btn-outline-secondary"
                    disabled="@(sedangProses || kodeManual.Trim().Length == 0)"
                    @onclick="() => CariAsync(kodeManual)">Cari</button>
        </div>
    </div>

    @if (pesanError.Length > 0)
    {
        <div class="alert alert-danger mb-0 py-2 small">@pesanError</div>
    }
    @if (pesanSukses.Length > 0)
    {
        <div class="alert alert-success mb-0 py-2 small">@pesanSukses</div>
    }

    @if (bundleAktif is null)
    {
        <div class="text-muted small py-3 text-center">Belum ada bundle yang discan.</div>
    }
    else
    {
        <div class="card mb-0">
            <div class="card-body py-2 px-3" style="font-size: 0.85rem;">
                <div class="fw-bold">@bundleAktif.CuttingCode <span class="text-muted">· @bundleAktif.Serial</span></div>
                <div class="text-muted">@(bundleAktif.NoPo ?? "-") &middot; @bundleAktif.ArticleName</div>
                <div>
                    Size <strong>@bundleAktif.SizeName</strong> &middot;
                    <strong>@bundleAktif.Qty</strong> pcs &middot;
                    Set @bundleAktif.SetNo
                </div>
                <div class="text-muted">
                    Nomor @bundleAktif.NumberRange &middot;
                    Hamparan @bundleAktif.SpreadCode (@bundleAktif.SpreadDate.ToString("dd MMM"))
                </div>
            </div>
        </div>

        @* Prompt 81: Line tujuan WAJIB. Opsi = resource divisi penerima log Bundling,
           dihitung SP (BundlingTargetDivisionId) dengan definisi yang sama seperti
           validasi di SIS_CuttingBundle_Take, jadi pilihan UI tidak bisa ditolak SP. *@
        <div class="border-top pt-2">
            <label class="form-label mb-1 fw-bold">Claim ke Line</label>
            @if (lineOptions.Count == 0)
            {
                <div class="alert alert-warning mb-0 py-2 small">
                    Artikel ini belum punya Line tujuan (workflow-nya tidak punya step sesudah
                    Bundling, atau divisi tujuan belum punya resource aktif). Perbaiki workflow
                    artikelnya dulu — bundle tidak bisa diambil tanpa Line.
                </div>
            }
            else
            {
                <div class="row g-2">
                    @foreach (var r in lineOptions)
                    {
                        <div class="col-6 col-md-4">
                            <button type="button" class="btn w-100 @(lineId == r.Id ? "btn-primary" : "btn-outline-secondary")"
                                    disabled="@sedangProses" @onclick="() => PilihLineAsync(r.Id)">
                                @r.ResourceName
                            </button>
                        </div>
                    }
                </div>
                <div class="row g-2 mt-2">
                    <div class="col-8">
                        <label class="form-label">Penjahit (opsional)</label>
                        <SearchableSelect TItem="EmployeeLookupDto" Items="employeeOptions" @bind-Value="employeeId"
                                          IdSelector="@(e => e.Id)"
                                          TextSelector="@(e => BundleDisplay.FormatEmployeeOption(e.EmployeeCode, e.EmployeeName))"
                                          AllowNone="true" NoneLabel="- Tidak ada -" Disabled="@(lineId <= 0)"
                                          Placeholder="Cari penjahit..." />
                    </div>
                    <div class="col-4">
                        <label class="form-label">Jumlah Label</label>
                        <input type="number" min="0" class="form-control" @bind="jumlahLabel" />
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-between align-items-center gap-2 border-top pt-2">
            <button type="button" class="btn btn-outline-secondary" disabled="@sedangProses" @onclick="Batal">
                Batal
            </button>
            <button type="button" class="btn btn-success"
                    disabled="@(sedangProses || ResourceId <= 0 || lineId <= 0)"
                    title="@ClaimTitle"
                    @onclick="ClaimAsync">
                @(sedangProses ? "Memproses…" : "Claim & cetak label")
            </button>
        </div>
    }
</div>

<QrScannerModal Show="showScanner" OnScanned="HasilScanAsync" OnClose="() => showScanner = false" />

@code {
    // Operator sesi station (resource divisi Bundling) -- dipakai sebagai pengambil.
    [Parameter] public int ResourceId { get; set; }

    // Dipanggil setelah claim sukses supaya halaman station memuat ulang WIP/IN/OUT
    // (bundle yang diklaim langsung jadi baris handover Bundling yang sudah diterima).
    [Parameter] public EventCallback OnTaken { get; set; }

    // Prompt 81: satu bundle sekali proses -- tidak ada daftar/pooling.
    private CuttingBundleScanDto? bundleAktif;
    private string kodeManual = string.Empty;
    private bool showScanner;
    private bool sedangProses;
    private string pesanError = string.Empty;
    private string pesanSukses = string.Empty;

    // Line & penjahit dipertahankan antar bundle supaya claim beruntun ke Line yang sama
    // tidak perlu dipilih ulang; direset kalau artikel berikutnya tidak punya Line itu.
    private List<ResourceLookupDto> lineOptions = new();
    private List<EmployeeLookupDto> employeeOptions = new();
    private int lineId;
    private int employeeId;
    private int jumlahLabel = 1;

    private string ClaimTitle => ResourceId <= 0
        ? "Pilih operator dulu"
        : lineId <= 0 ? "Pilih Line tujuan dulu" : "Claim bundle ke Line & cetak label";

    private async Task HasilScanAsync(string nilai)
    {
        showScanner = false;
        await CariAsync(nilai);
    }

    private async Task KodeKeyDown(KeyboardEventArgs e)
    {
        // Pemindai barcode genggam mengirim Enter di akhir -- diperlakukan sama dengan Cari.
        if (e.Key == "Enter" && kodeManual.Trim().Length > 0) await CariAsync(kodeManual);
    }

    private async Task CariAsync(string kode)
    {
        kode = (kode ?? string.Empty).Trim();
        if (kode.Length == 0) return;

        sedangProses = true;
        pesanError = string.Empty;
        pesanSukses = string.Empty;

        var (success, error, bundle) = await StationApi.LookupCuttingBundleAsync(kode);

        sedangProses = false;

        if (!success || bundle is null)
        {
            pesanError = error;
            return;
        }

        bundleAktif = bundle;
        kodeManual = string.Empty;

        await MuatOpsiLineAsync(bundle);
    }

    // Opsi Line = resource divisi PENERIMA log Bundling (divisi step sesudah Bundling,
    // dihitung di SP dengan definisi yang sama seperti validasi SIS_CuttingBundle_Take).
    // Pakai resources/{divisionId}, BUKAN receiver-options -- endpoint itu 500 karena
    // SIS_Station_ReceiverOptions mengembalikan kolom ResourceId sedangkan
    // ResourceLookupDto menuntut Id, dan client menelan errornya jadi list kosong.
    private async Task MuatOpsiLineAsync(CuttingBundleScanDto bundle)
    {
        lineOptions = bundle.BundlingTargetDivisionId is int divisionId
            ? await StationApi.GetResourcesByDivisionAsync(divisionId)
            : new();

        if (!lineOptions.Any(r => r.Id == lineId))
        {
            lineId = 0;
            employeeId = 0;
            employeeOptions = new();
        }
    }

    private async Task PilihLineAsync(int resourceId)
    {
        lineId = resourceId;
        employeeId = 0;
        employeeOptions = resourceId > 0 ? await StationApi.GetEmployeesByResourceAsync(resourceId) : new();
    }

    private void Batal()
    {
        bundleAktif = null;
        pesanError = string.Empty;
        pesanSukses = string.Empty;
    }

    private async Task ClaimAsync()
    {
        if (bundleAktif is null || ResourceId <= 0 || lineId <= 0) return;

        sedangProses = true;
        pesanError = string.Empty;
        pesanSukses = string.Empty;

        var kode = bundleAktif.CuttingCode;
        var pcs = bundleAktif.Qty;
        var namaLine = lineOptions.FirstOrDefault(r => r.Id == lineId)?.ResourceName ?? "Line";

        var (success, error, hasil) = await StationApi.TakeCuttingBundlesAsync(
            new List<int> { bundleAktif.BundleId }, ResourceId,
            lineId, employeeId, jumlahLabel < 0 ? 0 : jumlahLabel);

        sedangProses = false;

        if (!success)
        {
            pesanError = error;
            return;
        }

        pesanSukses = $"{kode} ({hasil?.TotalPcs ?? pcs} pcs) diklaim ke {namaLine} " +
                      $"· {hasil?.LabelsQueued ?? 0} label dikirim ke printer.";

        // Claim tetap berhasil walau label gagal masuk antrean -- tampilkan sebagai
        // peringatan, bukan error, supaya operator tidak scan ulang.
        if (!string.IsNullOrWhiteSpace(hasil?.LabelError))
            pesanError = $"Bundle sudah diklaim, tapi label gagal dikirim: {hasil!.LabelError}";

        bundleAktif = null;   // siap scan bundle berikutnya; Line & penjahit dipertahankan

        if (OnTaken.HasDelegate) await OnTaken.InvokeAsync();
    }
}

@* Panel lengkap input log step non-bundle (mis. Cutting) untuk satu artikel: form input
   beruntun, riwayat, ringkasan per ukuran. Dipakai di /workflow-input/{ArticleId} (halaman
   WorkflowInput.razor). Pola sama dengan BundleManager.razor (Prompt 11b). *@
@using TerakarsaApp.Client.Services
@using TerakarsaApp.Shared.Projects
@using TerakarsaApp.Shared.Resources
@using TerakarsaApp.Shared.WorkflowLogs
@using Microsoft.AspNetCore.Components.Authorization
@inject WorkflowInputApiService WorkflowInputApi
@inject WorkflowLogApiService WorkflowLogApi
@inject AuthenticationStateProvider AuthStateProvider

@if (hasAccess is null)
{
    <p>Memeriksa akses...</p>
}
else if (hasAccess == false)
{
    <div class="alert alert-danger">Anda tidak memiliki akses ke modul ini.</div>
}
else if (isLoading)
{
    <p>Memuat data...</p>
}
else if (article is null)
{
    <div class="alert alert-danger">Artikel tidak ditemukan.</div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="mb-1">@project?.ProjectName</h5>
            <p class="mb-0 text-muted">@article.ArticleName @(string.IsNullOrEmpty(article.Style) ? "" : $"- {article.Style}") @(string.IsNullOrEmpty(article.Color) ? "" : $"/ {article.Color}")</p>
        </div>
    </div>

    @if (steps.Count == 0)
    {
        <div class="alert alert-warning">Artikel ini tidak punya step tanpa bundle.</div>
    }
    else
    {
        @if (steps.Count > 1)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <label class="form-label">Step</label>
                    <select class="form-select" @bind="selectedStepIdText" @bind:after="HandleStepChanged">
                        <option value="0">-- Pilih Step --</option>
                        @foreach (var s in steps)
                        {
                            <option value="@s.ArticleWorkflowId">@s.StepName</option>
                        }
                    </select>
                </div>
            </div>
        }

        @if (selectedStep is not null)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">Ringkasan per Ukuran &middot; @selectedStep.StepName</h3>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered border mb-0">
                            <thead>
                                <tr>
                                    <th>Ukuran</th>
                                    <th>Qty Order</th>
                                    <th>Tercatat</th>
                                    <th>Selisih</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in SizeSummary)
                                {
                                    <tr class="@(s.Selisih != 0 ? "table-warning" : "")">
                                        <td>@s.SizeName</td>
                                        <td>@s.QtyOrder</td>
                                        <td>@s.QtyRecorded</td>
                                        <td>@s.Selisih</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="row mb-0">
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <div class="card h-100 mb-0">
                        <div class="card-header">
                            <h3 class="card-title">Input</h3>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <label class="form-label">Size</label>
                                <SearchableSelect TItem="ArticleSizeDto" Items="article.Sizes" @bind-Value="formArticleSizeId"
                                                  IdSelector="@(s => s.Id)" TextSelector="@(s => s.SizeName)"
                                                  Placeholder="Cari ukuran..." />
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label">Qty OK</label>
                                    <input type="number" min="0" class="form-control" @bind="formQtyOk" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Reject Print</label>
                                    <input type="number" min="0" class="form-control" @bind="formQtyRejectPrint" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Reject Bahan</label>
                                    <input type="number" min="0" class="form-control" @bind="formQtyRejectFabric" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Reject Jahit</label>
                                    <input type="number" min="0" class="form-control" @bind="formQtyRejectSewing" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Rework</label>
                                    <input type="number" min="0" class="form-control" @bind="formQtyRework" />
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Resource Pencatat</label>
                                <SearchableSelect TItem="ResourceLookupDto" Items="resourceOptions" @bind-Value="formResourceId"
                                                  IdSelector="@(r => r.Id)" TextSelector="@(r => r.ResourceName)"
                                                  AllowNone="true" NoneLabel="- Tidak ada -" Placeholder="Cari resource..." />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Divisi Tujuan</label>
                                <div class="form-control bg-light">
                                    @(selectedStep.IsLastStep ? "Step terakhir — tidak ada serah lanjutan" : (selectedStep.NextDivisionName ?? "-"))
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Catatan (opsional)</label>
                                <textarea class="form-control" rows="2" @bind="formRemark"></textarea>
                            </div>
                            <button class="btn btn-primary w-100" disabled="@isSaving" @onclick="HandleSave">
                                @(isSaving ? "Menyimpan..." : "Simpan")
                            </button>
                            @if (!string.IsNullOrEmpty(saveError))
                            {
                                <div class="alert alert-danger mt-3 mb-0">@saveError</div>
                            }
                            @if (!string.IsNullOrEmpty(saveSuccessMessage))
                            {
                                <div class="alert alert-success mt-3 mb-0">@saveSuccessMessage</div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="card h-100 mb-0">
                        <div class="card-header">
                            <h3 class="card-title">Riwayat Input</h3>
                        </div>
                        <div class="card-body">
                            @if (isLoadingLogs)
                            {
                                <p class="mb-0">Memuat riwayat...</p>
                            }
                            else if (stepLogs.Count == 0)
                            {
                                <p class="text-muted mb-0">Belum ada input untuk step ini.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-bordered border text-nowrap mb-0">
                                        <thead>
                                            <tr>
                                                <th>Waktu</th>
                                                <th>Size</th>
                                                <th>Qty OK</th>
                                                <th>Reject Print</th>
                                                <th>Reject Bahan</th>
                                                <th>Reject Jahit</th>
                                                <th>Rework</th>
                                                <th>Tujuan</th>
                                                <th>Status Terima</th>
                                                <th>Catatan</th>
                                                @if (isAdmin)
                                                {
                                                    <th>Aksi</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var log in stepLogs)
                                            {
                                                <tr>
                                                    <td>@log.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td>@(log.SizeName ?? "-")</td>
                                                    <td>@log.QtyOk</td>
                                                    <td>@log.QtyRejectPrint</td>
                                                    <td>@log.QtyRejectFabric</td>
                                                    <td>@log.QtyRejectSewing</td>
                                                    <td>@log.QtyRework</td>
                                                    <td>@(log.TargetDivisionName ?? "-")</td>
                                                    <td>
                                                        @if (log.TargetDivisionId is null)
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                        else if (log.ReceivedAt is not null)
                                                        {
                                                            <span class="badge bg-success">Diterima @log.ReceivedAt.Value.ToString("dd/MM HH:mm") oleh @(log.ReceivedByResourceName ?? "-")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning">Menunggu diterima</span>
                                                        }
                                                    </td>
                                                    <td>@(log.Remark ?? "-")</td>
                                                    @if (isAdmin)
                                                    {
                                                        <td>
                                                            <button class="btn btn-sm btn-danger" title="Hapus" @onclick="() => HandleDeleteLog(log)"><i class="fe fe-trash-2"></i></button>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <ConfirmDeleteModal Show="showDeleteConfirm" IsBusy="isDeleting" OnConfirm="ConfirmDeleteLog" OnCancel="CancelDeleteLog">
        <Message>
            <p>Yakin ingin menghapus log ini (@logPendingDelete?.CreatedAt.ToString("dd/MM/yyyy HH:mm"))?</p>
            <label class="form-label">Alasan hapus (wajib)</label>
            <textarea class="form-control" rows="2" @bind="deleteReason"></textarea>
            @if (!string.IsNullOrEmpty(deleteError))
            {
                <div class="text-danger mt-2">@deleteError</div>
            }
        </Message>
    </ConfirmDeleteModal>
}

@code {
    [Parameter, EditorRequired] public int ArticleId { get; set; }

    private bool? hasAccess = null;
    private bool isAdmin = false;
    private bool isLoading = true;

    private ArticleDto? article;
    private ProjectDto? project;
    private List<ArticleNonBundleStepDto> steps = new();
    private int selectedStepId;
    private string selectedStepIdText
    {
        get => selectedStepId.ToString();
        set => selectedStepId = int.TryParse(value, out var v) ? v : 0;
    }
    private ArticleNonBundleStepDto? selectedStep => steps.FirstOrDefault(s => s.ArticleWorkflowId == selectedStepId);

    private List<ResourceLookupDto> resourceOptions = new();
    private List<WorkflowLogDto> allLogs = new();
    private List<WorkflowLogDto> stepLogs => allLogs.Where(l => l.ArticleWorkflowId == selectedStepId)
        .OrderByDescending(l => l.CreatedAt).ToList();
    private bool isLoadingLogs = false;

    private int formArticleSizeId;
    private int formQtyOk;
    private int formQtyRejectPrint;
    private int formQtyRejectFabric;
    private int formQtyRejectSewing;
    private int formQtyRework;
    private int formResourceId;
    private string formRemark = string.Empty;
    private bool isSaving = false;
    private string saveError = string.Empty;
    private string saveSuccessMessage = string.Empty;

    private bool showDeleteConfirm = false;
    private bool isDeleting = false;
    private string deleteReason = string.Empty;
    private string deleteError = string.Empty;
    private WorkflowLogDto? logPendingDelete;

    private class SizeSummaryRow
    {
        public string SizeName { get; set; } = string.Empty;
        public int QtyOrder { get; set; }
        public int QtyRecorded { get; set; }
        public int Selisih => QtyRecorded - QtyOrder;
    }

    private List<SizeSummaryRow> SizeSummary => article is null ? new() : article.Sizes
        .Select(sz => new SizeSummaryRow
        {
            SizeName = sz.SizeName,
            QtyOrder = sz.Qty,
            QtyRecorded = stepLogs.Where(l => l.ArticleSizeId == sz.Id).Sum(l => l.QtyOk)
        }).ToList();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        hasAccess = state.User.HasClaim("module", "WORKFLOW_INPUT");
        isAdmin = state.User.IsInRole("Admin");

        if (hasAccess != true)
        {
            isLoading = false;
            return;
        }

        isLoading = true;

        article = await WorkflowInputApi.GetArticleAsync(ArticleId);
        if (article is not null)
        {
            project = await WorkflowInputApi.GetProjectAsync(article.ProjectId);
            steps = await WorkflowInputApi.GetNonBundleStepsAsync(ArticleId);

            if (steps.Count == 1)
                await SelectStep(steps[0].ArticleWorkflowId);
        }

        isLoading = false;
    }

    private async Task HandleStepChanged()
    {
        await SelectStep(selectedStepId);
    }

    private async Task SelectStep(int articleWorkflowId)
    {
        selectedStepId = articleWorkflowId;
        ResetForm();

        var step = steps.FirstOrDefault(s => s.ArticleWorkflowId == articleWorkflowId);
        resourceOptions = step is null ? new() : await WorkflowInputApi.GetResourcesByDivisionAsync(step.DivisionId);

        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        isLoadingLogs = true;
        allLogs = await WorkflowLogApi.GetByArticleAsync(ArticleId);
        isLoadingLogs = false;
    }

    private void ResetForm()
    {
        formArticleSizeId = 0;
        formQtyOk = 0;
        formQtyRejectPrint = 0;
        formQtyRejectFabric = 0;
        formQtyRejectSewing = 0;
        formQtyRework = 0;
        formResourceId = 0;
        formRemark = string.Empty;
        saveError = string.Empty;
        saveSuccessMessage = string.Empty;
    }

    private async Task HandleSave()
    {
        saveError = string.Empty;
        saveSuccessMessage = string.Empty;

        if (formArticleSizeId <= 0)
        {
            saveError = "Size wajib dipilih.";
            return;
        }

        isSaving = true;

        var (success, error) = await WorkflowInputApi.CreateLogAsync(new WorkflowInputCreateRequest
        {
            ArticleWorkflowId = selectedStepId,
            ArticleSizeId = formArticleSizeId,
            ResourceId = formResourceId > 0 ? formResourceId : null,
            QtyOk = formQtyOk,
            QtyRejectPrint = formQtyRejectPrint,
            QtyRejectFabric = formQtyRejectFabric,
            QtyRejectSewing = formQtyRejectSewing,
            QtyRework = formQtyRework,
            Remark = string.IsNullOrWhiteSpace(formRemark) ? null : formRemark
        });

        isSaving = false;

        if (!success)
        {
            saveError = error;
            return;
        }

        // Size & resource dipertahankan supaya operator/supervisor bisa input beruntun untuk
        // step yang sama; hanya qty & catatan yang direset.
        formQtyOk = 0;
        formQtyRejectPrint = 0;
        formQtyRejectFabric = 0;
        formQtyRejectSewing = 0;
        formQtyRework = 0;
        formRemark = string.Empty;
        saveSuccessMessage = "Tersimpan.";
        await LoadLogs();
    }

    private void HandleDeleteLog(WorkflowLogDto log)
    {
        logPendingDelete = log;
        deleteReason = string.Empty;
        deleteError = string.Empty;
        showDeleteConfirm = true;
    }

    private void CancelDeleteLog()
    {
        showDeleteConfirm = false;
        logPendingDelete = null;
    }

    private async Task ConfirmDeleteLog()
    {
        if (logPendingDelete is null) return;

        if (string.IsNullOrWhiteSpace(deleteReason))
        {
            deleteError = "Alasan hapus wajib diisi.";
            return;
        }

        isDeleting = true;
        var result = await WorkflowLogApi.DeleteAsync(logPendingDelete.Id, deleteReason);
        isDeleting = false;

        if (result.Success)
        {
            showDeleteConfirm = false;
            logPendingDelete = null;
            await LoadLogs();
        }
        else
        {
            deleteError = result.Error;
        }
    }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Ad hoc (lanjutan Prompt 48): instance API yang dijalankan lokal (`dotnet run`, environment
  // Development) SELALU melayani api/print/claim, /report, /render dari print_jobs_dryrun --
  // bukan flag yang dikirim client (worker) yang menentukan, tapi environment API-nya sendiri.
  // Ini murni per-proses/file config, TIDAK disimpan di DB -- jadi memakai DB live yang sama
  // (mis. AGS) lewat instance lokal ini tidak pernah menyentuh antrian print_jobs live; instance
  // API produksi (appsettings.json, DryRun=false) di AGS tetap melayani live seperti biasa.
  "PrintService": {
    "DryRun": false
  },
  // Audit log TNI (TniAuditJurnal.cs) MATI saat API dijalankan lokal dari VS Code
  // (launchSettings -> Development). Server IIS = Production -> file ini tidak dibaca,
  // jadi tetap memakai "Aktif": true dari appsettings.json.
  "Tni": {
    "AuditLog": {
      "Aktif": false
    }
  },
  // Prompt 91: API lokal (dev) membaca MediaMTX di server pabrik lewat LAN.
  // StreamTokenSecret kosong di Development -> secret acak per proses (Prompt 92).
  "Cctv": {
    "MtxApiBaseUrl": "http://192.168.8.233:9997",
    "MtxHlsBaseUrl": "http://192.168.8.233:8888",
    "MtxWebRtcBaseUrl": "http://192.168.8.233:8889",
    "MtxPlaybackBaseUrl": "http://192.168.8.233:9996"
  }
}

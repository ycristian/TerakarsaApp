{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Ad hoc (lanjutan Prompt 48): instance API yang dijalankan lokal (`dotnet run`, environment
  // Development) SELALU melayani api/print/claim, /report, /render dari print_jobs_dryrun --
  // bukan flag yang dikirim client (worker) yang menentukan, tapi environment API-nya sendiri.
  // Ini murni per-proses/file config, TIDAK disimpan di DB -- jadi memakai DB live yang sama
  // (mis. AGS) lewat instance lokal ini tidak pernah menyentuh antrian print_jobs live; instance
  // API produksi (appsettings.json, DryRun=false) di AGS tetap melayani live seperti biasa.
  "PrintService": {
    "DryRun": true
  }
}

<Window x:Class="TerakarsaApp.GateApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:TerakarsaApp.GateApp"
        Title="Gate TMOS"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#12161F">
    <!-- Prompt 70: tanpa title bar dan selalu di atas, karena tablet di dudukan meja satpam
         tidak boleh bisa di-minimize atau ditutup sembarangan. Satu-satunya jalan keluar
         aplikasi ada di dalam menu satpam (butuh tap kartu is_gate_operator = 1). -->
    <Grid>
        <blazor:BlazorWebView x:Name="blazorWebView" HostPage="wwwroot\index.html">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type local:Main}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>

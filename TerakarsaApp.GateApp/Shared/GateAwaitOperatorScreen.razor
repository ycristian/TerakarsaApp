@* Prompt 70 -- antara tombol "Menu" (Gate 1) dan Menu Satpam (Gate 7): menu hanya terbuka
   dengan tap kartu ber-jabatan is_gate_operator = 1. Kartu karyawan biasa ditolak.
   Pengecekannya dari CACHE (kartu satpam ikut sync), jadi menu tetap bisa dibuka saat offline --
   yang dibatasi online hanya aksi di dalamnya (daftar kartu, ubah data). *@

<div style="width: 100%; height: 100%; box-sizing: border-box; background: #12161F; color: #FFFFFF; display: flex; flex-direction: column">

    <div style="height: 76px; box-sizing: border-box; padding: 0 44px; border-bottom: 1px solid #252C3B; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0">
        <div style="font-size: 20px; font-weight: 600; letter-spacing: 0.14em; color: #9AA4B5">@GateName</div>
        <button type="button" @onclick="OnCancel"
                style="font-size: 18px; font-weight: 600; color: #D6DCE6; background: transparent; border: 1px solid #39425A; border-radius: 10px; padding: 12px 28px; cursor: pointer">Batal</button>
    </div>

    <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0; padding: 0 70px; box-sizing: border-box; text-align: center">

        <svg width="78" height="78" viewBox="0 0 24 24" fill="none" stroke="#5BD98A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>

        <div style="font-size: 56px; font-weight: 700; line-height: 1.15; margin-top: 22px">Tempelkan kartu petugas</div>
        @if (string.IsNullOrWhiteSpace(EditTargetName))
        {
            <div style="font-size: 26px; color: #9AA4B5; margin-top: 12px; max-width: 760px; line-height: 1.5">Menu hanya terbuka untuk kartu dengan jabatan yang berhak. Kartu karyawan biasa akan ditolak.</div>
        }
        else
        {
            <div style="font-size: 26px; color: #9AA4B5; margin-top: 12px; max-width: 820px; line-height: 1.5">Untuk mengubah data <span style="color: #FFFFFF; font-weight: 600">@EditTargetName</span>. Hanya kartu petugas yang berhak.</div>
        }

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div style="margin-top: 34px; font-size: 26px; font-weight: 600; color: #F3A6A6; background: #3A1414; border: 1px solid #5E2A2A; border-radius: 12px; padding: 18px 30px; max-width: 820px">@ErrorMessage</div>
        }

    </div>

    <div style="padding: 0 44px 34px; text-align: center; flex-shrink: 0">
        <div style="font-size: 20px; color: #7D8899">Kembali ke layar tunggu dalam @SecondsLeft detik</div>
    </div>

</div>

@code {
    [Parameter, EditorRequired] public string GateName { get; set; } = string.Empty;
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public int SecondsLeft { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    // Terisi kalau layar ini dibuka dari tombol "Ubah data" di layar hasil tap.
    [Parameter] public string? EditTargetName { get; set; }
}

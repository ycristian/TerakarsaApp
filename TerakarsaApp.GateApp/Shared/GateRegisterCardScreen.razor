@* Prompt 70 -- Gate 8 (Daftar Kartu). SIS_Gate_Pending mode BELUM_PUNYA_KARTU di kiri,
   SIS_Gate_RegisterCard di kanan.
   BUTUH ONLINE: UID kembar harus dicek ke server, jadi layar ini TIDAK PERNAH diantrekan.
   Daftar default-nya karyawan yang belum punya kartu -- supaya rollout 150 kartu tinggal
   mengambil dari atas sampai daftarnya habis. *@

<div style="width: 100%; height: 100%; box-sizing: border-box; background: #12161F; color: #FFFFFF; display: flex; flex-direction: column">

    <div style="height: 76px; box-sizing: border-box; padding: 0 30px; border-bottom: 1px solid #252C3B; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0">
        <div style="display: flex; align-items: center; gap: 14px">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5BD98A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <div style="font-size: 22px; font-weight: 600">Daftar Kartu</div>
            <div style="font-size: 18px; color: #9AA4B5">@Operator.EmployeeName@(string.IsNullOrWhiteSpace(Operator.EmployeeCode) ? "" : " · " + Operator.EmployeeCode)</div>
        </div>
        <div style="display: flex; align-items: center; gap: 12px">
            <button type="button" @onclick="OnToggleCheck"
                    style="font-size: 17px; font-weight: 600; color: #FFFFFF; background: @(CheckMode ? "#1E3A5F" : "transparent"); border: 1px solid @(CheckMode ? "#2F6098" : "#39425A"); border-radius: 10px; padding: 13px 24px; cursor: pointer; display: flex; align-items: center; gap: 10px">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m20 20-3.5-3.5"></path>
                </svg>
                @(CheckMode ? "Selesai cek" : "Cek kartu")
            </button>
            <button type="button" @onclick="OnBack"
                    style="font-size: 17px; font-weight: 600; color: #D6DCE6; background: transparent; border: 1px solid #39425A; border-radius: 10px; padding: 13px 24px; cursor: pointer">Kembali</button>
        </div>
    </div>

    @if (CheckMode)
    {
        @* Cek kartu: tempel kartu -> siapa pemiliknya. Dibaca dari CACHE kartu tablet (hanya
           kartu AKTIF ikut SIS_Gate_CardSync), jadi bisa dipakai saat offline dan tidak pernah
           mencatat absen. Kartu nonaktif / belum terdaftar sama-sama tampil "tidak dikenal". *@
        <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 70px; box-sizing: border-box; text-align: center">

            @if (string.IsNullOrEmpty(CheckUid))
            {
                <svg width="76" height="76" viewBox="0 0 24 24" fill="none" stroke="#7D8899" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                    <rect x="2" y="5" width="13" height="14" rx="2"></rect>
                    <path d="M17.5 8.5a5 5 0 0 1 0 7"></path>
                    <path d="M20.5 6a9 9 0 0 1 0 12"></path>
                </svg>
                <div style="font-size: 44px; font-weight: 600; margin-top: 18px">Tempelkan kartu yang mau dicek</div>
                <div style="font-size: 23px; color: #9AA4B5; margin-top: 12px; max-width: 760px; line-height: 1.5">Hanya menampilkan pemilik kartu &mdash; tidak mencatat masuk/pulang.</div>
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div style="margin-top: 22px; font-size: 21px; color: #F3A6A6; background: #2A1414; border: 1px solid #5E2A2A; border-radius: 12px; padding: 16px 22px">@ErrorMessage</div>
                }
            }
            else
            {
                <div style="font-size: 18px; letter-spacing: 0.1em; color: #6E7A8C; font-weight: 600">UID TERBACA</div>
                <div style="font-family: 'IBM Plex Mono', Consolas, ui-monospace, monospace; font-size: 40px; font-weight: 500; letter-spacing: 0.08em; color: #E6EAF1; margin-top: 4px">@CheckUid</div>

                @if (CheckCard is null)
                {
                    <div style="margin-top: 30px; padding: 26px 46px; border: 1px solid #5E2A2A; border-radius: 14px; background: #2A1414; max-width: 820px">
                        <div style="font-size: 40px; font-weight: 700; color: #F3A6A6">Kartu tidak dikenal</div>
                        <div style="font-size: 21px; color: #D9B3B3; margin-top: 10px; line-height: 1.5">Belum terdaftar, sudah dinonaktifkan, atau tablet belum sinkron. Kartu ini bisa didaftarkan ke karyawan.</div>
                    </div>
                }
                else
                {
                    <div style="margin-top: 30px; padding: 28px 50px; border: 1px solid #1A8549; border-radius: 14px; background: #10301E; min-width: 560px; max-width: 900px">
                        <div style="font-size: 18px; letter-spacing: 0.1em; color: #9ED4B4; font-weight: 600">TERDAFTAR ATAS NAMA</div>
                        <div style="font-size: 54px; font-weight: 700; line-height: 1.15; margin-top: 6px">@CheckCard.EmployeeName</div>
                        <div style="font-size: 22px; color: #C6E8D4; margin-top: 6px">
                            @CheckCard.PositionName &middot; @(CheckCard.EmployeeCode ?? "tanpa kode") &middot; @CheckCard.DivisionName
                        </div>
                        @if (!string.IsNullOrEmpty(CheckMaskedPhone))
                        {
                            <div style="font-size: 21px; color: #C6E8D4; margin-top: 4px; font-family: 'IBM Plex Mono', Consolas, ui-monospace, monospace; letter-spacing: 0.06em">@CheckMaskedPhone</div>
                        }
                        <div style="display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; margin-top: 18px">
                            <span style="font-size: 18px; font-weight: 600; padding: 7px 18px; border-radius: 999px; background: #1E4430; border: 1px solid #2E7D4F">Kartu @(CheckCard.CardType == "SEMENTARA" ? "sementara" : "tetap")</span>
                            @if (!string.IsNullOrWhiteSpace(CheckCard.ResourceName))
                            {
                                <span style="font-size: 18px; font-weight: 600; padding: 7px 18px; border-radius: 999px; background: @GateFormat.BadgeColor(CheckCard.ColorHex)">@CheckCard.ResourceName</span>
                            }
                            @if (CheckCard.IsGateOperator)
                            {
                                <span style="font-size: 18px; font-weight: 600; padding: 7px 18px; border-radius: 999px; background: #1E3A5F; border: 1px solid #2F6098">Boleh buka menu gate</span>
                            }
                        </div>
                        <button type="button" @onclick="() => OnEditCardOwner.InvokeAsync(CheckCard)"
                                style="margin-top: 22px; font-size: 20px; font-weight: 600; color: #FFFFFF; background: #1E3A5F; border: 1px solid #2F6098; border-radius: 12px; padding: 16px 30px; min-height: 56px; cursor: pointer">Ubah data karyawan</button>
                    </div>
                }

                <div style="font-size: 20px; color: #8892A4; margin-top: 26px">Tempelkan kartu lain untuk cek berikutnya.</div>
            }
        </div>
    }
    else if (!IsOnline)
    {
        @* Penolakan eksplisit, bukan form yang diam-diam gagal: satpam harus tahu kenapa. *@
        <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0; padding: 0 70px; box-sizing: border-box; text-align: center">
            <svg width="76" height="76" viewBox="0 0 24 24" fill="none" stroke="#F3B14E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 20h.01"></path>
                <path d="M8.5 16.4a5 5 0 0 1 7 0"></path>
                <path d="M5 12.9a10 10 0 0 1 5.2-2.7"></path>
                <path d="M19 12.9a10 10 0 0 0-3.1-2.1"></path>
                <path d="m2 2 20 20"></path>
            </svg>
            <div style="font-size: 52px; font-weight: 700; margin-top: 24px">Tidak bisa mendaftarkan kartu saat offline</div>
            <div style="font-size: 26px; color: #9AA4B5; margin-top: 14px; max-width: 820px; line-height: 1.5">
                UID kartu harus dicek ke server dulu supaya tidak kembar dengan kartu orang lain. Pendaftaran kartu sengaja tidak diantrekan.
            </div>
            <div style="font-size: 24px; color: #F3B14E; margin-top: 26px">Tap kartu tetap tercatat seperti biasa.</div>
        </div>
    }
    else
    {
        <div style="flex-grow: 1; display: flex; min-height: 0">

            <div style="width: 580px; flex-shrink: 0; border-right: 1px solid #252C3B; display: flex; flex-direction: column; min-height: 0">
                <div style="padding: 20px 24px 14px; flex-shrink: 0">
                    <div style="font-size: 20px; font-weight: 600">@(ShowAll ? "Semua karyawan aktif" : "Karyawan belum punya kartu")</div>
                    <div style="font-size: 16px; color: #8892A4; margin-top: 4px">
                        @VisibleRows.Count orang @(ShowAll ? "" : "— daftar menyusut tiap kartu didaftarkan")
                    </div>

                    @* Kotak cari untuk kasus GANTI kartu (orangnya sudah punya kartu aktif). *@
                    <input type="text" placeholder="Cari nama atau kode karyawan..." value="@Search"
                           @oninput="e => OnSearchChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)"
                           style="width: 100%; box-sizing: border-box; margin-top: 14px; font-size: 20px; padding: 14px 16px; border: 1px solid #39425A; border-radius: 10px; background: #171D2B; color: #FFFFFF" />

                    <label style="display: flex; align-items: center; gap: 10px; margin-top: 12px; font-size: 17px; color: #C3CBD8; min-height: 48px; cursor: pointer">
                        <input type="checkbox" checked="@ShowAll"
                               @onchange="e => OnShowAllChanged.InvokeAsync(e.Value is bool b && b)"
                               style="width: 24px; height: 24px" />
                        Tampilkan juga yang sudah punya kartu (ganti kartu)
                    </label>
                </div>

                <div style="padding: 0 16px 16px; display: flex; flex-direction: column; gap: 8px; overflow-y: auto; min-height: 0">
                    @{ var lastGroup = string.Empty; }
                    @foreach (var emp in VisibleRows)
                    {
                        var group = GroupLabel(emp);
                        if (group != lastGroup)
                        {
                            lastGroup = group;
                            <div style="padding: 12px 10px 4px; font-size: 14px; font-weight: 600; letter-spacing: 0.1em; color: #6E7A8C">@group.ToUpperInvariant()</div>
                        }
                        var selected = Selected?.EmployeeId == emp.EmployeeId;
                        <button type="button" @onclick="() => OnSelect.InvokeAsync(emp)"
                                style="text-align: left; background: @(selected ? "#1E3A5F" : "transparent"); border: 1px solid @(selected ? "#2F6098" : "#2B3245"); border-radius: 12px; padding: 16px 18px; min-height: 64px; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 12px">
                            <span>
                                <span style="display: block; font-size: 22px; font-weight: @(selected ? "600" : "500"); color: @(selected ? "#FFFFFF" : "#E6EAF1")">@emp.EmployeeName</span>
                                <span style="display: block; font-size: 16px; color: @(selected ? "#A9B6C9" : "#8892A4"); margin-top: 2px">
                                    @(emp.EmployeeCode ?? "tanpa kode")@(emp.HasActiveCard ? " · sudah punya kartu" : "")
                                </span>
                            </span>
                            @if (!string.IsNullOrWhiteSpace(emp.ResourceName))
                            {
                                <span style="display: inline-block; background: @GateFormat.BadgeColor(emp.ColorHex); color: #FFFFFF; font-size: 15px; font-weight: 600; padding: 5px 15px; border-radius: 999px; flex-shrink: 0">@emp.ResourceName</span>
                            }
                        </button>
                    }
                </div>
            </div>

            <div style="flex-grow: 1; padding: 24px 30px; box-sizing: border-box; min-width: 0; display: flex; flex-direction: column; overflow-y: auto">

                @if (Selected is null)
                {
                    <div style="flex-grow: 1; display: flex; align-items: center; justify-content: center; text-align: center">
                        <div style="font-size: 28px; color: #6E7A8C; max-width: 460px; line-height: 1.5">Pilih karyawan di sebelah kiri, lalu tempelkan kartu barunya.</div>
                    </div>
                }
                else
                {
                    <div style="font-size: 17px; letter-spacing: 0.1em; color: #6E7A8C; font-weight: 600">KARYAWAN DIPILIH</div>
                    <div style="font-size: 40px; font-weight: 700; margin-top: 6px">@Selected.EmployeeName</div>
                    <div style="font-size: 19px; color: #9AA4B5; margin-top: 2px">@Selected.PositionName &middot; @(Selected.EmployeeCode ?? "tanpa kode") &middot; @Selected.DivisionName</div>

                    <div style="margin-top: 26px; border: 2px dashed @(string.IsNullOrEmpty(ScannedUid) ? "#39425A" : "#2E7D4F"); border-radius: 14px; background: #171D2B; padding: 30px 26px; text-align: center">
                        <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="#7D8899" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                            <rect x="2" y="5" width="13" height="14" rx="2"></rect>
                            <path d="M17.5 8.5a5 5 0 0 1 0 7"></path>
                            <path d="M20.5 6a9 9 0 0 1 0 12"></path>
                        </svg>
                        <div style="font-size: 28px; font-weight: 500; color: #E6EAF1; margin-top: 10px">Tempelkan kartu baru</div>
                        <div style="font-family: 'IBM Plex Mono', Consolas, ui-monospace, monospace; font-size: 34px; font-weight: 500; letter-spacing: 0.08em; color: @(string.IsNullOrEmpty(ScannedUid) ? "#4A5366" : "#5BD98A"); margin-top: 14px">
                            @(string.IsNullOrEmpty(ScannedUid) ? "----------" : ScannedUid)
                        </div>
                    </div>

                    <div style="margin-top: 24px">
                        <div style="font-size: 18px; font-weight: 600; color: #C3CBD8; margin-bottom: 10px">Jenis kartu</div>
                        <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px">
                            <button type="button" @onclick='() => OnCardTypeChanged.InvokeAsync("TETAP")' style="@CardTypeStyle(CardType == "TETAP")">Kartu tetap</button>
                            <button type="button" @onclick='() => OnCardTypeChanged.InvokeAsync("SEMENTARA")' style="@CardTypeStyle(CardType == "SEMENTARA")">Kartu sementara</button>
                        </div>
                    </div>

                    @if (Selected.HasActiveCard)
                    {
                        @* Satu karyawan BOLEH punya beberapa kartu aktif (kartu tetap + sementara),
                           jadi ini pilihan satpam, bukan otomatis. *@
                        <div style="margin-top: 20px; border: 1px solid #252C3B; border-radius: 12px; background: #161B26; padding: 18px 20px">
                            <div style="font-size: 18px; font-weight: 600; color: #F3B14E; margin-bottom: 12px">Karyawan ini sudah punya kartu aktif</div>
                            <label style="display: flex; align-items: flex-start; gap: 12px; font-size: 19px; color: #C3CBD8; min-height: 48px; cursor: pointer">
                                <input type="checkbox" checked="@DeactivateOld"
                                       @onchange="e => OnDeactivateOldChanged.InvokeAsync(e.Value is bool b && b)"
                                       style="width: 26px; height: 26px; margin-top: 2px; flex-shrink: 0" />
                                <span>
                                    Nonaktifkan kartu lamanya
                                    <span style="display: block; font-size: 16px; color: #8892A4; margin-top: 2px">
                                        Jangan dicentang kalau kartu lama masih dipakai &mdash; dua kartu aktif tetap satu sesi absensi.
                                    </span>
                                </span>
                            </label>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div style="margin-top: 18px; font-size: 20px; color: #F3A6A6; background: #2A1414; border: 1px solid #5E2A2A; border-radius: 12px; padding: 16px 20px">@ErrorMessage</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
                    {
                        <div style="margin-top: 18px; font-size: 20px; color: #A8E6BF; background: #10301E; border: 1px solid #1A8549; border-radius: 12px; padding: 16px 20px">@SuccessMessage</div>
                    }

                    <div style="flex-grow: 1; min-height: 20px"></div>

                    <div style="display: flex; gap: 12px; padding-top: 20px">
                        <button type="button" @onclick="OnCancel"
                                style="flex-grow: 1; font-size: 21px; font-weight: 500; color: #C3CBD8; background: transparent; border: 1px solid #39425A; border-radius: 12px; padding: 20px; cursor: pointer">Batal</button>
                        <button type="button" disabled="@(IsSaving || string.IsNullOrEmpty(ScannedUid))" @onclick="OnSave"
                                style="flex-grow: 2; font-size: 21px; font-weight: 600; color: #FFFFFF; background: @(string.IsNullOrEmpty(ScannedUid) ? "#1E4430" : "#0E6B38"); border: 1px solid #1A8549; border-radius: 12px; padding: 20px; cursor: pointer">
                            @(IsSaving ? "Menyimpan..." : "Simpan kartu")
                        </button>
                    </div>
                }

            </div>

        </div>
    }

</div>

@code {
    [Parameter, EditorRequired] public GateCardDto Operator { get; set; } = new();
    [Parameter] public bool IsOnline { get; set; }
    [Parameter] public List<GateEmployeeDto> VisibleRows { get; set; } = new();
    [Parameter] public GateEmployeeDto? Selected { get; set; }
    [Parameter] public string ScannedUid { get; set; } = string.Empty;
    [Parameter] public string CardType { get; set; } = "TETAP";
    [Parameter] public bool DeactivateOld { get; set; }
    [Parameter] public string Search { get; set; } = string.Empty;
    [Parameter] public bool ShowAll { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? SuccessMessage { get; set; }
    // Mode "Cek kartu": kartu yang ditempel hanya dicari pemiliknya, tidak mengisi pendaftaran.
    [Parameter] public bool CheckMode { get; set; }
    [Parameter] public string CheckUid { get; set; } = string.Empty;
    [Parameter] public GateCardDto? CheckCard { get; set; }
    // No. telepon pemilik kartu, SUDAH tersamar (GateFormat.MaskPhone).
    [Parameter] public string? CheckMaskedPhone { get; set; }
    [Parameter] public EventCallback OnToggleCheck { get; set; }
    // Tombol "Ubah data karyawan" pada hasil cek: buka form ubah data pemilik kartu.
    [Parameter] public EventCallback<GateCardDto> OnEditCardOwner { get; set; }

    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback<GateEmployeeDto> OnSelect { get; set; }
    [Parameter] public EventCallback<string> OnCardTypeChanged { get; set; }
    [Parameter] public EventCallback<bool> OnDeactivateOldChanged { get; set; }
    [Parameter] public EventCallback<string> OnSearchChanged { get; set; }
    [Parameter] public EventCallback<bool> OnShowAllChanged { get; set; }

    // Dikelompokkan per divisi (resource kalau ada) -- urutannya sudah dari SP/cache.
    private static string GroupLabel(GateEmployeeDto emp) =>
        string.IsNullOrWhiteSpace(emp.ResourceName) ? emp.DivisionName : $"{emp.DivisionName} · {emp.ResourceName}";

    private static string CardTypeStyle(bool active) =>
        "font-size: 22px; font-weight: " + (active ? "600" : "500") +
        "; color: " + (active ? "#FFFFFF" : "#C3CBD8") +
        "; background: " + (active ? "#1E3A5F" : "transparent") +
        "; border: " + (active ? "2px solid #2F6098" : "1px solid #2B3245") +
        "; border-radius: 12px; padding: 20px; cursor: pointer";
}

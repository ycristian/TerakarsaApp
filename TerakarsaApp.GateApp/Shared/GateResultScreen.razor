@* Prompt 70 -- Gate 2 (CHECK_IN), Gate 3 (CHECK_OUT), Gate 4 (ditolak), Gate 6 (tersimpan
   offline). Satu komponen karena ketiganya kerangka yang sama dengan warna latar berbeda;
   warna & ukuran mengikuti claude prompt/mockup_70_absensi_rfid.html. Tampil 3 detik lalu
   kembali ke layar tunggu -- TIDAK ada tombol OK. Sentuhan di mana saja (termasuk tombol X di
   kanan atas) langsung kembali ke layar tunggu tanpa menunggu hitungan mundur habis. *@

<div style="width: 100%; height: 100%; box-sizing: border-box; background: @Bg; color: #FFFFFF; display: flex; flex-direction: column; cursor: pointer"
     @onclick="OnDismiss">

    <div style="height: 76px; box-sizing: border-box; padding: 0 44px; border-bottom: 1px solid @BorderColor; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0">
        <div style="font-size: 20px; font-weight: 600; letter-spacing: 0.14em; color: @MutedColor">@GateName</div>
        <div style="display: flex; align-items: center; gap: 28px">
        @if (IsOfflineSave)
        {
            <div style="display: flex; align-items: center; gap: 10px; font-size: 19px; font-weight: 600; color: #F3B14E">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h.01"></path>
                    <path d="M8.5 16.4a5 5 0 0 1 7 0"></path>
                    <path d="M5 12.9a10 10 0 0 1 5.2-2.7"></path>
                    <path d="M19 12.9a10 10 0 0 0-3.1-2.1"></path>
                    <path d="m2 2 20 20"></path>
                </svg>
                Offline &mdash; @PendingCount tap menunggu dikirim
            </div>
        }
        else
        {
            <div style="font-size: 20px; color: @MutedColor">@GateFormat.LongDate(Now)</div>
        }
            @* Klik-nya ditangani div terluar (sentuh di mana saja = kembali); tombol ini hanya
               penanda yang terlihat. Ukuran 56px supaya mudah kena jari. *@
            <button type="button" title="Tutup" aria-label="Tutup"
                    style="width: 56px; height: 56px; border-radius: 50%; border: 1px solid @BorderColor; background: rgba(255,255,255,0.12); color: #FFFFFF; display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                </svg>
            </button>
        </div>
    </div>

    <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: @(IsRejected ? "10px" : "8px"); padding: 0 @(IsRejected ? "70px" : "60px"); box-sizing: border-box; text-align: center">

        @if (IsRejected)
        {
            @* Gate 4: nama tidak selalu ada (kartu memang tidak dikenal). Yang WAJIB terbaca
               adalah UID-nya -- itu yang dipakai satpam mendaftarkan kartu pengganti. *@
            <svg width="76" height="76" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 7.5v5.5"></path>
                <path d="M12 16.5h.01"></path>
            </svg>

            <div style="font-size: 68px; font-weight: 700; line-height: 1.15; margin-top: 18px">@RejectTitle</div>
            <div style="font-size: 30px; color: #F0C9C9; margin-top: 10px; max-width: 820px">@RejectSubtitle</div>

            <div style="margin-top: 44px; padding: 22px 46px; border: 1px solid #BF4C4C; border-radius: 14px; background: #7A1616">
                <div style="font-size: 20px; color: #EBB9B9; letter-spacing: 0.1em">UID TERBACA</div>
                <div style="font-family: 'IBM Plex Mono', Consolas, ui-monospace, monospace; font-size: 54px; font-weight: 500; letter-spacing: 0.08em; margin-top: 6px">@Result.CardUid</div>
            </div>
        }
        else
        {
            @if (!IsOfflineSave)
            {
                <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 6px">
                    @if (IsDuplicate)
                    {
                        <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="m8 12 3 3 6-6"></path>
                        </svg>
                        <div style="font-size: 40px; font-weight: 700; letter-spacing: 0.18em">SUDAH TERCATAT</div>
                    }
                    else if (IsCheckIn)
                    {
                        <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="m8 12 3 3 6-6"></path>
                        </svg>
                        <div style="font-size: 40px; font-weight: 700; letter-spacing: 0.18em">MASUK</div>
                    }
                    else
                    {
                        <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <path d="m16 17 5-5-5-5"></path>
                            <path d="M21 12H9"></path>
                        </svg>
                        <div style="font-size: 40px; font-weight: 700; letter-spacing: 0.18em">PULANG</div>
                    }
                </div>
            }

            <div style="font-size: @(IsOfflineSave ? "78px" : "86px"); font-weight: 700; line-height: 1.1; letter-spacing: -0.01em">@DisplayName</div>
            <div style="font-size: @(IsOfflineSave ? "27px" : "28px"); color: @SubtleColor; margin-top: @(IsOfflineSave ? "6px" : "4px")">@SubLine</div>
            @if (!string.IsNullOrEmpty(MaskedPhone))
            {
                <div style="font-size: 24px; color: @SubtleColor; margin-top: 4px; font-family: 'IBM Plex Mono', Consolas, ui-monospace, monospace; letter-spacing: 0.06em">@MaskedPhone</div>
            }

            @if (!string.IsNullOrWhiteSpace(Result.ResourceName))
            {
                <div style="display: inline-block; margin-top: @(IsOfflineSave ? "20px" : "22px"); background: @GateFormat.BadgeColor(Result.ColorHex); color: #FFFFFF; font-size: @(IsOfflineSave ? "26px" : "28px"); font-weight: 600; padding: @(IsOfflineSave ? "11px 32px" : "12px 34px"); border-radius: 999px">@Result.ResourceName</div>
            }

            @if (IsOfflineSave)
            {
                @* Gate 6: SENGAJA tidak menyebut masuk atau pulang -- penentuan in/out milik
                   server, dan saat offline server belum menjawab. *@
                <div style="margin-top: 42px; padding: 26px 48px; background: #332200; border: 1px solid #7A5406; border-radius: 14px">
                    <div style="font-size: 44px; font-weight: 700; color: #F3B14E; letter-spacing: 0.04em">TERSIMPAN (OFFLINE)</div>
                    <div style="font-size: 44px; font-weight: 600; color: #FFFFFF; margin-top: 8px">@TappedAt.ToString("HH:mm")</div>
                </div>
                <div style="font-size: 23px; color: #9AA4B5; margin-top: 26px; max-width: 760px; line-height: 1.5">Masuk atau pulang ditentukan server saat jaringan tersambung kembali. Jam yang tercatat tetap jam tap ini.</div>
            }
            else if (IsDuplicate && Result.CheckInAt is null)
            {
                @* Tap dobel yang jamnya tidak diketahui tablet (mis. tap pertama masih di antrian
                   offline): jangan tampilkan kolom jam kosong. *@
                <div style="margin-top: 30px; font-size: 26px; color: @SubtleColor">Tap sebelumnya sudah tercatat &mdash; tidak perlu tap lagi.</div>
            }
            else if (ShowsAsCheckIn)
            {
                <div style="margin-top: 36px; padding-top: 30px; border-top: 1px solid @BorderColor; width: 100%; max-width: 620px">
                    <div style="font-size: 22px; color: @MutedColor">Jam masuk</div>
                    <div style="font-size: 92px; font-weight: 600; line-height: 1.1">@GateFormat.Time(Result.CheckInAt)</div>
                </div>
            }
            else
            {
                <div style="margin-top: 36px; padding-top: 30px; border-top: 1px solid @BorderColor; width: 100%; max-width: 860px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px">
                    <div>
                        <div style="font-size: 22px; color: @MutedColor">Masuk</div>
                        <div style="font-size: 62px; font-weight: 600; line-height: 1.15">@GateFormat.Time(Result.CheckInAt)</div>
                    </div>
                    <div>
                        <div style="font-size: 22px; color: @MutedColor">Pulang</div>
                        <div style="font-size: 62px; font-weight: 600; line-height: 1.15">@GateFormat.Time(Result.CheckOutAt)</div>
                    </div>
                    <div>
                        <div style="font-size: 22px; color: @MutedColor">Durasi</div>
                        <div style="font-size: 62px; font-weight: 600; line-height: 1.15">@GateFormat.Duration(Result.DurationMinutes)</div>
                    </div>
                </div>
                @if (Result.CheckOutAt is null && !IsDuplicate)
                {
                    @* CHECK_OUT tanpa jam pulang = sesi ditutup sebagai ANOMALI (satpam memilih
                       "kartu lupa dikembalikan"). Pesannya datang dari SP. *@
                    <div style="margin-top: 22px; font-size: 24px; color: @SubtleColor; max-width: 760px">@Result.Message</div>
                }
            }
        }

    </div>

    <div style="padding: 0 44px 34px; text-align: center; flex-shrink: 0">
        @if (CanEdit)
        {
            @* stopPropagation: tanpa ini sentuhan di tombol ikut ditangkap div terluar dan layar
               langsung kembali ke layar tunggu. *@
            <button type="button" @onclick="OnEdit" @onclick:stopPropagation="true"
                    style="font-size: 22px; font-weight: 600; color: #FFFFFF; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.45); border-radius: 12px; padding: 16px 36px; min-height: 60px; margin-bottom: 18px; cursor: pointer; display: inline-flex; align-items: center; gap: 12px">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                </svg>
                Ubah data karyawan (kartu petugas)
            </button>
        }
        <div style="font-size: 20px; color: @FooterColor">Kembali ke layar tunggu dalam @SecondsLeft detik &middot; sentuh layar untuk kembali sekarang</div>
    </div>

</div>

@code {
    [Parameter, EditorRequired] public string GateName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public GateTapResultDto Result { get; set; } = new();
    // true = tap hanya masuk antrian lokal (server belum menjawab).
    [Parameter] public bool IsOfflineSave { get; set; }
    [Parameter] public int PendingCount { get; set; }
    [Parameter] public DateTime TappedAt { get; set; } = DateTime.Now;
    [Parameter] public DateTime Now { get; set; } = DateTime.Now;
    [Parameter] public int SecondsLeft { get; set; } = 3;
    // Sentuhan di mana saja / tombol X: kembali ke layar tunggu sekarang juga.
    [Parameter] public EventCallback OnDismiss { get; set; }
    // Tombol "Ubah data karyawan": minta kartu petugas lalu buka form karyawan yang baru tap.
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    // No. telepon pemilik kartu, SUDAH tersamar (GateFormat.MaskPhone). null = tidak ditampilkan.
    [Parameter] public string? MaskedPhone { get; set; }

    private bool IsCheckIn => Result.ResultCode == GateResultCodes.CheckIn;
    private bool IsDuplicate => Result.ResultCode == GateResultCodes.Duplicate;
    // DUPLIKAT memakai warna & kolom sesuai keadaan sesinya: masih OPEN (belum pulang) = hijau
    // dengan jam masuk saja; sudah pulang = biru dengan masuk/pulang/durasi.
    private bool ShowsAsCheckIn => IsCheckIn || (IsDuplicate && Result.CheckOutAt is null);
    private bool IsRejected => Result.ResultCode is GateResultCodes.UnknownCard or GateResultCodes.InactiveCard or GateFormat.BadReadCode;
    private bool IsBadRead => Result.ResultCode == GateFormat.BadReadCode;

    private string Bg => IsOfflineSave ? "#12161F"
        : IsRejected ? "#8E1D1D"
        : ShowsAsCheckIn ? "#0E6B38"
        : "#10467F";

    private string BorderColor => IsOfflineSave ? "#252C3B"
        : IsRejected ? "#A93434"
        : ShowsAsCheckIn ? "#1A8549"
        : "#1C5C9E";

    private string MutedColor => IsOfflineSave ? "#9AA4B5"
        : IsRejected ? "#EBB9B9"
        : ShowsAsCheckIn ? "#B9E2C9"
        : "#B4CDE8";

    private string SubtleColor => IsOfflineSave ? "#9AA4B5"
        : ShowsAsCheckIn ? "#C6E8D4"
        : "#C2D8EE";

    private string FooterColor => IsOfflineSave ? "#7D8899"
        : IsRejected ? "#E0A5A5"
        : ShowsAsCheckIn ? "#9ED4B4"
        : "#9BBCDD";

    private string RejectTitle => IsBadRead ? "Tempelkan ulang kartu"
        : Result.ResultCode == GateResultCodes.InactiveCard ? "Kartu sudah nonaktif"
        : "Kartu tidak dikenal";

    // Bacaan rusak (digit hilang) bukan kartu asing -- jangan suruh lapor petugas.
    private string RejectSubtitle => IsBadRead
        ? "Pembacaan kartu tidak sempurna. Tahan kartu di reader sampai berbunyi."
        : "Lapor ke petugas untuk didaftarkan sebagai kartu pengganti";

    // Saat offline nama diambil dari cache SQLite; kalau kartunya belum pernah ikut sync, tidak
    // ada nama yang bisa ditampilkan dan itu harus kelihatan apa adanya.
    private string DisplayName => string.IsNullOrWhiteSpace(Result.EmployeeName) ? "Kartu belum dikenal di tablet" : Result.EmployeeName!;

    private string SubLine
    {
        get
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(Result.PositionName)) parts.Add(Result.PositionName!);
            if (!string.IsNullOrWhiteSpace(Result.EmployeeCode)) parts.Add(Result.EmployeeCode!);
            return parts.Count == 0 ? Result.CardUid ?? string.Empty : string.Join(" · ", parts);
        }
    }
}
